+def repair_fixtures(task, tree):
+    """Lay the `FIXTURE_REPAIRS` files of this task that the tree lacks; return `["<path>: <reason>"]`."""
+    done = []
+    for dst, src, why in FIXTURE_REPAIRS.get(task["task"].get("name"), []):
