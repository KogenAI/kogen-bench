+        if os.path.isfile(s) and not os.path.lexists(d):  # on a case-insensitive host `d` exists: nothing to do
+            os.makedirs(os.path.dirname(d), exist_ok=True)
+            shutil.copyfile(s, d)
+            done.append(f"{dst}: {why}")
+    return done
