+package provider
+
+import (
+	"context"
+	"reflect"
+	"testing"
+)
+
+// Exercise the actual key route, dispatch, SSE parser and second request. No
+// benchmark task or provider credential is used; these are local scripted servers.
+func TestAPIResponsesReplay(t *testing.T) {
+	for _, effort := range []string{"high", "medium"} {
+		t.Run(effort, func(t *testing.T) {
+			reason := map[string]any{"type": "reasoning", "id": "rs_fixture", "summary": []any{}, "encrypted_content": "opaque-fixture"}
+			call := map[string]any{"type": "function_call", "id": "fc_fixture", "call_id": "call_fixture", "name": "read_file", "arguments": `{"path":"a"}`}
+			e, f, role := compatibleEnv(t, "", events(itemDone(0, reason), itemDone(1, call),
+				done(map[string]any{"status": "completed", "output": []any{reason, call}})), textAnswer("done"))
+			role.Model, role.Effort = "gpt-6.1-terra", effort
+			role.BaseURL = f.srv.URL + "/tenant/v1/"
+			if effort == "high" {
+				e.saveCreds("openai-compatible", map[string]any{"provider": "openai-compatible", "api_key": testKey})
+			}
+			req := Request{Role: role, Instructions: "policy", Input: user("work"), Tools: []any{goTool("read_file")}, CacheID: "api-fixture"}
+			response, err := e.c.Respond(context.Background(), e.s, req, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(response.Items) != 2 || !reflect.DeepEqual(response.Items[0], reason) || !reflect.DeepEqual(response.Items[1], call) {
+				t.Fatalf("native response items lost: %#v", response.Items)
+			}
+			for _, item := range response.Items {
+				req.Input = append(req.Input, item)
+			}
+			req.Input = append(req.Input, map[string]any{"type": "function_call_output", "call_id": "call_fixture", "output": "1\tcontent"})
+			if _, err := e.c.Respond(context.Background(), e.s, req, nil); err != nil {
+				t.Fatal(err)
+			}
+			requests := f.requests()
+			if len(requests) != 2 {
+				t.Fatalf("requests: %d", len(requests))
+			}
+			for _, r := range requests {
+				if r.Path != "/tenant/v1/responses" {
+					t.Fatalf("route: %s", r.Path)
+				}
+				if r.JSON["model"] != role.Model || r.JSON["reasoning"].(map[string]any)["effort"] != effort || r.JSON["store"] != false || r.JSON["stream"] != true {
+					t.Fatalf("controls changed: %#v", r.JSON)
+				}
+				if !reflect.DeepEqual(r.JSON["include"], []any{"reasoning.encrypted_content"}) || r.JSON["prompt_cache_key"] != "api-fixture" {
+					t.Fatalf("replay/cache controls: %#v", r.JSON)
+				}
+				auth := ""
+				if effort == "high" {
+					auth = "Bearer " + testKey
+				}
+				if r.Header.Get("Authorization") != auth {
+					t.Fatal("optional key behavior changed")
+				}
+				for _, h := range []string{"session_id", "conversation_id", "X-Opencode-Session"} {
+					if r.Header.Get(h) != "" {
+						t.Fatalf("vendor header %s", h)
+					}
+				}
+				if _, ok := r.JSON["messages"]; ok {
+					t.Fatal("Chat translation remains")
+				}
+			}
+			input := requests[1].JSON["input"].([]any)
+			if !reflect.DeepEqual(input[1], reason) || !reflect.DeepEqual(input[2], call) {
+				t.Fatal("replay changed")
+			}
+		})
+	}
+}
+
+func TestAPIResponsesDoesNotFallbackToChat(t *testing.T) {
+	e, f, role := compatibleEnv(t, "", httpFail(400, "invalid_request_error", "fixture refusal"))
+	role.Model, role.Effort = "gpt-6.1-terra", "medium"
+	_, err := e.c.Respond(context.Background(), e.s, Request{Role: role, Instructions: "p", Input: user("x")}, nil)
+	if err == nil || len(f.requests()) != 1 || f.requests()[0].Path != "/v1/responses" {
+		t.Fatalf("refusal/fallback: %v, %d requests", err, len(f.requests()))
+	}
+}
