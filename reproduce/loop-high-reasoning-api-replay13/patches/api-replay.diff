+package conformance
+
+import (
+	"context"
+	"reflect"
+	"testing"
+
+	"kogen-loop/api"
+	"kogen-loop/loop"
+	"kogen-loop/provider"
+)
+
+// Exercise real session execution and persisted replay through the local fake API.
+func TestAPIResponsesSessionPreservesReasoning(t *testing.T) {
+	for _, effort := range []string{"high", "medium"} {
+		t.Run(effort, func(t *testing.T) {
+			w := newWorld(t).seed(map[string]string{"a": "content\n"})
+			reason := map[string]any{"type": "reasoning", "id": "rs_fixture", "summary": []any{}, "encrypted_content": "opaque-fixture"}
+			f := newFakeProvider(t, []exchange{
+				{Items: []map[string]any{reason, call("read", "read_file", map[string]any{"path": "a"})}},
+				{Items: []map[string]any{message("done")}},
+				{Items: []map[string]any{message("again")}},
+			})
+			var ev []api.Event
+			cfg := sessionConfig(w, f, &ev)
+			cfg.Role = provider.Role{Provider: "openai-compatible", Model: "gpt-6.1-terra", Effort: effort, BaseURL: f.url() + "/v1"}
+			cfg.Dir = t.TempDir()
+			s, err := loop.NewSession(cfg)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if _, err := s.Round(context.Background(), "work"); err != nil {
+				t.Fatal(err)
+			}
+			in := f.requests()[1]["input"].([]any)
+			if !reflect.DeepEqual(in[1], reason) || in[3].(map[string]any)["output"] != "1\tcontent" {
+				t.Fatalf("reasoning/tool replay changed: %#v", in)
+			}
+			resumed, err := loop.ResumeSession(cfg)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if _, err := resumed.Round(context.Background(), "continue"); err != nil {
+				t.Fatal(err)
+			}
+			in = f.requests()[2]["input"].([]any)
+			if !reflect.DeepEqual(in[1], reason) {
+				t.Fatal("persisted reasoning lost")
+			}
+		})
+	}
+}
