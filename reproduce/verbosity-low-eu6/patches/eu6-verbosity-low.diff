diff -ruN ctl/src/provider/api_verbosity_test.go vlo/src/provider/api_verbosity_test.go
--- ctl/src/provider/api_verbosity_test.go	1970-01-01 03:00:00
+++ vlo/src/provider/api_verbosity_test.go	2026-10-30 22:55:01
@@ -0,0 +1,27 @@
+package provider
+
+import "testing"
+
+func TestAPIVerbosityLow(t *testing.T) {
+	cases := []struct {
+		provider, model string
+		low             bool
+	}{{"openai-compatible", "gpt-6.1-terra", true}, {"openai-compatible", "other-model", false}, {"chatgpt", "gpt-6.1-terra", false}}
+	for _, c := range cases {
+		info, ok := Lookup(c.provider)
+		if !ok {
+			t.Fatal(c.provider)
+		}
+		r, err := render(info, Request{Role: Role{Provider: c.provider, Model: c.model, Effort: "high", BaseURL: "http://fixture/v1"}}, "session", false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		text, exists := r.body["text"].(map[string]any)
+		if c.low != (exists && text["verbosity"] == "low") {
+			t.Fatalf("%s %s: text %v", c.provider, c.model, r.body["text"])
+		}
+		if c.low && (r.body["reasoning"].(map[string]any)["effort"] != "high" || r.body["store"] != false) {
+			t.Fatal("reasoning effort or store changed")
+		}
+	}
+}
