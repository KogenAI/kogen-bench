diff --git a/cli/shape/hc_p2_test.go b/cli/shape/hc_p2_test.go
new file mode 100644
index 0000000..4d7ebae
--- /dev/null
+++ b/cli/shape/hc_p2_test.go
@@ -0,0 +1,50 @@
+package shape
+
+import (
+	"strings"
+	"testing"
+
+	"kogen/executor"
+)
+
+// Lane patch P2/S1: the shaper's policy carries the unstated-requirement pass, and a ready
+// Intent records the hc_p2_unstated witness with the count of its `- unstated:` lines.
+
+func TestHCP2ShaperPolicyCarriesTheUnstatedRequirementPass(t *testing.T) {
+	text := ShaperInstructions()
+	for _, want := range []string{"Unstated-requirement pass:", "nearest existing counterpart", "- unstated: <requirement> -> "} {
+		if !strings.Contains(text, want) {
+			t.Errorf("shaper policy lacks %q", want)
+		}
+	}
+	if strings.Contains(refineInstructions(), "Unstated-requirement pass:") {
+		t.Error("the pass belongs to Shape only, not Refine")
+	}
+}
+
+func TestHCP2UnstatedItemsCountsLines(t *testing.T) {
+	items, out := unstatedItems("- The request asks for x.\n- unstated: empty input -> Scenario: Empty (evidence: request)\n  - Unstated: errors keep the old text -> out of scope: no error path changes (evidence: lib/x.py)\n")
+	shpEq(t, "items", items, 2)
+	shpEq(t, "out of scope", out, 1)
+}
+
+func TestHCP2ReadyShapeRecordsTheWitness(t *testing.T) {
+	parallel(t)
+	files := shpFiles()
+	list := files["files"].([]any)
+	md := strings.Replace(shpIntentMD, "## Source comparison\n- The request asks for is_even; the feature covers it.\n",
+		"## Source comparison\n- The request asks for is_even; the feature covers it.\n- unstated: zero is even -> Scenario: Even numbers (evidence: request)\n- unstated: negative numbers -> out of scope: request names integers only (evidence: request)\n", 1)
+	list[0] = map[string]any{"path": ".kogen/intents/is-even/intent.md", "content": md}
+	f := newShpFx(t)
+	f.useExternalShape(6)
+	x := &shapeExec{t: t, rounds: []func(int, string) (executor.RoundResult, error){result(files)}}
+	if exit, err := f.shapeWith(x, "Add calc.is_even(n)."); err != nil || exit != 0 {
+		t.Fatalf("exit %d, err %v; refusals %v", exit, err, shpNamed(f.events(), "submission_refused"))
+	}
+	shpContains(t, "external brief", x.starts[0].Brief.Stable, "Unstated-requirement pass:")
+	got := shpNamed(f.events(), "hc_p2_unstated")
+	shpEq(t, "witness events", len(got), 1)
+	shpEq(t, "items", got[0]["items"], any(float64(2)))
+	shpEq(t, "scenarios", got[0]["scenarios"], any(float64(1)))
+	shpEq(t, "out of scope", got[0]["out_of_scope"], any(float64(1)))
+}
