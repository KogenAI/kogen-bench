+// ShaperInstructions is the shaper's policy: its instructions, the context guidance, the
+// named-test helper guidance and the unstated-requirement pass.
 func ShaperInstructions() string {
-	return agent.Prompt(agent.Shaper) + contextGuidance() + "\n" + namedTestGuidance
+	return agent.Prompt(agent.Shaper) + contextGuidance() + "\n" + namedTestGuidance + "\n" + unstatedRequirementPass
+}
+
+// unstatedItems counts the `- unstated:` lines of a Source comparison: all of them, and those
+// settled as out of scope rather than by a scenario.
+func unstatedItems(comparison string) (items, outOfScope int) {
+	for _, line := range strings.Split(comparison, "\n") {
+		line = strings.TrimSpace(line)
+		if !strings.HasPrefix(strings.ToLower(line), "- unstated:") {
+			continue
+		}
+		items++
+		if strings.Contains(strings.ToLower(line), "out of scope") {
+			outOfScope++
+		}
+	}
+	return items, outOfScope
 }
 
