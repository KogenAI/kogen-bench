@@ -0,0 +1,80 @@
+package shape
+
+// research lane: tests of the NE-1 coverage ledger.
+
+import (
+	"strings"
+	"testing"
+)
+
+const ledgerRequest = "Add `calc.is_even(n)` with a `--strict` flag. A call that takes longer than 750 ms must fail with \"timeout exceeded\". " +
+	"The wait counts from the latest reading, never from the first. Set `CALC_LIMIT` to 1,024 bytes.\n\n```\nexample: 2 s\n```\n"
+
+const ledgerFeature = "Feature: Is even\n  # a comment with --strict\n  Scenario: Slow call\n    Given a call that takes 750 milliseconds\n    Then it fails with \"Timeout exceeded\"\n  Scenario: Wait\n    Then the wait counts from the latest reading\n"
+
+func TestRequestItems(t *testing.T) {
+	var got []string
+	for _, it := range requestItems(ledgerRequest) {
+		got = append(got, it.Kind+": "+it.Text)
+	}
+	want := []string{"number: 750 ms", "number: 1,024 bytes", "number: 2 s", "identifier: calc.is_even", "identifier: --strict", "identifier: CALC_LIMIT", "string: timeout exceeded", "sentence: The wait counts from the latest reading, never from the first."}
+	if strings.Join(got, "\n") != strings.Join(want, "\n") {
+		t.Fatalf("items:\n%s\nwant:\n%s", strings.Join(got, "\n"), strings.Join(want, "\n"))
+	}
+}
+
+func TestCheckLedger(t *testing.T) {
+	units := featureUnits(ledgerFeature)
+	if len(units) != 2 || units[0].name != "scenario: Slow call" {
+		t.Fatalf("units: %+v", units)
+	}
+	l := checkLedger(ledgerRequest, units)
+	mapped := map[string]bool{}
+	for _, it := range l.Items {
+		mapped[it.Text] = it.Mapped
+	}
+	// 750 ms is "750 milliseconds" in the scenario; the string differs by case only; the sentence shares its words.
+	for _, text := range []string{"750 ms", "timeout exceeded", "The wait counts from the latest reading, never from the first."} {
+		if !mapped[text] {
+			t.Errorf("%q is unmapped: %+v", text, l)
+		}
+	}
+	// The comment line does not cover --strict; nothing mentions the rest.
+	for _, text := range []string{"--strict", "calc.is_even", "CALC_LIMIT", "1,024 bytes", "2 s"} {
+		if mapped[text] {
+			t.Errorf("%q is mapped: %+v", text, l)
+		}
+	}
+	if l.Mapped != 3 || l.Unmapped != 5 {
+		t.Errorf("counts %d/%d", l.Mapped, l.Unmapped)
+	}
+	// A Decision that quotes an item maps it, and a longer token does not.
+	units = append(units, ledgerUnit{name: "Decision: x", text: "`--strict` is out of scope; CALC_LIMIT_MAX is 1024 bytes (source: request)"})
+	l = checkLedger(ledgerRequest, units)
+	for _, it := range l.Items {
+		if (it.Text == "--strict" || it.Text == "1,024 bytes") && !it.Mapped || it.Text == "CALC_LIMIT" && it.Mapped {
+			t.Errorf("%q mapped=%v", it.Text, it.Mapped)
+		}
+	}
+}
+
+// research lane: the witness. An unmapped request item comes back as submission feedback, a
+// coverage_ledger event records it, and the resubmission that quotes it in a Decision is accepted.
+func TestCoverageLedgerReturnsUnmappedItems(t *testing.T) {
+	covered := shpFilesWithDecisions("- Non-integers raise TypeError. (source: request)", "- `calc.is_even` takes one argument and the 750ms limit is out of scope here. (source: request)")
+	f := newShpFx(t, shpSubmit("c1", shpFiles()), shpSubmit("c2", covered), shpAck("c3"))
+	exit, err := f.shape("Add `calc.is_even(n)`. It must finish in 750ms.")
+	if err != nil || exit != 0 {
+		t.Fatalf("exit %d, err %v\n%s", exit, err, f.Stderr)
+	}
+	reqs := f.Prov.requests()
+	shpEq(t, "requests", len(reqs), 3)
+	shpContains(t, "feedback", shpOutputs(reqs[1])["c1"], "These request items are not covered by any scenario or Decision:\n- number: 750ms\n- identifier: calc.is_even\nAdd a scenario")
+	ev := shpNamed(f.events(), "coverage_ledger")
+	// the acknowledgment submission is linted again, unchanged
+	if len(ev) != 3 || ev[0]["unmapped"] != any(float64(2)) || ev[1]["unmapped"] != any(float64(0)) || ev[2]["unmapped"] != any(float64(0)) {
+		t.Fatalf("coverage_ledger events: %v", ev)
+	}
+	shpEq(t, "refusals", len(shpNamed(f.events(), "submission_refused")), 1)
+	shpContains(t, "ledger text", f.read(".kogen/local/shaping/"+shpSlug+"/coverage-ledger.md"), "| calc.is_even | identifier | Decision:")
+}
