diff -ruN src-base/loop/snapshot_open_test.go src-wmap/loop/snapshot_open_test.go
--- src-base/loop/snapshot_open_test.go	1970-01-01 03:00:00
+++ src-wmap/loop/snapshot_open_test.go	2026-11-02 02:22:06
@@ -0,0 +1,70 @@
+package loop
+
+import (
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"kogen-loop/provider"
+	"kogen-loop/sys"
+	"kogen-loop/tools"
+)
+
+// The opening round of a small repository carries the workspace snapshot as a second user
+// message after the task text; later rounds do not repeat it.
+func TestOpeningRoundCarriesTheWorkspaceSnapshot(t *testing.T) {
+	root := t.TempDir()
+	env := []string{"HOME=" + t.TempDir(), "PATH=" + os.Getenv("PATH"), "GIT_CONFIG_GLOBAL=/dev/null", "GIT_CONFIG_NOSYSTEM=1"}
+	cmd := exec.Command("git", "init", "-q")
+	cmd.Dir, cmd.Env = root, env
+	if out, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("git init: %v %s", err, out)
+	}
+	if err := os.WriteFile(filepath.Join(root, "a.go"), []byte("package a\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	s, err := NewSession(SessionConfig{
+		Root: root, Role: provider.Role{Provider: "openai-compatible", Model: "local", BaseURL: "http://127.0.0.1:1"},
+		Session: sys.NewWith(env, root),
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	in := s.next("do it")
+	if len(in) != 2 {
+		t.Fatalf("opening input has %d items, want task + snapshot", len(in))
+	}
+	if first := in[0].(map[string]any); first["content"] != "do it" || first["role"] != "user" {
+		t.Fatalf("task message changed: %v", first)
+	}
+	snap := in[1].(map[string]any)
+	text, _ := snap["content"].(string)
+	if snap["role"] != "user" || !strings.HasPrefix(text, tools.SnapshotHeader) || !strings.Contains(text, "read_file \"a.go\":\n1\tpackage a") {
+		t.Fatalf("snapshot message: %v", snap)
+	}
+	// A failed first round leaves the input empty; the retry opens with the same snapshot
+	// even after the round changed the tree.
+	if err := os.WriteFile(filepath.Join(root, "a.go"), []byte("package changed\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if again := s.next("do it"); len(again) != 2 || again[1].(map[string]any)["content"] != text {
+		t.Fatalf("retried opening differs from the first snapshot: %v", again)
+	}
+	s.input = in
+	if later := s.next("again"); len(later) != 3 || strings.HasPrefix(later[2].(map[string]any)["content"].(string), tools.SnapshotHeader) {
+		t.Fatalf("a later round must append only the user text: %v", later)
+	}
+
+	plain, err := NewSession(SessionConfig{
+		Root: t.TempDir(), Role: provider.Role{Provider: "openai-compatible", Model: "local", BaseURL: "http://127.0.0.1:1"},
+		Session: sys.NewWith(env, root),
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if in := plain.next("do it"); len(in) != 1 {
+		t.Fatalf("a root that is not a repository must open with the task alone: %v", in)
+	}
+}
diff -ruN src-base/tools/snapshot.go src-wmap/tools/snapshot.go
--- src-base/tools/snapshot.go	1970-01-01 03:00:00
+++ src-wmap/tools/snapshot.go	2026-11-02 02:21:11
@@ -0,0 +1,98 @@
+package tools
+
+import (
+	"bytes"
+	"io"
+	"os"
+	"slices"
+	"strconv"
+	"strings"
+	"syscall"
+	"unicode/utf8"
+)
+
+// The workspace snapshot of a small repository opens a session: what list_files and
+// read_file would return at the start, so the model does not spend its first requests
+// listing and reading a repository that fits in a few thousand tokens. Larger repositories
+// get no snapshot (their exploration is targeted search, which a map does not replace).
+const (
+	snapshotFiles     = 64     // more listed paths: no snapshot
+	snapshotFileBytes = 4096   // a larger file is listed but not shown
+	snapshotBytes     = 32_768 // listing + shown read_file outputs above this: no snapshot
+)
+
+// SnapshotHeader opens the snapshot text.
+const SnapshotHeader = "Workspace at the start of the task: the output of list_files, then read_file of every listed file of up to " +
+	"4096 bytes (larger or binary files are listed only). Files you change later are not updated here."
+
+// Snapshot is the opening workspace view, or "" when list_files or read_file is not
+// enabled, the listing fails or is empty, it lists more than snapshotFiles paths, or the
+// listing and shown outputs exceed snapshotBytes. The listing and each shown file are
+// exactly the list_files and read_file outputs as a session delivers them (uncut). Only
+// regular files are read, at most snapshotFileBytes+1 bytes each, without blocking; a path
+// read_file would refuse, a larger, binary or invalid UTF-8 file, or one whose numbered
+// output a delivery would cut, is listed only.
+func (t *Tools) Snapshot() string {
+	if !slices.Contains(t.Enabled, ListFilesTool) || !slices.Contains(t.Enabled, ReadFileTool) {
+		return ""
+	}
+	listing := t.listFiles(map[string]any{})
+	if listing == "(no files)" || strings.HasPrefix(listing, "error:") || strings.HasPrefix(listing, "refused:") || Cut(listing) != listing {
+		return ""
+	}
+	if len(strings.Split(listing, "\n")) > snapshotFiles {
+		return ""
+	}
+	// The listing shows Git's quoted form of unusual names; the reads need the real names,
+	// in the same order.
+	res, err := t.repo().Run("ls-files", "-z", "--cached", "--others", "--exclude-standard", "--deduplicate", "--")
+	if err != nil || res.Status != 0 {
+		return ""
+	}
+	names := strings.Split(strings.TrimSuffix(res.Stdout, "\x00"), "\x00")
+	if len(names) != len(strings.Split(listing, "\n")) {
+		return ""
+	}
+	var b strings.Builder
+	b.WriteString(SnapshotHeader + "\n\nlist_files:\n" + listing + "\n")
+	total := len(listing)
+	for _, name := range names {
+		data, ok := t.smallRegular(name)
+		if !ok || bytes.IndexByte(data, 0) >= 0 || !utf8.Valid(data) {
+			continue
+		}
+		text := numbered(string(data), nil, nil)
+		if Cut(text) != text {
+			continue
+		}
+		if total += len(text); total > snapshotBytes {
+			return ""
+		}
+		b.WriteString("\nread_file " + strconv.Quote(name) + ":\n" + text + "\n")
+	}
+	return strings.TrimRight(b.String(), "\n")
+}
+
+// smallRegular is the content of a contained regular file of at most snapshotFileBytes,
+// read through the same containment as read_file. A FIFO or device is not read (the open
+// does not block and the opened file must be regular).
+func (t *Tools) smallRegular(path string) ([]byte, bool) {
+	root, rel, err := t.openRoot(path)
+	if err != nil {
+		return nil, false
+	}
+	defer root.Close()
+	f, err := root.OpenFile(rel, os.O_RDONLY|syscall.O_NONBLOCK, 0)
+	if err != nil {
+		return nil, false
+	}
+	defer f.Close()
+	if fi, err := f.Stat(); err != nil || !fi.Mode().IsRegular() || fi.Size() > snapshotFileBytes {
+		return nil, false
+	}
+	data, err := io.ReadAll(io.LimitReader(f, snapshotFileBytes+1))
+	if err != nil || len(data) > snapshotFileBytes {
+		return nil, false
+	}
+	return data, true
+}
diff -ruN src-base/tools/snapshot_test.go src-wmap/tools/snapshot_test.go
--- src-base/tools/snapshot_test.go	1970-01-01 03:00:00
+++ src-wmap/tools/snapshot_test.go	2026-11-02 02:21:54
@@ -0,0 +1,105 @@
+package tools
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"syscall"
+	"testing"
+)
+
+// shown is the snapshot block of a file: read_file's exact output under its real name.
+func shown(tl *Tools, name string) string {
+	return "\nread_file " + strconv.Quote(name) + ":\n" + tl.readFile(map[string]any{"path": name}).Text + "\n"
+}
+
+func TestSnapshotShowsListingAndSmallFilesAsTheToolsReturnThem(t *testing.T) {
+	_, root := newRepo(t)
+	write(t, root, "main.go", "package main\n\nfunc main() {}\n")
+	write(t, root, "docs/a.md", "alpha\nbeta\n")
+	write(t, root, "tab\tname.go", "package tab\n")
+	write(t, root, "big.txt", strings.Repeat("x", snapshotFileBytes+1))
+	write(t, root, "bin.dat", "a\x00b")
+	write(t, root, "bad.txt", "a\xffb\n")
+	write(t, root, "lines.txt", strings.Repeat("\n", snapshotFileBytes)) // 4096 bytes, numbered beyond the delivery cut
+	write(t, root, ".gitkeep", "")
+	write(t, root, "ignored/skip.go", "package skip\n")
+	write(t, root, ".gitignore", "/ignored/\n")
+	if err := os.Symlink("/etc/hosts", filepath.Join(root, "out")); err != nil {
+		t.Fatal(err)
+	}
+	if err := syscall.Mkfifo(filepath.Join(root, "pipe"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	tl := newTools(root, ReadFileTool, ListFilesTool)
+	got := tl.Snapshot() // returns: a FIFO must not block it
+	listing := tl.listFiles(map[string]any{})
+	if !strings.HasPrefix(got, SnapshotHeader+"\n\nlist_files:\n"+listing+"\n") {
+		t.Fatalf("snapshot does not open with the header and the list_files output:\n%s", got)
+	}
+	if !strings.Contains(listing, `"tab\tname.go"`) {
+		t.Fatalf("fixture: expected Git's quoted name in the listing:\n%s", listing)
+	}
+	if _, ok := tl.smallRegular("pipe"); ok { // Git may not list a FIFO; read it directly
+		t.Fatal("a FIFO must not be read")
+	}
+	for _, p := range []string{"main.go", "docs/a.md", "tab\tname.go", ".gitkeep", ".gitignore"} {
+		if !strings.Contains(got+"\n", shown(tl, p)) {
+			t.Fatalf("snapshot lacks read_file output of %q:\n%s", p, got)
+		}
+	}
+	if !strings.Contains(got, "read_file \".gitkeep\":\n\n") {
+		t.Fatalf("an empty file must show read_file's empty output:\n%s", got)
+	}
+	for _, p := range []string{"big.txt", "bin.dat", "bad.txt", "lines.txt", "out", "pipe", "ignored/skip.go"} {
+		if strings.Contains(got, "read_file "+strconv.Quote(p)) {
+			t.Fatalf("%s must not be shown:\n%s", p, got)
+		}
+	}
+	if strings.Contains(got, "ignored/skip.go") {
+		t.Fatalf("gitignored path listed:\n%s", got)
+	}
+}
+
+func TestSnapshotIsEmptyForLargeOrUnlistableWorkspaces(t *testing.T) {
+	_, many := newRepo(t)
+	for i := 0; i <= snapshotFiles; i++ {
+		write(t, many, fmt.Sprintf("f/%03d.txt", i), "x\n")
+	}
+	if got := newTools(many, ReadFileTool, ListFilesTool).Snapshot(); got != "" {
+		t.Fatalf("more than %d paths must give no snapshot, got %d bytes", snapshotFiles, len(got))
+	}
+	_, heavy := newRepo(t)
+	for i := 0; i < 9; i++ { // 9 x (4096 bytes + "1\t") of shown output > 32768
+		write(t, heavy, "f"+string(rune('a'+i))+".txt", strings.Repeat("y", snapshotFileBytes))
+	}
+	if got := newTools(heavy, ReadFileTool, ListFilesTool).Snapshot(); got != "" {
+		t.Fatalf("more than %d shown bytes must give no snapshot", snapshotBytes)
+	}
+	_, numberedHeavy := newRepo(t)
+	for i := 0; i < 5; i++ { // raw 5 x 2000 bytes fits; numbered (5 x ~11 KB, each uncut) does not
+		write(t, numberedHeavy, "n"+string(rune('a'+i))+".txt", strings.Repeat("\n", 2000))
+	}
+	if got := newTools(numberedHeavy, ReadFileTool, ListFilesTool).Snapshot(); got != "" {
+		t.Fatalf("the bound counts the numbered output, got %d bytes", len(got))
+	}
+	plain := t.TempDir()
+	write(t, plain, "a.go", "package a\n")
+	if got := newTools(plain, ReadFileTool, ListFilesTool).Snapshot(); got != "" {
+		t.Fatalf("a folder that is not a repository must give no snapshot: %q", got)
+	}
+	_, small := newRepo(t)
+	write(t, small, "a.go", "package a\n")
+	if got := newTools(small, ListFilesTool, ShellTool).Snapshot(); got != "" {
+		t.Fatalf("no snapshot without read_file: %q", got)
+	}
+	if got := newTools(small, ReadFileTool, ShellTool).Snapshot(); got != "" {
+		t.Fatalf("no snapshot without list_files: %q", got)
+	}
+	_, empty := newRepo(t)
+	if got := newTools(empty, ReadFileTool, ListFilesTool).Snapshot(); got != "" {
+		t.Fatalf("an empty repository must give no snapshot: %q", got)
+	}
+}
