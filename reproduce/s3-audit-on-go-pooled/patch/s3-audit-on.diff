+		sh.ev.Record(map[string]any{"event": "hc_s3_audit_on", "configured": false})
+	}
+	if sh.cfg.ShapeAudit.Enabled || hcS3AuditOn {
 		if err := sh.audit(ctx, st.Request); err != nil {
 			return 0, err
 		}
