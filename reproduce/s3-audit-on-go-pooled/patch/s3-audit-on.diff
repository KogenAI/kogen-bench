diff --git a/cli/shape/hc_s3_test.go b/cli/shape/hc_s3_test.go
new file mode 100644
index 0000000..9b62e4a
--- /dev/null
+++ b/cli/shape/hc_s3_test.go
@@ -0,0 +1,51 @@
+package shape
+
+import (
+	"testing"
+
+	"kogen/executor"
+)
+
+// Lane patch S3: package tests keep B0's default (shpEnv sets KOGEN_HC_S3_AUDIT=off); these
+// fixtures drop the opt-out, as a lanes cell runs.
+func hcS3On(f *shpFx) {
+	env := f.Env[:0:0]
+	for _, kv := range f.Env {
+		if kv != "KOGEN_HC_S3_AUDIT=off" {
+			env = append(env, kv)
+		}
+	}
+	f.Env = env
+}
+
+func TestHCS3AuditRunsWithoutTheConfigKey(t *testing.T) {
+	f := newShpFx(t)
+	hcS3On(f)
+	f.useExternalShape(6)
+	audit := map[string]any{"examples": []any{}, "rules": []any{}, "cells": []any{}, "defects": []any{}}
+	x := &shapeExec{t: t, rounds: []func(int, string) (executor.RoundResult, error){result(audit), result(shpFiles())}}
+	f.shapeWith(x, "Add calc.is_even(n).")
+	if len(x.starts) != 2 {
+		t.Fatalf("%d sessions, want the audit session and the shaping session", len(x.starts))
+	}
+	shpContains(t, "audit schema", string(x.starts[0].Schema), "exposing_input")
+	shpEq(t, "witness events", len(shpNamed(f.events(), "hc_s3_audit_on")), 1)
+	shpEq(t, "audit events", len(shpNamed(f.events(), "request_audit")), 1)
+	if !f.exists(".kogen/intents/is-even") {
+		t.Error("the Intent was not published")
+	}
+}
+
+func TestHCS3ConfiguredAuditHasNoWitness(t *testing.T) {
+	f := newShpFx(t)
+	hcS3On(f)
+	f.useExternalShape(6)
+	f.write(".kogen/project.yaml", f.read(".kogen/project.yaml")+"shape_audit:\n  enabled: true\n")
+	f.git("add", ".kogen/project.yaml")
+	f.git("commit", "-qm", "audit")
+	audit := map[string]any{"examples": []any{}, "rules": []any{}, "cells": []any{}, "defects": []any{}}
+	x := &shapeExec{t: t, rounds: []func(int, string) (executor.RoundResult, error){result(audit), result(shpFiles())}}
+	f.shapeWith(x, "Add calc.is_even(n).")
+	shpEq(t, "witness events", len(shpNamed(f.events(), "hc_s3_audit_on")), 0)
+	shpEq(t, "audit events", len(shpNamed(f.events(), "request_audit")), 1)
+}
