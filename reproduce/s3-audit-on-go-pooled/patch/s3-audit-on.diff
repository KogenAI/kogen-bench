 	sh.request = st.Request
-	if sh.cfg.ShapeAudit.Enabled {
+	// Lane patch S3: the request audit runs on every Shape, as if shape_audit.enabled were set.
+	// Lanes writes project.yaml without the key, so the patch cannot be a lane setting. Package
+	// tests opt out with KOGEN_HC_S3_AUDIT=off to keep B0's behaviour.
