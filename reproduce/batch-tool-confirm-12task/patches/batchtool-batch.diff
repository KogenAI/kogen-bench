diff -ruN base/tools/batch.go batch/tools/batch.go
--- base/tools/batch.go	1970-01-01 03:00:00
+++ batch/tools/batch.go	2026-10-30 13:57:12
@@ -0,0 +1,193 @@
+package tools
+
+import (
+	"context"
+	"fmt"
+	"slices"
+	"strings"
+	"sync"
+
+	"kogen-loop/sys"
+)
+
+// BatchTool runs several independent reads, searches and commands in one call. A standalone
+// session offers it whenever one of BatchOperations is enabled.
+const BatchTool = "batch"
+
+// BatchOperations are the tools a batch operation may name, when they are enabled.
+var BatchOperations = []string{ReadFileTool, ListFilesTool, SearchTextTool, ShellTool}
+
+const (
+	// MaxBatchOperations is the most operations one batch call takes.
+	MaxBatchOperations = 16
+	// batchConcurrency is the most operations of a batch that run at once.
+	batchConcurrency = 8
+	// maxJoinedResults bounds a joined result to that many results' bounds.
+	maxJoinedResults = 4
+)
+
+// BatchDefinition is the model-facing definition of batch.
+func BatchDefinition() map[string]any {
+	ops := make([]any, len(BatchOperations))
+	for i, n := range BatchOperations {
+		ops[i] = n
+	}
+	operation := map[string]any{
+		"type": "object",
+		"properties": map[string]any{
+			"tool":       map[string]any{"type": "string", "enum": ops},
+			"path":       str(),
+			"start_line": integer(),
+			"end_line":   integer(),
+			"pattern":    str(),
+			"command":    str(),
+		},
+		"required":             []any{"tool"},
+		"additionalProperties": false,
+	}
+	return fun(BatchTool,
+		fmt.Sprintf("Run up to %d independent operations in one call: read_file (path, start_line, end_line), list_files (path), search_text (pattern, path) and shell (command), with the same arguments and results as those tools. The operations run at the same time; their results come back in the order given, each labelled with its number and operation. Batch independent reads, searches and checks here instead of calling the tools one at a time. An operation that needs an earlier result, and every edit, belongs in a later call.", MaxBatchOperations),
+		map[string]any{"operations": map[string]any{
+			"type": "array", "items": operation, "minItems": 1, "maxItems": MaxBatchOperations,
+		}}, "operations")
+}
+
+// batchOp is one operation: the tool and its arguments.
+type batchOp struct {
+	tool string
+	args map[string]any
+}
+
+// batchOps parses the operations argument, or returns the error text the model gets.
+func batchOps(args map[string]any) ([]batchOp, string) {
+	list, ok := args["operations"].([]any)
+	if !ok {
+		return nil, "error: argument operations must be a list of operations"
+	}
+	if len(list) == 0 || len(list) > MaxBatchOperations {
+		return nil, fmt.Sprintf("error: batch takes 1 to %d operations, got %d", MaxBatchOperations, len(list))
+	}
+	ops := make([]batchOp, len(list))
+	for i, v := range list {
+		m, ok := v.(map[string]any)
+		if !ok {
+			return nil, fmt.Sprintf("error: operation %d must be an object", i+1)
+		}
+		name, _ := m["tool"].(string)
+		a := map[string]any{}
+		for k, x := range m {
+			if k != "tool" {
+				a[k] = x
+			}
+		}
+		ops[i] = batchOp{tool: name, args: a}
+	}
+	return ops, ""
+}
+
+// label is the heading of an operation's result: number, tool and its main argument.
+func (op batchOp) label(i int) string {
+	l := fmt.Sprintf("[%d] %s", i+1, op.tool)
+	for _, k := range []string{"command", "pattern", "path"} {
+		if v, ok := op.args[k].(string); ok {
+			v = strings.Join(strings.Fields(v), " ")
+			if len(v) > 200 {
+				v = validPrefix(v[:200]) + "..."
+			}
+			return l + " " + v
+		}
+	}
+	return l
+}
+
+// batch runs the operations concurrently (at most batchConcurrency at once) and returns
+// their results in the order given, each cut as a call of its own; the joined text is cut
+// to maxJoinedResults results' bounds. An operation's refusal
+// or failure is its result. A stopping error of one operation (an interrupt, timeout
+// observation failure) or the end of ctx starts no further operation, terminates the
+// process groups the batch started, waits for the running ones and returns the error.
+func (t *Tools) batch(ctx context.Context, args map[string]any) (Output, error) {
+	ops, msg := batchOps(args)
+	if msg != "" {
+		return Output{Text: msg}, nil
+	}
+	parent := ctx
+	if parent == nil {
+		parent = context.Background()
+	}
+	s := t.session()
+	before := map[int]bool{}
+	for _, g := range s.Groups() {
+		before[g] = true
+	}
+	terminate := func() {
+		var mine []int
+		for _, g := range s.Groups() {
+			if !before[g] {
+				mine = append(mine, g)
+			}
+		}
+		sys.Terminate(mine)
+	}
+	run, cancel := context.WithCancel(parent)
+	defer cancel()
+	stopTerminate := context.AfterFunc(parent, terminate)
+	defer stopTerminate()
+
+	outs := make([]Output, len(ops))
+	var (
+		wg      sync.WaitGroup
+		mu      sync.Mutex
+		stopErr error
+	)
+	slots := make(chan struct{}, batchConcurrency)
+	for i, op := range ops {
+		select {
+		case slots <- struct{}{}:
+		case <-run.Done():
+		}
+		if run.Err() != nil {
+			break
+		}
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			defer func() { <-slots }()
+			var out Output
+			var err error
+			if !slices.Contains(BatchOperations, op.tool) {
+				out = Output{Text: "error: a batch operation is one of " + strings.Join(BatchOperations, ", ")}
+			} else {
+				out, err = t.RunContext(run, op.tool, op.args)
+			}
+			if err != nil {
+				mu.Lock()
+				first := stopErr == nil
+				if first {
+					stopErr = err
+				}
+				mu.Unlock()
+				if first {
+					cancel()
+					terminate()
+				}
+				return
+			}
+			outs[i] = t.Cut(out)
+		}()
+	}
+	wg.Wait()
+	if stopErr != nil {
+		return Output{}, stopErr
+	}
+	if err := parent.Err(); err != nil {
+		return Output{}, err
+	}
+	parts := make([]string, len(ops))
+	for i, op := range ops {
+		parts[i] = op.label(i) + "\n" + outs[i].Text
+	}
+	bound, head := t.budgets()
+	text := cutText(strings.Join(parts, "\n\n"), min(len(ops), maxJoinedResults)*bound, head)
+	return Output{Text: text, Segments: len(ops), Ops: len(ops)}, nil
+}
