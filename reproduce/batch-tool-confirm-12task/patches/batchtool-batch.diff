@@ -0,0 +1,213 @@
+package tools
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+
+	"kogen-loop/sys"
+)
+
+func batchArgs(ops ...map[string]any) map[string]any {
+	list := make([]any, len(ops))
+	for i, op := range ops {
+		list[i] = op
+	}
+	return map[string]any{"operations": list}
+}
+
+func TestBatchKeepsTheOrderGivenAndRunsConcurrently(t *testing.T) {
+	_, root := newRepo(t)
+	write(t, root, "a.txt", "alpha\n")
+	tl := newTools(root, ReadFileTool, ShellTool, BatchTool)
+	start := time.Now()
+	out, err := tl.RunContext(context.Background(), BatchTool, batchArgs(
+		map[string]any{"tool": "shell", "command": "sleep 0.6; echo slow"},
+		map[string]any{"tool": "shell", "command": "sleep 0.6; echo second"},
+		map[string]any{"tool": "read_file", "path": "a.txt"},
+	))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if d := time.Since(start); d > 1100*time.Millisecond {
+		t.Errorf("operations ran one after another: %v", d)
+	}
+	want := "[1] shell sleep 0.6; echo slow\nexit status: 0\nslow\n\n\n[2] shell sleep 0.6; echo second\nexit status: 0\nsecond\n\n\n[3] read_file a.txt\n1\talpha"
+	if out.Text != want {
+		t.Errorf("got %q\nwant %q", out.Text, want)
+	}
+	if out.Ops != 3 || out.Segments != 3 {
+		t.Errorf("ops %d segments %d", out.Ops, out.Segments)
+	}
+}
+
+func TestBatchFailuresAreResults(t *testing.T) {
+	_, root := newRepo(t)
+	write(t, root, "a.txt", "alpha\n")
+	// list_files is not enabled; write_file is never a batch operation.
+	tl := newTools(root, ReadFileTool, ShellTool, WriteFileTool, BatchTool)
+	out, err := tl.Run(BatchTool, batchArgs(
+		map[string]any{"tool": "read_file", "path": "missing.txt"},
+		map[string]any{"tool": "shell", "command": "echo bad >&2; exit 3"},
+		map[string]any{"tool": "write_file", "path": "b.txt", "content": "x"},
+		map[string]any{"tool": "list_files"},
+		map[string]any{"tool": "read_file"},
+		map[string]any{"tool": "read_file", "path": "a.txt"},
+	))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, want := range []string{
+		"[1] read_file missing.txt\nerror: missing.txt does not exist",
+		"[2] shell echo bad >&2; exit 3\nexit status: 3\nbad",
+		"[3] write_file b.txt\nerror: a batch operation is one of read_file, list_files, search_text, shell",
+		"[4] list_files\nerror: unknown tool list_files",
+		"[5] read_file\nerror: argument path must be a string",
+		"[6] read_file a.txt\n1\talpha",
+	} {
+		if !strings.Contains(out.Text, want) {
+			t.Errorf("missing %q in\n%s", want, out.Text)
+		}
+	}
+	if _, err := os.Stat(filepath.Join(root, "b.txt")); err == nil {
+		t.Error("batch wrote a file")
+	}
+	for _, args := range []map[string]any{
+		{}, {"operations": []any{}}, {"operations": "x"}, {"operations": []any{"x"}},
+		batchArgs(make([]map[string]any, MaxBatchOperations+1)...),
+	} {
+		out, err := tl.Run(BatchTool, args)
+		if err != nil || !strings.HasPrefix(out.Text, "error: ") || out.Ops != 0 {
+			t.Errorf("%v: %q %v", args, out.Text, err)
+		}
+	}
+	if out, _ := newTools(root, ShellTool).Run(BatchTool, batchArgs(map[string]any{"tool": "shell", "command": "true"})); out.Text != "error: unknown tool batch" {
+		t.Errorf("not enabled: %q", out.Text)
+	}
+}
+
+func TestBatchCutsEachOperationAsACallOfItsOwn(t *testing.T) {
+	_, root := newRepo(t)
+	big := strings.Repeat("x", 20000)
+	write(t, root, "big.txt", big)
+	tl := newTools(root, ShellTool, BatchTool)
+	out, err := tl.Run(BatchTool, batchArgs(
+		map[string]any{"tool": "shell", "command": "cat big.txt"},
+		map[string]any{"tool": "shell", "command": "cat big.txt"},
+	))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n := strings.Count(out.Text, "bytes omitted"); n != 2 {
+		t.Errorf("%d cut markers", n)
+	}
+	if out.Cut().Text != out.Text || tl.Cut(out).Text != out.Text {
+		t.Error("the joined result was cut again")
+	}
+	if len(out.Text) > 2*(maxResult+250) {
+		t.Errorf("%d bytes", len(out.Text))
+	}
+	var many []map[string]any
+	for i := 0; i < 6; i++ {
+		many = append(many, map[string]any{"tool": "shell", "command": "cat big.txt"})
+	}
+	out, err = tl.Run(BatchTool, batchArgs(many...))
+	if err != nil || len(out.Text) > maxJoinedResults*maxResult || !strings.HasPrefix(out.Text, "[1] shell cat big.txt") || !strings.Contains(out.Text, "[6] shell cat big.txt") {
+		t.Errorf("joined bound: %d bytes, %v", len(out.Text), err)
+	}
+	if c := (Output{Text: strings.Repeat("y", 3*maxResult)}).Cut(); len(c.Text) > maxResult {
+		t.Errorf("single bound %d", len(c.Text))
+	}
+}
+
+func TestBatchCancellationStopsItsProcessGroups(t *testing.T) {
+	_, root := newRepo(t)
+	tl := newTools(root, ShellTool, BatchTool)
+	ctx, cancel := context.WithCancel(context.Background())
+	var ops []map[string]any
+	for i := 0; i < batchConcurrency+2; i++ {
+		ops = append(ops, map[string]any{"tool": "shell", "command": "echo $$ >> started; sleep 30; touch finished"})
+	}
+	done := make(chan error, 1)
+	go func() { _, err := tl.RunContext(ctx, BatchTool, batchArgs(ops...)); done <- err }()
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		data, _ := os.ReadFile(filepath.Join(root, "started"))
+		if strings.Count(string(data), "\n") == batchConcurrency {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("started: %q", data)
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	cancel()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("err %v", err)
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatal("batch did not stop")
+	}
+	groups := tl.Session.Groups()
+	if len(groups) != batchConcurrency {
+		t.Errorf("%d groups started, want %d (queued operations must not start)", len(groups), batchConcurrency)
+	}
+	for _, g := range groups {
+		if err := syscall.Kill(-g, 0); !errors.Is(err, syscall.ESRCH) {
+			t.Errorf("group %d still alive: %v", g, err)
+		}
+	}
+	if _, err := os.Stat(filepath.Join(root, "finished")); err == nil {
+		t.Error("a cancelled command finished")
+	}
+}
+
+func TestBatchStopsOnAnInterrupt(t *testing.T) {
+	_, root := newRepo(t)
+	s := sys.NewWith(hermeticEnv(), root)
+	tl := &Tools{Root: root, Session: s, Enabled: []string{ShellTool, BatchTool}}
+	done := make(chan error, 1)
+	go func() {
+		_, err := tl.Run(BatchTool, batchArgs(
+			map[string]any{"tool": "shell", "command": "touch started; sleep 30"},
+			map[string]any{"tool": "shell", "command": "sleep 30"},
+		))
+		done <- err
+	}()
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		if _, err := os.Stat(filepath.Join(root, "started")); err == nil && len(s.Groups()) == 2 {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("not started")
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	s.Interrupt("SIGINT")
+	select {
+	case err := <-done:
+		var in *sys.Interrupted
+		if !errors.As(err, &in) {
+			t.Fatalf("err %v", err)
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatal("batch did not stop")
+	}
+	for _, g := range s.Groups() {
+		// Teardown is asynchronous after an interrupt; a group of zombies answers EPERM on macOS.
+		for i := 0; i < 250 && !errors.Is(syscall.Kill(-g, 0), syscall.ESRCH); i++ {
+			time.Sleep(20 * time.Millisecond)
+		}
+		if err := syscall.Kill(-g, 0); !errors.Is(err, syscall.ESRCH) {
+			t.Errorf("group %d still alive: %v", g, err)
+		}
+	}
+}
