diff -ruN base/tools/shell_yield_test.go patched/tools/shell_yield_test.go
--- base/tools/shell_yield_test.go	1970-01-01 03:00:00
+++ patched/tools/shell_yield_test.go	2026-10-30 22:02:54
@@ -0,0 +1,117 @@
+package tools
+
+import (
+	"os"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+
+	"kogen-loop/sys"
+)
+
+func yieldTools(t *testing.T, yield time.Duration) *Tools {
+	root := t.TempDir()
+	return &Tools{Root: root, Enabled: []string{ShellTool}, Session: sys.NewWith(os.Environ(), root), ShellYield: yield}
+}
+
+func TestShellYieldFastCommandIsOrdinary(t *testing.T) {
+	tl := yieldTools(t, 2*time.Second)
+	if got := run(t, tl, ShellTool, map[string]any{"command": "echo hi; exit 3"}); got != "exit status: 3\nhi\n" {
+		t.Errorf("%q", got)
+	}
+	if len(tl.jobs) != 0 {
+		t.Errorf("ended command left a session: %v", tl.jobs)
+	}
+}
+
+func TestShellYieldReturnsWhileTheCommandRunsAndWaitsForItsEnd(t *testing.T) {
+	tl := yieldTools(t, 300*time.Millisecond)
+	start := time.Now()
+	got := run(t, tl, ShellTool, map[string]any{"command": "echo first; sleep 2; echo second"})
+	if el := time.Since(start); el > 1500*time.Millisecond {
+		t.Fatalf("first call took %v, want about the yield", el)
+	}
+	if got != "still running after 300ms as shell session 1; output so far:\nfirst\n" {
+		t.Fatalf("%q", got)
+	}
+	got = run(t, tl, ShellTool, map[string]any{"session": float64(1), "wait_seconds": float64(10)})
+	if got != "exit status: 0\nsecond\n" { // only the new output
+		t.Fatalf("%q", got)
+	}
+	if got := run(t, tl, ShellTool, map[string]any{"session": float64(1)}); !strings.HasPrefix(got, "error: no running shell session") {
+		t.Errorf("ended session still answers: %q", got)
+	}
+}
+
+func TestShellYieldStopEndsTheWholeGroup(t *testing.T) {
+	tl := yieldTools(t, 200*time.Millisecond)
+	got := run(t, tl, ShellTool, map[string]any{"command": "sleep 60 & echo child $!; wait"})
+	if !strings.Contains(got, "shell session 1") {
+		t.Fatalf("%q", got)
+	}
+	var pid int
+	for _, f := range strings.Fields(got) {
+		if n, err := parseInt(f); err == nil {
+			pid = n
+		}
+	}
+	start := time.Now()
+	got = run(t, tl, ShellTool, map[string]any{"session": float64(1), "stop": true})
+	if !strings.HasPrefix(got, "stopped session 1\nexit status: ") || time.Since(start) > 7*time.Second {
+		t.Fatalf("%q after %v", got, time.Since(start))
+	}
+	time.Sleep(100 * time.Millisecond)
+	if pid > 0 && syscall.Kill(pid, 0) == nil {
+		t.Errorf("background child %d survived stop", pid)
+	}
+}
+
+func TestShellYieldWaitIsBounded(t *testing.T) {
+	tl := yieldTools(t, 200*time.Millisecond)
+	run(t, tl, ShellTool, map[string]any{"command": "sleep 30"})
+	start := time.Now()
+	got := run(t, tl, ShellTool, map[string]any{"session": float64(1), "wait_seconds": float64(1)})
+	if el := time.Since(start); el < 900*time.Millisecond || el > 3*time.Second || got != "still running after 1s as shell session 1; output so far:\n" {
+		t.Fatalf("%q after %v", got, el)
+	}
+	run(t, tl, ShellTool, map[string]any{"session": float64(1), "stop": true})
+}
+
+func TestShellYieldDefinitionAndDefaultUnchanged(t *testing.T) {
+	plain, _ := (&Tools{}).Definition(ShellTool)
+	base, _ := Definition(ShellTool)
+	if plain["description"] != base["description"] {
+		t.Errorf("default definition changed")
+	}
+	d, _ := (&Tools{ShellYield: 30 * time.Second}).Definition(ShellTool)
+	props := d["parameters"].(map[string]any)["properties"].(map[string]any)
+	for _, k := range []string{"command", "session", "wait_seconds", "stop"} {
+		if props[k] == nil {
+			t.Errorf("missing %s", k)
+		}
+	}
+	if !strings.Contains(d["description"].(string), "within 30s") {
+		t.Errorf("%v", d["description"])
+	}
+	if u := (&Tools{ShellYield: time.Second, ShellTimeout: time.Second}); true {
+		d, _ := u.Definition(ShellTool)
+		if strings.Contains(d["description"].(string), "session") {
+			t.Errorf("a positive ShellTimeout keeps the timeout shell")
+		}
+	}
+}
+
+func parseInt(s string) (int, error) {
+	n := 0
+	if s == "" {
+		return 0, os.ErrInvalid
+	}
+	for _, c := range s {
+		if c < '0' || c > '9' {
+			return 0, os.ErrInvalid
+		}
+		n = n*10 + int(c-'0')
+	}
+	return n, nil
+}
