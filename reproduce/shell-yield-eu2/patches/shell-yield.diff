diff -ruN base/sys/job.go patched/sys/job.go
--- base/sys/job.go	1970-01-01 03:00:00
+++ patched/sys/job.go	2026-10-30 22:02:10
@@ -0,0 +1,112 @@
+package sys
+
+import (
+	"os/exec"
+	"strconv"
+	"syscall"
+	"time"
+)
+
+// Job is a command Start began and the caller waits for in bounded slices (the yielding
+// shell). Its process group is one of the session's groups, so round custody and Owned
+// treat it like any other command's group.
+type Job struct {
+	pgid    int
+	cmd     *exec.Cmd
+	buf     *capBuffer
+	waited  chan struct{}
+	release func()
+	seen    int // stream bytes already returned by New
+}
+
+// Start begins `/bin/sh -c command` in dir like Run, without waiting for it. A refused
+// command returns a nil Job and the refusal Result; a command that cannot start returns a
+// nil Job and status 127. Options.Timeout and KillGroupOnExit do not apply.
+func (s *Session) Start(command, dir string, opts Options) (*Job, Result, error) {
+	if opts.RefuseForeignKill {
+		if rule, refused := ForeignKill(command, s.Owned); refused {
+			return nil, Result{Status: 126, Output: RefusalText(rule), Rule: rule}, nil
+		}
+	}
+	s.Debug("command in " + dir + ": " + command)
+	cmd, release, err := supervised(command)
+	if err != nil {
+		return nil, Result{Status: 127, Output: err.Error()}, nil
+	}
+	cmd.Dir = dir
+	cmd.Env = append([]string{}, s.Env...)
+	for k, v := range opts.Env {
+		cmd.Env = append(cmd.Env, k+"="+v)
+	}
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
+	buf := &capBuffer{}
+	cmd.Stdout, cmd.Stderr = buf, buf
+	cmd.WaitDelay = time.Second
+
+	s.mu.Lock()
+	if s.cancelled != "" {
+		sig := s.cancelled
+		s.mu.Unlock()
+		release()
+		return nil, Result{}, &Interrupted{sig}
+	}
+	if err := cmd.Start(); err != nil {
+		s.mu.Unlock()
+		release()
+		return nil, Result{Status: 127, Output: err.Error()}, nil
+	}
+	j := &Job{pgid: cmd.Process.Pid, cmd: cmd, buf: buf, waited: make(chan struct{}), release: release}
+	s.groups[j.pgid] = true
+	s.mu.Unlock()
+	go func() { cmd.Wait(); release(); close(j.waited) }()
+	return j, Result{}, nil
+}
+
+// Wait waits up to d for the command to end and reports whether it has. An interrupt of
+// the session returns its error; the command keeps running under round custody.
+func (j *Job) Wait(s *Session, d time.Duration) (bool, error) {
+	t := time.NewTimer(d)
+	defer t.Stop()
+	select {
+	case <-j.waited:
+		return true, nil
+	case <-t.C:
+		return false, nil
+	case <-s.done:
+		return false, s.Err()
+	}
+}
+
+// Stop ends the command's process group (SIGTERM, then SIGKILL) and waits for the leader.
+func (j *Job) Stop() {
+	Terminate([]int{j.pgid})
+	<-j.waited
+}
+
+// Status is the exit status of an ended command (128+signal when killed).
+func (j *Job) Status() int { return exitStatus(j.cmd.ProcessState) }
+
+// New returns the output written since the previous New, with an omission marker when
+// part of it fell in the capped middle of the stream.
+func (j *Job) New() string {
+	text, total := j.buf.since(j.seen)
+	j.seen = total
+	return text
+}
+
+// since returns the stream from byte n on, and the stream length.
+func (b *capBuffer) since(n int) (string, int) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	total := len(b.head) + b.dropped + len(b.tail)
+	switch tailAt := len(b.head) + b.dropped; {
+	case n >= tailAt:
+		return string(b.tail[n-tailAt:]), total
+	case n < len(b.head) && b.dropped == 0:
+		return string(b.head[n:]) + string(b.tail), total
+	case n < len(b.head):
+		return string(b.head[n:]) + "\n[... " + strconv.Itoa(b.dropped) + " bytes omitted ...]\n" + string(b.tail), total
+	default:
+		return "[... " + strconv.Itoa(tailAt-n) + " bytes omitted ...]\n" + string(b.tail), total
+	}
+}
