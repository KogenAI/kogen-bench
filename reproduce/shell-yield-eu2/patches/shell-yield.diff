+
+// maxShellWait bounds the wait_seconds of a session call.
+const maxShellWait = 300 * time.Second
+
+// yieldShell is shell with ShellYield: a new command, or {session, wait_seconds, stop} for one
+// still running. Calls run one at a time (the engine is serial), so jobs needs no lock.
+func (t *Tools) yieldShell(args map[string]any) (string, string, error) {
+	if v, ok := args["session"]; ok && v != nil {
+		n, ok := v.(float64)
+		job := t.jobs[int(n)]
+		if !ok || job == nil {
+			return "error: no running shell session " + fmt.Sprint(v), "", nil
+		}
+		id := int(n)
+		if stop, _ := args["stop"].(bool); stop {
+			job.Stop()
+			delete(t.jobs, id)
+			return "stopped session " + strconv.Itoa(id) + "\nexit status: " + strconv.Itoa(job.Status()) + "\n" + job.New(), "", nil
+		}
+		wait := t.ShellYield
+		if w, ok := args["wait_seconds"].(float64); ok && w > 0 {
+			wait = min(time.Duration(w*float64(time.Second)), maxShellWait)
+		}
+		return t.await(id, job, wait)
+	}
+	command, msg := stringArg(args, "command")
+	if msg != "" {
+		return msg, "", nil
+	}
+	job, res, err := t.session().Start(command, t.Root, sys.Options{RefuseForeignKill: true})
+	if err != nil {
+		return "", "", err
+	}
+	if job == nil {
+		if res.Rule != "" {
+			return res.Output, res.Rule, nil
+		}
+		return "exit status: " + strconv.Itoa(res.Status) + "\n" + res.Output, "", nil
+	}
+	if t.jobs == nil {
+		t.jobs = map[int]*sys.Job{}
+	}
+	t.lastJob++
+	t.jobs[t.lastJob] = job
+	return t.await(t.lastJob, job, t.ShellYield)
+}
+
+// await waits up to wait for session id and reports its new output.
+func (t *Tools) await(id int, job *sys.Job, wait time.Duration) (string, string, error) {
+	done, err := job.Wait(t.session(), wait)
+	if err != nil {
+		return "", "", err
+	}
+	if done {
+		delete(t.jobs, id)
+		return "exit status: " + strconv.Itoa(job.Status()) + "\n" + job.New(), "", nil
+	}
+	return "still running after " + wait.String() + " as shell session " + strconv.Itoa(id) + "; output so far:\n" + job.New(), "", nil
 }
 
 func (t *Tools) probe(args map[string]any) (string, error) {
