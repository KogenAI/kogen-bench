new file mode 100644
index 0000000..4aa077a
--- /dev/null
+++ b/conformance/shell_completion_wait_test.go
@@ -0,0 +1,53 @@
+package conformance
+
+import (
+	"context"
+	"path/filepath"
+	"syscall"
+	"testing"
+
+	"kogen-loop/loop"
+	"kogen-loop/provider"
+)
+
+type completionRequester struct {
+	scripted
+	t     *testing.T
+	root  string
+	child owned
+	seen  bool
+}
+
+func (c *completionRequester) Request(ctx context.Context, r loop.Request) (*provider.Response, []any, error) {
+	if len(c.asked) == 1 {
+		if got := shellResult(c.t, r, "c1"); got != "exit status: 0\ndone\n" {
+			c.t.Fatalf("completed command did not return its result in the same response: %q", got)
+		}
+		c.child = own(c.t, filepath.Join(c.root, "child.pid"))
+		pid := c.child.pid
+		c.t.Cleanup(func() { syscall.Kill(pid, syscall.SIGKILL) })
+		c.seen = c.child.live(c.t)
+	}
+	return c.scripted.Request(ctx, r)
+}
+
+// A command that completes inside the bounded completion wait returns without a handle; a
+// background child it left keeps running within the round (as after any fast command) and
+// round custody stops it before loop.Run returns.
+func TestShellCompletionWaitDescendantCustody(t *testing.T) {
+	t.Parallel()
+	l := newLifecycleRun(t)
+	l.rd.Tools.CommandWait = 0 // production default, 45 s
+	command := `sleep 600 >/dev/null 2>&1 & echo $! > child.pid; sleep 2; echo done`
+	rq := &completionRequester{t: t, root: l.w.root, scripted: scripted{responses: []*provider.Response{respond("r1", shellItem("c1", command)), respond("r2", message("done"))}}}
+	res, err := loop.Run(context.Background(), l.rd, []any{userMessage("go")}, rq, loop.Hooks{})
+	if err != nil || res.Ending != loop.EndNoCall {
+		t.Fatalf("round: %+v %v", res, err)
+	}
+	if !rq.seen {
+		t.Fatal("background child was not alive after its leader completed")
+	}
+	if rq.child.live(t) {
+		t.Fatal("background child of a completed command outlived the round")
+	}
+}
