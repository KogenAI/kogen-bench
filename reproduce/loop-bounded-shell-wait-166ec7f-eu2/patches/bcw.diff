diff --git a/tools/shell_completion_wait_test.go b/tools/shell_completion_wait_test.go
new file mode 100644
index 0000000..b2c0429
--- /dev/null
+++ b/tools/shell_completion_wait_test.go
@@ -0,0 +1,153 @@
+package tools
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+
+	"kogen-loop/sys"
+)
+
+// A new command that finishes within the bounded completion wait returns its exit status
+// and complete output in the same call: no handle, nothing left registered.
+func TestShellCommandWaitReturnsCompletedResult(t *testing.T) {
+	t.Parallel()
+	if DefaultCommandWait != 45*time.Second {
+		t.Fatalf("default command wait %v", DefaultCommandWait)
+	}
+	root := t.TempDir()
+	tl := &Tools{Root: root, Session: sys.NewWith(os.Environ(), root), Enabled: []string{ShellTool}}
+	defer tl.EndShellRound()
+	start := time.Now()
+	got := run(t, tl, ShellTool, map[string]any{"command": "printf one; sleep 3; printf two >&2; exit 5"})
+	if got != "exit status: 5\nonetwo" {
+		t.Fatalf("completed result: %q", got)
+	}
+	if d := time.Since(start); d < 2500*time.Millisecond || d > 15*time.Second {
+		t.Fatalf("returned after %v", d)
+	}
+	r := tl.registry()
+	r.mu.Lock()
+	n := len(r.jobs)
+	r.mu.Unlock()
+	if n != 0 {
+		t.Fatalf("%d jobs registered after a completed command", n)
+	}
+}
+
+// A command longer than the bound yields a handle with cumulative output and keeps running;
+// the handle path delivers its later output and exit status.
+func TestShellCommandWaitYieldsAtBound(t *testing.T) {
+	t.Parallel()
+	root := t.TempDir()
+	tl := &Tools{Root: root, Session: sys.NewWith(os.Environ(), root), Enabled: []string{ShellTool}, CommandWait: 2 * time.Second}
+	defer tl.EndShellRound()
+	start := time.Now()
+	text := run(t, tl, ShellTool, map[string]any{"command": "printf one; while [ ! -f release ]; do date +%s%N > alive; sleep .05; done; printf two; exit 7"})
+	var v map[string]any
+	if err := json.Unmarshal([]byte(text), &v); err != nil {
+		t.Fatalf("%q: %v", text, err)
+	}
+	if d := time.Since(start); v["status"] != "running" || v["output"] != "one" || d < 1800*time.Millisecond || d > 8*time.Second {
+		t.Fatalf("yield after %v: %v", d, v)
+	}
+	id, _ := v["handle"].(string)
+	if id == "" {
+		t.Fatal(v)
+	}
+	before, _ := os.ReadFile(filepath.Join(root, "alive"))
+	time.Sleep(300 * time.Millisecond)
+	after, _ := os.ReadFile(filepath.Join(root, "alive"))
+	if len(before) == 0 || string(before) == string(after) {
+		t.Fatal("yielded command is not running")
+	}
+	if err := os.WriteFile(filepath.Join(root, "release"), nil, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := json.Unmarshal([]byte(run(t, tl, ShellTool, map[string]any{"handle": id})), &v); err != nil {
+		t.Fatal(err)
+	}
+	if v["status"] != "completed" || v["exit_status"] != float64(7) || v["output"] != "onetwo" {
+		t.Fatal(v)
+	}
+}
+
+// The default bound itself: a command running past 45 seconds yields a handle near the
+// bound, still running, and round end stops it.
+func TestShellCommandWaitDefaultBound(t *testing.T) {
+	t.Parallel()
+	root := t.TempDir()
+	tl := &Tools{Root: root, Session: sys.NewWith(os.Environ(), root), Enabled: []string{ShellTool}}
+	defer tl.EndShellRound()
+	start := time.Now()
+	text := run(t, tl, ShellTool, map[string]any{"command": "echo $$ > actor.pid; exec sleep 600"})
+	d := time.Since(start)
+	var v map[string]any
+	if err := json.Unmarshal([]byte(text), &v); err != nil || v["status"] != "running" || v["handle"] == "" {
+		t.Fatalf("%q: %v", text, err)
+	}
+	if d < 44*time.Second || d > 52*time.Second {
+		t.Fatalf("yielded after %v", d)
+	}
+	pid := readPID(t, root)
+	if err := syscall.Kill(pid, 0); err != nil {
+		t.Fatalf("yielded command not alive: %v", err)
+	}
+	tl.EndShellRound()
+	if err := syscall.Kill(pid, 0); !errors.Is(err, syscall.ESRCH) {
+		t.Fatalf("command survived round end: %v", err)
+	}
+}
+
+// Cancellation and the round deadline end the bounded wait at once and stop the command
+// before the call returns.
+func TestShellCommandWaitCancellationStopsCommand(t *testing.T) {
+	for _, mode := range []string{"cancel", "deadline"} {
+		t.Run(mode, func(t *testing.T) {
+			t.Parallel()
+			root := t.TempDir()
+			tl := &Tools{Root: root, Session: sys.NewWith(os.Environ(), root), Enabled: []string{ShellTool}}
+			defer tl.EndShellRound()
+			var ctx context.Context
+			var cancel context.CancelFunc
+			want := context.Canceled
+			if mode == "deadline" {
+				ctx, cancel = context.WithTimeout(context.Background(), 2*time.Second)
+				want = context.DeadlineExceeded
+			} else {
+				ctx, cancel = context.WithCancel(context.Background())
+				timer := time.AfterFunc(2*time.Second, cancel)
+				defer timer.Stop()
+			}
+			defer cancel()
+			start := time.Now()
+			_, err := tl.RunContext(ctx, ShellTool, map[string]any{"command": "echo $$ > actor.pid; exec sleep 600"})
+			if !errors.Is(err, want) || time.Since(start) > 8*time.Second {
+				t.Fatalf("cancellation: %v after %v", err, time.Since(start))
+			}
+			if err := syscall.Kill(readPID(t, root), 0); !errors.Is(err, syscall.ESRCH) {
+				t.Fatalf("command still exists: %v", err)
+			}
+		})
+	}
+}
+
+func readPID(t *testing.T, root string) int {
+	t.Helper()
+	data, err := os.ReadFile(filepath.Join(root, "actor.pid"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	pid, err := strconv.Atoi(strings.TrimSpace(string(data)))
+	if err != nil || pid <= 1 {
+		t.Fatalf("pid: %q", data)
+	}
+	return pid
+}
