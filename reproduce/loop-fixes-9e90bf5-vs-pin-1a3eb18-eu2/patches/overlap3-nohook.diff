@@ -120,6 +121,9 @@ func (t *Tools) Call(c Call) (Output, error) { return t.CallContext(nil, c) }
 
 // CallContext runs a response call like RunContext.
 func (t *Tools) CallContext(ctx context.Context, c Call) (Output, error) {
+	fields := map[string]any{"name": c.Name, "call_id": c.CallID()}
+	otrace.Event("tool_start", fields)
+	defer otrace.Event("tool_end", map[string]any{"name": c.Name, "call_id": c.CallID()})
 	return t.RunContext(ctx, c.Name, c.Args())
 }
 
