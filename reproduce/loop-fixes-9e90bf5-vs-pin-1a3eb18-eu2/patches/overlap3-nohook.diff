diff --git a/internal/otrace/otrace.go b/internal/otrace/otrace.go
new file mode 100644
index 0000000..bee2211
--- /dev/null
+++ b/internal/otrace/otrace.go
@@ -0,0 +1,36 @@
+// Package otrace writes timing lines for the tool-overlap measurement. It is off unless
+// NODE_OVERLAP3_TRACE names a file (or is 1: $TMPDIR/overlap3-trace.jsonl); it never records arguments or output.
+package otrace
+
+import (
+	"encoding/json"
+	"os"
+	"time"
+)
+
+var path = func() string {
+	v := os.Getenv("NODE_OVERLAP3_TRACE")
+	if v == "1" {
+		// The sandboxed loop can write only below its TMPDIR; the harness copies the file out.
+		return os.Getenv("TMPDIR") + "/overlap3-trace.jsonl"
+	}
+	return v
+}()
+
+// Event appends one line: kind, wall-clock nanoseconds and the given fields.
+func Event(kind string, fields map[string]any) {
+	if path == "" {
+		return
+	}
+	fields["k"], fields["t"] = kind, time.Now().UnixNano()
+	line, err := json.Marshal(fields)
+	if err != nil {
+		return
+	}
+	f, err := os.OpenFile(path, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0o644)
+	if err != nil {
+		return
+	}
+	f.Write(append(line, '\n'))
+	f.Close()
+}
diff --git a/loop/nohook.go b/loop/nohook.go
new file mode 100644
index 0000000..758f403
--- /dev/null
+++ b/loop/nohook.go
@@ -0,0 +1,42 @@
+package loop
+
+import (
+	"context"
+
+	"kogen-loop/api"
+	"kogen-loop/internal/otrace"
+	"kogen-loop/provider"
+	"kogen-loop/tools"
+)
+
+// observedRequester forwards a Session's requests to its Direct and does what the Session's
+// AfterResponse and BeforeCall hooks did, once the response has arrived: it records the usage,
+// emits the response event, and emits one tool.call event per call of the response. With
+// those hooks gone the engine is free to run tool calls while the response streams.
+type observedRequester struct {
+	s      *Session
+	usages *[]api.Usage
+}
+
+func (o observedRequester) Request(ctx context.Context, r Request) (*provider.Response, []any, error) {
+	otrace.Event("request", map[string]any{"n": o.s.requests})
+	resp, sent, err := o.s.direct.Request(ctx, r)
+	if err != nil {
+		otrace.Event("request_failed", map[string]any{"n": o.s.requests})
+		return resp, sent, err
+	}
+	otrace.Event("response", map[string]any{"n": o.s.requests})
+	u := UsageOf(resp)
+	*o.usages = append(*o.usages, u)
+	var id any
+	if resp.ID != "" {
+		id = resp.ID
+	}
+	o.s.emit(api.EventResponse, map[string]any{"n": o.s.requests, "response_id": id, "usage": u})
+	for _, call := range tools.Calls(resp.Items) {
+		o.s.emit(api.EventToolCall, map[string]any{
+			"call_id": call.CallID(), "name": call.Name, "arguments_sha256": digest(call.Arguments),
+		})
+	}
+	return resp, sent, nil
+}
