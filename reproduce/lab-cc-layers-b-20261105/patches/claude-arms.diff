+def kexec_command(a, claude_bin, settings_path, session_id, lean, system=None):
+    """roundArgs(n=1) + roleRoundArgs("build") of kogen-executor; lean swaps the system prompt and limits the tools."""
+    cmd = [claude_bin, "-p", "--session-id", session_id]
+    if a.model:
+        cmd += ["--model", a.model]
+    if a.effort:
+        cmd += ["--effort", a.effort]
+    cmd += ["--output-format", "stream-json", "--verbose", "--include-hook-events",
+            "--permission-mode", "acceptEdits", "--permission-prompts", "none", "--allowedTools", "Bash",
+            "--settings", settings_path, "--setting-sources", "",
+            "--strict-mcp-config", "--mcp-config", '{"mcpServers":{}}', "--no-chrome", "--max-turns", "150"]
+    if lean:
+        return cmd + ["--system-prompt", system or KEXEC_CONSTRAINTS, "--tools", LEAN_TOOLS, "--json-schema", BUILD_SCHEMA]
+    return cmd + ["--append-system-prompt", KEXEC_CONSTRAINTS, "--disallowedTools", "ScheduleWakeup", "--json-schema", BUILD_SCHEMA]
 
 
+def kogen_hook_settings(hook_bin, policy_path):
+    """kogen-executor hookSettings: blocking PreToolUse guard on file-writing tools, PostToolUse Bash observation."""
+    def hook(sub, block):
+        h = {"type": "command", "command": hook_bin, "args": ["__kogen_executor_hook", sub, "--policy", policy_path], "timeout": 10}
+        if block:
+            h["onFailure"] = "block"
+        return h
+    return {"hooks": {"PreToolUse": [{"matcher": "Write|Edit|MultiEdit|NotebookEdit", "hooks": [hook("pretool", True)]}],
+                      "PostToolUse": [{"matcher": "Bash", "hooks": [hook("posttool", False)]}]}}
+
+
+def read_api_key(home):
+    """The Anthropic API key stored in `<home>/.kogen/credentials/anthropic.json`; used in memory only, handed on a pipe fd."""
+    path = os.path.join(home, ".kogen", "credentials", "anthropic.json")
+    try:
+        with open(path, encoding="utf-8") as f:
+            key = json.load(f).get("api_key")
+    except (OSError, ValueError):
+        key = None
+    if not key:
+        raise BareError(f"no stored Anthropic API key in {path}")
+    return key
+
+
+def write_private(path, data):
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+    with os.fdopen(fd, "w") as f:
+        f.write(data)
+
