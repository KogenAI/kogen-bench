+func TestSessionOffersApplyPatchWithWriteFile(t *testing.T) {
+	names := func(enabled []string) []string {
+		s, err := NewSession(SessionConfig{Root: t.TempDir(), Role: provider.Role{Provider: "openai-compatible", Model: "local", BaseURL: "http://localhost:1"}, Enabled: enabled})
+		if err != nil {
+			t.Fatal(err)
+		}
+		var out []string
+		for _, d := range s.Definitions() {
+			out = append(out, d.(map[string]any)["name"].(string))
+		}
+		return out
+	}
+	if got := strings.Join(names([]string{"read_file", "write_file", "list_files", "search_text", "shell"}), ","); got != "read_file,write_file,list_files,search_text,shell,apply_patch,finish" {
