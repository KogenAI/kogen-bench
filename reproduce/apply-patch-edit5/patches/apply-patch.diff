--- kogen-loop.base/tools/apply_patch_test.go	1970-01-01 03:00:00
+++ kogen-loop/tools/apply_patch_test.go	2026-10-31 03:00:15
@@ -0,0 +1,174 @@
+package tools
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func patchTools(t *testing.T) (*Tools, string) {
+	t.Helper()
+	root, err := filepath.EvalSymlinks(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &Tools{Root: root, Enabled: []string{ApplyPatchTool, WriteFileTool}}, root
+}
+
+func runPatch(t *testing.T, tl *Tools, patch string) string {
+	t.Helper()
+	out, err := tl.Run(ApplyPatchTool, map[string]any{"input": patch})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return out.Text
+}
+
+func readBack(t *testing.T, root, path string) string {
+	t.Helper()
+	b, err := os.ReadFile(filepath.Join(root, path))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(b)
+}
+
+func TestApplyPatchAddUpdateDeleteMove(t *testing.T) {
+	tl, root := patchTools(t)
+	write(t, root, "core.go", "package core\n\nfunc A() int {\n\treturn 1\n}\n\nfunc B() int {\n\treturn 2\n}\n")
+	write(t, root, "old.txt", "bye\n")
+	write(t, root, "src/app.py", "def greet():\n    print(\"Hi\")\n")
+	out := runPatch(t, tl, "*** Begin Patch\n*** Add File: pkg/new.go\n+package pkg\n+\n+const X = 1\n*** Update File: core.go\n@@ func B() int {\n-\treturn 2\n+\treturn 3\n*** Delete File: old.txt\n*** Update File: src/app.py\n*** Move to: src/main.py\n@@ def greet():\n-    print(\"Hi\")\n+    print(\"Hello, world!\")\n*** End Patch")
+	want := "Success. Updated the following files:\nA pkg/new.go\nM core.go\nD old.txt\nM src/main.py"
+	if out != want {
+		t.Fatalf("result %q", out)
+	}
+	if got := readBack(t, root, "pkg/new.go"); got != "package pkg\n\nconst X = 1\n" {
+		t.Errorf("added %q", got)
+	}
+	if got := readBack(t, root, "core.go"); got != "package core\n\nfunc A() int {\n\treturn 1\n}\n\nfunc B() int {\n\treturn 3\n}\n" {
+		t.Errorf("updated %q", got)
+	}
+	if _, err := os.Stat(filepath.Join(root, "old.txt")); !os.IsNotExist(err) {
+		t.Errorf("old.txt still there: %v", err)
+	}
+	if _, err := os.Stat(filepath.Join(root, "src/app.py")); !os.IsNotExist(err) {
+		t.Errorf("moved source still there: %v", err)
+	}
+	if got := readBack(t, root, "src/main.py"); got != "def greet():\n    print(\"Hello, world!\")\n" {
+		t.Errorf("moved %q", got)
+	}
+}
+
+func TestApplyPatchContextLinesAndSeveralChunks(t *testing.T) {
+	tl, root := patchTools(t)
+	write(t, root, "a.txt", "one\ntwo\nthree\nfour\nfive\nsix\nseven\n")
+	out := runPatch(t, tl, "*** Begin Patch\n*** Update File: a.txt\n@@\n one\n-two\n+TWO\n three\n@@\n five\n-six\n+SIX\n+six and a half\n seven\n*** End Patch\n")
+	if !strings.HasPrefix(out, "Success.") {
+		t.Fatalf("result %q", out)
+	}
+	if got := readBack(t, root, "a.txt"); got != "one\nTWO\nthree\nfour\nfive\nSIX\nsix and a half\nseven\n" {
+		t.Errorf("%q", got)
+	}
+}
+
+func TestApplyPatchFirstChunkWithoutMarkerAndFuzzyWhitespace(t *testing.T) {
+	tl, root := patchTools(t)
+	write(t, root, "b.go", "x := 1   \ny := 2\n")
+	// the first chunk may omit @@; the context line differs only by trailing spaces
+	out := runPatch(t, tl, "*** Begin Patch\n*** Update File: b.go\n x := 1\n-y := 2\n+y := 3\n*** End Patch")
+	if !strings.HasPrefix(out, "Success.") {
+		t.Fatalf("result %q", out)
+	}
+	if got := readBack(t, root, "b.go"); got != "x := 1   \ny := 3\n" {
+		t.Errorf("%q", got)
+	}
+}
+
+func TestApplyPatchEndOfFileAndHeredoc(t *testing.T) {
+	tl, root := patchTools(t)
+	write(t, root, "c.txt", "a\nb\na\nb\n")
+	out := runPatch(t, tl, "<<'EOF'\n*** Begin Patch\n*** Update File: c.txt\n@@\n a\n-b\n+B\n*** End of File\n*** End Patch\nEOF\n")
+	if !strings.HasPrefix(out, "Success.") {
+		t.Fatalf("result %q", out)
+	}
+	if got := readBack(t, root, "c.txt"); got != "a\nb\na\nB\n" {
+		t.Errorf("end-of-file chunk applied at %q", got)
+	}
+}
+
+func TestApplyPatchErrorsChangeNothing(t *testing.T) {
+	tl, root := patchTools(t)
+	write(t, root, "d.txt", "keep\n")
+	cases := map[string]string{
+		"no begin":       "*** Update File: d.txt\n-keep\n+x\n*** End Patch",
+		"no end":         "*** Begin Patch\n*** Update File: d.txt\n-keep\n+x",
+		"bad header":     "*** Begin Patch\n*** Change File: d.txt\n*** End Patch",
+		"empty update":   "*** Begin Patch\n*** Update File: d.txt\n*** End Patch",
+		"missing lines":  "*** Begin Patch\n*** Add File: e.txt\n+new\n*** Update File: d.txt\n@@\n-absent\n+x\n*** End Patch",
+		"missing file":   "*** Begin Patch\n*** Add File: e.txt\n+new\n*** Update File: nope.txt\n@@\n-a\n+b\n*** End Patch",
+		"missing delete": "*** Begin Patch\n*** Add File: e.txt\n+new\n*** Delete File: nope.txt\n*** End Patch",
+	}
+	for name, patch := range cases {
+		out := runPatch(t, tl, patch)
+		if !strings.HasPrefix(out, "error: ") {
+			t.Errorf("%s: %q", name, out)
+		}
+		if got := readBack(t, root, "d.txt"); got != "keep\n" {
+			t.Errorf("%s: d.txt became %q", name, got)
+		}
+		if _, err := os.Stat(filepath.Join(root, "e.txt")); !os.IsNotExist(err) {
+			t.Errorf("%s: e.txt was written before the patch was validated", name)
+		}
+	}
+	if out := runPatch(t, tl, "*** Begin Patch\n*** Update File: d.txt\n@@\n-absent\n+x\n*** End Patch"); !strings.Contains(out, "Failed to find expected lines in d.txt") {
+		t.Errorf("diagnostic %q", out)
+	}
+	if out, _ := tl.Run(ApplyPatchTool, map[string]any{"patch": "x"}); out.Text != "error: argument input must be a string" {
+		t.Errorf("argument error %q", out.Text)
+	}
+}
+
+func TestApplyPatchRefusesProtectedPaths(t *testing.T) {
+	tl, root := patchTools(t)
+	tl.Protected = []string{"features/a.feature"}
+	write(t, root, "features/a.feature", "Feature: a\n")
+	write(t, root, "f.txt", "f\n")
+	for _, patch := range []string{
+		"*** Begin Patch\n*** Update File: features/a.feature\n@@\n-Feature: a\n+Feature: b\n*** End Patch",
+		"*** Begin Patch\n*** Update File: f.txt\n*** Move to: features/a.feature\n@@\n-f\n+g\n*** End Patch",
+		"*** Begin Patch\n*** Delete File: features/a.feature\n*** End Patch",
+	} {
+		if out := runPatch(t, tl, patch); out != "refused: features/a.feature is part of the approved acceptance baseline" {
+			t.Errorf("%q", out)
+		}
+	}
+	if got := readBack(t, root, "features/a.feature"); got != "Feature: a\n" {
+		t.Errorf("protected file changed: %q", got)
+	}
+}
+
+func TestApplyPatchNotEnabledIsUnknown(t *testing.T) {
+	tl, _ := patchTools(t)
+	tl.Enabled = []string{WriteFileTool}
+	if out, _ := tl.Run(ApplyPatchTool, map[string]any{"input": "*** Begin Patch\n*** End Patch"}); out.Text != "error: unknown tool apply_patch" {
+		t.Errorf("%q", out.Text)
+	}
+}
+
+func TestApplyPatchDefinition(t *testing.T) {
+	d, ok := Definition(ApplyPatchTool)
+	if !ok || d["name"] != "apply_patch" || !strings.Contains(d["description"].(string), "*** Update File: <path>") {
+		t.Fatalf("%v", d)
+	}
+	params := d["parameters"].(map[string]any)
+	if _, ok := params["properties"].(map[string]any)["input"]; !ok || len(params["required"].([]any)) != 1 {
+		t.Errorf("%v", params)
+	}
+	// write_file's own definition is unchanged
+	w, _ := Definition(WriteFileTool)
+	if w["description"] != "Write the whole content of a file of the repository (created with its folders if needed)." {
+		t.Errorf("write_file description changed: %v", w["description"])
+	}
+}
