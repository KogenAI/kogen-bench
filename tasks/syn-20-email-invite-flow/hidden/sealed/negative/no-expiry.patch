+  ## Invitations
+
+  @invite_ttl_seconds 7 * 24 * 60 * 60
+
+  @doc """
+  Invites `email` to `org` with `role` ("agent" or "viewer"). Only owners may invite.
+  Sends the invitation email; returns `{:ok, invitation}`.
+  """
+  def invite_member(%Organization{} = org, %User{} = inviter, email, role) do
+    if owner?(org, inviter) do
+      token = new_invite_token()
+
+      changeset =
+        %Invitation{
+          organization_id: org.id,
+          inviter_id: inviter.id,
+          token_hash: hash_token(token),
+          sent_at: DateTime.truncate(Trackline.Clock.now(), :second)
+        }
+        |> Invitation.create_changeset(%{email: email, role: role})
+
+      with {:ok, invitation} <- Repo.insert(changeset),
+           {:ok, _email} <- deliver_invite(invitation, org, token) do
+        {:ok, invitation}
+      end
+    else
+      {:error, :forbidden}
+    end
+  end
+
+  @doc "Sends the invitation again with a fresh link; the previous link stops working."
+  def resend_invite(%Invitation{} = invitation, %User{} = actor) do
+    invitation = Repo.get!(Invitation, invitation.id) |> Repo.preload(:organization)
+
+    cond do
+      not owner?(invitation.organization, actor) ->
+        {:error, :forbidden}
+
+      invitation.accepted_at != nil ->
+        {:error, :already_accepted}
+
+      true ->
+        token = new_invite_token()
+
+        {:ok, invitation} =
+          invitation
+          |> Ecto.Changeset.change(
+            token_hash: hash_token(token),
+            sent_at: DateTime.truncate(Trackline.Clock.now(), :second)
+          )
+          |> Repo.update()
+
+        with {:ok, _email} <- deliver_invite(invitation, invitation.organization, token) do
+          {:ok, invitation}
+        end
+    end
+  end
+
+  @doc """
+  Accepts the invitation behind `token` for `user`. The invitation must be
+  current, unexpired, unused, and addressed to `user`'s email.
+  """
+  def accept_invite(token, %User{} = user) when is_binary(token) do
+    Repo.transact(fn ->
+      with %Invitation{} = invitation <- Repo.get_by(Invitation, token_hash: hash_token(token)),
+           :ok <- check_unused(invitation),
+           :ok <- check_fresh(invitation),
+           :ok <- check_addressee(invitation, user),
+           {1, _} <- mark_accepted(invitation),
+           {:ok, membership} <-
+             Repo.insert(
+               Membership.changeset(%Membership{}, %{
+                 organization_id: invitation.organization_id,
+                 user_id: user.id,
+                 role: invitation.role
+               })
+             ) do
+        {:ok, membership}
+      else
+        nil -> {:error, :invalid}
+        {0, _} -> {:error, :already_accepted}
+        {:error, reason} -> {:error, reason}
+      end
+    end)
+  end
+
+  def accept_invite(_token, _user), do: {:error, :invalid}
+
+  defp check_unused(%{accepted_at: nil}), do: :ok
+  defp check_unused(_), do: {:error, :already_accepted}
+
+  defp check_fresh(%{sent_at: sent_at}) do
+    _ = {sent_at, @invite_ttl_seconds}
+    :ok
+  end
+
+  defp check_addressee(invitation, user) do
+    if String.downcase(String.trim(user.email)) == invitation.email,
+      do: :ok,
+      else: {:error, :email_mismatch}
+  end
+
+  defp mark_accepted(invitation) do
+    now = DateTime.truncate(Trackline.Clock.now(), :second)
+
+    Repo.update_all(
+      from(i in Invitation, where: i.id == ^invitation.id and is_nil(i.accepted_at)),
+      set: [accepted_at: now]
+    )
+  end
+
+  defp owner?(%Organization{} = org, %User{} = user) do
+    case get_membership(org, user) do
+      %Membership{role: "owner"} -> true
+      _ -> false
+    end
+  end
+
+  defp new_invite_token, do: :crypto.strong_rand_bytes(32) |> Base.url_encode64(padding: false)
+  defp hash_token(token), do: :crypto.hash(:sha256, token)
+
+  defp deliver_invite(invitation, org, token) do
+    InviteNotifier.deliver_invite(invitation, org, TracklineWeb.Endpoint.url() <> "/invites/" <> token)
+  end
+
   ## Tickets
 
   @doc """
diff --git a/lib/trackline/support/invitation.ex b/lib/trackline/support/invitation.ex
new file mode 100644
index 0000000..262e284
--- /dev/null
+++ b/lib/trackline/support/invitation.ex
@@ -0,0 +1,29 @@
+defmodule Trackline.Support.Invitation do
+  use Ecto.Schema
+  import Ecto.Changeset
+
+  @roles ~w(agent viewer)
+
+  schema "invitations" do
+    field :email, :string
+    field :role, :string
+    field :token_hash, :binary
+    field :sent_at, :utc_datetime
+    field :accepted_at, :utc_datetime
+
+    belongs_to :organization, Trackline.Support.Organization
+    belongs_to :inviter, Trackline.Accounts.User
+
+    timestamps(type: :utc_datetime)
+  end
+
+  def create_changeset(invitation, attrs) do
+    invitation
+    |> cast(attrs, [:email, :role])
+    |> update_change(:email, &(&1 |> String.trim() |> String.downcase()))
+    |> validate_required([:email, :role])
+    |> validate_format(:email, ~r/^[^\s@]+@[^\s@]+\.[^\s@]+$/)
+    |> validate_length(:email, max: 254)
+    |> validate_inclusion(:role, @roles)
+  end
+end
diff --git a/lib/trackline/support/invite_notifier.ex b/lib/trackline/support/invite_notifier.ex
new file mode 100644
index 0000000..ae79233
--- /dev/null
+++ b/lib/trackline/support/invite_notifier.ex
@@ -0,0 +1,24 @@
+defmodule Trackline.Support.InviteNotifier do
+  import Swoosh.Email
+
+  alias Trackline.Mailer
+
+  def deliver_invite(invitation, organization, url) do
+    email =
+      new()
+      |> to(invitation.email)
+      |> from({"Trackline", "contact@example.com"})
+      |> subject("You are invited to #{organization.name} on Trackline")
+      |> text_body("""
+      You have been invited to join #{organization.name} as #{invitation.role}.
+
+      Accept the invitation (the link works once and expires in 7 days):
+
+      #{url}
+
+      If you were not expecting this, ignore this email.
+      """)
+
+    with {:ok, _metadata} <- Mailer.deliver(email), do: {:ok, email}
+  end
+end
diff --git a/lib/trackline_web/controllers/invite_controller.ex b/lib/trackline_web/controllers/invite_controller.ex
