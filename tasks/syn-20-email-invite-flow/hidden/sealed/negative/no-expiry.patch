@@ -0,0 +1,23 @@
+defmodule TracklineWeb.InviteController do
+  use TracklineWeb, :controller
+
+  alias Trackline.Support
+
+  def accept(conn, %{"token" => token}) do
+    user = conn.assigns.current_scope.user
+
+    case Support.accept_invite(token, user) do
+      {:ok, membership} ->
+        org = Trackline.Repo.get!(Trackline.Support.Organization, membership.organization_id)
+
+        conn
+        |> put_flash(:info, "Welcome to #{org.name}!")
+        |> redirect(to: ~p"/orgs/#{org.slug}/tickets")
+
+      {:error, _reason} ->
+        conn
+        |> put_flash(:error, "This invitation link is not valid any more.")
+        |> redirect(to: ~p"/orgs")
+    end
+  end
+end
