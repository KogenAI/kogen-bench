diff --git a/lib/trackline/ports/cleanup_schedule.ex b/lib/trackline/ports/cleanup_schedule.ex
index 7a31b93..338dc47 100644
--- a/lib/trackline/ports/cleanup_schedule.ex
+++ b/lib/trackline/ports/cleanup_schedule.ex
@@ -1,3 +1,8 @@
 defmodule Trackline.Ports.CleanupSchedule do
-  def oban_options, do: Application.fetch_env!(:trackline, Oban)
+  def oban_options do
+    config = Application.fetch_env!(:trackline, Oban)
+    plugins = Keyword.get(config, :plugins, [])
+    cron = {Oban.Plugins.Cron, crontab: [{"0 * * * *", Trackline.Ports.IncinerateDue}]}
+    Keyword.put(config, :plugins, [cron | plugins])
+  end
 end
diff --git a/lib/trackline/ports/incinerate_due.ex b/lib/trackline/ports/incinerate_due.ex
index c64466d..fec70b0 100644
--- a/lib/trackline/ports/incinerate_due.ex
+++ b/lib/trackline/ports/incinerate_due.ex
@@ -1,5 +1,26 @@
 defmodule Trackline.Ports.IncinerateDue do
   use Oban.Worker, queue: :default
+  import Ecto.Query
+  alias Trackline.Repo
+  alias Trackline.Support.Organization
+  alias Trackline.Ports.{CleanupBoard, CleanupAsset, CleanupInvitation, CleanupEvent, CleanupSearch}
   @impl Oban.Worker
-  def perform(_job), do: :ok
+  def perform(%Oban.Job{args: args}) do
+    now = case args["now"] do
+      nil -> DateTime.utc_now()
+      text -> elem(DateTime.from_iso8601(text), 1)
+    end
+    cutoff = DateTime.add(now, -30 * 86400, :second)
+    Repo.transact(fn ->
+      ids = Repo.all(from o in Organization, where: not o.active and o.cancelled_at < ^cutoff, select: o.id)
+      for module <- [CleanupAsset, CleanupInvitation, CleanupEvent, CleanupSearch, CleanupBoard] do
+        Repo.delete_all(from row in module, where: row.organization_id in ^ids)
+      end
+      # Oban args are JSON; organization jobs keep this public identifier.
+      Repo.delete_all(from j in Oban.Job, where: fragment("json_extract(?, '$.organization_id')", j.args) in ^ids)
+      Repo.delete_all(from o in Organization, where: o.id in ^ids)
+      {:ok, :ok}
+    end)
+    :ok
+  end
 end
