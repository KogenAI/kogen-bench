diff --git a/app/controllers/boards/default_assignees_controller.rb b/app/controllers/boards/default_assignees_controller.rb
new file mode 100644
index 0000000..ce505df
--- /dev/null
+++ b/app/controllers/boards/default_assignees_controller.rb
@@ -0,0 +1,31 @@
+class Boards::DefaultAssigneesController < ApplicationController
+  before_action :set_board
+
+  def show
+    render_default_assignee
+  end
+
+  def update
+    return head :forbidden unless Current.user.can_administer_board?(@board)
+
+    assignee_id = params[:default_assignee_id]
+    assignee = assignee_id.present? ? @board.users.active.find_by(id: assignee_id) : nil
+
+    if assignee_id.present? && assignee.nil?
+      render json: { error: "default_assignee_must_be_active_board_user" }, status: :unprocessable_entity
+    elsif @board.update(default_assignee: assignee)
+      render_default_assignee
+    else
+      render json: { error: "default_assignee_must_be_active_board_user" }, status: :unprocessable_entity
+    end
+  end
+
+  private
+    def set_board
+      @board = Current.user.boards.find(params[:board_id])
+    end
+
+    def render_default_assignee
+      render json: { board_id: @board.id, default_assignee_id: @board.default_assignee_id }, status: :ok
+    end
+end
