--- a/src/core.zig
+++ b/src/core.zig
@@ -1,4 +1,5 @@
 const std = @import("std");
+const shared = @import("shared.zig");
 
 pub const Failure = struct {
     code: u8,
@@ -10,10 +11,222 @@
     failure: Failure,
 };
 
-pub fn execute(
-    _: std.Io,
-    _: std.mem.Allocator,
-    _: []const []const u8,
-) error{OutOfMemory}!Outcome {
