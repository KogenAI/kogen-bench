diff --git a/app/models/board/card_exportable.rb b/app/models/board/card_exportable.rb
new file mode 100644
index 0000000..1cb4412
--- /dev/null
+++ b/app/models/board/card_exportable.rb
@@ -0,0 +1,43 @@
+require "csv"
+
+module Board::CardExportable
+  extend ActiveSupport::Concern
+
+  def cards_csv
+    CSV.generate do |csv|
+      csv << [ "Number", "Title", "Status", "Assignees", "Tags", "Created At" ]
+
+      cards.published.includes(:column, :closure, :not_now, :assignees, :tags).order(number: :asc).each do |card|
+        csv << [
+          card.number,
+          card.title,
+          export_status(card),
+          export_assignees(card),
+          export_tags(card),
+          card.created_at.utc.iso8601
+        ]
+      end
+    end
+  end
+
+  private
+    def export_status(card)
+      if card.closed?
+        "Done"
+      elsif card.postponed?
+        "Not now"
+      elsif card.column.present?
+        card.column.name
+      else
+        "Maybe?"
+      end
+    end
+
+    def export_assignees(card)
+      card.assignees.sort_by { |user| [ user.name.downcase, user.name ] }.map(&:name).join("; ")
+    end
+
+    def export_tags(card)
+      card.tags.sort_by { |tag| [ tag.title.downcase, tag.title ] }.map(&:title).join("; ")
+    end
+end
