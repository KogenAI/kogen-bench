diff --git a/app/controllers/boards/card_exports_controller.rb b/app/controllers/boards/card_exports_controller.rb
new file mode 100644
index 0000000..a8d3a56
--- /dev/null
+++ b/app/controllers/boards/card_exports_controller.rb
@@ -0,0 +1,42 @@
+require "csv"
+
+class Boards::CardExportsController < ApplicationController
+  def show
+    board = Current.user.boards.find(params[:board_id])
+
+    send_data csv_for(board),
+      type: "text/csv; charset=utf-8",
+      disposition: "attachment",
+      filename: "board-cards.csv"
+  end
+
+  private
+    def csv_for(board)
+      CSV.generate do |csv|
+        csv << [ "Number", "Title", "Status", "Assignees", "Tags", "Created At" ]
+
+        board.cards.published.includes(:column, :closure, :not_now, :assignees, :tags).order(number: :asc).each do |card|
+          csv << [
+            card.number,
+            card.title,
+            status_for(card),
+            card.assignees.sort_by { |user| [ user.name.downcase, user.name ] }.map(&:name).join("; "),
+            card.tags.sort_by { |tag| [ tag.title.downcase, tag.title ] }.map(&:title).join("; "),
+            card.created_at.utc.iso8601
+          ]
+        end
+      end
+    end
+
+    def status_for(card)
+      if card.closed?
+        "Done"
+      elsif card.postponed?
+        "Not now"
+      elsif card.column.present?
+        card.column.name
+      else
+        "Maybe?"
+      end
+    end
+end
