+  @impl true
+  def handle_info({:transfer_batch, batch}, socket) do
+    if MapSet.member?(socket.assigns.batch_ids, batch.batch_id) do
+      {:noreply, socket}
+    else
+      updates = Map.new(batch.tickets, &{&1.id, &1})
+      tickets = Enum.map(socket.assigns.tickets, fn t ->
+        case updates[t.id] do
+          %{version: v} = u when v > t.version ->
+            %{t | version: v, assignee_id: u.assignee_id, assignee: if(u.assignee_id, do: Trackline.Repo.get(Trackline.Accounts.User, u.assignee_id))}
+          _ -> t
+        end
+      end)
+      {:noreply, socket |> assign(:tickets, tickets) |> assign(:batch_ids, MapSet.put(socket.assigns.batch_ids, batch.batch_id))}
+    end
+  end
