+module Card::Duplicable
+  extend ActiveSupport::Concern
+
+  def duplicate_by(user)
+    copy = self.class.create!(
+      board: board,
+      creator: user,
+      status: "published",
+      title: title,
+      description: description.to_plain_text
+    )
+    comments.each do |comment|
+      copy.comments.create!(creator: user, body: comment.body.to_plain_text)
+    end
+    copy
+  end
+end
