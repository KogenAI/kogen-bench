+class Cards::DuplicatesController < ApplicationController
+  include CardScoped
+
+  def create
+    copy = @card.duplicate_by(Current.user)
+
+    render json: {
+      id: copy.number,
+      title: copy.title,
+      description: copy.description.to_plain_text
+    }, status: :created
+  end
+end
