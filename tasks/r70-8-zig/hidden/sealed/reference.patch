+fn sleepMs(ms: u64) void {
+    const deadline = monotonicMs() + ms;
+    while (monotonicMs() < deadline) {
+        const remaining = deadline - monotonicMs();
+        var request = c.struct_timespec{
+            .tv_sec = @intCast(remaining / 1000),
+            .tv_nsec = @intCast((remaining % 1000) * 1_000_000),
+        };
+        _ = c.nanosleep(&request, null);
+    }
