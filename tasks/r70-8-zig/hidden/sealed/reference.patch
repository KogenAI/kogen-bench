+
+const Parser = struct {
+    buffer: std.array_list.Managed(u8),
+    event_name: std.array_list.Managed(u8),
+    data: ?[]const u8 = null,
+    calls: std.array_list.Managed(Call),
+    text: std.array_list.Managed(u8),
+    saw_text: bool = false,
+    completed: bool = false,
+    invalid: bool = false,
+    usage: Usage = .{},
+
+    fn init() Parser {
+        return .{
+            .buffer = std.array_list.Managed(u8).init(gpa),
+            .event_name = std.array_list.Managed(u8).init(gpa),
+            .calls = std.array_list.Managed(Call).init(gpa),
+            .text = std.array_list.Managed(u8).init(gpa),
+        };
+    }
+
+    fn feed(self: *Parser, chunk: []const u8) bool {
+        self.buffer.appendSlice(chunk) catch {
+            self.invalid = true;
+            return true;
+        };
+        var consumed: usize = 0;
+        while (std.mem.indexOfScalarPos(u8, self.buffer.items, consumed, '\n')) |newline| {
+            var line = self.buffer.items[consumed..newline];
+            consumed = newline + 1;
+            if (line.len > 0 and line[line.len - 1] == '\r') line = line[0 .. line.len - 1];
+            if (!validUtf8(line)) {
+                self.invalid = true;
+                break;
+            }
+            if (line.len == 0) {
+                if (self.event_name.items.len != 0 or self.data != null) self.dispatch();
+                self.event_name.clearRetainingCapacity();
+                self.data = null;
+                if (self.completed or self.invalid) break;
+            } else if (line[0] == ':') {
+                continue;
+            } else if (std.mem.startsWith(u8, line, "event: ")) {
+                if (self.event_name.items.len != 0) {
+                    self.invalid = true;
+                    break;
+                }
+                self.event_name.appendSlice(line[7..]) catch {
+                    self.invalid = true;
+                    break;
+                };
+            } else if (std.mem.startsWith(u8, line, "data: ")) {
+                if (self.data != null) {
+                    self.invalid = true;
+                    break;
+                }
+                self.data = gpa.dupe(u8, line[6..]) catch {
+                    self.invalid = true;
+                    break;
+                };
+            } else {
+                self.invalid = true;
+                break;
+            }
+        }
+        if (consumed != 0) {
+            const remaining = self.buffer.items.len - consumed;
+            std.mem.copyForwards(u8, self.buffer.items[0..remaining], self.buffer.items[consumed..]);
+            self.buffer.shrinkRetainingCapacity(remaining);
+        }
+        return self.completed or self.invalid;
+    }
+
+    fn dispatch(self: *Parser) void {
+        if (self.event_name.items.len == 0 or self.data == null or self.completed) {
+            self.invalid = true;
+            return;
+        }
+        const value = parseJson(self.data.?) orelse {
+            self.invalid = true;
+            return;
+        };
+        const event = self.event_name.items;
+        if (std.mem.eql(u8, event, "response.function_call_arguments.delta")) {
+            const call_id = getString(value, "call_id") orelse {
+                self.invalid = true;
+                return;
+            };
+            const name = getString(value, "name") orelse {
+                self.invalid = true;
+                return;
+            };
+            const delta = getString(value, "delta") orelse {
+                self.invalid = true;
+                return;
+            };
+            if (call_id.len == 0 or (!std.mem.eql(u8, name, "read_file") and !std.mem.eql(u8, name, "run_command"))) {
+                self.invalid = true;
+                return;
+            }
+            for (self.calls.items) |*call| {
+                if (std.mem.eql(u8, call.id, call_id)) {
+                    if (!std.mem.eql(u8, call.name, name)) {
+                        self.invalid = true;
+                        return;
+                    }
+                    call.arguments.appendSlice(delta) catch {
+                        self.invalid = true;
+                    };
+                    return;
+                }
+            }
+            var arguments = std.array_list.Managed(u8).init(gpa);
+            arguments.appendSlice(delta) catch {
+                self.invalid = true;
+                return;
+            };
+            self.calls.append(.{ .id = call_id, .name = name, .arguments = arguments }) catch {
+                self.invalid = true;
+            };
+        } else if (std.mem.eql(u8, event, "response.output_text.delta")) {
+            const delta = getString(value, "delta") orelse {
+                self.invalid = true;
+                return;
+            };
+            self.saw_text = true;
+            self.text.appendSlice(delta) catch {
+                self.invalid = true;
+            };
+        } else if (std.mem.eql(u8, event, "response.completed")) {
+            if (value != .object) {
+                self.invalid = true;
+                return;
+            }
+            const usage_value = value.object.get("usage") orelse {
+                self.invalid = true;
+                return;
+            };
+            const input = jsonInteger(usage_value, "input_tokens") orelse {
+                self.invalid = true;
+                return;
+            };
+            const output = jsonInteger(usage_value, "output_tokens") orelse {
+                self.invalid = true;
+                return;
+            };
+            const details = usage_value.object.get("input_tokens_details") orelse {
+                self.invalid = true;
+                return;
+            };
+            const cached = jsonInteger(details, "cached_tokens") orelse {
+                self.invalid = true;
+                return;
+            };
+            if ((self.saw_text and self.calls.items.len != 0)) {
+                self.invalid = true;
+                return;
+            }
+            self.usage = .{ .input_tokens = input, .output_tokens = output, .cached_tokens = cached };
+            self.completed = true;
+        } else {
+            self.invalid = true;
+        }
+    }
+
+    fn finish(self: *Parser) ?StreamResponse {
+        if (self.invalid or !self.completed or self.buffer.items.len != 0 or self.event_name.items.len != 0 or self.data != null or (self.saw_text and self.calls.items.len != 0)) return null;
+        return .{
+            .text = self.text.toOwnedSlice() catch return null,
+            .calls = self.calls.toOwnedSlice() catch return null,
+            .usage = self.usage,
+        };
+    }
+};
