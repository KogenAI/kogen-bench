+fn readFile(path: []const u8) Failure![]u8 {
+    const path_z = try cString(path);
+    const fd = c.open(path_z, c.O_RDONLY);
+    if (fd < 0) return error.CannotReadPrompt;
+    defer _ = c.close(fd);
+    return readFd(fd, error.CannotReadPrompt);
+}
+
+fn readFd(fd: c_int, failure: Failure) Failure![]u8 {
+    var buffer = std.array_list.Managed(u8).init(gpa);
+    var chunk: [16 * 1024]u8 = undefined;
+    while (true) {
+        const n = c.read(fd, chunk[0..].ptr, chunk.len);
+        if (n < 0) return failure;
+        if (n == 0) break;
+        buffer.appendSlice(chunk[0..@intCast(n)]) catch return error.OutOfMemory;
+    }
+    if (!std.unicode.utf8ValidateSlice(buffer.items)) return failure;
+    return buffer.toOwnedSlice() catch error.OutOfMemory;
+}
