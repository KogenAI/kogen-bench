+            server = value;
+        } else if (std.mem.eql(u8, flag, "--records")) {
+            records = value;
+        } else if (std.mem.eql(u8, flag, "--workdir")) {
+            workdir = value;
+        } else if (std.mem.eql(u8, flag, "--session")) {
