+fn canonicalPath(path: []const u8) Failure![]u8 {
+    const path_z = try cString(path);
+    const resolved = c.realpath(path_z, null) orelse return error.InvalidWorkdir;
+    defer c.free(resolved);
+    return gpa.dupe(u8, std.mem.span(resolved)) catch error.OutOfMemory;
+}
+
+fn resolveWorkdir(value: ?[]const u8) Failure![]u8 {
+    var path: []const u8 = undefined;
+    if (value) |provided| {
+        path = provided;
+    } else {
+        const cwd = c.getcwd(null, 0) orelse return error.InvalidWorkdir;
+        defer c.free(cwd);
+        path = std.mem.span(cwd);
+    }
+    const resolved = try canonicalPath(path);
+    const z = try cString(resolved);
+    const dir = c.opendir(z) orelse return error.InvalidWorkdir;
+    _ = c.closedir(dir);
+    return resolved;
+}
