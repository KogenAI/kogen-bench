#!/usr/bin/env python3
"""lanes-qualify <task-dir>...: check each task against the qualification rules; exit 1 on a failure."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from lanes import grading  # noqa: E402

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        sys.exit(2)
    sys.exit(grading.qualify_main(sys.argv[1:]))
