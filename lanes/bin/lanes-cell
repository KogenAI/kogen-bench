#!/usr/bin/env python3
import os
import sys

if sys.version_info < (3, 12):  # tomllib (3.11) and tarfile extraction filters (3.12)
    sys.exit("lanes-cell needs Python 3.12 or newer")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
from lanes import cell  # noqa: E402

sys.exit(cell.main())
