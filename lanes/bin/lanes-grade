#!/usr/bin/env python3
"""lanes-grade <run-dir> [<cell-id>...] [--tasks DIR] [--deadline S]: write evaluation.json per cell."""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from lanes import grading  # noqa: E402


def main(argv=None):
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("run_dir")
    p.add_argument("cells", nargs="*", help="cell ids <task>/r<rep>/<lane>; default every finished cell")
    p.add_argument("--tasks", default=os.environ.get("KOGEN_LANES_TASKS"), help="private tasks folder")
    p.add_argument("--deadline", type=float, help="seconds per evaluator command (default: evaluate.toml)")
    a = p.parse_args(argv)
    if not a.tasks:
        p.error("--tasks or KOGEN_LANES_TASKS is required")
    status = 0
    for cell in a.cells or grading.finished_cells(a.run_dir):
        try:
            rec = grading.grade_cell(a.run_dir, cell, a.tasks, a.deadline)
        except (grading.GradeError, OSError, KeyError, ValueError) as e:
            print(f"{cell}: error: {e}", file=sys.stderr)
            status = 1
            continue
        if rec.get("infrastructure"):
            verdict = "infrastructure: " + rec["infrastructure"]
        elif rec.get("phase") == "shape":
            verdict = grading.shape_summary(rec)
        else:
            verdict = "pass" if rec["all_passed"] else "fail"
        shape = rec.get("shape")  # an e2e cell also grades the Intent it shaped
        if isinstance(shape, dict):
            verdict += "; shape " + (("infrastructure: " + shape["infrastructure"]) if shape.get("infrastructure")
                                     else grading.shape_summary(shape))
        print(f"{cell}: {verdict}")
    return status


if __name__ == "__main__":
    sys.exit(main())
