#!/usr/bin/env python3
import os
import sys

if sys.version_info < (3, 12):  # the cell module needs tomllib and tarfile extraction filters
    sys.exit("lanes-preflight needs Python 3.12 or newer")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
from lanes import preflight  # noqa: E402

sys.exit(preflight.main())
