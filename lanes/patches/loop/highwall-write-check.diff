--- /dev/null
+++ b/tools/highwall_write_check_test.go
@@ -0,0 +1,90 @@
+package tools
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestWriteCheckRunsAfterWriteAndReportsFailure(t *testing.T) {
+	root := t.TempDir()
+	tl := newTools(root, WriteFileTool, ShellTool)
+	out, err := tl.Run(WriteFileTool, map[string]any{
+		"path": "source", "content": "new bytes", "command": "cat source; exit 7",
+	})
+	if err != nil || out.Text != "ok\nexit status: 7\nnew bytes" {
+		t.Fatalf("%q %v", out.Text, err)
+	}
+	// A subsequent ordinary write retains the exact old result.
+	out, err = tl.Run(WriteFileTool, map[string]any{"path": "source", "content": "next"})
+	if err != nil || out.Text != "ok" {
+		t.Fatalf("%q %v", out.Text, err)
+	}
+}
+
+func TestWriteCheckRejectsBeforeMutation(t *testing.T) {
+	for _, command := range []any{nil, 4, "", " \n"} {
+		root := t.TempDir()
+		tl := newTools(root, WriteFileTool, ShellTool)
+		out, err := tl.Run(WriteFileTool, map[string]any{"path": "source", "content": "new", "command": command})
+		if err != nil || !strings.HasPrefix(out.Text, "error:") {
+			t.Fatalf("%q %v", out.Text, err)
+		}
+		if _, err := os.Stat(filepath.Join(root, "source")); !os.IsNotExist(err) {
+			t.Fatal("invalid command changed disk")
+		}
+	}
+	root := t.TempDir()
+	tl := newTools(root, WriteFileTool)
+	out, err := tl.Run(WriteFileTool, map[string]any{"path": "source", "content": "new", "command": "echo bad > marker"})
+	if err != nil || !strings.Contains(out.Text, "requires shell") {
+		t.Fatalf("%q %v", out.Text, err)
+	}
+	if _, err := os.Stat(filepath.Join(root, "source")); !os.IsNotExist(err) {
+		t.Fatal("disabled shell changed disk")
+	}
+}
+
+func TestWriteCheckNeverRunsAfterFailedWrite(t *testing.T) {
+	for _, path := range []string{"protected", "folder"} {
+		root := t.TempDir()
+		write(t, root, "protected", "original")
+		if err := os.Mkdir(filepath.Join(root, "folder"), 0700); err != nil {
+			t.Fatal(err)
+		}
+		tl := newTools(root, WriteFileTool, ShellTool)
+		tl.Protected = []string{"protected"}
+		out, err := tl.Run(WriteFileTool, map[string]any{"path": path, "content": "new", "command": "echo bad > marker"})
+		if err != nil || out.Text == "ok" {
+			t.Fatalf("%q %v", out.Text, err)
+		}
+		if _, err := os.Stat(filepath.Join(root, "marker")); !os.IsNotExist(err) {
+			t.Fatal("command ran after failed write")
+		}
+		b, err := os.ReadFile(filepath.Join(root, "protected"))
+		if err != nil || string(b) != "original" {
+			t.Fatalf("protected bytes changed: %q %v", b, err)
+		}
+	}
+}
+
+func TestWriteCheckUsesShellTimeoutAndRefusal(t *testing.T) {
+	root := t.TempDir()
+	tl := newTools(root, WriteFileTool, ShellTool)
+	tl.ShellTimeout = 20 * time.Millisecond
+	out, err := tl.RunContext(context.Background(), WriteFileTool, map[string]any{
+		"path": "source", "content": "new", "command": "sleep 2",
+	})
+	if err != nil || !strings.Contains(out.Text, "timed out after 20ms") {
+		t.Fatalf("%q %v", out.Text, err)
+	}
+	out, err = tl.Run(WriteFileTool, map[string]any{
+		"path": "source", "content": "next", "command": "pkill -f nothing-at-all",
+	})
+	if err != nil || out.Rule == "" || !strings.Contains(out.Text, "refused") {
+		t.Fatalf("%q rule=%q %v", out.Text, out.Rule, err)
+	}
+}
