+package loop
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+
+	"kogen-loop/api"
+	"kogen-loop/provider"
+	"kogen-loop/sys"
+	"kogen-loop/tools"
+)
+
+func TestSessionOffersToolsThroughExecAndReportsItsCalls(t *testing.T) {
+	root := t.TempDir()
+	if err := os.WriteFile(filepath.Join(root, "a.txt"), []byte("alpha\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	args, _ := json.Marshal(map[string]any{"code": `const [a, b] = await Promise.all([tools.shell("sleep 0.2; echo one"), tools.read_file("a.txt")]); text(a); text(b)`})
+	quoted, _ := json.Marshal(string(args))
+	answers := []string{
+		`{"choices":[{"message":{"role":"assistant","content":null,"tool_calls":[{"id":"c1","type":"function","function":{"name":"exec","arguments":` + string(quoted) + `}}]},"finish_reason":"tool_calls"}]}`,
+		`{"choices":[{"message":{"role":"assistant","content":null,"tool_calls":[{"id":"c2","type":"function","function":{"name":"finish","arguments":"{\"summary\":\"done\"}"}}]},"finish_reason":"tool_calls"}]}`,
+	}
+	var mu sync.Mutex
+	var bodies []string
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		b, _ := io.ReadAll(r.Body)
+		mu.Lock()
+		n := len(bodies)
+		bodies = append(bodies, string(b))
+		mu.Unlock()
+		w.Header().Set("Content-Type", "application/json")
+		fmt.Fprint(w, answers[min(n, len(answers)-1)])
+	}))
+	defer srv.Close()
+	var events []api.Event
+	session := sys.NewWith([]string{"HOME=" + t.TempDir(), "PATH=" + os.Getenv("PATH")}, root)
+	s, err := NewSession(SessionConfig{Root: root, Role: provider.Role{Provider: "openai-compatible", Model: "local", BaseURL: srv.URL},
+		Session: session, Enabled: []string{tools.ReadFileTool, tools.ShellTool, tools.ViewImageTool}, Emit: func(e api.Event) { events = append(events, e) }})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var names []string
+	for _, d := range s.Definitions() {
+		names = append(names, d.(map[string]any)["name"].(string))
+	}
+	if strings.Join(names, ",") != "view_image,exec,finish" {
+		t.Fatalf("definitions %v", names)
+	}
+	res, err := s.Round(context.Background(), "go")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if res.Ending != EndTerminal || res.Requests != 2 {
+		t.Fatalf("%+v", res)
+	}
+	if !strings.Contains(bodies[1], `Output:\nexit status: 0\none\n\n1\talpha`) {
+		t.Errorf("second request lacks the script result: %s", bodies[1])
+	}
+	if !strings.Contains(bodies[0], "Promise.allSettled") {
+		t.Error("instructions lack the batching rule")
+	}
+	var ops []any
+	for _, e := range events {
+		if e.Type == api.EventToolResult {
+			ops = append(ops, e.Fields["operations"])
+		}
+	}
+	if len(ops) != 1 || ops[0] != 2 {
+		t.Errorf("operations %v", ops)
+	}
+}
