+func TestExecStopsOnAnInterrupt(t *testing.T) {
+	_, root := newRepo(t)
+	s := sys.NewWith(hermeticEnv(), root)
+	tl := &Tools{Root: root, Session: s, Enabled: []string{ShellTool, ExecTool}}
+	done := make(chan error, 1)
+	go func() {
+		_, err := tl.Run(ExecTool, map[string]any{"code": `await Promise.all([tools.shell("touch started; sleep 30"), tools.shell("sleep 30")])`})
+		done <- err
+	}()
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		if _, err := os.Stat(filepath.Join(root, "started")); err == nil && len(s.Groups()) == 2 {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("not started")
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	s.Interrupt("SIGINT")
+	select {
+	case err := <-done:
+		var in *sys.Interrupted
+		if !errors.As(err, &in) {
+			t.Fatalf("err %v", err)
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatal("exec did not stop")
+	}
+	for _, g := range s.Groups() {
+		// Teardown is asynchronous after an interrupt; a group of zombies answers EPERM on macOS.
+		for i := 0; i < 250 && !errors.Is(syscall.Kill(-g, 0), syscall.ESRCH); i++ {
+			time.Sleep(20 * time.Millisecond)
+		}
+		if err := syscall.Kill(-g, 0); !errors.Is(err, syscall.ESRCH) {
+			t.Errorf("group %d still alive: %v", g, err)
+		}
+	}
+}
