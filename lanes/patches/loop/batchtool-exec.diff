diff -ruN base/tools/exec.go exec/tools/exec.go
--- base/tools/exec.go	1970-01-01 03:00:00
+++ exec/tools/exec.go	2026-10-30 13:57:55
@@ -0,0 +1,342 @@
+package tools
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"slices"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/dop251/goja"
+
+	"kogen-loop/sys"
+)
+
+// ExecTool runs a JavaScript script that calls the session's tools. A standalone session
+// offers its ExecNested tools only through exec.
+const ExecTool = "exec"
+
+// ExecNested are the tools an exec script may call, when they are enabled.
+var ExecNested = []string{ShellTool, ReadFileTool, WriteFileTool, ListFilesTool, SearchTextTool}
+
+const (
+	// execConcurrency is the most nested calls of a script that run at once.
+	execConcurrency = 8
+	// maxJoinedResults bounds a script's result to that many results' bounds.
+	maxJoinedResults = 4
+)
+
+// execShorthand is the argument a nested tool takes when the script passes a string.
+var execShorthand = map[string]string{
+	ShellTool: "command", ReadFileTool: "path", ListFilesTool: "path", SearchTextTool: "pattern",
+}
+
+const execDescription = `Run JavaScript code to orchestrate/compose tool calls
+- Evaluates the provided JavaScript code in a fresh isolate as the body of an async function: top-level ` + "`await`" + ` and ` + "`return`" + ` work.
+- All nested tools are available on the global ` + "`tools`" + ` object, for example ` + "`await tools.shell({command: \"go test ./...\"})`" + `.
+- Nested tool methods take either a string or an object as their input argument, and return a promise of the tool's text result.
+- Nested calls you start together run at the same time. Batch independent searches and reads with ` + "`await Promise.allSettled([...])`" + ` and inspect every result; keep dependencies and edits sequential.
+- Runs raw JavaScript -- no Node, no file system, no network access, no console, no require or import.
+- Put raw JavaScript source text in ` + "`code`" + `, not markdown code fences.
+- When the code is fully evaluated the script ends; nested calls it started still finish first, but their results are discarded unless awaited.
+
+- Global helpers:
+- ` + "`exit()`" + `: Immediately ends the current script successfully (like an early return from the top level).
+- ` + "`text(value: string | number | boolean | undefined | null)`" + `: Appends a text item to the result. Non-string values are stringified with ` + "`JSON.stringify(...)`" + ` when possible.
+- ` + "`ALL_TOOLS`" + `: metadata for the enabled nested tools as ` + "`{ name, description }`" + ` entries.
+Only what you append with text() is returned, with an uncaught error if the script fails.`
+
+// ExecDefinition is the model-facing definition of exec over the nested tools named (in
+// ExecNested order; others are left out).
+func ExecDefinition(nested []string) map[string]any {
+	var b strings.Builder
+	b.WriteString(execDescription)
+	b.WriteString("\n\nNested tools:\ndeclare const tools: {\n")
+	for _, name := range ExecNested {
+		if !slices.Contains(nested, name) {
+			continue
+		}
+		d, _ := Definition(name)
+		b.WriteString("  // " + d["description"].(string) + "\n")
+		b.WriteString("  " + name + "(args: " + tsArgs(d) + "): Promise<string>;\n")
+	}
+	b.WriteString("};")
+	return fun(ExecTool, b.String(), map[string]any{"code": str()}, "code")
+}
+
+// tsArgs is the TypeScript object type of a definition's parameters.
+func tsArgs(d map[string]any) string {
+	params := d["parameters"].(map[string]any)
+	props := params["properties"].(map[string]any)
+	required := params["required"].([]any)
+	var names []string
+	for k := range props {
+		names = append(names, k)
+	}
+	// Required arguments first, then the optional ones, each group in name order.
+	slices.SortFunc(names, func(a, b string) int {
+		ra, rb := slices.Contains(required, any(a)), slices.Contains(required, any(b))
+		if ra != rb {
+			if ra {
+				return -1
+			}
+			return 1
+		}
+		return strings.Compare(a, b)
+	})
+	var fields []string
+	for _, k := range names {
+		typ := "string"
+		if p, _ := props[k].(map[string]any); p["type"] == "integer" {
+			typ = "number"
+		}
+		opt := "?"
+		if slices.Contains(required, any(k)) {
+			opt = ""
+		}
+		fields = append(fields, k+opt+": "+typ)
+	}
+	return "{ " + strings.Join(fields, "; ") + " }"
+}
+
+// execNestedArgs converts a nested call's argument to tool arguments, or returns the error
+// text the script gets.
+func execNestedArgs(name string, v goja.Value) (map[string]any, string) {
+	if v == nil || goja.IsUndefined(v) || goja.IsNull(v) {
+		return map[string]any{}, ""
+	}
+	switch x := v.Export().(type) {
+	case string:
+		key, ok := execShorthand[name]
+		if !ok {
+			return nil, "error: " + name + " takes an object argument"
+		}
+		return map[string]any{key: x}, ""
+	case map[string]any:
+		// A JSON round trip gives the tool the argument types of a model call.
+		data, err := json.Marshal(x)
+		if err != nil {
+			return nil, "error: " + name + ": arguments are not JSON: " + err.Error()
+		}
+		args := DecodeArguments(string(data))
+		if args["__invalid__"] == true {
+			return nil, "error: " + name + ": arguments are not a JSON object"
+		}
+		return args, ""
+	}
+	return nil, "error: " + name + " takes a string or an object argument"
+}
+
+// execCompletion is a finished nested call.
+type execCompletion struct {
+	resolve func(any) error
+	out     Output
+	err     error
+}
+
+// exec runs a script. Nested calls run concurrently (at most execConcurrency at once,
+// write_file alone), each cut as a call of its own before the script sees it. The result
+// is the script's text items, cut to min(nested calls, maxJoinedResults) results' bounds.
+// A script error is a result. A stopping error of a nested call (an interrupt, timeout
+// observation failure) or the end of ctx stops the script, starts no further nested call,
+// terminates the process groups the script started, waits for the running calls and
+// returns the error.
+func (t *Tools) exec(ctx context.Context, args map[string]any) (Output, error) {
+	code, msg := stringArg(args, "code")
+	if msg != "" {
+		return Output{Text: msg}, nil
+	}
+	if strings.TrimSpace(code) == "" {
+		return Output{Text: "error: exec expects JavaScript source text (non-empty)"}, nil
+	}
+	parent := ctx
+	if parent == nil {
+		parent = context.Background()
+	}
+	s := t.session()
+	before := map[int]bool{}
+	for _, g := range s.Groups() {
+		before[g] = true
+	}
+	terminate := func() {
+		var mine []int
+		for _, g := range s.Groups() {
+			if !before[g] {
+				mine = append(mine, g)
+			}
+		}
+		sys.Terminate(mine)
+	}
+	run, cancel := context.WithCancel(parent)
+	defer cancel()
+	stopTerminate := context.AfterFunc(parent, terminate)
+	defer stopTerminate()
+
+	start := time.Now()
+	vm := goja.New()
+	// The script stops when the round ends or the caller interrupts, even in a busy loop.
+	stopInterrupt := context.AfterFunc(run, func() { vm.Interrupt(context.Canceled) })
+	defer stopInterrupt()
+	stopSessionInterrupt := context.AfterFunc(s.Context(), func() { vm.Interrupt(context.Canceled) })
+	defer stopSessionInterrupt()
+
+	var nested []string
+	for _, n := range ExecNested {
+		if slices.Contains(t.Enabled, n) {
+			nested = append(nested, n)
+		}
+	}
+	var (
+		texts   []string
+		calls   int
+		pending int
+		wg      sync.WaitGroup
+		writes  sync.RWMutex
+		stopErr error
+	)
+	done := make(chan execCompletion)
+	slots := make(chan struct{}, execConcurrency)
+	call := func(name string, arg goja.Value) *goja.Promise {
+		p, resolve, _ := vm.NewPromise()
+		a, msg := execNestedArgs(name, arg)
+		if msg != "" {
+			resolve(msg)
+			return p
+		}
+		if run.Err() != nil {
+			// Stopping: nothing starts; the promise never settles.
+			return p
+		}
+		calls++
+		pending++
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			c := execCompletion{resolve: resolve}
+			select {
+			case slots <- struct{}{}:
+				defer func() { <-slots }()
+				if name == WriteFileTool {
+					writes.Lock()
+					defer writes.Unlock()
+				} else {
+					writes.RLock()
+					defer writes.RUnlock()
+				}
+				if c.err = run.Err(); c.err == nil {
+					c.out, c.err = t.RunContext(run, name, a)
+				}
+			case <-run.Done():
+				c.err = run.Err()
+			}
+			done <- c
+		}()
+		return p
+	}
+
+	toolsObject := vm.NewObject()
+	var all []any
+	for _, name := range nested {
+		toolsObject.Set(name, func(fc goja.FunctionCall) goja.Value { return vm.ToValue(call(name, fc.Argument(0))) })
+		d, _ := Definition(name)
+		all = append(all, map[string]any{"name": name, "description": d["description"]})
+	}
+	vm.Set("tools", toolsObject)
+	vm.Set("ALL_TOOLS", all)
+	vm.Set("text", func(v goja.Value) { texts = append(texts, execString(vm, v)) })
+	exitSentinel := vm.NewObject()
+	vm.Set("exit", func() { panic(exitSentinel) })
+	vm.Set("__kogen_exit__", exitSentinel)
+
+	// The prefix keeps the script's line numbers.
+	wrapped := "(async () => { try { " + code + "\n} catch (e) { if (e === __kogen_exit__) return; throw e; } })()"
+	var failure string
+	v, err := vm.RunString(wrapped)
+	var promise *goja.Promise
+	if err != nil {
+		failure = execError(err)
+	} else if p, ok := v.Export().(*goja.Promise); ok {
+		promise = p
+	}
+	for pending > 0 {
+		c := <-done
+		pending--
+		if c.err != nil {
+			if stopErr == nil {
+				stopErr = c.err
+				cancel()
+				terminate()
+			}
+			continue
+		}
+		if stopErr != nil || run.Err() != nil || (promise != nil && promise.State() != goja.PromiseStatePending) {
+			continue // results of a stopped or finished script are discarded
+		}
+		if err := c.resolve(t.Cut(c.out).Text); err != nil && failure == "" {
+			failure = execError(err)
+		}
+	}
+	wg.Wait()
+	if stopErr != nil {
+		return Output{}, stopErr
+	}
+	if err := parent.Err(); err != nil {
+		return Output{}, err
+	}
+	if err := s.Err(); err != nil {
+		return Output{}, err
+	}
+	if failure == "" && promise != nil {
+		switch promise.State() {
+		case goja.PromiseStateRejected:
+			failure = execString(vm, promise.Result())
+		case goja.PromiseStatePending:
+			failure = "Error: the script awaited a promise that never settles"
+		}
+	}
+	head := "Script completed"
+	if failure != "" {
+		head = "Script failed"
+		texts = append(texts, failure)
+	}
+	text := fmt.Sprintf("%s\nWall time %.1f seconds\nOutput:\n%s", head, time.Since(start).Seconds(), strings.Join(texts, "\n"))
+	bound, cutHead := t.budgets()
+	text = cutText(text, min(max(calls, 1), maxJoinedResults)*bound, cutHead)
+	return Output{Text: text, Segments: max(calls, 1), Ops: calls}, nil
+}
+
+// execString is a value as text(): strings unchanged, errors as "Name: message", others as
+// JSON when possible.
+func execString(vm *goja.Runtime, v goja.Value) string {
+	if v == nil || goja.IsUndefined(v) {
+		return "undefined"
+	}
+	if goja.IsNull(v) {
+		return "null"
+	}
+	if s, ok := v.Export().(string); ok {
+		return s
+	}
+	if o, ok := v.(*goja.Object); ok {
+		if stack := o.Get("stack"); stack != nil && !goja.IsUndefined(stack) {
+			return stack.String()
+		}
+	}
+	if data, err := json.Marshal(v.Export()); err == nil {
+		return string(data)
+	}
+	return v.String()
+}
+
+// execError is the text of an error the runtime returned.
+func execError(err error) string {
+	switch e := err.(type) {
+	case *goja.Exception:
+		return e.String()
+	case *goja.InterruptedError:
+		return "Error: script interrupted"
+	}
+	return "Error: " + err.Error()
+}
diff -ruN base/tools/exec_test.go exec/tools/exec_test.go
--- base/tools/exec_test.go	1970-01-01 03:00:00
+++ exec/tools/exec_test.go	2026-10-30 13:59:26
@@ -0,0 +1,239 @@
+package tools
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+
+	"kogen-loop/sys"
+)
+
+var execHead = regexp.MustCompile(`^Script (completed|failed)\nWall time \d+\.\d seconds\nOutput:\n`)
+
+// execOutput runs a script and returns its output after the header.
+func execOutput(t *testing.T, tl *Tools, ctx context.Context, code string) (string, string, Output) {
+	t.Helper()
+	out, err := tl.RunContext(ctx, ExecTool, map[string]any{"code": code})
+	if err != nil {
+		t.Fatal(err)
+	}
+	m := execHead.FindStringSubmatch(out.Text)
+	if m == nil {
+		t.Fatalf("no header: %q", out.Text)
+	}
+	return m[1], out.Text[len(m[0]):], out
+}
