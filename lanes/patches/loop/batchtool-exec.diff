+func TestExecKeepsOrderAndRunsNestedCallsConcurrently(t *testing.T) {
+	_, root := newRepo(t)
+	write(t, root, "a.txt", "alpha\n")
+	tl := newTools(root, ReadFileTool, ShellTool, ExecTool)
+	start := time.Now()
+	status, text, out := execOutput(t, tl, context.Background(), `
+const [slow, fast, file] = await Promise.all([
+  tools.shell({command: "sleep 0.6; echo slow"}),
+  tools.shell("sleep 0.6; echo fast"),
+  tools.read_file({path: "a.txt"}),
+]);
+text(slow); text(fast); text(file);`)
+	if d := time.Since(start); d > 1100*time.Millisecond {
+		t.Errorf("nested calls ran one after another: %v", d)
+	}
+	if status != "completed" || text != "exit status: 0\nslow\n\nexit status: 0\nfast\n\n1\talpha" {
+		t.Errorf("%s %q", status, text)
+	}
+	if out.Ops != 3 {
+		t.Errorf("ops %d", out.Ops)
+	}
+}
