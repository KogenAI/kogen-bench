+func TestExecCancellationStopsItsProcessGroups(t *testing.T) {
+	_, root := newRepo(t)
+	tl := newTools(root, ShellTool, ExecTool)
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() {
+		_, err := tl.RunContext(ctx, ExecTool, map[string]any{"code": `
+const all = [];
+for (let i = 0; i < 10; i++) all.push(tools.shell("echo $$ >> started; sleep 30; touch finished"));
+await Promise.all(all);
+text("not reached");`})
+		done <- err
+	}()
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		data, _ := os.ReadFile(filepath.Join(root, "started"))
+		if strings.Count(string(data), "\n") == execConcurrency {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("started: %q", data)
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	cancel()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("err %v", err)
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatal("exec did not stop")
+	}
+	groups := tl.Session.Groups()
+	if len(groups) != execConcurrency {
+		t.Errorf("%d groups started, want %d (queued calls must not start)", len(groups), execConcurrency)
+	}
+	for _, g := range groups {
+		if err := syscall.Kill(-g, 0); !errors.Is(err, syscall.ESRCH) {
+			t.Errorf("group %d still alive: %v", g, err)
+		}
+	}
+	if _, err := os.Stat(filepath.Join(root, "finished")); err == nil {
+		t.Error("a cancelled command finished")
+	}
+}
