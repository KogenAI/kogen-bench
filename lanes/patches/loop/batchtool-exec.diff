+func TestExecCutsNestedResultsAndItsOutput(t *testing.T) {
+	_, root := newRepo(t)
+	write(t, root, "big.txt", strings.Repeat("x", 20000))
+	tl := newTools(root, ShellTool, ExecTool)
+	_, text, out := execOutput(t, tl, context.Background(), `const r = await tools.shell("cat big.txt"); text(String(r.length)); text(r)`)
+	if n, _, _ := strings.Cut(text, "\n"); len(n) != 5 || n > "16384" || n < "16000" || strings.Count(text, "bytes omitted") != 1 {
+		t.Errorf("nested result not cut as a call: %.80q", text)
+	}
+	if out.Cut().Text != out.Text || tl.Cut(out).Text != out.Text {
+		t.Error("the result was cut again")
+	}
+	_, _, out = execOutput(t, tl, context.Background(), `for (let i = 0; i < 6; i++) text(await tools.shell("cat big.txt"))`)
+	if len(out.Text) > maxJoinedResults*maxResult || out.Ops != 6 || !strings.Contains(out.Text, "bytes omitted") {
+		t.Errorf("joined bound: %d bytes, ops %d", len(out.Text), out.Ops)
+	}
+	_, _, out = execOutput(t, tl, context.Background(), `text("y".repeat(40000))`)
+	if len(out.Text) > maxResult || out.Ops != 0 {
+		t.Errorf("no-call bound: %d bytes", len(out.Text))
+	}
+}
