#!/usr/bin/env python3
"""Stand-in for lanes-cell: records the call, optionally sleeps, writes result.json."""
import json
import os
import subprocess
import sys
import time

run_dir, cell = sys.argv[1], sys.argv[2]
opts = dict(zip(sys.argv[3::2], sys.argv[4::2]))
events = os.environ.get("FAKE_EVENTS")
if events:
    with open(events, "a") as f:
        f.write(f"cell {cell} {opts['--host']}\n")
if os.environ.get("FAKE_PIDS"):
    with open(os.environ["FAKE_PIDS"], "a") as f:
        f.write(f"{os.getpid()}\n")
if os.environ.get("FAKE_HOG") == cell:  # a child that allocates steadily, MB per step, up to a ceiling
    hog = ("import os,time\nkeep=[]\nmax_mb=int(os.environ.get('FAKE_HOG_MAX_MB','400'))\n"
           "for i in range(max_mb//int(os.environ.get('FAKE_HOG_STEP_MB','10'))):\n"
           " keep.append(bytearray(b'x'*(int(os.environ.get('FAKE_HOG_STEP_MB','10'))<<20)))\n time.sleep(0.25)\n"
           "time.sleep(float(os.environ.get('FAKE_HOG_HOLD','30')))\n")
    subprocess.run([sys.executable, "-c", hog])
time.sleep(float(os.environ.get("FAKE_SLEEP_" + opts["--host"], os.environ.get("FAKE_SLEEP", "0"))))
if os.environ.get("FAKE_FAIL") == cell:
    sys.exit(3)
task = cell.split("/")[0]
d = os.path.join(run_dir, "cells", *cell.split("/"))
os.makedirs(d, exist_ok=True)
lock = json.load(open(os.path.join(run_dir, "lanes.lock.json")))
art = lock[0]["artifact_sha256"]
home = os.environ.get("KOGEN_LANES_HOME", "")
with open(os.path.join(d, "result.json.tmp"), "w") as f:  # atomic, like lanes-cell
    json.dump({"cell": cell, "host": opts["--host"],
               "evaluator": os.path.exists(os.path.join(opts["--tasks"], task, "evaluator")),
               "start": os.path.isdir(os.path.join(opts["--tasks"], task, "start")),
               "artifact": os.path.isfile(os.path.join(home, "artifacts", art, "kogen")),
               "totals": {"cost_usd": float(os.environ.get("FAKE_COST_" + cell.split("/")[-1].upper(),
                                                           os.environ.get("FAKE_COST", 0)))}}, f)
if os.environ.get("FAKE_RUNLOG"):  # a Kogen run log: executor events, a native build request, or none at all
    names = {"executor": ["executor_started", "executor_round_started", "executor_round_ended"],
             "native": ["request"], "empty": []}[os.environ["FAKE_RUNLOG"]]
    os.makedirs(os.path.join(d, "run-log"), exist_ok=True)
    with open(os.path.join(d, "run-log", "log.jsonl"), "w") as f:
        for n in names:
            f.write(json.dumps({"event": n, "executor": "claude-code", "role": "build"}) + "\n")
if os.environ.get("FAKE_ENV_LOG"):  # whether CLAUDE_CONFIG_DIR reached the cell (the value only)
    with open(os.environ["FAKE_ENV_LOG"], "a") as f:
        f.write(f"{cell} {os.environ.get('CLAUDE_CONFIG_DIR', '-')}\n")
if os.environ.get("FAKE_PATH_LOG"):  # the first PATH entry the cell's Kogen would search
    with open(os.environ["FAKE_PATH_LOG"], "a") as f:
        f.write(f"{cell} {os.environ.get('PATH', '').split(os.pathsep)[0]}\n")
os.replace(os.path.join(d, "result.json.tmp"), os.path.join(d, "result.json"))
if os.environ.get("FAKE_RATE_LIMIT") == cell:  # Kogen's error line for a provider's usage limit
    with open(os.path.join(d, "stdout.txt"), "w") as f:
        f.write("provider/usage_limit: usage limit reached\n")
if events:
    with open(events, "a") as f:
        f.write(f"end {cell} {opts['--host']}\n")
