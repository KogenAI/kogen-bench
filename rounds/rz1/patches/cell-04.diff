-pub fn execute(_args: &[String]) -> Result<String, (i32, String)> {
-    Ok(String::new())
+use std::collections::HashSet;
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum CoreError {
+    InvalidSumLine(usize),
+    InvalidStatusLine(usize),
+    DuplicateId { line: usize, id: String },
+}
+
+#[derive(Debug, Default, PartialEq, Eq)]
+pub struct StatusCounts {
+    pub total: usize,
+    pub queued: usize,
+    pub running: usize,
+    pub done: usize,
+    pub failed: usize,
+}
+
+pub fn physical_lines(text: &str) -> impl Iterator<Item = &str> {
+    text.split_terminator('\n')
+        .map(|line| line.strip_suffix('\r').unwrap_or(line))
+}
+
+pub fn sum(text: &str, scale: u32) -> Result<i64, CoreError> {
+    let mut total = 0_i64;
+
+    for (index, line) in physical_lines(text).enumerate() {
+        if line.is_empty() {
+            continue;
+        }
+
+        let digits = line
+            .strip_prefix('+')
+            .or_else(|| line.strip_prefix('-'))
+            .unwrap_or(line);
+        if digits.is_empty() || !digits.bytes().all(|byte| byte.is_ascii_digit()) {
+            return Err(CoreError::InvalidSumLine(index + 1));
+        }
+
+        let value = line
+            .parse::<i64>()
+            .ok()
+            .filter(|value| (-1_000_000..=1_000_000).contains(value))
+            .ok_or(CoreError::InvalidSumLine(index + 1))?;
+        total += value;
+    }
+
+    Ok(total * i64::from(scale))
+}
+
+pub fn status(text: &str) -> Result<StatusCounts, CoreError> {
+    let mut ids = HashSet::new();
+    let mut counts = StatusCounts::default();
+
+    for (index, line) in physical_lines(text).enumerate() {
+        if line.is_empty() {
+            continue;
+        }
+
+        let Some((id, state)) = line.split_once(',') else {
+            return Err(CoreError::InvalidStatusLine(index + 1));
+        };
+        if state.contains(',') || !valid_id(id) {
+            return Err(CoreError::InvalidStatusLine(index + 1));
+        }
+
+        let state_index = match state {
+            "queued" => 0,
+            "running" => 1,
+            "done" => 2,
+            "failed" => 3,
+            _ => return Err(CoreError::InvalidStatusLine(index + 1)),
+        };
+
+        if !ids.insert(id) {
+            return Err(CoreError::DuplicateId {
+                line: index + 1,
+                id: id.to_owned(),
+            });
+        }
+
+        counts.total += 1;
+        match state_index {
+            0 => counts.queued += 1,
+            1 => counts.running += 1,
+            2 => counts.done += 1,
+            3 => counts.failed += 1,
+            _ => unreachable!(),
+        }
+    }
+
+    Ok(counts)
+}
+
+fn valid_id(id: &str) -> bool {
+    let bytes = id.as_bytes();
+    (1..=32).contains(&bytes.len())
+        && bytes[0].is_ascii_lowercase()
+        && bytes[1..].iter().all(|byte| {
+            byte.is_ascii_lowercase() || byte.is_ascii_digit() || *byte == b'_' || *byte == b'-'
+        })
 }
