-mod core;
+fn execute(args: &[String]) -> Result<String, (i32, String)> {
+    match args {
+        [] => return Ok(HELP.to_owned()),
+        [one] if one == "--help" || one == "-h" => return Ok(HELP.to_owned()),
+        [one] if one == "--version" => return Ok("kogen 1.0.0\n".to_owned()),
+        _ => {}
+    }
+
+    let command = match args[0].as_str() {
+        "sum" => Command::Sum,
+        "status" => Command::Status,
+        token if token.starts_with('-') => {
+            return Err((2, format!("kogen: unknown option '{token}'")));
+        }
+        token => return Err((2, format!("kogen: unknown command '{token}'"))),
+    };
+
+    if args.len() == 2 && (args[1] == "--help" || args[1] == "-h") {
+        return Ok(match command {
+            Command::Sum => SUM_HELP,
+            Command::Status => STATUS_HELP,
+        }
+        .to_owned());
+    }
+
+    let options = parse_options(command, &args[1..])?;
+    let bytes = read_input(options.path.as_deref()).map_err(|message| (1, message))?;
+    if !bytes.is_ascii() {
+        return Err((1, "kogen: input is not ASCII".to_owned()));
+    }
+    let input = std::str::from_utf8(&bytes).expect("ASCII is valid UTF-8");
+
+    match options.command {
+        Command::Sum => {
+            let result = core::sum(input, options.scale).map_err(content_error)?;
+            Ok(render_sum(result, options.format))
+        }
+        Command::Status => {
+            let counts = core::status(input).map_err(content_error)?;
+            Ok(render_status(&counts, options.format))
+        }
+    }
+}
+
+fn parse_options(command: Command, args: &[String]) -> Result<Options, (i32, String)> {
+    let mut format = Format::Text;
+    let mut scale = 1;
+    let mut path = None;
+    let mut saw_format = false;
+    let mut saw_scale = false;
+    let mut index = 0;
+
+    while index < args.len() {
+        let token = args[index].as_str();
+        match token {
+            "--format" => {
+                if saw_format {
+                    return Err((2, "kogen: duplicate option '--format'".to_owned()));
+                }
+                saw_format = true;
+                let value = option_value(args, index, "--format")?;
+                format = match value {
+                    "text" => Format::Text,
+                    "json" => Format::Json,
+                    _ => return Err(invalid_value("--format", value)),
+                };
+                index += 2;
+            }
+            "--scale" if matches!(command, Command::Sum) => {
+                if saw_scale {
+                    return Err((2, "kogen: duplicate option '--scale'".to_owned()));
+                }
+                saw_scale = true;
+                let value = option_value(args, index, "--scale")?;
+                scale = parse_scale(value).ok_or_else(|| invalid_value("--scale", value))?;
+                index += 2;
+            }
+            _ if token.starts_with('-') && token != "-" => {
+                return Err((2, format!("kogen: unknown option '{token}'")));
+            }
+            _ => {
+                if path.is_some() {
+                    return Err((2, "kogen: expected at most one input path".to_owned()));
+                }
+                path = Some(token.to_owned());
+                index += 1;
+            }
+        }
+    }
+
+    Ok(Options {
+        command,
+        format,
+        scale,
+        path,
+    })
+}
+
+fn option_value<'a>(
+    args: &'a [String],
+    index: usize,
+    flag: &str,
+) -> Result<&'a str, (i32, String)> {
+    args.get(index + 1)
+        .map(String::as_str)
+        .ok_or_else(|| (2, format!("kogen: option '{flag}' requires a value")))
+}
+
+fn parse_scale(value: &str) -> Option<u32> {
+    let bytes = value.as_bytes();
+    if bytes == b"0"
+        || (bytes
+            .first()
+            .is_some_and(|byte| (b'1'..=b'9').contains(byte))
+            && bytes[1..].iter().all(u8::is_ascii_digit))
+    {
+        value.parse::<u32>().ok().filter(|scale| *scale <= 100)
+    } else {
+        None
+    }
+}
+
+fn invalid_value(flag: &str, value: &str) -> (i32, String) {
+    (2, format!("kogen: invalid value for '{flag}': '{value}'"))
+}
+
+fn read_input(path: Option<&str>) -> Result<Vec<u8>, String> {
+    let input = match path {
+        None | Some("-") => {
+            let mut bytes = Vec::new();
+            io::stdin().read_to_end(&mut bytes).map(|_| bytes)
+        }
+        Some(path) => std::fs::read(path),
+    };
+    input.map_err(|_| "kogen: cannot read input".to_owned())
+}
+
+fn content_error(error: core::CoreError) -> (i32, String) {
+    let message = match error {
+        core::CoreError::InvalidSumLine(line) => {
+            format!("kogen:{line}: expected integer -1000000..1000000")
+        }
+        core::CoreError::InvalidStatusLine(line) => {
+            format!("kogen:{line}: expected ID,STATE")
+        }
+        core::CoreError::DuplicateId { line, id } => {
+            format!("kogen:{line}: duplicate id '{id}'")
+        }
+    };
+    (1, message)
+}
+
+fn render_sum(sum: i64, format: Format) -> String {
+    match format {
+        Format::Text => format!("sum={sum}\n"),
+        Format::Json => format!("{{\"sum\":{sum}}}\n"),
+    }
+}
+
+fn render_status(counts: &core::StatusCounts, format: Format) -> String {
+    match format {
+        Format::Text => format!(
+            "total={}\nqueued={}\nrunning={}\ndone={}\nfailed={}\n",
+            counts.total, counts.queued, counts.running, counts.done, counts.failed
+        ),
+        Format::Json => format!(
+            "{{\"total\":{},\"queued\":{},\"running\":{},\"done\":{},\"failed\":{}}}\n",
+            counts.total, counts.queued, counts.running, counts.done, counts.failed
+        ),
+    }
+}
 
