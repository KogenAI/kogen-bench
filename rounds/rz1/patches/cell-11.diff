+const std = @import("std");
+const config_parser = @import("config.zig");
+const shared = @import("shared.zig");
+
 pub const Failure = struct {
     code: u8,
     message: []const u8,
@@ -8,9 +12,55 @@ pub const Result = union(enum) {
     failure: Failure,
 };
 
-pub fn execute(_io: @import("std").Io, _allocator: @import("std").mem.Allocator, _args: []const []const u8) !Result {
-    _ = _io;
-    _ = _allocator;
-    _ = _args;
-    return .{ .output = "" };
+const help_text =
+    "Usage: kogen-config [FILE|-]\n" ++
+    "Parse a strict YAML-subset configuration from FILE or stdin.\n" ++
+    "Options:\n" ++
+    "  --help  Show this help.\n";
+
+pub fn execute(io: std.Io, allocator: std.mem.Allocator, args: []const []const u8) !Result {
+    for (args) |arg| {
+        if (!std.mem.startsWith(u8, arg, "-") or std.mem.eql(u8, arg, "-")) continue;
+        if (std.mem.eql(u8, arg, "--help") and args.len == 1) {
+            return .{ .output = help_text };
+        }
+        return .{ .failure = .{
+            .code = 2,
+            .message = try std.fmt.allocPrint(allocator, "config: unknown option '{s}'", .{arg}),
+        } };
+    }
+
+    if (args.len > 1) {
+        return .{ .failure = .{
+            .code = 2,
+            .message = "config: expected at most one input path",
+        } };
+    }
+
+    const path: ?[]const u8 = if (args.len == 0) null else args[0];
+    const input = shared.load(io, allocator, path) catch {
+        return .{ .failure = .{ .code = 1, .message = "config: cannot read input" } };
+    };
+
+    const parsed = try config_parser.parse(input, allocator);
+    switch (parsed) {
+        .failure => |parse_error| return .{ .failure = .{
+            .code = 1,
+            .message = try std.fmt.allocPrint(
+                allocator,
+                "config:{d}:{d}: {s}",
+                .{ parse_error.line, parse_error.column, parse_error.message },
+            ),
+        } },
+        .config => |value| return .{ .output = try std.fmt.allocPrint(
+            allocator,
+            "name={s}\nworkers={d}\nenabled={s}\ndirectory={s}\n",
+            .{
+                value.name,
+                value.workers,
+                if (value.enabled) "true" else "false",
+                value.directory,
+            },
+        ) },
+    }
 }
