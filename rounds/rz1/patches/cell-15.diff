-mod core;
+fn execute(args: &[String]) -> Result<String, (i32, String)> {
+    if args.is_empty() || args == ["--help"] || args == ["-h"] {
+        return Ok(HELP.to_owned());
+    }
+    if args == ["--version"] {
+        return Ok(format!("kogen {}\n", env!("CARGO_PKG_VERSION")));
+    }
+
+    let command = match args[0].as_str() {
+        "sum" => Command::Sum,
+        "status" => Command::Status,
+        token if token.starts_with('-') => {
+            return Err((2, format!("kogen: unknown option '{token}'")));
+        }
+        token => return Err((2, format!("kogen: unknown command '{token}'"))),
+    };
+
+    if args.len() == 2 {
+        match (command, args[1].as_str()) {
+            (Command::Sum, "--help" | "-h") => return Ok(SUM_HELP.to_owned()),
+            (Command::Status, "--help" | "-h") => return Ok(STATUS_HELP.to_owned()),
+            _ => {}
+        }
+    }
+
+    let options = parse_options(command, &args[1..]).map_err(|message| (2, message))?;
+    let input = read_input(options.path.as_deref()).map_err(|message| (1, message))?;
+    if !input.is_ascii() {
+        return Err((1, "kogen: input is not ASCII".to_owned()));
+    }
+    let text = String::from_utf8(input).expect("ASCII input is valid UTF-8");
+
+    match options.command {
+        Command::Sum => core::sum(&text, options.scale)
+            .map(|result| render_sum(result, options.format))
+            .map_err(|message| (1, format!("kogen:{message}"))),
+        Command::Status => core::status(&text)
+            .map(|counts| render_status(counts, options.format))
+            .map_err(|message| (1, format!("kogen:{message}"))),
+    }
+}
+
+fn parse_options(command: Command, args: &[String]) -> Result<Options, String> {
+    let mut format = None;
+    let mut scale = None;
+    let mut path = None;
+    let mut index = 0;
+
+    while index < args.len() {
+        let token = args[index].as_str();
+        match token {
+            "--format" => {
+                if format.is_some() {
+                    return Err("kogen: duplicate option '--format'".to_owned());
+                }
+                let value = args
+                    .get(index + 1)
+                    .ok_or_else(|| "kogen: option '--format' requires a value".to_owned())?;
+                format = Some(match value.as_str() {
+                    "text" => Format::Text,
+                    "json" => Format::Json,
+                    _ => {
+                        return Err(format!("kogen: invalid value for '--format': '{value}'"));
+                    }
+                });
+                index += 2;
+            }
+            "--scale" if matches!(command, Command::Sum) => {
+                if scale.is_some() {
+                    return Err("kogen: duplicate option '--scale'".to_owned());
+                }
+                let value = args
+                    .get(index + 1)
+                    .ok_or_else(|| "kogen: option '--scale' requires a value".to_owned())?;
+                let parsed = parse_scale(value)
+                    .ok_or_else(|| format!("kogen: invalid value for '--scale': '{value}'"))?;
+                scale = Some(parsed);
+                index += 2;
+            }
+            _ if token.starts_with('-') && token != "-" => {
+                return Err(format!("kogen: unknown option '{token}'"));
+            }
+            _ => {
+                if path.is_some() {
+                    return Err("kogen: expected at most one input path".to_owned());
+                }
+                path = Some(token.to_owned());
+                index += 1;
+            }
+        }
+    }
+
+    Ok(Options {
+        command,
+        format: format.unwrap_or(Format::Text),
+        scale: scale.unwrap_or(1),
+        path,
+    })
+}
+
+fn parse_scale(value: &str) -> Option<u32> {
+    let bytes = value.as_bytes();
+    if bytes.is_empty()
+        || (bytes.len() > 1 && bytes[0] == b'0')
+        || !bytes.iter().all(u8::is_ascii_digit)
+    {
+        return None;
+    }
+
+    let parsed = value.parse::<u32>().ok()?;
+    (parsed <= 100).then_some(parsed)
+}
+
+fn read_input(path: Option<&str>) -> Result<Vec<u8>, String> {
+    let result = match path {
+        None | Some("-") => {
+            let mut input = Vec::new();
+            io::stdin().read_to_end(&mut input).map(|_| input)
+        }
+        Some(path) => std::fs::read(path),
+    };
+    result.map_err(|_| "kogen: cannot read input".to_owned())
+}
+
+fn render_sum(result: i64, format: Format) -> String {
+    match format {
+        Format::Text => format!("sum={result}\n"),
+        Format::Json => format!("{{\"sum\":{result}}}\n"),
+    }
+}
+
+fn render_status(counts: core::StatusCounts, format: Format) -> String {
+    match format {
+        Format::Text => format!(
+            "total={}\nqueued={}\nrunning={}\ndone={}\nfailed={}\n",
+            counts.total, counts.queued, counts.running, counts.done, counts.failed
+        ),
+        Format::Json => format!(
+            "{{\"total\":{},\"queued\":{},\"running\":{},\"done\":{},\"failed\":{}}}\n",
+            counts.total, counts.queued, counts.running, counts.done, counts.failed
+        ),
+    }
+}
 
