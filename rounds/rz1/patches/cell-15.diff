-pub fn execute(_args: &[String]) -> Result<String, (i32, String)> {
-    Ok(String::new())
+use std::collections::HashSet;
+
+#[derive(Debug, Default, PartialEq, Eq)]
+pub struct StatusCounts {
+    pub total: usize,
+    pub queued: usize,
+    pub running: usize,
+    pub done: usize,
+    pub failed: usize,
+}
+
+pub fn physical_lines(text: &str) -> Vec<&str> {
+    if text.is_empty() {
+        return Vec::new();
+    }
+
+    text.split_terminator('\n')
+        .map(|line| line.strip_suffix('\r').unwrap_or(line))
+        .collect()
+}
+
+pub fn sum(input: &str, scale: u32) -> Result<i64, String> {
+    let mut total = 0_i64;
+
+    for (index, line) in physical_lines(input).into_iter().enumerate() {
+        if line.is_empty() {
+            continue;
+        }
+
+        let Some(value) = parse_sum_line(line) else {
+            return Err(format!("{}: expected integer -1000000..1000000", index + 1));
+        };
+        total += value;
+    }
+
+    Ok(total * i64::from(scale))
+}
+
+fn parse_sum_line(line: &str) -> Option<i64> {
+    let bytes = line.as_bytes();
+    let (negative, digits) = match bytes.first() {
+        Some(b'-') => (true, &bytes[1..]),
+        Some(b'+') => (false, &bytes[1..]),
+        _ => (false, bytes),
+    };
+
+    if digits.is_empty() || !digits.iter().all(u8::is_ascii_digit) {
+        return None;
+    }
+
+    let mut magnitude = 0_u32;
+    for digit in digits {
+        magnitude = (magnitude * 10 + u32::from(digit - b'0')).min(1_000_001);
+    }
+
+    if magnitude > 1_000_000 {
+        return None;
+    }
+
+    let value = i64::from(magnitude);
+    Some(if negative { -value } else { value })
+}
+
+pub fn status(input: &str) -> Result<StatusCounts, String> {
+    let mut counts = StatusCounts::default();
+    let mut ids = HashSet::new();
+
+    for (index, line) in physical_lines(input).into_iter().enumerate() {
+        if line.is_empty() {
+            continue;
+        }
+
+        let Some((id, state)) = line.split_once(',') else {
+            return Err(format!("{}: expected ID,STATE", index + 1));
+        };
+        if !valid_id(id) || !matches!(state, "queued" | "running" | "done" | "failed") {
+            return Err(format!("{}: expected ID,STATE", index + 1));
+        }
+
+        if !ids.insert(id) {
+            return Err(format!("{}: duplicate id '{}'", index + 1, id));
+        }
+
+        counts.total += 1;
+        match state {
+            "queued" => counts.queued += 1,
+            "running" => counts.running += 1,
+            "done" => counts.done += 1,
+            "failed" => counts.failed += 1,
+            _ => unreachable!("state was validated above"),
+        }
+    }
+
+    Ok(counts)
+}
+
+fn valid_id(id: &str) -> bool {
+    let bytes = id.as_bytes();
+    (1..=32).contains(&bytes.len())
+        && bytes[0].is_ascii_lowercase()
+        && bytes
+            .iter()
+            .all(|byte| byte.is_ascii_lowercase() || byte.is_ascii_digit() || b"_-".contains(byte))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{StatusCounts, physical_lines, status, sum};
+
+    #[test]
+    fn physical_line_endings() {
+        assert_eq!(physical_lines("a\r\n\nb\r"), vec!["a", "", "b"]);
+        assert_eq!(physical_lines(""), Vec::<&str>::new());
+    }
+
+    #[test]
+    fn sum_accepts_signs_and_leading_zeroes() {
+        assert_eq!(sum("+001\n-2\n", 3), Ok(-3));
+        assert!(sum("1000001", 1).is_err());
+    }
+
+    #[test]
+    fn status_counts_distinct_records() {
+        assert_eq!(
+            status("a,queued\nb-2,running\nc_done,done\nd,failed\n"),
+            Ok(StatusCounts {
+                total: 4,
+                queued: 1,
+                running: 1,
+                done: 1,
+                failed: 1,
+            })
+        );
+        assert_eq!(
+            status("a,queued\na,done"),
+            Err("2: duplicate id 'a'".into())
+        );
+    }
 }
