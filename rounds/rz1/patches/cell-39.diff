+pub fn parse_args(raw_args: &[OsString]) -> Option<Config> {
+    let args = raw_args
+        .iter()
+        .map(|arg| arg.to_str())
+        .collect::<Option<Vec<_>>>()?;
+    if args.first().copied() != Some("model") {
+        return None;
+    }
+
+    let mut url = None;
+    let mut prompt = None;
+    let mut timeout = None;
+    let mut usage_path = None;
+    let mut index = 1;
+
+    while index < args.len() {
+        if index + 1 >= args.len() {
+            return None;
+        }
+        let option = args[index];
+        let value = args[index + 1];
+        match option {
+            "--url" if url.is_none() => {
+                if !value.starts_with("http://")
+                    || value
+                        .bytes()
+                        .any(|byte| byte.is_ascii_whitespace() || byte.is_ascii_control())
+                {
+                    return None;
+                }
+                let parsed = Url::parse(value).ok()?;
+                if parsed.scheme() != "http" || parsed.host_str().is_none() {
+                    return None;
+                }
+                url = Some(parsed);
+            }
+            "--prompt" if prompt.is_none() => prompt = Some(value.to_owned()),
+            "--idle-timeout-ms" if timeout.is_none() => {
+                if value.is_empty() || !value.bytes().all(|byte| byte.is_ascii_digit()) {
+                    return None;
+                }
+                let significant = value.trim_start_matches('0');
+                let millis = if significant.is_empty() {
+                    0
+                } else {
+                    significant.parse::<u64>().ok()?
+                };
+                if !(1..=60_000).contains(&millis) {
+                    return None;
+                }
+                timeout = Some(millis);
+            }
+            "--usage-file" if usage_path.is_none() && !value.is_empty() => {
+                usage_path = Some(PathBuf::from(value));
+            }
+            _ => return None,
+        }
+        index += 2;
+    }
+
+    Some(Config {
+        url: url?,
+        prompt: prompt?,
+        idle_timeout: Duration::from_millis(timeout?),
+        usage_path: usage_path?,
+    })
+}
+
+enum AttemptOutcome {
+    Retryable,
+    Failed,
+    Success(Success),
+}
+
+pub async fn execute(config: &Config) -> Result<Success, ()> {
+    let client = reqwest::Client::builder()
+        .no_proxy()
+        .redirect(reqwest::redirect::Policy::none())
+        .retry(reqwest::retry::never())
+        .build()
+        .map_err(|_| ())?;
+    let prompt_json = serde_json::to_string(&config.prompt).map_err(|_| ())?;
+    let body = format!("{{\"prompt\":{prompt_json}}}");
+
+    for attempt in 0..2 {
+        match run_attempt(&client, config, &body).await {
+            AttemptOutcome::Success(success) => return Ok(success),
+            AttemptOutcome::Failed => return Err(()),
+            AttemptOutcome::Retryable if attempt == 0 => {}
+            AttemptOutcome::Retryable => return Err(()),
+        }
+    }
+    Err(())
+}
+
+async fn run_attempt(client: &reqwest::Client, config: &Config, body: &str) -> AttemptOutcome {
+    let request = client
+        .post(config.url.clone())
+        .header(reqwest::header::CONTENT_TYPE, "application/json")
+        .header(reqwest::header::ACCEPT, "text/event-stream")
+        .body(body.to_owned());
+
+    let response = match time::timeout(config.idle_timeout, request.send()).await {
+        Err(_) => return AttemptOutcome::Retryable,
+        Ok(Err(error)) if is_malformed_http(&error) => return AttemptOutcome::Failed,
+        Ok(Err(_)) => return AttemptOutcome::Retryable,
+        Ok(Ok(response)) => response,
+    };
+
+    let status = response.status();
+    if (500..=599).contains(&status.as_u16()) {
+        return AttemptOutcome::Retryable;
+    }
+    if !status.is_success() {
+        return AttemptOutcome::Failed;
+    }
+
+    let mut response = response;
+    let mut parser = SseParser::default();
+    let mut deadline = Instant::now() + config.idle_timeout;
+    loop {
+        match time::timeout_at(deadline, response.chunk()).await {
+            Err(_) => return AttemptOutcome::Retryable,
+            Ok(Err(error)) if is_malformed_http(&error) => return AttemptOutcome::Failed,
+            Ok(Err(_)) => return AttemptOutcome::Retryable,
+            Ok(Ok(Some(bytes))) => {
+                let received_bytes = !bytes.is_empty();
+                if !parser.push(&bytes) {
+                    return AttemptOutcome::Failed;
+                }
+                if received_bytes {
+                    deadline = Instant::now() + config.idle_timeout;
+                }
+                if parser.done {
+                    return parser
+                        .usage
+                        .map(|usage| {
+                            AttemptOutcome::Success(Success {
+                                text: std::mem::take(&mut parser.text),
+                                usage,
+                            })
+                        })
+                        .unwrap_or(AttemptOutcome::Failed);
+                }
+            }
+            Ok(Ok(None)) => break,
+        }
+    }
+
+    if !parser.validate_eof() || !parser.done {
+        return AttemptOutcome::Failed;
+    }
+    parser
+        .usage
+        .map(|usage| {
+            AttemptOutcome::Success(Success {
+                text: parser.text,
+                usage,
+            })
+        })
+        .unwrap_or(AttemptOutcome::Failed)
+}
+
+#[derive(Default)]
+struct SseParser {
+    line: Vec<u8>,
+    data: Vec<String>,
+    saw_data: bool,
+    text: String,
+    usage: Option<Usage>,
+    done: bool,
+}
+
+impl SseParser {
+    fn push(&mut self, bytes: &[u8]) -> bool {
+        for &byte in bytes {
+            if byte == b'\n' {
+                if !self.finish_line() {
+                    return false;
+                }
+                if self.done {
+                    return true;
+                }
+            } else {
+                self.line.push(byte);
+            }
+        }
+        !matches!(
+            std::str::from_utf8(&self.line),
+            Err(error) if error.error_len().is_some()
+        )
+    }
+
+    fn finish_line(&mut self) -> bool {
+        if self.line.last() == Some(&b'\r') {
+            self.line.pop();
+        }
+        let bytes = std::mem::take(&mut self.line);
+        let Ok(line) = String::from_utf8(bytes) else {
+            return false;
+        };
+
+        if line.is_empty() {
+            return self.finish_event();
+        }
+        if line.starts_with(':') {
+            return true;
+        }
+        if let Some(value) = line.strip_prefix("data:") {
+            let value = value.strip_prefix(' ').unwrap_or(value);
+            self.saw_data = true;
+            self.data.push(value.to_owned());
+        }
+        true
+    }
+
+    fn finish_event(&mut self) -> bool {
+        if !self.saw_data {
+            self.data.clear();
+            return true;
+        }
+
+        let event_data = self.data.join("\n");
+        self.data.clear();
+        self.saw_data = false;
+        if event_data == "[DONE]" {
+            self.done = true;
+            return true;
+        }
+
+        let Ok(value) = serde_json::from_str::<Value>(&event_data) else {
+            return false;
+        };
+        let Some(object) = value.as_object() else {
+            return false;
+        };
+        match object.get("type").and_then(Value::as_str) {
+            Some("text") => {
+                let Some(text) = object.get("text").and_then(Value::as_str) else {
+                    return false;
+                };
+                self.text.push_str(text);
+            }
+            Some("usage") => {
+                let Some(input_tokens) = object
+                    .get("input_tokens")
+                    .and_then(Value::as_number)
+                    .and_then(safe_integer)
+                else {
+                    return false;
+                };
+                let Some(output_tokens) = object
+                    .get("output_tokens")
+                    .and_then(Value::as_number)
+                    .and_then(safe_integer)
+                else {
+                    return false;
+                };
+                self.usage = Some(Usage {
+                    input_tokens,
+                    output_tokens,
+                });
+            }
+            _ => {}
+        }
+        true
+    }
+
+    fn validate_eof(&self) -> bool {
+        std::str::from_utf8(&self.line).is_ok()
+    }
+}
+
+fn is_malformed_http(error: &reqwest::Error) -> bool {
+    let mut source = error.source();
+    while let Some(cause) = source {
+        if cause
+            .downcast_ref::<hyper::Error>()
+            .is_some_and(hyper::Error::is_parse)
+            || cause
+                .downcast_ref::<io::Error>()
+                .is_some_and(|cause| cause.kind() == io::ErrorKind::InvalidData)
+        {
+            return true;
+        }
+        source = cause.source();
+    }
+    false
+}
+
+fn safe_integer(number: &Number) -> Option<u64> {
+    let raw = number.to_string();
+    let (negative, raw) = raw
+        .strip_prefix('-')
+        .map_or((false, raw.as_str()), |rest| (true, rest));
+    let (mantissa, exponent) = match raw.find(['e', 'E']) {
+        Some(index) => (&raw[..index], &raw[index + 1..]),
+        None => (raw, "0"),
+    };
+    let (integer, fraction) = match mantissa.find('.') {
+        Some(index) => (&mantissa[..index], &mantissa[index + 1..]),
+        None => (mantissa, ""),
+    };
+    let mut digits = String::with_capacity(integer.len() + fraction.len());
+    digits.push_str(integer);
+    digits.push_str(fraction);
+    let significant_start = digits.bytes().position(|byte| byte != b'0');
+    let Some(significant_start) = significant_start else {
+        return Some(0);
+    };
+    if negative {
+        return None;
+    }
+    digits.drain(..significant_start);
+
+    let exponent = exponent.parse::<i128>().ok()?;
+    let fraction_len = i128::try_from(fraction.len()).ok()?;
+    let scale = exponent.checked_sub(fraction_len)?;
+    if scale < 0 {
+        let decimal_places = usize::try_from(scale.checked_neg()?).ok()?;
+        if decimal_places > digits.len()
+            || !digits[digits.len() - decimal_places..]
+                .bytes()
+                .all(|byte| byte == b'0')
+        {
+            return None;
+        }
+        digits.truncate(digits.len() - decimal_places);
+    } else {
+        let zeroes = usize::try_from(scale).ok()?;
+        if digits.len().checked_add(zeroes)? > 16 {
+            return None;
+        }
+        digits.extend(std::iter::repeat_n('0', zeroes));
+    }
+    if digits.len() > 16 {
+        return None;
+    }
+    let value = digits.parse::<u64>().ok()?;
+    (value <= MAX_USAGE_VALUE).then_some(value)
+}
