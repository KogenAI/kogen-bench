+            "--prompt",
+            "one",
+            "--prompt",
+            "two",
+            "--url",
+            "http://localhost/",
+            "--idle-timeout-ms",
+            "1",
+            "--usage-file",
+            "usage.json",
+        ]
+        .map(OsString::from);
+        assert!(parse_args(&duplicate).is_none());
+    }
