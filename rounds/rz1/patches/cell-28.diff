+const Store = struct {
+    allocator: std.mem.Allocator,
+    path: []const u8,
+    directory_fd: c_int,
+    lock_fd: c_int,
+    jobs: std.ArrayList(Job) = .empty,
+
+    fn deinit(self: *Store) void {
+        _ = flock(self.lock_fd, LOCK_UN);
+        _ = close(self.lock_fd);
+        _ = close(self.directory_fd);
+    }
+
+    fn dbPath(self: *Store) ![]u8 {
+        return std.fmt.allocPrint(self.allocator, "{s}/queue.bin", .{self.path});
+    }
+
+    fn load(self: *Store) StoreError!void {
+        const path = self.dbPath() catch return error.StoreFailure;
+        const path_z = self.allocator.dupeSentinel(u8, path, 0) catch return error.StoreFailure;
+        const fd = open(path_z.ptr, O_RDONLY | O_CLOEXEC, @as(c_uint, 0));
+        if (fd < 0) {
+            if (errno() == ENOENT) return;
+            return error.StoreFailure;
+        }
+        var file_open = true;
+        defer {
+            if (file_open) _ = close(fd);
+        }
+
+        var bytes: std.ArrayList(u8) = .empty;
+        var buffer: [16384]u8 = undefined;
+        while (true) {
+            const amount = read(fd, &buffer, buffer.len);
+            if (amount == 0) break;
+            if (amount < 0) {
+                if (errno() == EINTR) continue;
+                return error.StoreFailure;
+            }
+            bytes.appendSlice(self.allocator, buffer[0..@intCast(amount)]) catch return error.StoreFailure;
+        }
+        if (close(fd) != 0) return error.StoreFailure;
+        file_open = false;
+        self.decode(bytes.items) catch return error.StoreFailure;
+    }
+
+    fn decode(self: *Store, bytes: []const u8) !void {
+        const magic = "KOGEN01\n";
+        if (bytes.len < magic.len or !std.mem.eql(u8, bytes[0..magic.len], magic)) return error.InvalidStore;
+        var cursor = Cursor{ .bytes = bytes, .index = magic.len };
+        const count = try cursor.readU32();
+        if (count > (bytes.len - cursor.index) / 24) return error.InvalidStore;
+        try self.jobs.ensureTotalCapacity(self.allocator, count);
+        for (0..count) |_| {
+            const id_len = try cursor.readU8();
+            if (id_len == 0 or id_len > 64) return error.InvalidStore;
+            const id = try self.allocator.dupe(u8, try cursor.take(id_len));
+            if (!validId(id)) return error.InvalidStore;
+            for (self.jobs.items) |existing| {
+                if (std.mem.eql(u8, existing.id, id)) return error.InvalidStore;
+            }
+
+            const argc = try cursor.readU32();
+            if (argc == 0 or argc > bytes.len / 8 + 1) return error.InvalidStore;
+            const argv = try self.allocator.alloc([]u8, argc);
+            for (argv) |*arg| {
+                const len = try cursor.readU64();
+                if (len > std.math.maxInt(usize)) return error.InvalidStore;
+                arg.* = try self.allocator.dupe(u8, try cursor.take(@intCast(len)));
+                if (std.mem.indexOfScalar(u8, arg.*, 0) != null or !validUtf8(arg.*)) return error.InvalidStore;
+            }
+            if (argv[0].len == 0) return error.InvalidStore;
+            const attempt = try cursor.readU64();
+            const has_result = try cursor.readU8();
+            if (has_result > 1 or (has_result == 1 and attempt == 0)) return error.InvalidStore;
+            var result: ?Result = null;
+            if (has_result == 1) {
+                const exit_code: i32 = @bitCast(try cursor.readU32());
+                const out_len = try cursor.readU64();
+                if (out_len > std.math.maxInt(usize)) return error.InvalidStore;
+                const out = try self.allocator.dupe(u8, try cursor.take(@intCast(out_len)));
+                const err_len = try cursor.readU64();
+                if (err_len > std.math.maxInt(usize)) return error.InvalidStore;
+                const err_text = try self.allocator.dupe(u8, try cursor.take(@intCast(err_len)));
+                if (!validUtf8(out) or !validUtf8(err_text)) return error.InvalidStore;
+                result = .{ .exit_code = exit_code, .stdout = out, .stderr = err_text };
+            }
+            try self.jobs.append(self.allocator, .{ .id = id, .argv = argv, .attempt = attempt, .result = result });
+        }
+        if (cursor.index != bytes.len) return error.InvalidStore;
+    }
+
+    fn save(self: *Store) StoreError!void {
+        var bytes: std.ArrayList(u8) = .empty;
+        bytes.appendSlice(self.allocator, "KOGEN01\n") catch return error.StoreFailure;
+        if (self.jobs.items.len > std.math.maxInt(u32)) return error.StoreFailure;
