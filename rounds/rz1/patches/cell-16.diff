+/// Sum the already validated values and apply the requested scale.
+pub fn sum(values: []const i64, scale: u32) i64 {
+    var total: i64 = 0;
+    for (values) |value| total += value;
+    return total * @as(i64, scale);
+}
+
+/// Count the already validated states.
+pub fn count(states: []const State) Counts {
+    var result: Counts = .{};
+    for (states) |state| {
+        result.total += 1;
+        switch (state) {
+            .queued => result.queued += 1,
+            .running => result.running += 1,
+            .done => result.done += 1,
+            .failed => result.failed += 1,
+        }
+    }
+    return result;
 }
