+fn parse_args(args: &[String]) -> Option<Options> {
+    if args.first().map(String::as_str) != Some("model") {
+        return None;
+    }
+
+    let mut url = None;
+    let mut prompt = None;
+    let mut idle_timeout = None;
+    let mut usage_path = None;
+    let mut index = 1;
+    while index < args.len() {
+        let option = args[index].as_str();
+        index += 1;
+        if index >= args.len() {
+            return None;
+        }
+        let value = &args[index];
+        index += 1;
+        match option {
+            "--url" if url.is_none() => url = Some(parse_url(value)?),
+            "--prompt" if prompt.is_none() => prompt = Some(value.clone()),
+            "--idle-timeout-ms" if idle_timeout.is_none() => {
+                let millis = parse_timeout(value)?;
+                idle_timeout = Some(Duration::from_millis(millis));
+            }
+            "--usage-file" if usage_path.is_none() && !value.is_empty() => {
+                usage_path = Some(PathBuf::from(value));
+            }
+            _ => return None,
+        }
+    }
+
+    Some(Options {
+        url: url?,
+        prompt: prompt?,
+        idle_timeout: idle_timeout?,
+        usage_path: usage_path?,
+    })
+}
