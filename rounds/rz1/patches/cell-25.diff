+pub fn execute(args: &[String]) -> Result<String, (i32, String)> {
+    let options = parse_args(args).ok_or((2, "error: invalid arguments".to_owned()))?;
+    let request_body = encode_prompt(&options.prompt);
+
+    let mut response = None;
+    for attempt in 0..2 {
+        match request_once(&options.url, &request_body, options.idle_timeout) {
+            Ok(parsed) => {
+                response = Some(parsed);
+                break;
+            }
+            Err(Failure::Retryable) if attempt == 0 => continue,
+            Err(_) => return Err((5, "error: request failed".to_owned())),
+        }
+    }
+
+    let (text, usage) = response.ok_or((5, "error: request failed".to_owned()))?;
+    let usage_json = format!(
+        "{{\"input_tokens\":{},\"output_tokens\":{}}}\n",
+        usage.input_tokens, usage.output_tokens
+    );
+    replace_atomically(&options.usage_path, usage_json.as_bytes())
+        .map_err(|_| (5, "error: request failed".to_owned()))?;
+
+    let mut output = text;
+    output.push('\n');
+    Ok(output)
+}
