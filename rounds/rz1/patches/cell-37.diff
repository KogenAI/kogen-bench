-pub fn execute(_args: &[String]) -> Result<String, (i32, String)> {
-    Ok(String::new())
+use serde_json::Value;
+use std::fs::{self, OpenOptions};
+use std::io::{self, Read, Write};
+use std::net::{SocketAddr, TcpStream, ToSocketAddrs};
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::{Duration, Instant};
+use url::Url;
+
+const INVALID_ARGUMENTS: &str = "error: invalid arguments";
+const REQUEST_FAILED: &str = "error: request failed";
+const MAX_SAFE_INTEGER: &str = "9007199254740991";
+
+struct Options {
+    url: Url,
+    prompt: String,
+    idle_timeout: Duration,
+    usage_path: PathBuf,
+}
+
+struct Success {
+    text: String,
+    input_tokens: u64,
+    output_tokens: u64,
+}
+
+#[derive(Clone, Copy, Debug)]
+enum AttemptError {
+    Retryable,
+    Fatal,
+}
+
+#[derive(Clone, Copy)]
+enum Framing {
+    Length(u64),
+    Chunked,
+    UntilClose,
+}
+
+pub fn execute(args: &[String]) -> Result<String, (i32, String)> {
+    let options = parse_args(args).map_err(|_| (2, INVALID_ARGUMENTS.to_owned()))?;
+    let body = serde_json::to_vec(&serde_json::json!({ "prompt": options.prompt }))
+        .map_err(|_| (5, REQUEST_FAILED.to_owned()))?;
+
+    let result = match perform_attempt(&options, &body) {
+        Ok(success) => Ok(success),
+        Err(AttemptError::Retryable) => perform_attempt(&options, &body),
+        Err(AttemptError::Fatal) => Err(AttemptError::Fatal),
+    };
+
+    let success = result.map_err(|_| (5, REQUEST_FAILED.to_owned()))?;
+    let usage = format!(
+        "{{\"input_tokens\":{},\"output_tokens\":{}}}\n",
+        success.input_tokens, success.output_tokens
+    );
+    atomic_replace(&options.usage_path, usage.as_bytes())
+        .map_err(|_| (5, REQUEST_FAILED.to_owned()))?;
+
+    let mut output = success.text;
+    output.push('\n');
+    Ok(output)
+}
+
+fn parse_args(args: &[String]) -> Result<Options, ()> {
+    if args.first().map(String::as_str) != Some("model") {
+        return Err(());
+    }
+
+    let mut url_value: Option<&str> = None;
+    let mut prompt: Option<&str> = None;
+    let mut timeout: Option<&str> = None;
+    let mut usage_path: Option<&str> = None;
+    let mut index = 1;
+
+    while index < args.len() {
+        let name = args[index].as_str();
+        let value = args.get(index + 1).ok_or(())?.as_str();
+        let slot = match name {
+            "--url" => &mut url_value,
+            "--prompt" => &mut prompt,
+            "--idle-timeout-ms" => &mut timeout,
+            "--usage-file" => &mut usage_path,
+            _ => return Err(()),
+        };
+        if slot.replace(value).is_some() {
+            return Err(());
+        }
+        index += 2;
+    }
+
+    let raw_url = url_value.ok_or(())?;
+    let prompt = prompt.ok_or(())?;
+    let timeout = timeout.ok_or(())?;
+    let raw_path = usage_path.ok_or(())?;
+    if raw_path.is_empty()
+        || !raw_url
+            .get(..7)
+            .is_some_and(|prefix| prefix.eq_ignore_ascii_case("http://"))
+        || timeout.is_empty()
+        || !timeout.bytes().all(|byte| byte.is_ascii_digit())
+    {
+        return Err(());
+    }
+
+    let significant_timeout = timeout.trim_start_matches('0');
+    let timeout_ms: u64 = if significant_timeout.is_empty() {
+        0
+    } else if significant_timeout.len() > 5 {
+        return Err(());
+    } else {
+        significant_timeout.parse().map_err(|_| ())?
+    };
+    if !(1..=60_000).contains(&timeout_ms) {
+        return Err(());
+    }
+
+    let url = Url::parse(raw_url).map_err(|_| ())?;
+    if url.scheme() != "http" || url.host().is_none() {
+        return Err(());
+    }
+
+    Ok(Options {
+        url,
+        prompt: prompt.to_owned(),
+        idle_timeout: Duration::from_millis(timeout_ms),
+        usage_path: PathBuf::from(raw_path),
+    })
+}
+
+fn perform_attempt(options: &Options, body: &[u8]) -> Result<Success, AttemptError> {
+    let mut connection = connect(&options.url, options.idle_timeout)?;
+    let request = build_request(&options.url, body)?;
+    connection
+        .stream
+        .set_write_timeout(Some(options.idle_timeout))
+        .map_err(|_| AttemptError::Retryable)?;
+    connection
+        .stream
+        .write_all(&request)
+        .map_err(|_| AttemptError::Retryable)?;
+
+    let (status, framing) = connection.read_response_head(options.idle_timeout)?;
+    if (500..=599).contains(&status) {
+        return Err(AttemptError::Retryable);
+    }
+    if !(200..=299).contains(&status) {
+        return Err(AttemptError::Fatal);
+    }
+
+    let mut response_body = ResponseBody::new(connection, framing, options.idle_timeout);
+    parse_sse(&mut response_body)
+}
+
+fn connect(url: &Url, timeout: Duration) -> Result<Connection, AttemptError> {
+    let port = url.port_or_known_default().ok_or(AttemptError::Fatal)?;
+    let host = url.host().ok_or(AttemptError::Fatal)?.to_string();
+    let address = format!("{host}:{port}");
+    let addresses: Vec<SocketAddr> = address
+        .to_socket_addrs()
+        .map_err(|_| AttemptError::Retryable)?
+        .collect();
+    if addresses.is_empty() {
+        return Err(AttemptError::Retryable);
+    }
+
+    for address in addresses {
+        if let Ok(stream) = TcpStream::connect_timeout(&address, timeout) {
+            return Ok(Connection::new(stream));
+        }
+    }
+    Err(AttemptError::Retryable)
+}
+
+fn build_request(url: &Url, body: &[u8]) -> Result<Vec<u8>, AttemptError> {
+    let mut target = url.path().to_owned();
+    if target.is_empty() {
+        target.push('/');
+    }
+    if let Some(query) = url.query() {
+        target.push('?');
+        target.push_str(query);
+    }
+
+    let mut host = url.host().ok_or(AttemptError::Fatal)?.to_string();
+    if let Some(port) = url.port() {
+        host.push(':');
+        host.push_str(&port.to_string());
+    }
+
+    let mut request = format!(
+        "POST {target} HTTP/1.1\r\nHost: {host}\r\nContent-Type: application/json\r\nAccept: text/event-stream\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",
+        body.len()
+    )
+    .into_bytes();
+    request.extend_from_slice(body);
+    Ok(request)
+}
+
+struct Connection {
+    stream: TcpStream,
+    buffer: [u8; 8192],
+    offset: usize,
+    available: usize,
+}
+
+impl Connection {
+    fn new(stream: TcpStream) -> Self {
+        Self {
+            stream,
+            buffer: [0; 8192],
+            offset: 0,
+            available: 0,
+        }
+    }
+
+    fn raw_byte(&mut self, timeout: Duration) -> Result<Option<u8>, AttemptError> {
+        if self.offset == self.available {
+            self.offset = 0;
+            self.available = 0;
+            self.stream
+                .set_read_timeout(Some(timeout))
+                .map_err(|_| AttemptError::Retryable)?;
+            loop {
+                match self.stream.read(&mut self.buffer) {
+                    Ok(0) => return Ok(None),
+                    Ok(count) => {
+                        self.available = count;
+                        break;
+                    }
+                    Err(error) if error.kind() == io::ErrorKind::Interrupted => continue,
+                    Err(_) => return Err(AttemptError::Retryable),
+                }
+            }
+        }
+        let byte = self.buffer[self.offset];
+        self.offset += 1;
+        Ok(Some(byte))
+    }
+
+    fn read_response_head(&mut self, timeout: Duration) -> Result<(u16, Framing), AttemptError> {
+        let deadline = Instant::now() + timeout;
+        let mut bytes = Vec::new();
+        loop {
+            let remaining = deadline.saturating_duration_since(Instant::now());
+            if remaining.is_zero() {
+                return Err(AttemptError::Retryable);
+            }
+            let byte = self.raw_byte(remaining)?.ok_or(AttemptError::Retryable)?;
+            bytes.push(byte);
+            if bytes.ends_with(b"\r\n\r\n") {
+                return parse_response_head(&bytes);
+            }
+        }
+    }
+}
+
+fn parse_response_head(bytes: &[u8]) -> Result<(u16, Framing), AttemptError> {
+    let header_bytes = bytes.strip_suffix(b"\r\n\r\n").ok_or(AttemptError::Fatal)?;
+    let header_text = std::str::from_utf8(header_bytes).map_err(|_| AttemptError::Fatal)?;
+    let mut lines = header_text.split("\r\n");
+    let status_line = lines.next().ok_or(AttemptError::Fatal)?;
+    let (version, status_and_reason) = status_line.split_once(' ').ok_or(AttemptError::Fatal)?;
+    if version != "HTTP/1.0" && version != "HTTP/1.1" {
+        return Err(AttemptError::Fatal);
+    }
+    let status_text = status_and_reason.get(..3).ok_or(AttemptError::Fatal)?;
+    if !status_text.bytes().all(|byte| byte.is_ascii_digit())
+        || (status_and_reason.len() > 3 && !status_and_reason[3..].starts_with(' '))
+        || !valid_field_bytes(&status_and_reason[3..])
+    {
+        return Err(AttemptError::Fatal);
+    }
+    let status = status_text
+        .parse::<u16>()
+        .map_err(|_| AttemptError::Fatal)?;
+    if !(100..=999).contains(&status) {
+        return Err(AttemptError::Fatal);
+    }
+
+    let mut content_length: Option<u64> = None;
+    let mut transfer_encoding: Option<String> = None;
+    for line in lines {
+        let (name, value) = line.split_once(':').ok_or(AttemptError::Fatal)?;
+        if name.is_empty() || !name.bytes().all(is_token_byte) || !valid_field_bytes(value) {
+            return Err(AttemptError::Fatal);
+        }
+        let value = value.trim_matches([' ', '\t']);
+        if name.eq_ignore_ascii_case("content-length") {
+            if value.is_empty() || !value.bytes().all(|byte| byte.is_ascii_digit()) {
+                return Err(AttemptError::Fatal);
+            }
+            let parsed = value.parse::<u64>().map_err(|_| AttemptError::Fatal)?;
+            if content_length
+                .replace(parsed)
+                .is_some_and(|old| old != parsed)
+            {
+                return Err(AttemptError::Fatal);
+            }
+        } else if name.eq_ignore_ascii_case("transfer-encoding") {
+            if transfer_encoding.is_some() {
+                return Err(AttemptError::Fatal);
+            }
+            transfer_encoding = Some(value.to_ascii_lowercase());
+        }
+    }
+
+    if content_length.is_some() && transfer_encoding.is_some() {
+        return Err(AttemptError::Fatal);
+    }
+    let framing = if (100..200).contains(&status) || status == 204 || status == 304 {
+        Framing::Length(0)
+    } else if let Some(encoding) = transfer_encoding {
+        if encoding != "chunked" {
+            return Err(AttemptError::Fatal);
+        }
+        Framing::Chunked
+    } else if let Some(length) = content_length {
+        Framing::Length(length)
+    } else {
+        Framing::UntilClose
+    };
+    Ok((status, framing))
+}
+
+fn valid_field_bytes(value: &str) -> bool {
+    value
+        .bytes()
+        .all(|byte| byte == b'\t' || (byte >= b' ' && byte != 0x7f))
+}
+
+fn is_token_byte(byte: u8) -> bool {
+    byte.is_ascii_alphanumeric()
+        || matches!(
+            byte,
+            b'!' | b'#'
+                | b'$'
+                | b'%'
+                | b'&'
+                | b'\''
+                | b'*'
+                | b'+'
+                | b'-'
+                | b'.'
+                | b'^'
+                | b'_'
+                | b'`'
+                | b'|'
+                | b'~'
+        )
+}
+
+struct ResponseBody {
+    connection: Connection,
+    framing: Framing,
+    timeout: Duration,
+    remaining: u64,
+    chunk_remaining: u64,
+    chunk_ending_pending: bool,
+    finished: bool,
+}
+
+impl ResponseBody {
+    fn new(connection: Connection, framing: Framing, timeout: Duration) -> Self {
+        let remaining = match framing {
+            Framing::Length(length) => length,
+            Framing::Chunked | Framing::UntilClose => 0,
+        };
+        Self {
+            connection,
+            framing,
+            timeout,
+            remaining,
+            chunk_remaining: 0,
+            chunk_ending_pending: false,
+            finished: false,
+        }
+    }
+
+    fn next_byte(&mut self) -> Result<Option<u8>, AttemptError> {
+        if self.finished {
+            return Ok(None);
+        }
+        match self.framing {
+            Framing::Length(_) => {
+                if self.remaining == 0 {
+                    self.finished = true;
+                    return Ok(None);
+                }
+                let byte = self
+                    .connection
+                    .raw_byte(self.timeout)?
+                    .ok_or(AttemptError::Retryable)?;
+                self.remaining -= 1;
+                Ok(Some(byte))
+            }
+            Framing::UntilClose => match self.connection.raw_byte(self.timeout)? {
+                Some(byte) => Ok(Some(byte)),
+                None => {
+                    self.finished = true;
+                    Ok(None)
+                }
+            },
+            Framing::Chunked => self.next_chunked_byte(),
+        }
+    }
+
+    fn next_chunked_byte(&mut self) -> Result<Option<u8>, AttemptError> {
+        loop {
+            if self.chunk_remaining > 0 {
+                let byte = self
+                    .connection
+                    .raw_byte(self.timeout)?
+                    .ok_or(AttemptError::Retryable)?;
+                self.chunk_remaining -= 1;
+                if self.chunk_remaining == 0 {
+                    self.chunk_ending_pending = true;
+                }
+                return Ok(Some(byte));
+            }
+
+            if self.chunk_ending_pending {
+                self.expect_crlf()?;
+                self.chunk_ending_pending = false;
+            }
+
+            let size_line = self.read_crlf_line()?;
+            let size = parse_chunk_line(&size_line)?;
+            if size == 0 {
+                loop {
+                    if self.read_crlf_line()?.is_empty() {
+                        self.finished = true;
+                        return Ok(None);
+                    }
+                }
+            }
+            self.chunk_remaining = size;
+        }
+    }
+
+    fn expect_crlf(&mut self) -> Result<(), AttemptError> {
+        if self.connection.raw_byte(self.timeout)? != Some(b'\r')
+            || self.connection.raw_byte(self.timeout)? != Some(b'\n')
+        {
+            return Err(AttemptError::Fatal);
+        }
+        Ok(())
+    }
+
+    fn read_crlf_line(&mut self) -> Result<Vec<u8>, AttemptError> {
+        let mut line = Vec::new();
+        loop {
+            let byte = self
+                .connection
+                .raw_byte(self.timeout)?
+                .ok_or(AttemptError::Retryable)?;
+            if byte == b'\r' {
+                if self.connection.raw_byte(self.timeout)? != Some(b'\n') {
+                    return Err(AttemptError::Fatal);
+                }
+                return Ok(line);
+            }
+            if byte == b'\n' {
+                return Err(AttemptError::Fatal);
+            }
+            line.push(byte);
+        }
+    }
+}
+
+fn parse_chunk_line(line: &[u8]) -> Result<u64, AttemptError> {
+    let semicolon = line.iter().position(|byte| *byte == b';');
+    let size_end = if let Some(semicolon) = semicolon {
+        let mut size_end = semicolon;
+        while size_end > 0 && matches!(line[size_end - 1], b' ' | b'\t') {
+            size_end -= 1;
+        }
+        validate_chunk_extensions(line, semicolon)?;
+        size_end
+    } else {
+        line.len()
+    };
+    let size_text = &line[..size_end];
+    if size_text.is_empty() || !size_text.iter().all(u8::is_ascii_hexdigit) {
+        return Err(AttemptError::Fatal);
+    }
+    let size_text = std::str::from_utf8(size_text).map_err(|_| AttemptError::Fatal)?;
+    u64::from_str_radix(size_text, 16).map_err(|_| AttemptError::Fatal)
+}
+
+fn validate_chunk_extensions(line: &[u8], mut index: usize) -> Result<(), AttemptError> {
+    while index < line.len() {
+        while index < line.len() && matches!(line[index], b' ' | b'\t') {
+            index += 1;
+        }
+        if index == line.len() || line[index] != b';' {
+            return Err(AttemptError::Fatal);
+        }
+        index += 1;
+        while index < line.len() && matches!(line[index], b' ' | b'\t') {
+            index += 1;
+        }
+
+        let name_start = index;
+        while index < line.len() && is_token_byte(line[index]) {
+            index += 1;
+        }
+        if index == name_start {
+            return Err(AttemptError::Fatal);
+        }
+        let before_optional_value = index;
+        while index < line.len() && matches!(line[index], b' ' | b'\t') {
+            index += 1;
+        }
+        if index == line.len() {
+            return if index == before_optional_value {
+                Ok(())
+            } else {
+                Err(AttemptError::Fatal)
+            };
+        }
+
+        if index < line.len() && line[index] == b'=' {
+            index += 1;
+            while index < line.len() && matches!(line[index], b' ' | b'\t') {
+                index += 1;
+            }
+            if index < line.len() && line[index] == b'"' {
+                index += 1;
+                let mut closed = false;
+                while index < line.len() {
+                    match line[index] {
+                        b'"' => {
+                            index += 1;
+                            closed = true;
+                            break;
+                        }
+                        b'\\' => {
+                            index += 1;
+                            if index == line.len() || !valid_quoted_pair_byte(line[index]) {
+                                return Err(AttemptError::Fatal);
+                            }
+                            index += 1;
+                        }
+                        byte if valid_quoted_byte(byte) && byte != b'"' => index += 1,
+                        _ => return Err(AttemptError::Fatal),
+                    }
+                }
+                if !closed {
+                    return Err(AttemptError::Fatal);
+                }
+            } else {
+                let value_start = index;
+                while index < line.len() && is_token_byte(line[index]) {
+                    index += 1;
+                }
+                if index == value_start {
+                    return Err(AttemptError::Fatal);
+                }
+            }
+        }
+        let before_next_extension = index;
+        while index < line.len() && matches!(line[index], b' ' | b'\t') {
+            index += 1;
+        }
+        if index == line.len() {
+            return if index == before_next_extension {
+                Ok(())
+            } else {
+                Err(AttemptError::Fatal)
+            };
+        }
+    }
+    Ok(())
+}
+
+fn valid_quoted_byte(byte: u8) -> bool {
+    byte == b'\t' || (byte >= b' ' && byte != b'"' && byte != b'\\' && byte != 0x7f)
+}
+
+fn valid_quoted_pair_byte(byte: u8) -> bool {
+    byte == b'\t' || (byte >= b' ' && byte != 0x7f)
+}
+
+fn parse_sse(body: &mut ResponseBody) -> Result<Success, AttemptError> {
+    let mut parser = SseParser::default();
+    while let Some(byte) = body.next_byte()? {
+        if parser.push(byte)? {
+            return parser.finish();
+        }
+    }
+    std::str::from_utf8(&parser.line).map_err(|_| AttemptError::Fatal)?;
+    parser.finish()
+}
+
+#[derive(Default)]
+struct SseParser {
+    line: Vec<u8>,
+    data: Vec<String>,
+    text: String,
+    usage: Option<(u64, u64)>,
+    done: bool,
+}
+
+impl SseParser {
+    fn push(&mut self, byte: u8) -> Result<bool, AttemptError> {
+        if byte != b'\n' {
+            self.line.push(byte);
+            return Ok(false);
+        }
+
+        if self.line.last() == Some(&b'\r') {
+            self.line.pop();
+        }
+        let line = std::str::from_utf8(&self.line)
+            .map_err(|_| AttemptError::Fatal)?
+            .to_owned();
+        self.process_line(&line)?;
+        self.line.clear();
+        Ok(self.done)
+    }
+
+    fn process_line(&mut self, line: &str) -> Result<(), AttemptError> {
+        if line.is_empty() {
+            return self.end_record();
+        }
+        if line.starts_with(':') {
+            return Ok(());
+        }
+        if let Some(value) = line.strip_prefix("data:") {
+            self.data
+                .push(value.strip_prefix(' ').unwrap_or(value).to_owned());
+        }
+        Ok(())
+    }
+
+    fn end_record(&mut self) -> Result<(), AttemptError> {
+        if !self.data.is_empty() {
+            let data = self.data.join("\n");
+            if data == "[DONE]" {
+                self.done = true;
+            } else {
+                let value: Value = serde_json::from_str(&data).map_err(|_| AttemptError::Fatal)?;
+                let object = value.as_object().ok_or(AttemptError::Fatal)?;
+                match object.get("type").and_then(Value::as_str) {
+                    Some("text") => {
+                        let text = object
+                            .get("text")
+                            .and_then(Value::as_str)
+                            .ok_or(AttemptError::Fatal)?;
+                        self.text.push_str(text);
+                    }
+                    Some("usage") => {
+                        let input = object
+                            .get("input_tokens")
+                            .and_then(safe_integer)
+                            .ok_or(AttemptError::Fatal)?;
+                        let output = object
+                            .get("output_tokens")
+                            .and_then(safe_integer)
+                            .ok_or(AttemptError::Fatal)?;
+                        self.usage = Some((input, output));
+                    }
+                    _ => {}
+                }
+            }
+        }
+        self.data.clear();
+        Ok(())
+    }
+
+    fn finish(self) -> Result<Success, AttemptError> {
+        if !self.done {
+            return Err(AttemptError::Fatal);
+        }
+        let (input_tokens, output_tokens) = self.usage.ok_or(AttemptError::Fatal)?;
+        Ok(Success {
+            text: self.text,
+            input_tokens,
+            output_tokens,
+        })
+    }
+}
+
+fn safe_integer(value: &Value) -> Option<u64> {
+    let raw = value.as_number()?.to_string();
+    parse_safe_integer(&raw)
+}
+
+fn parse_safe_integer(raw: &str) -> Option<u64> {
+    let (negative, unsigned) = match raw.strip_prefix('-') {
+        Some(rest) => (true, rest),
+        None => (false, raw),
+    };
+    let exponent_index = unsigned.find(['e', 'E']).unwrap_or(unsigned.len());
+    let mantissa = &unsigned[..exponent_index];
+    let exponent = unsigned
+        .get(exponent_index + usize::from(exponent_index < unsigned.len())..)
+        .unwrap_or("");
+    let exponent = if exponent.is_empty() {
+        0
+    } else {
+        parse_saturated_exponent(exponent)
+    };
+
+    let dot_index = mantissa.find('.').unwrap_or(mantissa.len());
+    let fraction_length = mantissa
+        .len()
+        .saturating_sub(dot_index + usize::from(dot_index < mantissa.len()));
+    let mut coefficient = String::with_capacity(mantissa.len());
+    coefficient.push_str(&mantissa[..dot_index]);
+    if dot_index < mantissa.len() {
+        coefficient.push_str(&mantissa[dot_index + 1..]);
+    }
+    let coefficient = coefficient.trim_start_matches('0');
+    if coefficient.is_empty() {
+        return Some(0);
+    }
+    if negative {
+        return None;
+    }
+
+    let scale = exponent.saturating_sub(i128::try_from(fraction_length).ok()?);
+    let integer_digits = if scale >= 0 {
+        let scale = usize::try_from(scale).ok()?;
+        if coefficient.len().saturating_add(scale) > MAX_SAFE_INTEGER.len() {
+            return None;
+        }
+        let mut digits = coefficient.to_owned();
+        digits.extend(std::iter::repeat_n('0', scale));
+        digits
+    } else {
+        let remove = usize::try_from(scale.saturating_neg()).ok()?;
+        if remove > coefficient.len()
+            || !coefficient[coefficient.len() - remove..]
+                .bytes()
+                .all(|byte| byte == b'0')
+        {
+            return None;
+        }
+        coefficient[..coefficient.len() - remove].to_owned()
+    };
+
+    if integer_digits.is_empty()
+        || integer_digits.len() > MAX_SAFE_INTEGER.len()
+        || (integer_digits.len() == MAX_SAFE_INTEGER.len()
+            && integer_digits.as_str() > MAX_SAFE_INTEGER)
+    {
+        return None;
+    }
+    integer_digits.parse().ok()
+}
+
+fn parse_saturated_exponent(raw: &str) -> i128 {
+    let (negative, digits) = match raw.strip_prefix('-') {
+        Some(rest) => (true, rest),
+        None => (false, raw.strip_prefix('+').unwrap_or(raw)),
+    };
+    let limit = i128::MAX / 4;
+    let magnitude = digits.bytes().fold(0_i128, |value, byte| {
+        value
+            .saturating_mul(10)
+            .saturating_add(i128::from(byte - b'0'))
+            .min(limit)
+    });
+    if negative { -magnitude } else { magnitude }
+}
+
+fn atomic_replace(path: &Path, contents: &[u8]) -> io::Result<()> {
+    static NEXT_TEMP_ID: AtomicU64 = AtomicU64::new(0);
+
+    let parent = path
+        .parent()
+        .filter(|parent| !parent.as_os_str().is_empty())
+        .unwrap_or_else(|| Path::new("."));
+    let file_name = path.file_name().ok_or_else(|| {
+        io::Error::new(io::ErrorKind::InvalidInput, "usage path has no file name")
+    })?;
+    fs::create_dir_all(parent)?;
+
+    for _ in 0..100 {
+        let serial = NEXT_TEMP_ID.fetch_add(1, Ordering::Relaxed);
+        let mut temp_name = std::ffi::OsString::from(".");
+        temp_name.push(file_name);
+        temp_name.push(format!(".kogen.{}.{}.tmp", std::process::id(), serial));
+        let temp_path = parent.join(temp_name);
+        let mut file = match OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(&temp_path)
+        {
+            Ok(file) => file,
+            Err(error) if error.kind() == io::ErrorKind::AlreadyExists => continue,
+            Err(error) => return Err(error),
+        };
+
+        let write_result = file.write_all(contents).and_then(|()| file.sync_all());
+        drop(file);
+        if let Err(error) = write_result {
+            let _ = fs::remove_file(&temp_path);
+            return Err(error);
+        }
+        if let Err(error) = fs::rename(&temp_path, path) {
+            let _ = fs::remove_file(&temp_path);
+            return Err(error);
+        }
+        return Ok(());
+    }
+
+    Err(io::Error::new(
+        io::ErrorKind::AlreadyExists,
+        "unable to create a temporary usage file",
+    ))
 }
