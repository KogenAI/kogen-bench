diff --git a/src/core.rs b/src/core.rs
index b4e3d0f..7d6c6e6 100644
--- a/src/core.rs
+++ b/src/core.rs
@@ -1,3 +1,245 @@
-pub fn execute(_args: &[String]) -> Result<String, (i32, String)> {
-    Ok(String::new())
+use serde::{Deserialize, Serialize};
+use std::collections::{HashMap, HashSet};
+use std::ffi::{OsStr, OsString};
+use std::fs::{self, OpenOptions};
+use std::io::Write;
+
+#[derive(Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct Event {
+    id: String,
+    #[serde(rename = "type")]
+    event_type: String,
+    job: String,
+    ts: u64,
+}
+
+#[derive(Debug)]
+struct LoggedEvent {
+    event: Event,
+    line: usize,
+}
+
+#[derive(Debug)]
+struct EventError {
+    message: String,
+}
+
+fn invalid_event(line: usize) -> EventError {
+    EventError {
+        message: format!("eventlog:{line}: invalid event"),
+    }
+}
+
+fn valid_id(id: &str) -> bool {
+    let Some(suffix) = id.strip_prefix("e-") else {
+        return false;
+    };
+    (1..=16).contains(&suffix.len())
+        && suffix
+            .bytes()
+            .all(|byte| byte.is_ascii_lowercase() || byte.is_ascii_digit())
+}
+
+fn valid_job(job: &str) -> bool {
+    let bytes = job.as_bytes();
+    (1..=32).contains(&bytes.len())
+        && bytes[0].is_ascii_lowercase()
+        && bytes
+            .iter()
+            .all(|byte| byte.is_ascii_lowercase() || byte.is_ascii_digit() || *byte == b'-')
+}
+
+fn parse_event(bytes: &[u8], line: usize) -> Result<Event, EventError> {
+    let event: Event = serde_json::from_slice(bytes).map_err(|_| invalid_event(line))?;
+    if !valid_id(&event.id) || !valid_job(&event.job) || event.ts > i64::MAX as u64 {
+        return Err(invalid_event(line));
+    }
+    if !matches!(
+        event.event_type.as_str(),
+        "created" | "started" | "completed" | "failed"
+    ) {
+        return Err(EventError {
+            message: format!("eventlog:{line}: unknown event type '{}'", event.event_type),
+        });
+    }
+    Ok(event)
+}
+
+fn parse_complete_lines(
+    bytes: &[u8],
+) -> Result<(Vec<LoggedEvent>, HashSet<String>, usize), EventError> {
+    let mut events = Vec::new();
+    let mut ids = HashSet::new();
+    let mut line_number = 1usize;
+    let mut start = 0usize;
+
+    for (index, byte) in bytes.iter().enumerate() {
+        if *byte != b'\n' {
+            continue;
+        }
+        let event = parse_event(&bytes[start..index], line_number)?;
+        if !ids.insert(event.id.clone()) {
+            return Err(EventError {
+                message: format!("eventlog:{line_number}: duplicate event id '{}'", event.id),
+            });
+        }
+        events.push(LoggedEvent {
+            event,
+            line: line_number,
+        });
+        line_number += 1;
+        start = index + 1;
+    }
+
+    Ok((events, ids, start))
+}
+
+fn read_log(path: &OsStr) -> Result<Vec<u8>, String> {
+    match fs::read(path) {
+        Ok(bytes) => Ok(bytes),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(Vec::new()),
+        Err(_) => Err("eventlog: cannot access log".to_owned()),
+    }
+}
+
+fn check_transitions(events: &[LoggedEvent]) -> Result<HashMap<String, String>, EventError> {
+    let mut by_job: HashMap<&str, Vec<&LoggedEvent>> = HashMap::new();
+    for logged in events {
+        by_job
+            .entry(logged.event.job.as_str())
+            .or_default()
+            .push(logged);
+    }
+
+    let mut first_error: Option<(u64, usize, String)> = None;
+    let mut final_states = HashMap::new();
+
+    for (job, mut job_events) in by_job {
+        job_events.sort_by_key(|logged| (logged.event.ts, logged.line));
+        let mut state: Option<&str> = None;
+        let mut prior_ts: Option<u64> = None;
+        let mut job_error: Option<(u64, usize)> = None;
+
+        for logged in &job_events {
+            let event = &logged.event;
+            let timestamp_tie = prior_ts == Some(event.ts);
+            let transition_valid = match state {
+                None => event.event_type == "created",
+                Some("created") => event.event_type == "started",
+                Some("started") => event.event_type == "completed" || event.event_type == "failed",
+                Some("completed") | Some("failed") => false,
+                Some(_) => false,
+            };
+
+            if timestamp_tie || !transition_valid {
+                job_error = Some((event.ts, logged.line));
+                break;
+            }
+
+            state = Some(event.event_type.as_str());
+            prior_ts = Some(event.ts);
+        }
+
+        if let Some((timestamp, line)) = job_error {
+            let replace = first_error
+                .as_ref()
+                .is_none_or(|(first_ts, first_line, _)| {
+                    (timestamp, line) < (*first_ts, *first_line)
+                });
+            if replace {
+                first_error = Some((timestamp, line, job.to_owned()));
+            }
+        } else if let Some(state) = state {
+            final_states.insert(job.to_owned(), state.to_owned());
+        }
+    }
+
+    if let Some((_, line, job)) = first_error {
+        return Err(EventError {
+            message: format!("eventlog:{line}: invalid transition for job '{job}'"),
+        });
+    }
+    Ok(final_states)
+}
+
+fn usage_error() -> (i32, String) {
+    (2, "eventlog: usage error".to_owned())
+}
+
+fn event_error(error: EventError) -> (i32, String) {
+    (1, error.message)
+}
+
+fn append(path: &OsStr, json: &OsStr) -> Result<String, (i32, String)> {
+    let Some(json) = json.to_str() else {
+        return Err(event_error(invalid_event(1)));
+    };
+    let event = parse_event(json.as_bytes(), 1).map_err(event_error)?;
+    let id = event.id.clone();
+    let existing = read_log(path).map_err(|message| (1, message))?;
+    let (_, ids, parsed_bytes) = parse_complete_lines(&existing).map_err(event_error)?;
+
+    if parsed_bytes != existing.len() {
+        let fragment_line = existing.iter().filter(|byte| **byte == b'\n').count() + 1;
+        return Err(event_error(invalid_event(fragment_line)));
+    }
+    if ids.contains(&event.id) {
+        return Err(event_error(EventError {
+            message: format!("eventlog:1: duplicate event id '{}'", event.id),
+        }));
+    }
+
+    let compact =
+        serde_json::to_vec(&event).map_err(|_| (1, "eventlog: cannot access log".to_owned()))?;
+    let mut file = OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(path)
+        .map_err(|_| (1, "eventlog: cannot access log".to_owned()))?;
+    file.write_all(&compact)
+        .and_then(|()| file.write_all(b"\n"))
+        .map_err(|_| (1, "eventlog: cannot access log".to_owned()))?;
+
+    Ok(format!("appended {id}\n"))
+}
+
+fn reconcile(path: &OsStr) -> Result<String, (i32, String)> {
+    let bytes = read_log(path).map_err(|message| (1, message))?;
+    let (events, _, _) = parse_complete_lines(&bytes).map_err(event_error)?;
+    let final_states = check_transitions(&events).map_err(event_error)?;
+
+    let mut queued = 0usize;
+    let mut running = 0usize;
+    let mut done = 0usize;
+    let mut failed = 0usize;
+    for state in final_states.values() {
+        match state.as_str() {
+            "created" => queued += 1,
+            "started" => running += 1,
+            "completed" => done += 1,
+            "failed" => failed += 1,
+            _ => unreachable!(),
+        }
+    }
+    let total = final_states.len();
+    Ok(format!(
+        "total={total}\nqueued={queued}\nrunning={running}\ndone={done}\nfailed={failed}\n"
+    ))
+}
+
+pub fn execute(args: &[OsString]) -> Result<String, (i32, String)> {
+    match args.first().and_then(|arg| arg.to_str()) {
+        Some("append")
+            if args.len() == 5
+                && args[1].to_str() == Some("--log")
+                && args[3].to_str() == Some("--event") =>
+        {
+            append(&args[2], &args[4])
+        }
+        Some("reconcile") if args.len() == 3 && args[1].to_str() == Some("--log") => {
+            reconcile(&args[2])
+        }
+        _ => Err(usage_error()),
+    }
 }
