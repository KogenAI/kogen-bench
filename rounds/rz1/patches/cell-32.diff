+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum JobState {
+    Queued,
+    Running,
+    Done,
+    Failed,
+}
+
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub struct StateCounts {
+    pub total: usize,
+    pub queued: usize,
+    pub running: usize,
+    pub done: usize,
+    pub failed: usize,
+}
+
+pub fn sum(values: &[i64], scale: u32) -> i64 {
+    values.iter().sum::<i64>() * i64::from(scale)
+}
+
+pub fn count_states(states: &[JobState]) -> StateCounts {
+    let mut counts = StateCounts {
+        total: states.len(),
+        ..StateCounts::default()
+    };
+
+    for state in states {
+        match state {
+            JobState::Queued => counts.queued += 1,
+            JobState::Running => counts.running += 1,
+            JobState::Done => counts.done += 1,
+            JobState::Failed => counts.failed += 1,
+        }
+    }
+
+    counts
 }
