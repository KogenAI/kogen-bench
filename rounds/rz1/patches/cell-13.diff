diff --git a/src/core.zig b/src/core.zig
index 54871b5..b977c8f 100644
--- a/src/core.zig
+++ b/src/core.zig
@@ -6,10 +6,314 @@ pub const Response = struct {
     exit_code: u8 = 0,
 };
 
+const EventKind = enum {
+    created,
+    started,
+    completed,
+    failed,
+
+    fn text(self: EventKind) []const u8 {
+        return switch (self) {
+            .created => "created",
+            .started => "started",
+            .completed => "completed",
+            .failed => "failed",
+        };
+    }
+};
+
+const Event = struct {
+    id: []const u8,
+    kind: EventKind,
+    job: []const u8,
+    ts: u64,
+    line: usize,
+};
+
+const ParseEventResult = union(enum) {
+    event: Event,
+    invalid,
+    unknown_type: []const u8,
+};
+
+const LogResult = struct {
+    events: []Event = &.{},
+    failure: ?[]const u8 = null,
+};
+
+const JobState = enum { queued, running, done, failed };
+
+const JobInfo = struct {
+    state: JobState,
+    last_ts: u64,
+};
+
+const SerializedEvent = struct {
+    id: []const u8,
+    type: []const u8,
+    job: []const u8,
+    ts: u64,
+};
+
 pub fn execute(
-    _: std.mem.Allocator,
-    _: std.Io,
-    _: []const [:0]const u8,
+    allocator: std.mem.Allocator,
+    io: std.Io,
+    args: []const [:0]const u8,
+) !Response {
+    if (args.len == 5 and
+        std.mem.eql(u8, args[0], "append") and
+        std.mem.eql(u8, args[1], "--log") and
+        std.mem.eql(u8, args[3], "--event"))
+    {
+        return appendCommand(allocator, io, args[2], args[4]);
+    }
+
+    if (args.len == 3 and
+        std.mem.eql(u8, args[0], "reconcile") and
+        std.mem.eql(u8, args[1], "--log"))
+    {
+        return reconcileCommand(allocator, io, args[2]);
+    }
+
+    return .{ .stderr = "eventlog: usage error", .exit_code = 2 };
+}
+
+fn appendCommand(
+    allocator: std.mem.Allocator,
+    io: std.Io,
+    path: []const u8,
+    json: []const u8,
 ) !Response {
-    return .{};
+    const supplied = parseEvent(allocator, json, 1);
+    const event = switch (supplied) {
+        .event => |value| value,
+        .invalid => return .{ .stderr = try invalidMessage(allocator, 1), .exit_code = 1 },
+        .unknown_type => |value| return .{ .stderr = try unknownTypeMessage(allocator, 1, value), .exit_code = 1 },
+    };
+
+    const existing = std.Io.Dir.cwd().readFileAlloc(io, path, allocator, .unlimited) catch |err| switch (err) {
+        error.FileNotFound => try allocator.dupe(u8, ""),
+        else => return cannotAccess(),
+    };
+
+    const parsed_log = try parseLog(allocator, existing, false);
+    if (parsed_log.failure) |message| return .{ .stderr = message, .exit_code = 1 };
+
+    for (parsed_log.events) |old_event| {
+        if (std.mem.eql(u8, event.id, old_event.id)) {
+            return .{ .stderr = try duplicateIdMessage(allocator, 1, event.id), .exit_code = 1 };
+        }
+    }
+
+    const compact = try std.json.Stringify.valueAlloc(allocator, SerializedEvent{
+        .id = event.id,
+        .type = event.kind.text(),
+        .job = event.job,
+        .ts = event.ts,
+    }, .{});
+
+    var file = std.Io.Dir.cwd().createFile(io, path, .{ .truncate = false }) catch {
+        return cannotAccess();
+    };
+    defer file.close(io);
+
+    var write_buffer: [1024]u8 = undefined;
+    var writer = file.writer(io, &write_buffer);
+    writer.seekTo(@intCast(existing.len)) catch return cannotAccess();
+    writer.interface.writeAll(compact) catch return cannotAccess();
+    writer.interface.writeAll("\n") catch return cannotAccess();
+    writer.interface.flush() catch return cannotAccess();
+
+    return .{
+        .stdout = try std.fmt.allocPrint(allocator, "appended {s}\n", .{event.id}),
+    };
+}
+
+fn reconcileCommand(
+    allocator: std.mem.Allocator,
+    io: std.Io,
+    path: []const u8,
+) !Response {
+    const bytes = std.Io.Dir.cwd().readFileAlloc(io, path, allocator, .unlimited) catch |err| switch (err) {
+        error.FileNotFound => try allocator.dupe(u8, ""),
+        else => return cannotAccess(),
+    };
+
+    const parsed_log = try parseLog(allocator, bytes, true);
+    if (parsed_log.failure) |message| return .{ .stderr = message, .exit_code = 1 };
+
+    const events = parsed_log.events;
+    std.mem.sort(Event, events, {}, eventLessThan);
+
+    var jobs = std.StringHashMap(JobInfo).init(allocator);
+    defer jobs.deinit();
+
+    for (events) |event| {
+        if (jobs.getPtr(event.job)) |info| {
+            if (info.last_ts == event.ts) {
+                return .{ .stderr = try transitionMessage(allocator, event.line, event.job), .exit_code = 1 };
+            }
+
+            const next_state: ?JobState = switch (event.kind) {
+                .created => null,
+                .started => if (info.state == .queued) .running else null,
+                .completed => if (info.state == .running) .done else null,
+                .failed => if (info.state == .running) .failed else null,
+            };
+            if (next_state) |state| {
+                info.state = state;
+                info.last_ts = event.ts;
+            } else {
+                return .{ .stderr = try transitionMessage(allocator, event.line, event.job), .exit_code = 1 };
+            }
+        } else {
+            if (event.kind != .created) {
+                return .{ .stderr = try transitionMessage(allocator, event.line, event.job), .exit_code = 1 };
+            }
+            try jobs.put(event.job, .{ .state = .queued, .last_ts = event.ts });
+        }
+    }
+
+    var queued: usize = 0;
+    var running: usize = 0;
+    var done: usize = 0;
+    var failed: usize = 0;
+    var state_iter = jobs.valueIterator();
+    while (state_iter.next()) |info| {
+        switch (info.state) {
+            .queued => queued += 1,
+            .running => running += 1,
+            .done => done += 1,
+            .failed => failed += 1,
+        }
+    }
+
+    return .{
+        .stdout = try std.fmt.allocPrint(
+            allocator,
+            "total={d}\nqueued={d}\nrunning={d}\ndone={d}\nfailed={d}\n",
+            .{ jobs.count(), queued, running, done, failed },
+        ),
+    };
+}
+
+fn parseLog(allocator: std.mem.Allocator, bytes: []const u8, ignore_final_fragment: bool) !LogResult {
+    var events: std.ArrayList(Event) = .empty;
+    errdefer events.deinit(allocator);
+
+    var ids = std.StringHashMap(void).init(allocator);
+    defer ids.deinit();
+
+    var line_start: usize = 0;
+    var line_number: usize = 1;
+    for (bytes, 0..) |byte, index| {
+        if (byte != '\n') continue;
+
+        const parsed = parseEvent(allocator, bytes[line_start..index], line_number);
+        switch (parsed) {
+            .invalid => return .{ .failure = try invalidMessage(allocator, line_number) },
+            .unknown_type => |value| return .{ .failure = try unknownTypeMessage(allocator, line_number, value) },
+            .event => |event| {
+                if (ids.contains(event.id)) {
+                    return .{ .failure = try duplicateIdMessage(allocator, line_number, event.id) };
+                }
+                try ids.put(event.id, {});
+                try events.append(allocator, event);
+            },
+        }
+        line_start = index + 1;
+        line_number += 1;
+    }
+
+    if (line_start < bytes.len and !ignore_final_fragment) {
+        return .{ .failure = try invalidMessage(allocator, line_number) };
+    }
+
+    return .{ .events = try events.toOwnedSlice(allocator) };
+}
+
+fn parseEvent(allocator: std.mem.Allocator, input: []const u8, line: usize) ParseEventResult {
+    if (!std.unicode.utf8ValidateSlice(input)) return .invalid;
+
+    const value = std.json.parseFromSliceLeaky(std.json.Value, allocator, input, .{
+        .duplicate_field_behavior = .@"error",
+        .parse_numbers = false,
+    }) catch return .invalid;
+    if (value != .object or value.object.count() != 4) return .invalid;
+
+    const id = switch (value.object.get("id") orelse return .invalid) {
+        .string => |field| field,
+        else => return .invalid,
+    };
+    const kind_text = switch (value.object.get("type") orelse return .invalid) {
+        .string => |field| field,
+        else => return .invalid,
+    };
+    const job = switch (value.object.get("job") orelse return .invalid) {
+        .string => |field| field,
+        else => return .invalid,
+    };
+    const ts_text = switch (value.object.get("ts") orelse return .invalid) {
+        .number_string => |field| field,
+        else => return .invalid,
+    };
+
+    if (!validId(id) or !validJob(job)) return .invalid;
+
+    const ts = if (std.mem.eql(u8, ts_text, "-0")) @as(u64, 0) else std.fmt.parseInt(u64, ts_text, 10) catch return .invalid;
+    if (ts > std.math.maxInt(i64)) return .invalid;
+
+    const kind: EventKind = if (std.mem.eql(u8, kind_text, "created"))
+        .created
+    else if (std.mem.eql(u8, kind_text, "started"))
+        .started
+    else if (std.mem.eql(u8, kind_text, "completed"))
+        .completed
+    else if (std.mem.eql(u8, kind_text, "failed"))
+        .failed
+    else
+        return .{ .unknown_type = kind_text };
+
+    return .{ .event = .{ .id = id, .kind = kind, .job = job, .ts = ts, .line = line } };
+}
+
+fn validId(id: []const u8) bool {
+    if (id.len < 3 or id.len > 18 or !std.mem.startsWith(u8, id, "e-")) return false;
+    for (id[2..]) |byte| {
+        if (!((byte >= 'a' and byte <= 'z') or (byte >= '0' and byte <= '9'))) return false;
+    }
+    return true;
+}
+
+fn validJob(job: []const u8) bool {
+    if (job.len == 0 or job.len > 32 or job[0] < 'a' or job[0] > 'z') return false;
+    for (job[1..]) |byte| {
+        if (!((byte >= 'a' and byte <= 'z') or (byte >= '0' and byte <= '9') or byte == '-')) return false;
+    }
+    return true;
+}
+
+fn eventLessThan(_: void, left: Event, right: Event) bool {
+    if (left.ts != right.ts) return left.ts < right.ts;
+    return left.line < right.line;
+}
+
+fn invalidMessage(allocator: std.mem.Allocator, line: usize) ![]const u8 {
+    return std.fmt.allocPrint(allocator, "eventlog:{d}: invalid event", .{line});
+}
+
+fn unknownTypeMessage(allocator: std.mem.Allocator, line: usize, kind: []const u8) ![]const u8 {
+    return std.fmt.allocPrint(allocator, "eventlog:{d}: unknown event type '{s}'", .{ line, kind });
+}
+
+fn duplicateIdMessage(allocator: std.mem.Allocator, line: usize, id: []const u8) ![]const u8 {
+    return std.fmt.allocPrint(allocator, "eventlog:{d}: duplicate event id '{s}'", .{ line, id });
+}
+
+fn transitionMessage(allocator: std.mem.Allocator, line: usize, job: []const u8) ![]const u8 {
+    return std.fmt.allocPrint(allocator, "eventlog:{d}: invalid transition for job '{s}'", .{ line, job });
+}
+
+fn cannotAccess() Response {
+    return .{ .stderr = "eventlog: cannot access log", .exit_code = 1 };
 }
