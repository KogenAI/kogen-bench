+pub fn execute(allocator: std.mem.Allocator, _: std.Io, args: []const []const u8) Outcome {
+    const request = parseRequest(allocator, args) catch return .{ .failure = InvalidArguments };
+    const result = dispatch(allocator, request) catch |err| {
+        if (err == error.DuplicateJob) return .{ .failure = DuplicateJob };
+        return .{ .failure = StoreFailure };
+    };
