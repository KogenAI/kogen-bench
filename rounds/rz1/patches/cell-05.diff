+const InvalidArguments = Failure{ .code = 2, .message = "error: invalid arguments" };
+const DuplicateJob = Failure{ .code = 3, .message = "error: duplicate job id" };
+const StoreFailure = Failure{ .code = 4, .message = "error: store failure" };
