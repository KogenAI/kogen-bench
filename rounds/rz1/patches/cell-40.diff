+pub fn execute(allocator: Allocator, args: []const []const u8) !Response {
+    const parsed_args = try parseArguments(args);
+
+    var attempt: u8 = 0;
+    while (attempt < 2) : (attempt += 1) {
+        const result = try runAttempt(allocator, parsed_args);
+        switch (result) {
+            .failed => return error.RequestFailed,
+            .retryable => if (attempt == 1) return error.RequestFailed,
+            .success => |response| {
+                try writeUsageAtomically(allocator, parsed_args.usage_path, response.usage);
+                return response;
+            },
+        }
+    }
+    return error.RequestFailed;
+}
+
+fn parseArguments(args: []const []const u8) error{InvalidArguments}!Arguments {
+    if (args.len != 9 or !std.mem.eql(u8, args[0], "model")) return error.InvalidArguments;
+
+    var url_value: ?[]const u8 = null;
+    var prompt_value: ?[]const u8 = null;
+    var timeout_value: ?[]const u8 = null;
+    var path_value: ?[]const u8 = null;
+    var index: usize = 1;
+    while (index < args.len) : (index += 2) {
+        if (index + 1 >= args.len) return error.InvalidArguments;
+        const name = args[index];
+        const value = args[index + 1];
+        if (std.mem.eql(u8, name, "--url")) {
+            if (url_value != null) return error.InvalidArguments;
+            url_value = value;
+        } else if (std.mem.eql(u8, name, "--prompt")) {
+            if (prompt_value != null) return error.InvalidArguments;
+            prompt_value = value;
+        } else if (std.mem.eql(u8, name, "--idle-timeout-ms")) {
+            if (timeout_value != null) return error.InvalidArguments;
+            timeout_value = value;
+        } else if (std.mem.eql(u8, name, "--usage-file")) {
+            if (path_value != null) return error.InvalidArguments;
+            path_value = value;
+        } else {
+            return error.InvalidArguments;
+        }
+    }
+
+    const url_text = url_value orelse return error.InvalidArguments;
+    const prompt = prompt_value orelse return error.InvalidArguments;
+    const timeout_text = timeout_value orelse return error.InvalidArguments;
+    const usage_path = path_value orelse return error.InvalidArguments;
+    if (usage_path.len == 0) return error.InvalidArguments;
+    if (!std.unicode.utf8ValidateSlice(prompt)) return error.InvalidArguments;
+
+    var timeout: u32 = 0;
+    if (timeout_text.len == 0) return error.InvalidArguments;
+    for (timeout_text) |ch| {
+        if (ch < '0' or ch > '9') return error.InvalidArguments;
+        const digit: u32 = ch - '0';
+        if (timeout > 60000 / 10 or timeout * 10 > 60000 - digit) return error.InvalidArguments;
+        timeout = timeout * 10 + digit;
+    }
+    if (timeout < 1 or timeout > 60000) return error.InvalidArguments;
+
+    if (!validUriText(url_text)) return error.InvalidArguments;
+    const uri = std.Uri.parse(url_text) catch return error.InvalidArguments;
+    if (!std.ascii.eqlIgnoreCase(uri.scheme, "http") or uri.host == null or uri.host.?.isEmpty())
+        return error.InvalidArguments;
+
+    return .{
+        .prompt = prompt,
+        .timeout_ms = timeout,
+        .usage_path = usage_path,
+        .uri = uri,
+    };
+}
+
+fn validUriText(text: []const u8) bool {
+    var index: usize = 0;
+    while (index < text.len) : (index += 1) {
+        const byte = text[index];
+        if (byte <= 0x20 or byte >= 0x7f or byte == '\\') return false;
+        if (byte == '%') {
+            if (index + 2 >= text.len or !std.ascii.isHex(text[index + 1]) or !std.ascii.isHex(text[index + 2])) return false;
+            index += 2;
+        }
+    }
+    return true;
+}
+
+fn runAttempt(allocator: Allocator, args: Arguments) !AttemptResult {
+    var arena = std.heap.ArenaAllocator.init(allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+
+    const request_body = try makeRequestBody(a, args.prompt);
+    const request = try makeRequest(a, args.uri, request_body);
+
+    const fd = connectTo(a, args.uri) catch return .retryable;
+    defer _ = c.close(fd);
+
+    if (!sendAll(fd, request)) return .retryable;
+
+    const headers_deadline = monotonicNanos() + @as(i128, args.timeout_ms) * 1_000_000;
+    const http = receiveHeaders(a, fd, headers_deadline) catch |err| switch (err) {
+        error.Timeout, error.ConnectionFailure => return .retryable,
+        error.InvalidResponse => return .failed,
+        error.OutOfMemory => return error.OutOfMemory,
+    };
+
+    if (http.status >= 500 and http.status <= 599) return .retryable;
+    if (http.status < 200 or http.status > 299) return .failed;
+
+    var sse = SseParser.init(a);
+    var body = BodyDecoder.init(a, &sse, http.content_length, http.chunked);
+    const initial = body.feed(http.body_prefix) catch |err| switch (err) {
+        error.InvalidResponse => return .failed,
+        error.OutOfMemory => return error.OutOfMemory,
+    };
+    if (initial) return try successResponse(allocator, &sse);
+    if (body.finished()) return if (sse.complete()) try successResponse(allocator, &sse) else .failed;
+
+    while (true) {
+        const body_deadline = monotonicNanos() + @as(i128, args.timeout_ms) * 1_000_000;
+        var chunk: [4096]u8 = undefined;
+        const count = receiveSome(fd, &chunk, body_deadline) catch |err| switch (err) {
+            error.Timeout, error.ConnectionFailure => return .retryable,
+            error.InvalidResponse => return .failed,
+        };
+        if (count == 0) {
+            if (body.isCloseDelimited()) {
+                sse.finish() catch return .failed;
+                return if (sse.complete()) try successResponse(allocator, &sse) else .failed;
+            }
+            return .retryable;
+        }
+
+        const completed = body.feed(chunk[0..count]) catch |err| switch (err) {
+            error.InvalidResponse => return .failed,
+            error.OutOfMemory => return error.OutOfMemory,
+        };
+        if (completed) return try successResponse(allocator, &sse);
+        if (body.finished()) return if (sse.complete()) try successResponse(allocator, &sse) else .failed;
+    }
+}
+
+fn successResponse(allocator: Allocator, parser: *const SseParser) !AttemptResult {
+    const usage = parser.usage orelse return .failed;
+    return .{ .success = .{ .text = try allocator.dupe(u8, parser.text.items), .usage = usage } };
+}
+
+fn makeRequestBody(allocator: Allocator, prompt: []const u8) ![]u8 {
+    const encoded = try std.json.Stringify.valueAlloc(allocator, prompt, .{});
+    return try std.fmt.allocPrint(allocator, "{{\"prompt\":{s}}}", .{encoded});
+}
+
+fn makeRequest(allocator: Allocator, uri: std.Uri, body: []const u8) ![]u8 {
+    const host_component = uri.host orelse return error.InvalidArguments;
+    const host = try host_component.toRawMaybeAlloc(allocator);
+
+    var target = std.array_list.Managed(u8).init(allocator);
+    if (uri.path.isEmpty()) {
+        try target.append('/');
+    } else {
+        try target.appendSlice(componentBytes(uri.path));
+    }
+    if (uri.query) |query| {
+        try target.append('?');
+        try target.appendSlice(componentBytes(query));
+    }
