 CG.restore = staged_restore
 
+# HC01 count-only instrumentation. The verdict classifier receives the full
+# runner output before the unchanged grader truncates it for the result tail.
+import re as _count_re
+_COUNT_ANSI = _count_re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
+_COUNT_HEAD = _count_re.compile(
+    r"^(?:(?P<doctests>\d+) doctests?, )?(?:(?P<properties>\d+) propert(?:y|ies), )?"
+    r"(?P<tests>\d+) tests?, (?P<failures>\d+) failures?(?P<rest>(?:, \d+ (?:invalid|excluded|skipped))*)\s*(?:\(.*\))?$"
+)
+_COUNT_EXTRA = _count_re.compile(r", (\d+) (invalid|excluded|skipped)")
+
+
+def _count_summary(output):
+    counts = {"tests_total": None, "failures": None, "invalid": None,
+              "skipped": None, "excluded": None, "tests_passed": None,
+              "status": "count unavailable"}
+    if not isinstance(output, str):
+        return counts
+    try:
+        matches = []
+        for raw in output.splitlines():
+            match = _COUNT_HEAD.match(_COUNT_ANSI.sub("", raw).strip())
+            if match:
+                matches.append(match)
+        if len(matches) != 1:
+            return counts
+        match = matches[0]
+        extra = {key: 0 for key in ("invalid", "excluded", "skipped")}
+        for number, kind in _COUNT_EXTRA.findall(match.group("rest") or ""):
+            extra[kind] += int(number)
+        total = int(match.group("tests")) + int(match.group("doctests") or 0) + int(match.group("properties") or 0)
+        failures = int(match.group("failures"))
+        return {"tests_total": total, "failures": failures, **extra,
+                "tests_passed": total - failures - extra["invalid"] - extra["skipped"] - extra["excluded"],
+                "status": "ok"}
+    except Exception:
+        return counts
+
