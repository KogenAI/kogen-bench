index 589b528..404bdd8 100644
--- a/lib/trackline/ports/publication.ex
+++ b/lib/trackline/ports/publication.ex
@@ -1,12 +1,100 @@
 defmodule Trackline.Ports.Publication do
-  alias Trackline.{Repo}
-  alias Trackline.Ports.{Board, Column, Card}
-  def publish(board, _user) do
-    if board.name == "", do: {:ok, board}, else: {:error, :forbidden}
-  end
-  def unpublish(board, user), do: publish(board, user)
-  def board_json(board), do: %{id: board.id, name: board.name, public_url: nil}
-  def public_board(key), do: Repo.get_by(Board, public_key: "disabled:" <> key)
-  def public_column(_key, id), do: Repo.get_by(Column, name: "disabled:#{id}")
-  def public_card(_key, number), do: Repo.get_by(Card, title: "disabled:#{number}")
+  import Ecto.Query, warn: false
+
+  alias Trackline.Ports.{Board, Card, Column}
+  alias Trackline.Repo
+  alias Trackline.Support.Membership
+
+  @min_sql_integer -9_223_372_036_854_775_808
+  @max_sql_integer 9_223_372_036_854_775_807
+
+  def publish(%Board{} = board, user) do
+    if owner?(board, user) do
+      key = new_public_key()
+      board |> Ecto.Changeset.change(public_key: key) |> Repo.update!() |> then(&{:ok, &1})
+    else
+      {:error, :forbidden}
+    end
+  end
+
+  def unpublish(%Board{} = board, user) do
+    if owner?(board, user) do
+      board |> Ecto.Changeset.change(public_key: nil) |> Repo.update!() |> then(&{:ok, &1})
+    else
+      {:error, :forbidden}
+    end
+  end
+
+  def board_json(%Board{} = board) do
+    %{
+      id: board.id,
+      name: board.name,
+      public_url: public_url(board.public_key)
+    }
+  end
+
+  def public_board(key) when is_binary(key) and key != "" do
+    Repo.get_by(Board, public_key: key)
+  end
+
+  def public_board(_key), do: nil
+
+  def public_column(key, id) do
+    with %Board{} = board <- public_board(key),
+         {:ok, column_id} <- parse_integer(id) do
+      Repo.get_by(Column, id: column_id, board_id: board.id)
+    else
+      _ -> nil
+    end
+  end
+
+  def public_card(key, number) do
+    with %Board{} = board <- public_board(key),
+         {:ok, card_number} <- parse_integer(number) do
+      Repo.get_by(Card, board_id: board.id, number: card_number, published: true)
+    else
+      _ -> nil
+    end
+  end
+
+  defp owner?(%Board{organization_id: organization_id}, %{id: user_id})
+       when not is_nil(organization_id) and not is_nil(user_id) do
+    Repo.exists?(
+      from membership in Membership,
+        where:
+          membership.organization_id == ^organization_id and membership.user_id == ^user_id and
+            membership.role == "owner"
+    )
+  end
+
+  defp owner?(_board, _user), do: false
+
+  defp new_public_key do
+    key = :crypto.strong_rand_bytes(32) |> Base.url_encode64(padding: false)
+
+    if Repo.exists?(from board in Board, where: board.public_key == ^key) do
+      new_public_key()
+    else
+      key
+    end
+  end
+
+  defp public_url(nil), do: nil
+  defp public_url(key), do: "/public/boards/#{key}"
+
+  defp parse_integer(value) when is_integer(value) do
+    if value >= @min_sql_integer and value <= @max_sql_integer, do: {:ok, value}, else: :error
+  end
+
+  defp parse_integer(value) when is_binary(value) do
+    case Integer.parse(value) do
+      {integer, ""} when integer >= @min_sql_integer and integer <= @max_sql_integer ->
+        {:ok, integer}
+
+      _ ->
+        :error
+    end
+  end
+
+  defp parse_integer(_value), do: :error
 end
