diff --git a/lib/trackline_web/controllers/inbound_email_controller.ex b/lib/trackline_web/controllers/inbound_email_controller.ex
new file mode 100644
index 0000000..93247d8
--- /dev/null
+++ b/lib/trackline_web/controllers/inbound_email_controller.ex
@@ -0,0 +1,128 @@
+defmodule TracklineWeb.InboundEmailController do
+  use TracklineWeb, :controller
+
+  alias Trackline.Support
+
+  @max_body_bytes 65_536
+  @read_chunk 16_384
+
+  def create(conn, %{"slug" => slug}) do
+    case Support.get_organization_by_slug(slug) do
+      nil ->
+        respond_error(conn, :not_found, "organization_not_found")
+
+      organization ->
+        with {:ok, body, conn} <- read_bounded_body(conn),
+             :ok <- authenticate(conn, organization.webhook_secret, body),
+             {:ok, payload} <- decode_payload(body),
+             {:ok, result} <- Support.ingest_inbound_email(organization, payload) do
+          respond_with_result(conn, result)
+        else
+          {:error, :too_large, conn} ->
+            respond_error(conn, 413, "payload_too_large")
+
+          {:error, :unauthorized} ->
+            respond_error(conn, :unauthorized, "unauthorized")
+
+          {:error, :invalid_json} ->
+            respond_error(conn, :bad_request, "invalid_json")
+
+          {:error, :bad_request} ->
+            respond_error(conn, :bad_request, "bad_request")
+
+          {:error, :invalid_email} ->
+            respond_error(conn, :unprocessable_entity, "invalid_email")
+
+          {:error, _reason} ->
+            respond_error(conn, :internal_server_error, "internal_server_error")
+        end
+    end
+  end
+
+  defp respond_with_result(conn, {:created, ticket_id}) do
+    conn
+    |> put_status(:created)
+    |> json(%{ticket_id: ticket_id})
+  end
+
+  defp respond_with_result(conn, {:duplicate, ticket_id}) do
+    conn
+    |> put_status(:ok)
+    |> json(%{ticket_id: ticket_id, duplicate: true})
+  end
+
+  defp respond_error(conn, status, error) do
+    conn
+    |> put_status(status)
+    |> json(%{error: error})
+  end
+
+  defp read_bounded_body(conn), do: read_bounded_body(conn, <<>>)
+
+  defp read_bounded_body(conn, accumulated) do
+    remaining = @max_body_bytes + 1 - byte_size(accumulated)
+
+    case Plug.Conn.read_body(conn,
+           length: remaining,
+           read_length: min(@read_chunk, remaining),
+           read_timeout: 15_000
+         ) do
+      {:ok, chunk, conn} ->
+        body = accumulated <> chunk
+
+        if byte_size(body) <= @max_body_bytes do
+          {:ok, body, conn}
+        else
+          {:error, :too_large, conn}
+        end
+
+      {:more, chunk, conn} ->
+        body = accumulated <> chunk
+
+        cond do
+          byte_size(body) > @max_body_bytes -> {:error, :too_large, conn}
+          byte_size(body) == @max_body_bytes -> {:error, :too_large, conn}
+          true -> read_bounded_body(conn, body)
+        end
+
+      {:error, :too_large} ->
+        {:error, :too_large, conn}
+
+      {:error, _reason} ->
+        {:error, :bad_request}
+    end
+  end
+
+  defp authenticate(conn, secret, body) when is_binary(secret) and byte_size(secret) > 0 do
+    with [timestamp] <- Plug.Conn.get_req_header(conn, "x-webhook-timestamp"),
+         [signature] <- Plug.Conn.get_req_header(conn, "x-webhook-signature"),
+         true <- Regex.match?(~r/\A-?[0-9]+\z/, timestamp),
+         {:ok, unix_seconds} <- parse_timestamp(timestamp),
+         true <- abs(System.system_time(:second) - unix_seconds) <= 300,
+         true <- Regex.match?(~r/\A[0-9a-f]{64}\z/, signature),
+         expected <-
+           :crypto.mac(:hmac, :sha256, secret, timestamp <> "." <> body)
+           |> Base.encode16(case: :lower),
+         true <- Plug.Crypto.secure_compare(signature, expected) do
+      :ok
+    else
+      _ -> {:error, :unauthorized}
+    end
+  end
+
+  defp authenticate(_conn, _secret, _body), do: {:error, :unauthorized}
+
+  defp parse_timestamp(timestamp) do
+    case Integer.parse(timestamp) do
+      {value, ""} -> {:ok, value}
+      _ -> :error
+    end
+  end
+
+  defp decode_payload(body) do
+    case Jason.decode(body) do
+      {:ok, payload} when is_map(payload) -> {:ok, payload}
+      _ -> {:error, :invalid_json}
+    end
+  end
+end
diff --git a/lib/trackline_web/endpoint.ex b/lib/trackline_web/endpoint.ex
index 828db3f..cfd2cdc 100644
--- a/lib/trackline_web/endpoint.ex
+++ b/lib/trackline_web/endpoint.ex
@@ -39,13 +39,28 @@ defmodule TracklineWeb.Endpoint do
   plug Plug.RequestId
   plug Plug.Telemetry, event_prefix: [:phoenix, :endpoint]
 
-  plug Plug.Parsers,
-    parsers: [:urlencoded, :multipart, :json],
-    pass: ["*/*"],
-    json_decoder: Phoenix.json_library()
+  plug :parse_request_body
 
   plug Plug.MethodOverride
   plug Plug.Head
   plug Plug.Session, @session_options
   plug TracklineWeb.Router
+  # The inbound mail endpoint must authenticate the exact raw bytes before any
+  # JSON parser can reject or normalize the request body. All other routes keep
+  # the application's normal parser configuration.
+  defp parse_request_body(conn, _opts) do
+    if conn.method == "POST" and
+         Regex.match?(~r{\A/api/orgs/[^/]+/inbound-email\z}, conn.request_path) do
+      conn
+    else
+      Plug.Parsers.call(
+        conn,
+        Plug.Parsers.init(
+          parsers: [:urlencoded, :multipart, :json],
+          pass: ["*/*"],
+          json_decoder: Phoenix.json_library()
+        )
+      )
+    end
+  end
 end
