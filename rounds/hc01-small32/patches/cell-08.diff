+  alias Trackline.Support.{Comment, InboundEmailMessage, Membership, Organization, Ticket}
 
   ## Organizations and membership
 
@@ -84,6 +84,125 @@ defmodule Trackline.Support do
 
   def change_ticket(%Ticket{} = ticket, attrs \\ %{}), do: Ticket.changeset(ticket, attrs)
 
+  @doc "Persist an inbound email as a ticket or a threaded comment."
+  def ingest_inbound_email(%Organization{id: organization_id}, payload) when is_map(payload) do
+    with {:ok, attrs} <- inbound_email_attrs(payload) do
+      result =
+        Repo.transact(fn ->
+          case Repo.get_by(InboundEmailMessage,
+                 organization_id: organization_id,
+                 message_id: attrs.message_id
+               ) do
+            %InboundEmailMessage{ticket_id: ticket_id} ->
+              {:ok, {:duplicate, ticket_id}}
+
+            nil ->
+              persist_inbound_email(organization_id, attrs)
+          end
+        end)
+
+      case result do
+        {:ok, ingestion_result} ->
+          {:ok, ingestion_result}
+
+        {:error, _reason} = error ->
+          # A concurrent delivery may have inserted the unique mapping after the
+          # transaction's initial lookup. Its transaction is rolled back before
+          # resolving the mapping here, so no duplicate content is retained.
+          case Repo.get_by(InboundEmailMessage,
+                 organization_id: organization_id,
+                 message_id: attrs.message_id
+               ) do
+            %InboundEmailMessage{ticket_id: ticket_id} -> {:ok, {:duplicate, ticket_id}}
+            nil -> error
+          end
+      end
+    end
+  end
+
+  def ingest_inbound_email(_organization, _payload), do: {:error, :invalid_email}
+
+  defp inbound_email_attrs(payload) do
+    message_id = Map.get(payload, "message_id")
+    sender = Map.get(payload, "from")
+
+    if usable_string?(message_id) and usable_string?(sender) do
+      subject = Map.get(payload, "subject")
+      text = Map.get(payload, "text")
+      parent_id = Map.get(payload, "in_reply_to")
+
+      title =
+        case subject do
+          "" -> "(no subject)"
+          value when is_binary(value) -> String.slice(value, 0, 200)
+          _ -> "(no subject)"
+        end
+
+      {:ok,
+       %{
+         message_id: message_id,
+         sender: sender,
+         title: title,
+         text: if(is_binary(text), do: text, else: ""),
+         parent_id: if(usable_string?(parent_id), do: parent_id, else: nil)
+       }}
+    else
+      {:error, :invalid_email}
+    end
+  end
+
+  defp usable_string?(value), do: is_binary(value) and String.trim(value) != ""
+
+  defp persist_inbound_email(organization_id, attrs) do
+    parent =
+      if attrs.parent_id do
+        Repo.get_by(InboundEmailMessage,
+          organization_id: organization_id,
+          message_id: attrs.parent_id
+        )
+      end
+
+    if parent do
+      comment_body = String.slice(attrs.text, 0, 5_000)
+
+      with {:ok, _comment} <-
+             %Comment{ticket_id: parent.ticket_id, author_id: nil, body: comment_body}
+             |> Repo.insert(),
+           {:ok, _mapping} <-
+             create_inbound_mapping(organization_id, attrs.message_id, parent.ticket_id) do
+        {:ok, {:created, parent.ticket_id}}
+      end
+    else
+      title = if attrs.title == "", do: "(no subject)", else: attrs.title
+
+      with {:ok, ticket} <-
+             %Ticket{
+               organization_id: organization_id,
+               title: title,
+               body: attrs.text,
+               requester_email: attrs.sender,
+               status: "open",
+               priority: "normal",
+               author_id: nil,
+               assignee_id: nil
+             }
+             |> Repo.insert(),
+           {:ok, _mapping} <- create_inbound_mapping(organization_id, attrs.message_id, ticket.id) do
+        {:ok, {:created, ticket.id}}
+      end
+    end
+  end
+
+  defp create_inbound_mapping(organization_id, message_id, ticket_id) do
+    %InboundEmailMessage{}
+    |> InboundEmailMessage.changeset(%{
+      organization_id: organization_id,
+      message_id: message_id,
+      ticket_id: ticket_id
+    })
+    |> Repo.insert()
+  end
+
   def set_status(%Ticket{} = ticket, status) do
     ticket |> Ticket.status_changeset(status) |> Repo.update()
   end
