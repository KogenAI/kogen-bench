+defmodule Trackline.Support.InboundEmailMessage do
+  use Ecto.Schema
+  import Ecto.Changeset
+
+  alias Trackline.Support.{Organization, Ticket}
+
+  schema "inbound_email_messages" do
+    field :message_id, :string
+
+    belongs_to :organization, Organization
+    belongs_to :ticket, Ticket
+
+    timestamps(type: :utc_datetime)
+  end
+
+  def changeset(message, attrs) do
+    message
+    |> cast(attrs, [:organization_id, :message_id, :ticket_id])
+    |> validate_required([:organization_id, :message_id, :ticket_id])
+    |> unique_constraint(:message_id, name: :inbound_email_messages_org_message_index)
+  end
+end
