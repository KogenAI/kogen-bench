diff --git a/test/acceptance/syn-31-inbound-email-webhook_test.exs b/test/acceptance/syn-31-inbound-email-webhook_test.exs
new file mode 100644
index 0000000..bba6ba1
--- /dev/null
+++ b/test/acceptance/syn-31-inbound-email-webhook_test.exs
@@ -0,0 +1,374 @@
+defmodule TracklineWeb.InboundEmailIntentAcceptanceTest do
+  use TracklineWeb.ConnCase, async: false
+
+  alias Trackline.{Repo, Support}
+  import Trackline.AccountsFixtures
+  import Trackline.SupportFixtures
+
+  @secret "inbound-intent-secret"
+
+  defp org_with_secret(secret \\ @secret) do
+    organization_fixture(nil, %{webhook_secret: secret})
+  end
+
+  defp email(id, attrs \\ %{}) do
+    Map.merge(
+      %{
+        "message_id" => id,
+        "from" => "${OWNER_EMAIL}",
+        "subject" => "Help with my account",
+        "text" => "Please help."
+      },
+      attrs
+    )
+  end
+
+  defp signature(secret, timestamp, body) do
+    :crypto.mac(:hmac, :sha256, secret, timestamp <> "." <> body)
+    |> Base.encode16(case: :lower)
+  end
+
+  defp raw_request(org, body, opts \\ []) do
+    timestamp = Keyword.get(opts, :timestamp, Integer.to_string(System.system_time(:second)))
+    secret = Keyword.get(opts, :secret, Map.get(org, :webhook_secret) || "")
+    sig = Keyword.get(opts, :signature, signature(secret, timestamp, body))
+
+    conn =
+      build_conn()
+      |> put_req_header("content-type", "application/json")
+      |> put_req_header("x-webhook-timestamp", timestamp)
+      |> put_req_header("x-webhook-signature", sig)
+
+    conn =
+      Enum.reduce(Keyword.get(opts, :omit_headers, []), conn, fn header, conn ->
+        delete_req_header(conn, header)
+      end)
+
+    post(conn, "/api/orgs/#{org.slug}/inbound-email", body)
+  end
+
+  defp deliver(org, payload, opts \\ []) do
+    raw_request(org, Jason.encode!(payload), opts)
+  end
+
+  defp created_ticket(org, payload, opts \\ []) do
+    response = deliver(org, payload, opts)
+    assert response.status == 201
+    decoded = json_response(response, 201)
+    assert Map.has_key?(decoded, "ticket_id")
+    refute Map.get(decoded, "duplicate", false)
+    Support.get_ticket!(decoded["ticket_id"])
+  end
+
+  defp assert_duplicate(org, payload, ticket) do
+    response = deliver(org, payload)
+    assert response.status == 200
+    assert json_response(response, 200) == %{"ticket_id" => ticket.id, "duplicate" => true}
+  end
+
+  defp assert_prefix(kept, original, limit) do
+    assert is_binary(kept)
+    assert String.length(kept) > 0
+    assert String.length(kept) <= limit
+    assert String.starts_with?(original, kept)
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A1"
+  test "new emails preserve content, sender, defaults and normalize title limits" do
+    org = org_with_secret()
+    text = String.duplicate("x", 50_000)
+
+    payload =
+      email("new-large", %{
+        "text" => text,
+        "attachments" => [%{"name" => "file.txt", "content" => "ignored"}]
+      })
+
+    assert byte_size(Jason.encode!(payload)) < 65_536
+    ticket = created_ticket(org, payload)
+
+    assert ticket.organization_id == org.id
+    assert ticket.title == payload["subject"]
+    assert ticket.body == text
+    assert ticket.status == "open"
+    assert Map.fetch!(ticket, :requester_email) == payload["from"]
+    assert ticket.author_id == nil
+    assert ticket.assignee_id == nil
+    assert ticket.author == nil
+    assert ticket.assignee == nil
+    assert Support.list_comments(ticket) == []
+
+    # Check the required real column, not just a virtual field on the returned struct.
+    persisted =
+      Ecto.Adapters.SQL.query!(
+        Repo,
+        "SELECT requester_email, body, author_id, assignee_id FROM tickets WHERE id = ?",
+        [ticket.id]
+      )
+
+    assert persisted.rows == [[payload["from"], text, nil, nil]]
+
+    empty = created_ticket(org, email("empty-subject", %{"subject" => ""}))
+    assert empty.title == "(no subject)"
+
+    long_subject = String.duplicate("é", 250)
+    long = created_ticket(org, email("long-subject", %{"subject" => long_subject}))
+    assert_prefix(long.title, long_subject, 200)
+
+    allowed_subject = String.duplicate("a", 200)
+    allowed = created_ticket(org, email("title-at-limit", %{"subject" => allowed_subject}))
+    assert allowed.title == allowed_subject
+    assert length(Support.list_tickets(org)) == 4
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A2"
+  test "reply chains become ordered comments and parent resolution is organization local" do
+    org = org_with_secret()
+    other = org_with_secret("other-organization-secret")
+    ticket = created_ticket(org, email("root"))
+
+    first =
+      created_ticket(
+        org,
+        email("reply-one", %{
+          "in_reply_to" => "root",
+          "text" => "First reply",
+          "attachments" => [%{"name" => "reply.pdf", "content" => "ignored"}]
+        })
+      )
+
+    assert first.id == ticket.id
+
+    long_reply = String.duplicate("é", 5_500)
+
+    second =
+      created_ticket(
+        org,
+        email("reply-two", %{"in_reply_to" => "reply-one", "text" => long_reply})
+      )
+
+    assert second.id == ticket.id
+
+    third =
+      created_ticket(
+        org,
+        email("reply-three", %{"in_reply_to" => "reply-two", "text" => "Third reply"})
+      )
+
+    assert third.id == ticket.id
+
+    allowed_reply = String.duplicate("c", 5_000)
+
+    fourth =
+      created_ticket(
+        org,
+        email("reply-at-limit", %{"in_reply_to" => "reply-three", "text" => allowed_reply})
+      )
+
+    assert fourth.id == ticket.id
+
+    assert [one, two, three, four] = Support.list_comments(ticket)
+    assert one.body == "First reply"
+    assert_prefix(two.body, long_reply, 5_000)
+    assert three.body == "Third reply"
+    assert four.body == allowed_reply
+
+    assert Enum.all?([one, two, three, four], fn comment ->
+             comment.author_id == nil and comment.author == nil and comment.ticket_id == ticket.id
+           end)
+
+    assert length(Support.list_tickets(org)) == 1
+    unchanged = Support.get_ticket!(ticket.id)
+    assert unchanged.body == "Please help."
+    assert unchanged.author_id == nil
+    assert unchanged.assignee_id == nil
+    assert Map.fetch!(unchanged, :requester_email) == "${OWNER_EMAIL}"
+
+    unknown = created_ticket(org, email("unknown-parent", %{"in_reply_to" => "not-delivered"}))
+    refute unknown.id == ticket.id
+    assert unknown.status == "open"
+    assert Support.list_comments(unknown) == []
+
+    # Both a foreign original message and a foreign reply must be treated as new mail.
+    for parent <- ["root", "reply-two"] do
+      foreign =
+        created_ticket(other, email("foreign-parent-#{parent}", %{"in_reply_to" => parent}))
+
+      assert foreign.organization_id == other.id
+      refute foreign.id == ticket.id
+      assert foreign.status == "open"
+      assert foreign.body == "Please help."
+      assert foreign.author_id == nil
+      assert foreign.assignee_id == nil
+      assert Map.fetch!(foreign, :requester_email) == "${OWNER_EMAIL}"
+      assert Support.list_comments(foreign) == []
+    end
+
+    assert length(Support.list_comments(ticket)) == 4
+    assert length(Support.list_tickets(org)) == 2
+    assert length(Support.list_tickets(other)) == 2
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A3"
+  test "duplicate tickets and replies are idempotent and IDs are scoped to organizations" do
+    org = org_with_secret()
+    other = org_with_secret("independent-secret")
+    original = email("shared-id")
+    ticket = created_ticket(org, original)
+    assert_duplicate(org, original, ticket)
+
+    assert_duplicate(
+      org,
+      email("shared-id", %{"text" => "Changed duplicate", "subject" => "Do not replace"}),
+      ticket
+    )
+
+    assert length(Support.list_tickets(org)) == 1
+    assert Support.get_ticket!(ticket.id) == ticket
+    assert Support.list_comments(ticket) == []
+
+    reply = email("shared-reply", %{"in_reply_to" => "shared-id", "text" => "One comment"})
+    assert created_ticket(org, reply).id == ticket.id
+    before_duplicate = Support.list_comments(ticket)
+    assert_duplicate(org, reply, ticket)
+    assert_duplicate(org, Map.put(reply, "text", "Do not modify comment"), ticket)
+    assert Support.list_comments(ticket) == before_duplicate
+    assert [%{body: "One comment"}] = before_duplicate
+
+    other_ticket = created_ticket(other, original)
+    refute other_ticket.id == ticket.id
+    assert other_ticket.organization_id == other.id
+    assert created_ticket(other, reply).id == other_ticket.id
+    assert_duplicate(other, original, other_ticket)
+    assert_duplicate(other, reply, other_ticket)
+    assert [%{body: "One comment"}] = Support.list_comments(other_ticket)
+    assert length(Support.list_tickets(org)) == 1
+    assert length(Support.list_tickets(other)) == 1
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A4"
+  test "authentication rejects bad signatures and timestamps before parsing and requires a nonempty secret" do
+    org = org_with_secret()
+    existing = created_ticket(org, email("auth-root"))
+    reply_body = Jason.encode!(email("auth-reply", %{"in_reply_to" => "auth-root"}))
+    now = System.system_time(:second)
+
+    invalid_options = [
+      [secret: "incorrect-key"],
+      [signature: String.duplicate("0", 64)],
+      [timestamp: Integer.to_string(now - 600)],
+      [timestamp: Integer.to_string(now + 600)],
+      [timestamp: "not-a-number"],
+      [timestamp: "123abc"],
+      [omit_headers: ["x-webhook-timestamp"]],
+      [omit_headers: ["x-webhook-signature"]]
+    ]
+
+    for opts <- invalid_options do
+      assert raw_request(org, reply_body, opts).status == 401
+      assert raw_request(org, "not JSON", opts).status == 401
+    end
+
+    timestamp = Integer.to_string(now)
+    uppercase = signature(@secret, timestamp, reply_body) |> String.upcase()
+    assert raw_request(org, reply_body, timestamp: timestamp, signature: uppercase).status == 401
+
+    # Whitespace is signed too: a signature for a different byte sequence is invalid.
+    signed_body = Jason.encode!(email("byte-sensitive"))
+
+    assert raw_request(org, signed_body <> " ",
+             timestamp: timestamp,
+             signature: signature(@secret, timestamp, signed_body)
+           ).status == 401
+
+    missing = organization_fixture()
+    empty = org_with_secret() |> Ecto.Changeset.change(webhook_secret: "") |> Repo.update!()
+
+    for no_secret <- [missing, empty] do
+      assert raw_request(no_secret, reply_body, secret: "").status == 401
+      assert raw_request(no_secret, "not JSON", secret: "").status == 401
+      assert Support.list_tickets(no_secret) == []
+    end
+
+    other = org_with_secret("organization-specific-key")
+    assert deliver(other, email("wrong-org-key"), secret: @secret).status == 401
+    assert Support.list_tickets(other) == []
+    assert length(Support.list_tickets(org)) == 1
+    assert Support.list_comments(existing) == []
+
+    assert created_ticket(org, email("within-past"), timestamp: Integer.to_string(now - 240)).organization_id ==
+             org.id
+
+    assert created_ticket(org, email("within-future"), timestamp: Integer.to_string(now + 240)).organization_id ==
+             org.id
+
+    # Future boundary is stable if the clock advances during dispatch; avoid a flaky past-boundary test.
+    edge = Integer.to_string(System.system_time(:second) + 300)
+
+    assert created_ticket(org, email("five-minute-boundary"), timestamp: edge).organization_id ==
+             org.id
+
+    expired = Integer.to_string(System.system_time(:second) - 301)
+    assert deliver(org, email("outside-five-minutes"), timestamp: expired).status == 401
+
+    # Authentic whitespace around JSON must not be normalized before verification.
+    exact = " \n" <> Jason.encode!(email("exact-raw-bytes")) <> "\n "
+    assert raw_request(org, exact).status == 201
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A5"
+  test "transport and payload failures return specified statuses without writes" do
+    org = org_with_secret()
+    unknown = %{slug: "absent-org-#{System.unique_integer([:positive])}", webhook_secret: @secret}
+    assert deliver(unknown, email("unknown-org")).status == 404
+    assert raw_request(org, "{invalid JSON}").status == 400
+
+    for field <- ["message_id", "from"] do
+      payload = email("missing-#{field}") |> Map.delete(field)
+      assert deliver(org, payload).status == 422
+    end
+
+    large = Jason.encode!(email("too-large", %{"text" => String.duplicate("x", 65_536)}))
+    assert byte_size(large) > 65_536
+    assert raw_request(org, large).status == 413
+    assert Support.list_tickets(org) == []
+
+    # The limit is on transmitted bytes; exactly 64 KiB is permitted, one more byte is not.
+    base = Jason.encode!(email("at-limit"))
+    boundary = base <> String.duplicate(" ", 65_536 - byte_size(base))
+    assert byte_size(boundary) == 65_536
+    assert raw_request(org, boundary <> " ").status == 413
+    assert Support.list_tickets(org) == []
+    response = raw_request(org, boundary)
+    assert response.status == 201
+    id = json_response(response, 201)["ticket_id"]
+    assert Support.get_ticket!(id).body == "Please help."
+    assert length(Support.list_tickets(org)) == 1
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A6"
+  test "manual ticket and comment behavior remains authored, validated and organization scoped" do
+    owner = user_fixture()
+    org = organization_fixture(owner)
+    other = organization_fixture()
+
+    {:ok, ticket} =
+      Support.create_ticket(org, owner, %{title: "Manual", body: "Original description"})
+
+    assert ticket.author_id == owner.id
+    assert ticket.assignee_id == nil
+    assert ticket.status == "open"
+    assert {:error, _} = Support.create_ticket(org, owner, %{title: String.duplicate("t", 201)})
+    assert {:error, _} = Support.add_comment(ticket, owner, %{body: "   "})
+    assert {:error, _} = Support.add_comment(ticket, owner, %{body: String.duplicate("c", 5_001)})
+    {:ok, first} = Support.add_comment(ticket, owner, %{body: "First manual comment"})
+    {:ok, second} = Support.add_comment(ticket, owner, %{body: "Second manual comment"})
+    assert Enum.map(Support.list_comments(ticket), & &1.id) == [first.id, second.id]
+    assert Enum.all?(Support.list_comments(ticket), &(&1.author_id == owner.id))
+    assert [listed] = Support.list_tickets(org)
+    assert listed.id == ticket.id
+    assert listed.comment_count == 2
+    assert listed.author.id == owner.id
+    assert Support.list_tickets(other) == []
+  end
+end
