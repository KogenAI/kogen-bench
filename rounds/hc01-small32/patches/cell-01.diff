@@ -77,9 +77,33 @@ defmodule Trackline.Support do
     do: Repo.get!(Ticket, id) |> Repo.preload([:organization, :author, :assignee])
 
   def create_ticket(%Organization{id: org_id}, %User{id: author_id}, attrs) do
-    %Ticket{organization_id: org_id, author_id: author_id}
-    |> Ticket.changeset(attrs)
-    |> Repo.insert()
+    changeset =
+      %Ticket{organization_id: org_id, author_id: author_id}
+      |> Ticket.changeset(attrs)
+
+    if changeset.valid? do
+      Repo.transact(
+        fn ->
+          # An immediate transaction serializes allocation across SQLite writers.
+          # This write also acquires the lock when called inside an existing transaction.
+          Ecto.Adapters.SQL.query!(Repo, "UPDATE organizations SET id = id WHERE id = ?", [org_id])
+
+          next_number =
+            Repo.one(
+              from t in Ticket,
+                where: t.organization_id == ^org_id,
+                select: max(t.number)
+            ) || 0
+
+          changeset
+          |> Ecto.Changeset.put_change(:number, next_number + 1)
+          |> Repo.insert()
+        end,
+        mode: :immediate
+      )
+    else
+      {:error, changeset}
+    end
   end
 
   def change_ticket(%Ticket{} = ticket, attrs \\ %{}), do: Ticket.changeset(ticket, attrs)
