index 42b634f..4c23b20 100644
--- a/lib/trackline/support.ex
+++ b/lib/trackline/support.ex
@@ -77,9 +77,32 @@ defmodule Trackline.Support do
     do: Repo.get!(Ticket, id) |> Repo.preload([:organization, :author, :assignee])
 
   def create_ticket(%Organization{id: org_id}, %User{id: author_id}, attrs) do
-    %Ticket{organization_id: org_id, author_id: author_id}
-    |> Ticket.changeset(attrs)
-    |> Repo.insert()
+    changeset =
+      %Ticket{organization_id: org_id, author_id: author_id}
+      |> Ticket.changeset(attrs)
+
+    if changeset.valid? do
+      Repo.transact(fn ->
+        # Acquire SQLite's write lock before reading MAX(number), so concurrent
+        # creates for the same organization cannot allocate the same value.
+        Repo.query!("UPDATE organizations SET id = id WHERE id = ?", [org_id])
+
+        next_number =
+          Repo.one(
+            from(t in Ticket,
+              where: t.organization_id == ^org_id,
+              select: coalesce(max(t.number), 0) + 1
+            )
+          )
+
+        changeset
+        |> Ecto.Changeset.put_change(:number, next_number)
+        |> Ecto.Changeset.unique_constraint([:organization_id, :number])
+        |> Repo.insert()
+      end)
+    else
+      {:error, changeset}
+    end
   end
 
   def change_ticket(%Ticket{} = ticket, attrs \\ %{}), do: Ticket.changeset(ticket, attrs)
