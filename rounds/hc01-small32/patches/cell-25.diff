+defmodule Trackline.Repo.Migrations.AddInboundEmailSupport do
+  use Ecto.Migration
+
+  def change do
+    alter table(:tickets) do
+      add :requester_email, :string
+    end
+
+    create table(:inbound_messages) do
+      add :organization_id, references(:organizations, on_delete: :delete_all), null: false
+      add :ticket_id, references(:tickets, on_delete: :delete_all), null: false
+      add :message_id, :text, null: false
+
+      timestamps(type: :utc_datetime)
+    end
+
+    create unique_index(:inbound_messages, [:organization_id, :message_id])
+    create index(:inbound_messages, [:ticket_id])
+  end
+end
diff --git a/test/acceptance/syn-31-inbound-email-webhook_test.exs b/test/acceptance/syn-31-inbound-email-webhook_test.exs
new file mode 100644
index 0000000..44c212e
--- /dev/null
+++ b/test/acceptance/syn-31-inbound-email-webhook_test.exs
@@ -0,0 +1,361 @@
+defmodule TracklineWeb.InboundEmailIntentAcceptanceTest do
+  use TracklineWeb.ConnCase, async: false
+
+  alias Trackline.Repo
+  alias Trackline.Support
+  alias Trackline.Support.{Comment, Organization, Ticket}
+
+  defp organization(secret \\ "inbound-acceptance-secret") do
+    slug = "email-#{System.unique_integer([:positive, :monotonic])}"
+    Repo.insert!(struct(Organization, name: slug, slug: slug, webhook_secret: secret))
+  end
+
+  defp email(message_id, attrs \\ %{}) do
+    Map.merge(
+      %{
+        "message_id" => message_id,
+        "from" => "${OWNER_EMAIL}",
+        "subject" => "Support needed",
+        "text" => "Please help."
+      },
+      attrs
+    )
+  end
+
+  defp signature(secret, timestamp, body) do
+    :crypto.mac(:hmac, :sha256, secret, timestamp <> "." <> body)
+    |> Base.encode16(case: :lower)
+  end
+
+  defp request(org, payload, opts \\ []) do
+    body = if is_binary(payload), do: payload, else: Jason.encode!(payload)
+    timestamp = Keyword.get(opts, :timestamp, Integer.to_string(System.system_time(:second)))
+    secret = Keyword.get(opts, :secret, Map.get(org, :webhook_secret) || "")
+    sig = Keyword.get(opts, :signature, signature(secret, timestamp, body))
+    conn = build_conn() |> put_req_header("content-type", "application/json")
+
+    conn =
+      if Keyword.get(opts, :omit_timestamp, false),
+        do: conn,
+        else: put_req_header(conn, "x-webhook-timestamp", timestamp)
+
+    conn =
+      if Keyword.get(opts, :omit_signature, false),
+        do: conn,
+        else: put_req_header(conn, "x-webhook-signature", sig)
+
+    post(conn, "/api/orgs/#{org.slug}/inbound-email", body)
+  end
+
+  defp created_ticket(org, payload) do
+    response = request(org, payload) |> json_response(201)
+    assert is_integer(response["ticket_id"])
+    Support.get_ticket!(response["ticket_id"])
+  end
+
+  defp counts do
+    {Repo.aggregate(Ticket, :count, :id), Repo.aggregate(Comment, :count, :id)}
+  end
+
+  defp assert_prefix(actual, original, limit) do
+    assert is_binary(actual)
+    assert String.length(actual) in 1..limit
+    assert String.starts_with?(original, actual)
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A1"
+  test "new emails preserve fields, ignore attachments, and normalize subjects" do
+    org = organization()
+
+    raw =
+      "{\n  \"message_id\": \"raw-new\", \"from\": \"${OWNER_EMAIL}\", " <>
+        "\"subject\": \"Printer broken\", \"text\": \"  Keep whitespace.\\n\", " <>
+        "\"attachments\": [{\"filename\": \"log.txt\", \"content\": \"ignored\"}]\n}"
+
+    ticket = created_ticket(org, raw)
+    assert ticket.organization_id == org.id
+    assert ticket.title == "Printer broken"
+    assert ticket.body == "  Keep whitespace.\n"
+    assert Map.fetch!(ticket, :requester_email) == "${OWNER_EMAIL}"
+    assert ticket.status == "open"
+    assert ticket.author_id == nil
+    assert ticket.assignee_id == nil
+    assert Support.list_comments(ticket) == []
+
+    long_subject = String.duplicate("é", 250)
+    long_text = String.duplicate("x", 50_000)
+    large = created_ticket(org, email("large", %{"subject" => long_subject, "text" => long_text}))
+    assert_prefix(large.title, long_subject, 200)
+    assert large.body == long_text
+    assert Map.fetch!(large, :requester_email) == "${OWNER_EMAIL}"
+    assert large.author_id == nil
+    assert large.assignee_id == nil
+    assert large.status == "open"
+
+    blank = created_ticket(org, email("blank", %{"subject" => ""}))
+    assert blank.title == "(no subject)"
+    assert length(Support.list_tickets(org)) == 3
+
+    # Neither a title already at its limit nor a long description is shortened unnecessarily.
+    title_at_limit = String.duplicate("t", 200)
+    exact = created_ticket(org, email("exact-title", %{"subject" => title_at_limit}))
+    assert exact.title == title_at_limit
+    assert exact.body == "Please help."
+    assert Map.fetch!(exact, :requester_email) == "${OWNER_EMAIL}"
+    assert counts() == {4, 0}
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A2"
+  test "reply chains create ordered shortened comments and foreign parents open tickets" do
+    org = organization()
+    root = created_ticket(org, email("root"))
+    first = request(org, email("reply-1", %{"in_reply_to" => "root", "text" => "First reply"}))
+    assert json_response(first, 201)["ticket_id"] == root.id
+    long_reply = String.duplicate("é", 5_501)
+
+    second =
+      request(
+        org,
+        email("reply-2", %{
+          "in_reply_to" => "reply-1",
+          "text" => long_reply,
+          "attachments" => [%{"filename" => "ignored.pdf"}]
+        })
+      )
+
+    assert json_response(second, 201)["ticket_id"] == root.id
+    third = request(org, email("reply-3", %{"in_reply_to" => "reply-2", "text" => "Last reply"}))
+    assert json_response(third, 201)["ticket_id"] == root.id
+    assert length(Support.list_tickets(org)) == 1
+    [a, b, c] = Support.list_comments(root)
+    assert a.body == "First reply"
+    assert_prefix(b.body, long_reply, 5_000)
+    assert c.body == "Last reply"
+
+    for comment <- [a, b, c] do
+      assert comment.author_id == nil
+      assert Map.get(comment, :assignee_id) == nil
+      assert comment.ticket_id == root.id
+    end
+
+    assert Support.get_ticket!(root.id).body == "Please help."
+
+    unknown =
+      created_ticket(
+        org,
+        email("orphan", %{"in_reply_to" => "not-delivered", "text" => "Orphan"})
+      )
+
+    refute unknown.id == root.id
+    assert unknown.body == "Orphan"
+    assert unknown.organization_id == org.id
+    assert unknown.title == "Support needed"
+    assert unknown.status == "open"
+    assert unknown.author_id == nil
+    assert unknown.assignee_id == nil
+    assert Map.fetch!(unknown, :requester_email) == "${OWNER_EMAIL}"
+    other = organization()
+
+    foreign =
+      created_ticket(other, email("foreign", %{"in_reply_to" => "reply-2", "text" => "Foreign"}))
+
+    assert foreign.organization_id == other.id
+    refute foreign.id == root.id
+    assert foreign.body == "Foreign"
+    assert foreign.status == "open"
+    assert foreign.author_id == nil
+    assert foreign.assignee_id == nil
+    assert Map.fetch!(foreign, :requester_email) == "${OWNER_EMAIL}"
+    assert Support.list_comments(foreign) == []
+    assert length(Support.list_comments(root)) == 3
+
+    # Later root replies are appended, not sorted into their parent's arrival position.
+    exact_reply = String.duplicate("r", 5_000)
+    fourth = request(org, email("reply-4", %{"in_reply_to" => "root", "text" => exact_reply}))
+    assert json_response(fourth, 201)["ticket_id"] == root.id
+    [same_a, same_b, same_c, d] = Support.list_comments(root)
+    assert [same_a.id, same_b.id, same_c.id] == [a.id, b.id, c.id]
+    assert d.body == exact_reply
+    assert d.author_id == nil
+    assert d.ticket_id == root.id
+    assert counts() == {3, 4}
+
+    # A foreign root identity, like a foreign reply identity, must not resolve across tenants.
+    foreign_root = created_ticket(other, email("foreign-root", %{"in_reply_to" => "root"}))
+    refute foreign_root.id == root.id
+    assert foreign_root.organization_id == other.id
+    assert Support.list_comments(foreign_root) == []
+    assert length(Support.list_comments(root)) == 4
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A3"
+  test "ticket and reply deliveries are idempotent independently in each organization" do
+    org = organization()
+    ticket = created_ticket(org, email("shared-id"))
+    before_duplicate = counts()
+    duplicate = request(org, email("shared-id")) |> json_response(200)
+    assert duplicate == %{"ticket_id" => ticket.id, "duplicate" => true}
+    assert counts() == before_duplicate
+    assert Support.list_comments(ticket) == []
+    assert Support.get_ticket!(ticket.id).body == "Please help."
+
+    reply = email("reply-id", %{"in_reply_to" => "shared-id", "text" => "A reply"})
+    assert json_response(request(org, reply), 201)["ticket_id"] == ticket.id
+    before_duplicate = counts()
+    [original_comment] = Support.list_comments(ticket)
+
+    assert json_response(request(org, reply), 200) == %{
+             "ticket_id" => ticket.id,
+             "duplicate" => true
+           }
+
+    assert counts() == before_duplicate
+    assert length(Support.list_comments(ticket)) == 1
+    [unchanged_comment] = Support.list_comments(ticket)
+    assert unchanged_comment.id == original_comment.id
+    assert unchanged_comment.body == "A reply"
+
+    other = organization()
+    other_ticket = created_ticket(other, email("shared-id"))
+    refute other_ticket.id == ticket.id
+    assert other_ticket.organization_id == other.id
+    assert json_response(request(other, reply), 201)["ticket_id"] == other_ticket.id
+    before_duplicate = counts()
+
+    assert json_response(request(other, reply), 200) == %{
+             "ticket_id" => other_ticket.id,
+             "duplicate" => true
+           }
+
+    assert counts() == before_duplicate
+    assert length(Support.list_comments(other_ticket)) == 1
+
+    # Every reply remains a resolvable parent even after duplicate delivery.
+    nested = email("nested-id", %{"in_reply_to" => "reply-id", "text" => "Nested reply"})
+    assert json_response(request(org, nested), 201)["ticket_id"] == ticket.id
+    assert json_response(request(other, nested), 201)["ticket_id"] == other_ticket.id
+    assert Enum.map(Support.list_comments(ticket), & &1.body) == ["A reply", "Nested reply"]
+    assert Enum.map(Support.list_comments(other_ticket), & &1.body) == ["A reply", "Nested reply"]
+    before_duplicate = counts()
+
+    assert json_response(request(org, nested), 200) == %{
+             "ticket_id" => ticket.id,
+             "duplicate" => true
+           }
+
+    assert counts() == before_duplicate
+  end
