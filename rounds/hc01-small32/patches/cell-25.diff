+++ b/lib/trackline_web/inbound_email_parsers.ex
@@ -0,0 +1,16 @@
+defmodule TracklineWeb.InboundEmailParsers do
+  @moduledoc false
+
+  # Inbound email requests are authenticated over their original bytes. Skip
+  # Plug.Parsers for this one route so neither JSON parsing nor body rewriting
+  # can happen before the webhook controller verifies the signature.
+  def init(opts), do: Plug.Parsers.init(opts)
+
+  def call(
+        %Plug.Conn{method: "POST", path_info: ["api", "orgs", _slug, "inbound-email"]} = conn,
+        _opts
+      ),
+      do: conn
+
+  def call(conn, opts), do: Plug.Parsers.call(conn, opts)
+end
