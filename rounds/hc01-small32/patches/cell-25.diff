diff --git a/lib/trackline_web/controllers/inbound_email_controller.ex b/lib/trackline_web/controllers/inbound_email_controller.ex
new file mode 100644
index 0000000..9ec74bb
--- /dev/null
+++ b/lib/trackline_web/controllers/inbound_email_controller.ex
@@ -0,0 +1,144 @@
+defmodule TracklineWeb.InboundEmailController do
+  use TracklineWeb, :controller
+
+  alias Trackline.Support
+  alias Trackline.Support.Organization
+
+  @max_body_bytes 65_536
+  @timestamp_window_seconds 300
+  @read_chunk_bytes 8_192
+
+  def create(conn, %{"slug" => slug}) do
+    case Support.get_organization_by_slug(slug) do
+      nil ->
+        send_resp(conn, :not_found, "")
+
+      %Organization{} = organization ->
+        handle_request(conn, organization)
+    end
+  end
+
+  defp handle_request(conn, organization) do
+    case read_raw_body(conn) do
+      {:error, :too_large, conn} ->
+        conn |> put_status(413) |> json(%{error: "payload too large"})
+
+      {:error, _reason, conn} ->
+        conn |> put_status(:bad_request) |> json(%{error: "invalid request body"})
+
+      {:ok, body, conn} ->
+        case authenticate(conn, organization, body) do
+          :ok -> decode_and_process(conn, organization, body)
+          :error -> conn |> put_status(:unauthorized) |> json(%{error: "unauthorized"})
+        end
+    end
+  end
+
+  defp decode_and_process(conn, organization, body) do
+    case Jason.decode(body) do
+      {:ok, payload} ->
+        case email_attrs(payload) do
+          {:ok, attrs} ->
+            case Support.create_inbound_email(organization, attrs) do
+              {:ok, :created, ticket_id} ->
+                conn |> put_status(:created) |> json(%{ticket_id: ticket_id})
+
+              {:ok, :duplicate, ticket_id} ->
+                conn
+                |> put_status(:ok)
+                |> json(%{ticket_id: ticket_id, duplicate: true})
+
+              {:error, _reason} ->
+                conn
+                |> put_status(:internal_server_error)
+                |> json(%{error: "unable to process email"})
+            end
+
+          {:error, :missing_identifiers} ->
+            conn |> put_status(:unprocessable_entity) |> json(%{error: "missing identifiers"})
+        end
+
+      {:error, _decode_error} ->
+        conn |> put_status(:bad_request) |> json(%{error: "invalid JSON"})
+    end
+  end
+
+  defp email_attrs(payload) when is_map(payload) do
+    message_id = Map.get(payload, "message_id")
+    from = Map.get(payload, "from")
+
+    if valid_identifier?(message_id) and valid_identifier?(from) do
+      {:ok,
+       %{
+         message_id: message_id,
+         from: from,
+         subject: string_value(Map.get(payload, "subject")),
+         text: string_value(Map.get(payload, "text")),
+         in_reply_to: string_value(Map.get(payload, "in_reply_to"))
+       }}
+    else
+      {:error, :missing_identifiers}
+    end
+  end
+
+  defp email_attrs(_), do: {:error, :missing_identifiers}
+
+  defp valid_identifier?(value), do: is_binary(value) and value != ""
+  defp string_value(value) when is_binary(value), do: value
+  defp string_value(_), do: ""
+
+  defp authenticate(conn, %Organization{webhook_secret: secret}, body)
+       when is_binary(secret) and byte_size(secret) > 0 do
+    timestamps = Plug.Conn.get_req_header(conn, "x-webhook-timestamp")
+    signatures = Plug.Conn.get_req_header(conn, "x-webhook-signature")
+
+    with [timestamp] <- timestamps,
+         [signature] <- signatures,
+         true <- Regex.match?(~r/\A[0-9]+\z/, timestamp),
+         {timestamp_seconds, ""} <- Integer.parse(timestamp),
+         true <- abs(System.system_time(:second) - timestamp_seconds) <= @timestamp_window_seconds,
+         true <- Regex.match?(~r/\A[0-9a-f]{64}\z/, signature),
+         expected <-
+           :crypto.mac(:hmac, :sha256, secret, timestamp <> "." <> body)
+           |> Base.encode16(case: :lower),
+         true <- Plug.Crypto.secure_compare(expected, signature) do
+      :ok
+    else
+      _ -> :error
+    end
+  end
+
+  defp authenticate(_conn, _organization, _body), do: :error
+
+  defp read_raw_body(conn), do: read_raw_body(conn, [], 0)
+
+  defp read_raw_body(conn, chunks, size) do
+    remaining = @max_body_bytes + 1 - size
+
+    case Plug.Conn.read_body(conn,
+           length: remaining,
+           read_length: min(@read_chunk_bytes, remaining)
+         ) do
+      {:ok, chunk, conn} ->
+        total = size + byte_size(chunk)
+
+        if total > @max_body_bytes do
+          {:error, :too_large, conn}
+        else
+          {:ok, IO.iodata_to_binary(Enum.reverse([chunk | chunks])), conn}
+        end
+
+      {:more, chunk, conn} ->
+        total = size + byte_size(chunk)
+
+        if total > @max_body_bytes do
+          {:error, :too_large, conn}
+        else
+          read_raw_body(conn, [chunk | chunks], total)
+        end
+
+      {:error, reason} ->
+        {:error, reason, conn}
+    end
+  end
+end
