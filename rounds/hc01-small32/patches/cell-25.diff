+  @tag intent: "syn-31-inbound-email-webhook/A4"
+  test "authentication uses exact bytes and refuses timestamps or secrets before parsing" do
+    org = organization()
+    now = System.system_time(:second)
+    payload = email("auth")
+    body = Jason.encode!(payload)
+    before_requests = counts()
+
+    invalid_options = [
+      [signature: String.duplicate("0", 64)],
+      [secret: "wrong-secret"],
+      [omit_timestamp: true],
+      [omit_signature: true],
+      [timestamp: "not-a-number"],
+      [timestamp: Integer.to_string(now - 301)],
+      [timestamp: Integer.to_string(now + 360)],
+      [timestamp: "#{now}garbage"],
+      [timestamp: ""],
+      [timestamp: "#{now}.5"],
+      [signature: ""]
+    ]
+
+    for opts <- invalid_options do
+      assert response(request(org, payload, opts), 401)
+      # Timestamp/signature errors take precedence even for a malformed JSON body.
+      assert response(request(org, "{not json", opts), 401)
+    end
+
+    timestamp = Integer.to_string(now)
+    correct = signature(org.webhook_secret, timestamp, body)
+    assert response(request(org, body <> " ", timestamp: timestamp, signature: correct), 401)
+
+    assert response(
+             request(org, body, timestamp: timestamp, signature: String.upcase(correct)),
+             401
+           )
+
+    assert response(request(org, "{not json", timestamp: "not-a-number"), 401)
+    assert response(request(org, "{not json", signature: String.duplicate("0", 64)), 401)
+
+    for secret <- [nil, ""] do
+      disabled = organization(secret)
+      assert response(request(disabled, payload, secret: ""), 401)
+      assert response(request(disabled, "{not json", secret: ""), 401)
+    end
+
+    # A genuine signature for another organization's key is still unauthorized here.
+    other = organization("another-organization-secret")
+    assert response(request(org, payload, secret: other.webhook_secret), 401)
+    assert response(request(other, payload, secret: org.webhook_secret), 401)
+    assert counts() == before_requests
+    # Exercise valid timestamps on both sides of the clock without a boundary race.
+    for offset <- [-240, 240] do
+      conn = request(org, email("valid-#{offset}"), timestamp: Integer.to_string(now + offset))
+      assert is_integer(json_response(conn, 201)["ticket_id"])
+    end
+
+    # The future boundary is inclusive and cannot age further into the future in transit.
+    boundary = Integer.to_string(System.system_time(:second) + 300)
+
+    assert is_integer(
+             json_response(request(org, email("future-boundary"), timestamp: boundary), 201)[
+               "ticket_id"
+             ]
+           )
+
+    assert is_integer(json_response(request(other, email("own-secret")), 201)["ticket_id"])
+  end
