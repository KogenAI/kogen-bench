index 42b634f..231e355 100644
--- a/lib/trackline/support.ex
+++ b/lib/trackline/support.ex
@@ -82,6 +82,125 @@ defmodule Trackline.Support do
     |> Repo.insert()
   end
 
+  @doc "Persist an authenticated inbound email and its identity atomically."
+  def create_inbound_email(%Organization{id: organization_id}, attrs) do
+    message_id = attrs.message_id
+    identity_module = Trackline.Support.InboundMessage
+
+    result =
+      Repo.transaction(fn ->
+        case Repo.get_by(identity_module,
+               organization_id: organization_id,
+               message_id: message_id
+             ) do
+          %{ticket_id: ticket_id} ->
+            {:duplicate, ticket_id}
+
+          nil ->
+            persist_inbound_email(organization_id, attrs)
+        end
+      end)
+
+    case result do
+      {:ok, {:created, ticket_id}} ->
+        {:ok, :created, ticket_id}
+
+      {:ok, {:duplicate, ticket_id}} ->
+        {:ok, :duplicate, ticket_id}
+
+      {:error, :duplicate_race} ->
+        case Repo.get_by(identity_module,
+               organization_id: organization_id,
+               message_id: message_id
+             ) do
+          %{ticket_id: ticket_id} -> {:ok, :duplicate, ticket_id}
+          nil -> {:error, :duplicate_not_found}
+        end
+
+      {:error, {:creation_error, changeset}} ->
+        {:error, changeset}
+
+      {:error, reason} ->
+        {:error, reason}
+    end
+  end
+
+  defp persist_inbound_email(organization_id, attrs) do
+    identity_module = Trackline.Support.InboundMessage
+
+    parent =
+      case attrs[:in_reply_to] do
+        parent_id when is_binary(parent_id) and parent_id != "" ->
+          Repo.get_by(identity_module,
+            organization_id: organization_id,
+            message_id: parent_id
+          )
+
+        _ ->
+          nil
+      end
+
+    {ticket_id, outcome} =
+      case parent do
+        %{ticket_id: ticket_id} ->
+          body = String.slice(attrs.text, 0, 5_000)
+
+          comment_changeset =
+            %Comment{ticket_id: ticket_id} |> Comment.inbound_changeset(%{body: body})
+
+          case Repo.insert(comment_changeset) do
+            {:ok, _comment} -> {ticket_id, :created}
+            {:error, changeset} -> Repo.rollback({:creation_error, changeset})
+          end
+
+        nil ->
+          title =
+            case attrs.subject do
+              "" -> "(no subject)"
+              subject -> String.slice(subject, 0, 200)
+            end
+
+          ticket_changeset =
+            %Ticket{organization_id: organization_id}
+            |> Ticket.inbound_changeset(%{
+              title: title,
+              body: attrs.text,
+              requester_email: attrs.from
+            })
+
+          case Repo.insert(ticket_changeset) do
+            {:ok, ticket} -> {ticket.id, :created}
+            {:error, changeset} -> Repo.rollback({:creation_error, changeset})
+          end
+      end
+
+    identity_changeset =
+      struct(identity_module)
+      |> identity_module.changeset(%{
+        organization_id: organization_id,
+        ticket_id: ticket_id,
+        message_id: attrs.message_id
+      })
+
+    case Repo.insert(identity_changeset) do
+      {:ok, _identity} ->
+        {outcome, ticket_id}
+
+      {:error, changeset} ->
+        if unique_identity_error?(changeset) do
+          Repo.rollback(:duplicate_race)
+        else
+          Repo.rollback({:creation_error, changeset})
+        end
+    end
+  end
+
+  defp unique_identity_error?(changeset) do
+    Enum.any?(changeset.errors, fn {_field, {_message, metadata}} ->
+      metadata[:constraint] == :unique
+    end)
+  end
+
   def change_ticket(%Ticket{} = ticket, attrs \\ %{}), do: Ticket.changeset(ticket, attrs)
 
   def set_status(%Ticket{} = ticket, status) do
