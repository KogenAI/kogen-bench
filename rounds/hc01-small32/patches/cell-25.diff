+  @tag intent: "syn-31-inbound-email-webhook/A5"
+  test "size and input errors have specified statuses without creating records" do
+    org = organization()
+    before_requests = counts()
+    missing = %{slug: "missing-#{System.unique_integer([:positive])}", webhook_secret: "secret"}
+    assert response(request(missing, email("unknown-org")), 404)
+    assert response(request(org, String.duplicate("x", 65_537)), 413)
+    assert response(request(org, "{not json"), 400)
+
+    for key <- ["message_id", "from"] do
+      assert response(request(org, Map.delete(email("missing-#{key}"), key)), 422)
+    end
+
+    assert counts() == before_requests
+
+    # Valid JSON must also be refused when its byte count exceeds the ceiling.
+    oversized = email("oversized-json", %{"text" => String.duplicate("x", 65_536)})
+    assert byte_size(Jason.encode!(oversized)) > 65_536
+    assert response(request(org, oversized), 413)
+
+    # The ceiling counts UTF-8 bytes, not JSON text characters.
+    multibyte_base = email("oversized-utf8", %{"text" => ""})
+    overhead = byte_size(Jason.encode!(multibyte_base))
+    remaining = 65_537 - overhead
+
+    multibyte_text =
+      String.duplicate("é", div(remaining, 2)) <> String.duplicate("x", rem(remaining, 2))
+
+    multibyte_body = Jason.encode!(Map.put(multibyte_base, "text", multibyte_text))
+    assert byte_size(multibyte_body) == 65_537
+    assert String.length(multibyte_body) < 65_536
+    assert response(request(org, multibyte_body), 413)
+    assert counts() == before_requests
+
+    # A valid body exactly at the inclusive byte ceiling must not be rejected.
+    base = email("byte-ceiling", %{"text" => ""})
+    overhead = byte_size(Jason.encode!(base))
+    text = String.duplicate("x", 65_536 - overhead)
+    body = Jason.encode!(Map.put(base, "text", text))
+    assert byte_size(body) == 65_536
+    ticket = created_ticket(org, body)
+    assert ticket.body == text
+  end
+end
