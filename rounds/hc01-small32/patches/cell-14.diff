+  @doc "Creates a ticket or comment from an authenticated inbound email, deduplicated per organization."
+  def create_inbound_email(%Organization{id: org_id} = organization, payload)
+      when is_map(payload) do
+    with {:ok, email} <- normalize_inbound_email(payload) do
+      transaction_result =
+        Repo.transaction(fn ->
+          case Repo.get_by(InboundEmailMessage,
+                 organization_id: org_id,
+                 message_id: email.message_id
+               ) do
+            %InboundEmailMessage{ticket_id: ticket_id} ->
+              {:duplicate, ticket_id}
+
+            nil ->
+              case insert_inbound_email(organization, email) do
+                {:ok, ticket_id} -> {:created, ticket_id}
+                {:error, reason} -> Repo.rollback({:failed, reason})
+              end
+          end
+        end)
+
+      case transaction_result do
+        {:ok, {:created, ticket_id}} ->
+          {:ok, ticket_id}
+
+        {:ok, {:duplicate, ticket_id}} ->
+          {:duplicate, ticket_id}
+
+        {:error, {:failed, reason}} ->
+          case Repo.get_by(InboundEmailMessage,
+                 organization_id: org_id,
+                 message_id: email.message_id
+               ) do
+            %InboundEmailMessage{ticket_id: ticket_id} -> {:duplicate, ticket_id}
+            nil -> {:error, reason}
+          end
+      end
+    end
+  end
+
+  def create_inbound_email(_organization, _payload), do: {:error, :invalid_payload}
+
+  defp normalize_inbound_email(payload) do
+    message_id = Map.get(payload, "message_id")
+    sender = Map.get(payload, "from")
+
+    if is_binary(message_id) and byte_size(message_id) > 0 and is_binary(sender) and
+         byte_size(sender) > 0 do
+      subject =
+        if is_binary(Map.get(payload, "subject")), do: Map.get(payload, "subject"), else: ""
+
+      text = if is_binary(Map.get(payload, "text")), do: Map.get(payload, "text"), else: ""
+      in_reply_to = Map.get(payload, "in_reply_to")
+      title = if subject == "", do: "(no subject)", else: String.slice(subject, 0, 200)
+
+      {:ok,
+       %{
+         message_id: message_id,
+         sender: sender,
+         title: title,
+         text: text,
+         in_reply_to: in_reply_to
+       }}
+    else
+      {:error, :invalid_payload}
+    end
+  end
+
+  defp insert_inbound_email(%Organization{id: org_id}, email) do
+    ticket_id =
+      case email.in_reply_to do
+        reference when is_binary(reference) and reference != "" ->
+          case Repo.get_by(InboundEmailMessage,
+                 organization_id: org_id,
+                 message_id: reference
+               ) do
+            %InboundEmailMessage{ticket_id: existing_ticket_id} ->
+              insert_inbound_comment(existing_ticket_id, email.text)
+
+            nil ->
+              insert_inbound_ticket(org_id, email)
+          end
+
+        _ ->
+          insert_inbound_ticket(org_id, email)
+      end
+
+    with {:ok, ticket_id} <- ticket_id,
+         {:ok, _message} <-
+           %InboundEmailMessage{}
+           |> InboundEmailMessage.changeset(%{
+             organization_id: org_id,
+             ticket_id: ticket_id,
+             message_id: email.message_id
+           })
+           |> Repo.insert() do
+      {:ok, ticket_id}
+    end
+  end
+
+  defp insert_inbound_ticket(org_id, email) do
+    %Ticket{
+      organization_id: org_id,
+      title: email.title,
+      body: email.text,
+      requester_email: email.sender,
+      status: "open",
+      priority: "normal"
+    }
+    |> Ecto.Changeset.change()
+    |> Repo.insert()
+    |> case do
+      {:ok, ticket} -> {:ok, ticket.id}
+      {:error, changeset} -> {:error, changeset}
+    end
+  end
+
+  defp insert_inbound_comment(ticket_id, text) do
+    body = String.slice(text, 0, 5_000)
+
+    %Comment{ticket_id: ticket_id, body: body}
+    |> Ecto.Changeset.change()
+    |> Repo.insert()
+    |> case do
+      {:ok, _comment} -> {:ok, ticket_id}
+      {:error, changeset} -> {:error, changeset}
+    end
+  end
+
   def create_ticket(%Organization{id: org_id}, %User{id: author_id}, attrs) do
     %Ticket{organization_id: org_id, author_id: author_id}
     |> Ticket.changeset(attrs)
