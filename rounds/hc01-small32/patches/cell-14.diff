diff --git a/lib/trackline_web/plugs/raw_inbound_email_body.ex b/lib/trackline_web/plugs/raw_inbound_email_body.ex
new file mode 100644
index 0000000..86d33af
--- /dev/null
+++ b/lib/trackline_web/plugs/raw_inbound_email_body.ex
@@ -0,0 +1,62 @@
+defmodule TracklineWeb.Plugs.RawInboundEmailBody do
+  @moduledoc false
+  import Plug.Conn
+
+  @max_bytes 65_536
+
+  def init(opts), do: opts
+
+  def call(conn, _opts) do
+    if inbound_email_request?(conn) do
+      case read_bounded_body(conn, "") do
+        {:ok, body, conn} ->
+          conn
+          |> put_private(:inbound_email_raw_body, body)
+          |> Map.put(:body_params, %{})
+
+        {:too_large, conn} ->
+          conn
+          |> put_resp_content_type("application/json")
+          |> send_resp(413, ~s({"error":"payload too large"}))
+          |> halt()
+
+        {:error, conn} ->
+          conn
+          |> put_resp_content_type("application/json")
+          |> send_resp(400, ~s({"error":"invalid request body"}))
+          |> halt()
+      end
+    else
+      conn
+    end
+  end
+
+  defp inbound_email_request?(%{
+         method: "POST",
+         path_info: ["api", "orgs", _slug, "inbound-email"]
+       }),
+       do: true
+
+  defp inbound_email_request?(_conn), do: false
+
+  defp read_bounded_body(conn, accumulated) do
+    remaining = @max_bytes - byte_size(accumulated)
+    read_size = remaining + 1
+
+    case Plug.Conn.read_body(conn, length: read_size, read_length: read_size) do
+      {:ok, chunk, conn} ->
+        body = accumulated <> chunk
+        if byte_size(body) > @max_bytes, do: {:too_large, conn}, else: {:ok, body, conn}
+
+      {:more, chunk, conn} ->
+        body = accumulated <> chunk
+
+        if byte_size(body) > @max_bytes,
+          do: {:too_large, conn},
+          else: read_bounded_body(conn, body)
+
+      {:error, _reason} ->
+        {:error, conn}
+    end
+  end
+end
