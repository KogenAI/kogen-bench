diff --git a/test/acceptance/syn-31-inbound-email-webhook_test.exs b/test/acceptance/syn-31-inbound-email-webhook_test.exs
new file mode 100644
index 0000000..747bee8
--- /dev/null
+++ b/test/acceptance/syn-31-inbound-email-webhook_test.exs
@@ -0,0 +1,312 @@
+defmodule TracklineWeb.InboundEmailIntentTest do
+  use TracklineWeb.ConnCase, async: false
+
+  alias Trackline.Repo
+  alias Trackline.Support
+  alias Trackline.Support.{Comment, Organization, Ticket}
+
+  defp organization(secret \\ "email-provider-secret") do
+    slug = "inbound-#{System.unique_integer([:positive, :monotonic])}"
+
+    Organization
+    |> struct()
+    |> Ecto.Changeset.change(name: "Inbound support", slug: slug, webhook_secret: secret)
+    |> Repo.insert!()
+  end
+
+  defp email(id, overrides \\ %{}) do
+    Map.merge(
+      %{
+        "message_id" => id,
+        "from" => "${OWNER_EMAIL}",
+        "subject" => "Please help",
+        "text" => "I need support."
+      },
+      overrides
+    )
+  end
+
+  defp signature(secret, timestamp, body) do
+    :crypto.mac(:hmac, :sha256, secret, timestamp <> "." <> body)
+    |> Base.encode16(case: :lower)
+  end
+
+  defp deliver_raw(org, body, opts \\ []) do
+    timestamp = Keyword.get(opts, :timestamp, Integer.to_string(System.system_time(:second)))
+    secret = Keyword.get(opts, :secret, Map.get(org, :webhook_secret) || "")
+    sig = Keyword.get(opts, :signature, signature(secret, timestamp, body))
+
+    conn =
+      build_conn()
+      |> put_req_header("content-type", "application/json")
+      |> put_req_header("x-webhook-timestamp", timestamp)
+      |> put_req_header("x-webhook-signature", sig)
+
+    conn = Enum.reduce(Keyword.get(opts, :omit, []), conn, &delete_req_header(&2, &1))
+    post(conn, "/api/orgs/#{org.slug}/inbound-email", body)
+  end
+
+  defp deliver(org, payload, opts \\ []) do
+    deliver_raw(org, Jason.encode!(payload), opts)
+  end
+
+  defp created_id(conn) do
+    assert %{"ticket_id" => id} = json_response(conn, 201)
+    assert is_integer(id) or is_binary(id)
+    id
+  end
+
+  defp counts do
+    {Repo.aggregate(Ticket, :count, :id), Repo.aggregate(Comment, :count, :id)}
+  end
+
+  defp assert_prefix(actual, original, limit) do
+    assert is_binary(actual)
+    assert String.length(actual) in 1..limit
+    assert String.starts_with?(original, actual)
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A1"
+  test "new emails preserve content and sender while normalizing titles and ignoring attachments" do
+    org = organization()
+    before_counts = counts()
+
+    payload =
+      email("new-email", %{
+        "text" => "First line\nSecond line",
+        "attachments" => [%{"name" => "receipt.pdf", "content" => "ignored"}]
+      })
+
+    # The signature covers the original whitespace, not a JSON re-encoding.
+    body = " \n" <> Jason.encode!(payload, pretty: true) <> "\n"
+    id = org |> deliver_raw(body) |> created_id()
+    ticket = Repo.get!(Ticket, id)
+    assert ticket.organization_id == org.id
+    assert ticket.title == payload["subject"]
+    assert ticket.body == payload["text"]
+    assert Map.get(ticket, :requester_email) == payload["from"]
+    assert ticket.status == "open"
+    assert ticket.author_id == nil
+    assert ticket.assignee_id == nil
+    assert Support.list_comments(ticket) == []
+
+    empty_id = org |> deliver(email("empty-subject", %{"subject" => ""})) |> created_id()
+    assert Repo.get!(Ticket, empty_id).title == "(no subject)"
+
+    title = String.duplicate("é", 250)
+    text = String.duplicate("x", 50_000)
+    long_payload = email("long-content", %{"subject" => title, "text" => text})
+    assert byte_size(Jason.encode!(long_payload)) < 65_536
+    long_id = org |> deliver(long_payload) |> created_id()
+    long_ticket = Repo.get!(Ticket, long_id)
+    assert_prefix(long_ticket.title, title, 200)
+    assert long_ticket.body == text
+    assert Map.get(long_ticket, :requester_email) == "${OWNER_EMAIL}"
+    assert long_ticket.author_id == nil
+    assert long_ticket.assignee_id == nil
+    assert long_ticket.status == "open"
+    assert counts() == {elem(before_counts, 0) + 3, elem(before_counts, 1)}
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A2"
+  test "reply chains become ordered comments and references cannot cross organizations" do
+    org = organization()
+    other = organization("other-secret")
+    before_counts = counts()
+    id = org |> deliver(email("root")) |> created_id()
+    ticket = Repo.get!(Ticket, id)
+
+    reply_id =
+      org
+      |> deliver(email("reply", %{"in_reply_to" => "root", "text" => "First reply"}))
+      |> created_id()
+
+    assert reply_id == id
+    text = String.duplicate("é", 6_001)
+
+    nested_id =
+      org |> deliver(email("nested", %{"in_reply_to" => "reply", "text" => text})) |> created_id()
+
+    assert nested_id == id
+
+    final_id =
+      org
+      |> deliver(email("last", %{"in_reply_to" => "nested", "text" => "Last reply"}))
+      |> created_id()
+
+    assert final_id == id
+    comments = Support.list_comments(ticket)
+    assert length(comments) == 3
+    assert Enum.at(comments, 0).body == "First reply"
+    assert_prefix(Enum.at(comments, 1).body, text, 5_000)
+    assert Enum.at(comments, 2).body == "Last reply"
+    assert Enum.all?(comments, &is_nil(&1.author_id))
+    assert Enum.all?(comments, &(&1.ticket_id == id))
+    assert Repo.get!(Ticket, id).body == "I need support."
+    assert counts() == {elem(before_counts, 0) + 1, elem(before_counts, 1) + 3}
+
+    unknown_id =
+      org |> deliver(email("unknown-reply", %{"in_reply_to" => "never-received"})) |> created_id()
+
+    assert unknown_id != id
+    unknown_ticket = Repo.get!(Ticket, unknown_id)
+    assert unknown_ticket.organization_id == org.id
+    assert unknown_ticket.status == "open"
+    assert unknown_ticket.author_id == nil
+    assert unknown_ticket.assignee_id == nil
+    assert Map.get(unknown_ticket, :requester_email) == "${OWNER_EMAIL}"
+    assert Support.list_comments(unknown_ticket) == []
+
+    cross_id = other |> deliver(email("cross-reply", %{"in_reply_to" => "reply"})) |> created_id()
+    assert cross_id != id
+    cross_ticket = Repo.get!(Ticket, cross_id)
+    assert cross_ticket.organization_id == other.id
+    assert cross_ticket.status == "open"
+    assert cross_ticket.author_id == nil
+    assert cross_ticket.assignee_id == nil
+    assert Map.get(cross_ticket, :requester_email) == "${OWNER_EMAIL}"
+    assert Support.list_comments(cross_ticket) == []
+    assert length(Support.list_comments(ticket)) == 3
+    assert counts() == {elem(before_counts, 0) + 3, elem(before_counts, 1) + 3}
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A3"
+  test "duplicate root and reply deliveries are successful no-ops scoped to the organization" do
+    org = organization()
+    other = organization("other-secret")
+    payload = email("shared-message")
+    id = org |> deliver(payload) |> created_id()
+    original_counts = counts()
+    original_ticket = Repo.get!(Ticket, id)
+    assert json_response(deliver(org, payload), 200) == %{"ticket_id" => id, "duplicate" => true}
+    assert counts() == original_counts
+    assert Repo.get!(Ticket, id) == original_ticket
+
+    other_id = other |> deliver(payload) |> created_id()
+    assert other_id != id
+    assert Repo.get!(Ticket, other_id).organization_id == other.id
+    assert counts() == {elem(original_counts, 0) + 1, elem(original_counts, 1)}
+
+    reply = email("shared-reply", %{"in_reply_to" => "shared-message", "text" => "Reply content"})
+    assert org |> deliver(reply) |> created_id() == id
+    reply_counts = counts()
+    original_comments = Support.list_comments(Repo.get!(Ticket, id))
+    assert json_response(deliver(org, reply), 200) == %{"ticket_id" => id, "duplicate" => true}
+    assert counts() == reply_counts
+    assert Support.list_comments(Repo.get!(Ticket, id)) == original_comments
+    assert other |> deliver(reply) |> created_id() == other_id
+
+    assert json_response(deliver(other, reply), 200) == %{
+             "ticket_id" => other_id,
+             "duplicate" => true
+           }
+
+    assert Enum.map(Support.list_comments(Repo.get!(Ticket, id)), & &1.body) == ["Reply content"]
+
+    assert Enum.map(Support.list_comments(Repo.get!(Ticket, other_id)), & &1.body) == [
+             "Reply content"
+           ]
+
+    assert counts() == {elem(reply_counts, 0), elem(reply_counts, 1) + 1}
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A4"
+  test "authentication checks raw bytes, numeric freshness and nonempty secrets before parsing" do
+    org = organization()
+    before_counts = counts()
+    now = System.system_time(:second)
+    body = Jason.encode!(email("auth"))
+    timestamp = Integer.to_string(now)
+
+    assert deliver_raw(org, body, secret: "wrong-secret").status == 401
+
+    assert deliver_raw(org, body <> " ",
+             timestamp: timestamp,
+             signature: signature(org.webhook_secret, timestamp, body)
+           ).status == 401
+
+    assert deliver_raw(org, body, signature: String.duplicate("0", 64)).status == 401
+    assert deliver_raw(org, body, signature: "malformed").status == 401
+    assert deliver_raw(org, body, timestamp: Integer.to_string(now - 360)).status == 401
+    assert deliver_raw(org, body, timestamp: Integer.to_string(now + 360)).status == 401
+    # These invalid timestamps are nevertheless signed with the correct key.
+    assert deliver_raw(org, "not JSON", timestamp: "not-a-number").status == 401
+    assert deliver_raw(org, "not JSON", timestamp: "#{now}junk").status == 401
+    assert deliver_raw(org, "not JSON", signature: String.duplicate("0", 64)).status == 401
+    assert deliver_raw(org, body, omit: ["x-webhook-timestamp"]).status == 401
+    assert deliver_raw(org, body, omit: ["x-webhook-signature"]).status == 401
+
+    for secret <- [nil, ""] do
+      no_secret_org = organization(secret)
+      assert Repo.get!(Organization, no_secret_org.id).webhook_secret == secret
+      assert deliver(no_secret_org, email("no-secret"), secret: "").status == 401
+      assert deliver_raw(no_secret_org, "not JSON", secret: "").status == 401
+    end
+
+    assert counts() == before_counts
+
+    past_id =
+      org
+      |> deliver(email("recent-past"), timestamp: Integer.to_string(now - 240))
+      |> created_id()
+
+    future_id =
+      org
+      |> deliver(email("near-future"), timestamp: Integer.to_string(now + 240))
+      |> created_id()
+
+    assert past_id != future_id
+    assert counts() == {elem(before_counts, 0) + 2, elem(before_counts, 1)}
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A5"
+  test "organization, size, JSON and required-field errors have the specified status and no side effects" do
+    org = organization()
+    before_counts = counts()
+    unknown = %{slug: "missing-#{System.unique_integer([:positive])}", webhook_secret: "unused"}
+    assert deliver(unknown, email("unknown-org")).status == 404
+    assert deliver_raw(org, "not JSON").status == 400
+
+    for field <- ["message_id", "from"] do
+      assert deliver(org, Map.delete(email("missing-#{field}"), field)).status == 422
+    end
+
+    # A valid JSON body one byte above the maximum must be rejected.
+    base = Jason.encode!(email("oversized"))
+    too_large = base <> String.duplicate(" ", 65_537 - byte_size(base))
+    assert byte_size(too_large) == 65_537
+    assert deliver_raw(org, too_large).status == 413
+    assert counts() == before_counts
+
+    base = Jason.encode!(email("at-limit"))
+    at_limit = base <> String.duplicate(" ", 65_536 - byte_size(base))
+    assert byte_size(at_limit) == 65_536
+    id = org |> deliver_raw(at_limit) |> created_id()
+    assert Repo.get!(Ticket, id).title == "Please help"
+    assert counts() == {elem(before_counts, 0) + 1, elem(before_counts, 1)}
+  end
