new file mode 100644
index 0000000..ca1c246
--- /dev/null
+++ b/lib/trackline_web/controllers/inbound_email_controller.ex
@@ -0,0 +1,65 @@
+defmodule TracklineWeb.InboundEmailController do
+  use TracklineWeb, :controller
+
+  alias Trackline.Support
+
+  def create(conn, %{"slug" => slug}) do
+    case Support.get_organization_by_slug(slug) do
+      nil ->
+        conn |> put_status(:not_found) |> json(%{error: "not found"})
+
+      organization ->
+        raw_body = conn.private[:inbound_email_raw_body] || ""
+
+        if authenticated?(conn, organization.webhook_secret, raw_body) do
+          process_payload(conn, organization, raw_body)
+        else
+          conn |> put_status(:unauthorized) |> json(%{error: "unauthorized"})
+        end
+    end
+  end
+
+  defp authenticated?(conn, secret, raw_body) when is_binary(secret) and byte_size(secret) > 0 do
+    with [timestamp] <- get_req_header(conn, "x-webhook-timestamp"),
+         [signature] <- get_req_header(conn, "x-webhook-signature"),
+         true <- Regex.match?(~r/\A[0-9]+\z/, timestamp),
+         {unix_seconds, ""} <- Integer.parse(timestamp),
+         true <- abs(System.system_time(:second) - unix_seconds) <= 300,
+         true <- Regex.match?(~r/\A[0-9a-f]{64}\z/, signature) do
+      expected =
+        :crypto.mac(:hmac, :sha256, secret, timestamp <> "." <> raw_body)
+        |> Base.encode16(case: :lower)
+
+      Plug.Crypto.secure_compare(signature, expected)
+    else
+      _ -> false
+    end
+  end
+
+  defp authenticated?(_conn, _secret, _raw_body), do: false
+
+  defp process_payload(conn, organization, raw_body) do
+    case Jason.decode(raw_body) do
+      {:ok, payload} when is_map(payload) ->
+        case Support.create_inbound_email(organization, payload) do
+          {:ok, ticket_id} ->
+            conn |> put_status(:created) |> json(%{ticket_id: ticket_id})
+
+          {:duplicate, ticket_id} ->
+            json(conn, %{ticket_id: ticket_id, duplicate: true})
+
+          {:error, :invalid_payload} ->
+            conn |> put_status(:unprocessable_entity) |> json(%{error: "invalid payload"})
+
+          {:error, _reason} ->
+            conn |> put_status(:unprocessable_entity) |> json(%{error: "invalid payload"})
+        end
+
+      {:ok, _other} ->
+        conn |> put_status(:unprocessable_entity) |> json(%{error: "invalid payload"})
+
+      {:error, _error} ->
+        conn |> put_status(:bad_request) |> json(%{error: "invalid JSON"})
+    end
+  end
+end
