+defmodule Trackline.Repo.Migrations.AddInboundEmailDeliveries do
+  use Ecto.Migration
+
+  def change do
+    alter table(:tickets) do
+      add :requester_email, :string
+    end
+
+    create table(:inbound_email_deliveries) do
+      add :organization_id, references(:organizations, on_delete: :delete_all), null: false
+      add :message_id, :string, null: false
+      add :ticket_id, references(:tickets, on_delete: :delete_all), null: false
+
+      timestamps(type: :utc_datetime)
+    end
+
+    create unique_index(:inbound_email_deliveries, [:organization_id, :message_id])
+    create index(:inbound_email_deliveries, [:ticket_id])
+  end
+end
diff --git a/test/acceptance/syn-31-inbound-email-webhook_test.exs b/test/acceptance/syn-31-inbound-email-webhook_test.exs
new file mode 100644
index 0000000..a7ae324
--- /dev/null
+++ b/test/acceptance/syn-31-inbound-email-webhook_test.exs
@@ -0,0 +1,309 @@
+defmodule Trackline.InboundEmailIntentAcceptanceTest do
+  use ExUnit.Case, async: false
+
+  import Phoenix.ConnTest
+  import Plug.Conn, only: [put_req_header: 3]
+
+  alias Trackline.Repo
+  alias Trackline.Support
+  alias Trackline.Support.{Comment, Organization, Ticket}
+
+  @endpoint TracklineWeb.Endpoint
+
+  setup do
+    pid = Ecto.Adapters.SQL.Sandbox.start_owner!(Repo, shared: true)
+    on_exit(fn -> Ecto.Adapters.SQL.Sandbox.stop_owner(pid) end)
+    {:ok, org: organization("primary", "primary-secret")}
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A1"
+  test "emails create normalized tickets with full descriptions and ignored attachments", %{
+    org: org
+  } do
+    payload =
+      email("initial")
+      |> Map.put("attachments", [%{"filename" => "report.pdf", "content" => "ignored"}])
+
+    id = created_id(deliver(org, payload))
+    ticket = Repo.get!(Ticket, id)
+    assert ticket.organization_id == org.id
+    assert ticket.title == payload["subject"]
+    assert ticket.body == payload["text"]
+    assert Map.get(ticket, :requester_email) == payload["from"]
+    assert ticket.status == "open"
+    assert ticket.author_id == nil
+    assert ticket.assignee_id == nil
+    assert Support.list_comments(ticket) == []
+
+    empty_id = created_id(deliver(org, email("empty") |> Map.put("subject", "")))
+    assert Repo.get!(Ticket, empty_id).title == "(no subject)"
+
+    subject = String.duplicate("é", 250)
+    text = String.duplicate("x", 50_000)
+    large = email("large") |> Map.merge(%{"subject" => subject, "text" => text})
+    assert byte_size(Jason.encode!(large)) < 65_536
+    large_id = created_id(deliver(org, large))
+    large_ticket = Repo.get!(Ticket, large_id)
+    assert_prefix(large_ticket.title, subject, 200)
+    assert large_ticket.body == text
+    assert Map.get(large_ticket, :requester_email) == large["from"]
+    assert length(Support.list_tickets(org)) == 3
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A2"
+  test "reply chains append ordered comments and do not cross organization boundaries", %{
+    org: org
+  } do
+    id = created_id(deliver(org, email("root")))
+    first = email("reply-one") |> Map.merge(%{"in_reply_to" => "root", "text" => "first reply"})
+    assert created_id(deliver(org, first)) == id
+    long_text = String.duplicate("é", 5_500)
+    second = email("reply-two") |> Map.merge(%{"in_reply_to" => "reply-one", "text" => long_text})
+    assert created_id(deliver(org, second)) == id
+
+    third =
+      email("reply-three") |> Map.merge(%{"in_reply_to" => "reply-two", "text" => "third reply"})
+
+    assert created_id(deliver(org, third)) == id
+
+    ticket = Repo.get!(Ticket, id)
+    comments = Support.list_comments(ticket)
+    assert length(comments) == 3
+    [one, two, three] = comments
+    assert one.body == "first reply"
+    assert_prefix(two.body, long_text, 5_000)
+    assert three.body == "third reply"
+    assert Enum.all?(comments, &(&1.author_id == nil))
+    assert ticket.author_id == nil
+    assert ticket.assignee_id == nil
+    assert length(Support.list_tickets(org)) == 1
+
+    unknown = email("unknown-parent") |> Map.put("in_reply_to", "never-seen")
+    unknown_id = created_id(deliver(org, unknown))
+    assert unknown_id != id
+    assert Repo.get!(Ticket, unknown_id).body == unknown["text"]
+
+    other = organization("other", "other-secret")
+    foreign = email("foreign-reply") |> Map.put("in_reply_to", "root")
+    foreign_id = created_id(deliver(other, foreign))
+    foreign_ticket = Repo.get!(Ticket, foreign_id)
+    assert foreign_ticket.organization_id == other.id
+    assert foreign_id != id
+    assert Support.list_comments(foreign_ticket) == []
+    assert length(Support.list_comments(ticket)) == 3
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A3"
+  test "duplicate tickets and comments are no-ops scoped to the receiving organization", %{
+    org: org
+  } do
+    root = email("shared-id")
+    id = created_id(deliver(org, root))
+    before_ticket = Repo.get!(Ticket, id)
+    duplicate = deliver(org, root) |> json_response(200)
+    assert duplicate == %{"ticket_id" => id, "duplicate" => true}
+    assert Repo.get!(Ticket, id) == before_ticket
+    assert length(Support.list_tickets(org)) == 1
+
+    reply = email("shared-reply") |> Map.put("in_reply_to", "shared-id")
+    assert created_id(deliver(org, reply)) == id
+    before_comments = Support.list_comments(before_ticket)
+    assert length(before_comments) == 1
+    assert json_response(deliver(org, reply), 200) == %{"ticket_id" => id, "duplicate" => true}
+    assert Support.list_comments(before_ticket) == before_comments
+    assert length(Support.list_tickets(org)) == 1
+
+    other = organization("independent", "independent-secret")
+    other_id = created_id(deliver(other, root))
+    assert other_id != id
+    assert Repo.get!(Ticket, other_id).organization_id == other.id
+    assert created_id(deliver(other, reply)) == other_id
+    assert length(Support.list_comments(Repo.get!(Ticket, other_id))) == 1
+
+    assert json_response(deliver(other, root), 200) == %{
+             "ticket_id" => other_id,
+             "duplicate" => true
+           }
+
+    assert json_response(deliver(other, reply), 200) == %{
+             "ticket_id" => other_id,
+             "duplicate" => true
+           }
+
+    assert Support.list_comments(before_ticket) == before_comments
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A4"
+  test "authentication precedes parsing and binds exact bytes, timestamp, and nonempty secret", %{
+    org: org
+  } do
+    now = System.system_time(:second)
+
+    for offset <- [-240, 0, 240] do
+      body = Jason.encode!(email("valid-#{offset}"))
+      timestamp = Integer.to_string(now + offset)
+
+      assert raw(org, body, timestamp, signature(org.webhook_secret, timestamp, body)).status ==
+               201
+    end
+
+    assert length(Support.list_tickets(org)) == 3
+    valid_body = Jason.encode!(email("must-not-create"))
+    timestamp = Integer.to_string(now)
+
+    assert raw(org, valid_body, timestamp, String.duplicate("0", 64)).status == 401
+
+    assert raw(org, valid_body, timestamp, signature("wrong-secret", timestamp, valid_body)).status ==
+             401
+
+    assert raw(
+             org,
+             valid_body <> " ",
+             timestamp,
+             signature(org.webhook_secret, timestamp, valid_body)
+           ).status == 401
+
+    assert raw(org, valid_body, nil, nil).status == 401
+    assert raw(org, valid_body, timestamp, nil).status == 401
+
+    for offset <- [-600, 600] do
+      stale = Integer.to_string(now + offset)
+
+      assert raw(org, valid_body, stale, signature(org.webhook_secret, stale, valid_body)).status ==
+               401
+    end
+
+    for bad_timestamp <- ["not-a-number", "#{now}junk", "#{now}.5"] do
+      body = "not JSON"
+      sig = signature(org.webhook_secret, bad_timestamp, body)
+      assert raw(org, body, bad_timestamp, sig).status == 401
+    end
+
+    assert raw(org, "not JSON", timestamp, String.duplicate("0", 64)).status == 401
+
+    for secret <- [nil, ""] do
+      unconfigured = organization("unconfigured", secret)
+      empty_sig = signature("", timestamp, "not JSON")
+      assert raw(unconfigured, "not JSON", timestamp, empty_sig).status == 401
+      assert Support.list_tickets(unconfigured) == []
+    end
+
+    assert length(Support.list_tickets(org)) == 3
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A5"
+  test "transport errors and invalid required fields return specified statuses without writes", %{
+    org: org
+  } do
+    timestamp = Integer.to_string(System.system_time(:second))
+
+    unknown = %{
+      slug: "absent-#{System.unique_integer([:positive])}",
+      webhook_secret: "irrelevant"
+    }
+
+    assert deliver(unknown, email("unknown-org")).status == 404
+
+    oversized =
+      Jason.encode!(email("too-large") |> Map.put("text", String.duplicate("x", 65_536)))
+
+    assert byte_size(oversized) > 65_536
+
+    assert raw(org, oversized, timestamp, signature(org.webhook_secret, timestamp, oversized)).status ==
+             413
+
+    malformed = "{not valid JSON"
+
+    assert raw(org, malformed, timestamp, signature(org.webhook_secret, timestamp, malformed)).status ==
+             400
+
+    for missing <- ["message_id", "from"] do
+      payload = email("missing-#{missing}") |> Map.delete(missing)
+      assert deliver(org, payload).status == 422
+    end
+
+    assert Support.list_tickets(org) == []
+    assert Repo.aggregate(Comment, :count, :id) == 0
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A6"
+  test "the raw request limit includes exactly 64 KiB but excludes one byte more", %{org: org} do
+    base = email("boundary") |> Map.put("text", "")
+    text = String.duplicate("x", 65_536 - byte_size(Jason.encode!(base)))
+    body = Jason.encode!(Map.put(base, "text", text))
+    assert byte_size(body) == 65_536
+    timestamp = Integer.to_string(System.system_time(:second))
+    id = created_id(raw(org, body, timestamp, signature(org.webhook_secret, timestamp, body)))
+    assert Repo.get!(Ticket, id).body == text
+
+    # Trailing whitespace is valid JSON and is still part of the signed request bytes.
+    larger_body = body <> " "
+    assert byte_size(larger_body) == 65_537
+    assert Jason.decode!(larger_body) == Jason.decode!(body)
+
+    assert raw(
+             org,
+             larger_body,
+             timestamp,
+             signature(org.webhook_secret, timestamp, larger_body)
+           ).status == 413
+
+    assert length(Support.list_tickets(org)) == 1
+    assert Repo.aggregate(Comment, :count, :id) == 0
+  end
+
+  defp organization(prefix, secret) do
+    suffix = System.unique_integer([:positive, :monotonic])
+
+    struct(Organization,
+      name: "Email acceptance #{suffix}",
+      slug: "#{prefix}-#{suffix}",
+      webhook_secret: secret
+    )
+    |> Repo.insert!()
+  end
+
+  defp email(message_id) do
+    %{
+      "message_id" => message_id,
+      "from" => "${OWNER_EMAIL}",
+      "subject" => "Help with my account",
+      "text" => "Please help."
+    }
+  end
+
+  defp deliver(org, payload) do
+    body = Jason.encode!(payload)
+    timestamp = Integer.to_string(System.system_time(:second))
+    raw(org, body, timestamp, signature(org.webhook_secret, timestamp, body))
+  end
+
+  defp raw(org, body, timestamp, sig) do
+    conn = build_conn() |> put_req_header("content-type", "application/json")
+
+    conn =
+      if timestamp == nil, do: conn, else: put_req_header(conn, "x-webhook-timestamp", timestamp)
+
+    conn = if sig == nil, do: conn, else: put_req_header(conn, "x-webhook-signature", sig)
+    post(conn, "/api/orgs/#{org.slug}/inbound-email", body)
+  end
+
+  defp signature(secret, timestamp, body) do
+    :crypto.mac(:hmac, :sha256, secret, timestamp <> "." <> body)
+    |> Base.encode16(case: :lower)
+  end
+
+  defp created_id(conn) do
+    response = json_response(conn, 201)
+    assert %{"ticket_id" => id} = response
+    assert is_integer(id) and id > 0
+    refute Map.get(response, "duplicate", false)
+    id
+  end
+
+  defp assert_prefix(actual, original, limit) do
+    assert is_binary(actual)
+    assert String.length(actual) in 1..limit
+    assert String.starts_with?(original, actual)
+  end
+end
