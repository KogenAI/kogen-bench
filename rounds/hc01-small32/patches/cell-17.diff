@@ -0,0 +1,20 @@
+defmodule Trackline.Support.InboundEmailDelivery do
+  use Ecto.Schema
+  import Ecto.Changeset
+
+  schema "inbound_email_deliveries" do
+    field :message_id, :string
+
+    belongs_to :organization, Trackline.Support.Organization
+    belongs_to :ticket, Trackline.Support.Ticket
+
+    timestamps(type: :utc_datetime)
+  end
+
+  def changeset(delivery, attrs) do
+    delivery
+    |> cast(attrs, [:organization_id, :message_id, :ticket_id])
+    |> validate_required([:organization_id, :message_id, :ticket_id])
+    |> unique_constraint([:organization_id, :message_id])
+  end
+end
