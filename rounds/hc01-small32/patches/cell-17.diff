-  plug Plug.Parsers,
-    parsers: [:urlencoded, :multipart, :json],
-    pass: ["*/*"],
-    json_decoder: Phoenix.json_library()
+  # Inbound webhooks must authenticate the exact raw bytes before a JSON
+  # parser can reject or normalize their body. All other requests use the
+  # same parser configuration as before.
+  plug :parse_request_body
 
   plug Plug.MethodOverride
   plug Plug.Head
   plug Plug.Session, @session_options
   plug TracklineWeb.Router
+
+  @parser_options Plug.Parsers.init(
+                    parsers: [:urlencoded, :multipart, :json],
+                    pass: ["*/*"],
+                    json_decoder: Phoenix.json_library()
+                  )
+
+  defp parse_request_body(conn, _opts) do
+    if inbound_email_request?(conn) do
+      conn
+      |> Plug.Conn.fetch_query_params()
+      |> Map.put(:body_params, %{})
+    else
+      Plug.Parsers.call(conn, @parser_options)
+    end
+  end
+
+  defp inbound_email_request?(%Plug.Conn{
+         method: "POST",
+         path_info: ["api", "orgs", _slug, "inbound-email"]
+       }),
+       do: true
+
+  defp inbound_email_request?(_conn), do: false
 end
