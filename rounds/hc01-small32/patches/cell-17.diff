@@ -31,6 +32,15 @@ defmodule Trackline.Support.Ticket do
     |> validate_inclusion(:priority, @priorities)
   end
 
+  # Inbound email tickets intentionally have no author or assignee and use
+  # their own changeset so normal app-created tickets retain their validations.
+  def inbound_changeset(ticket, attrs) do
+    ticket
+    |> cast(attrs, [:title, :body, :requester_email], empty_values: [])
+    |> validate_required([:title, :requester_email])
+    |> validate_length(:title, max: 200)
+  end
+
   def status_changeset(ticket, status) do
