     |> change(status: status)
diff --git a/lib/trackline_web/controllers/inbound_email_controller.ex b/lib/trackline_web/controllers/inbound_email_controller.ex
new file mode 100644
index 0000000..81b18a7
--- /dev/null
+++ b/lib/trackline_web/controllers/inbound_email_controller.ex
@@ -0,0 +1,138 @@
+defmodule TracklineWeb.InboundEmailController do
+  use TracklineWeb, :controller
+
+  alias Trackline.Support
+  alias Trackline.Support.Organization
+
+  @max_body_bytes 65_536
+  @read_chunk_bytes 8_192
+
+  def create(conn, %{"slug" => slug}) do
+    case Support.get_organization_by_slug(slug) do
+      %Organization{} = organization -> handle_known_organization(conn, organization)
+      nil -> send_status(conn, 404)
+    end
+  end
+
+  defp handle_known_organization(conn, organization) do
+    case read_limited_body(conn, "") do
+      {:too_large, conn} -> send_status(conn, 413)
+      {:ok, body, conn} -> authenticate_and_process(conn, organization, body)
+      {:error, conn} -> send_status(conn, 400)
+    end
+  end
+
+  defp authenticate_and_process(conn, organization, body) do
+    case authenticate(conn, organization, body) do
+      {:ok, _timestamp} ->
+        case Jason.decode(body) do
+          {:ok, payload} -> process_payload(conn, organization, payload)
+          {:error, _error} -> send_status(conn, 400)
+        end
+
+      :error ->
+        send_status(conn, 401)
+    end
+  end
+
+  defp authenticate(conn, %Organization{webhook_secret: secret}, body)
+       when is_binary(secret) and byte_size(secret) > 0 do
+    case {Plug.Conn.get_req_header(conn, "x-webhook-timestamp"),
+          Plug.Conn.get_req_header(conn, "x-webhook-signature")} do
+      {[timestamp], [signature]} ->
+        with true <- Regex.match?(~r/\A[0-9]+\z/, timestamp),
+             {seconds, ""} <- Integer.parse(timestamp),
+             true <- abs(System.system_time(:second) - seconds) <= 300,
+             true <- Regex.match?(~r/\A[0-9a-f]{64}\z/, signature),
+             expected <-
+               :crypto.mac(:hmac, :sha256, secret, timestamp <> "." <> body)
+               |> Base.encode16(case: :lower),
+             true <- Plug.Crypto.secure_compare(expected, signature) do
+          {:ok, seconds}
+        else
+          _ -> :error
+        end
+
+      _ ->
+        :error
+    end
+  end
+
+  defp authenticate(_conn, _organization, _body), do: :error
+
+  defp process_payload(conn, organization, payload) when is_map(payload) do
+    message_id = Map.get(payload, "message_id")
+    sender = Map.get(payload, "from")
+    subject = Map.get(payload, "subject")
+    text = Map.get(payload, "text")
+    in_reply_to = Map.get(payload, "in_reply_to")
+
+    valid_required? = nonempty_string?(message_id) and nonempty_string?(sender)
+
+    valid_optional? =
+      optional_string?(subject) and optional_string?(text) and optional_string?(in_reply_to)
+
+    if valid_required? and valid_optional? do
+      attrs = %{
+        message_id: message_id,
+        from: sender,
+        subject: subject || "",
+        text: text || "",
+        in_reply_to: in_reply_to
+      }
+
+      case Support.process_inbound_email(organization, attrs) do
+        {:ok, {:created, ticket_id}} ->
+          conn |> put_status(:created) |> json(%{ticket_id: ticket_id})
+
+        {:ok, {:duplicate, ticket_id}} ->
+          json(conn, %{ticket_id: ticket_id, duplicate: true})
+
+        {:error, _reason} ->
+          send_status(conn, 422)
+      end
+    else
+      send_status(conn, 422)
+    end
+  end
+
+  defp process_payload(conn, _organization, _payload), do: send_status(conn, 422)
+
+  defp nonempty_string?(value) when is_binary(value), do: String.trim(value) != ""
+  defp nonempty_string?(_value), do: false
+
+  defp optional_string?(nil), do: true
+  defp optional_string?(value), do: is_binary(value)
+
+  defp read_limited_body(conn, accumulated) do
+    remaining = @max_body_bytes + 1 - byte_size(accumulated)
+
+    case Plug.Conn.read_body(conn,
+           length: remaining,
+           read_length: min(@read_chunk_bytes, remaining)
+         ) do
+      {status, chunk, conn} when status in [:ok, :more] ->
+        body = accumulated <> chunk
+
+        cond do
+          byte_size(body) > @max_body_bytes ->
+            {:too_large, conn}
+
+          status == :ok ->
+            {:ok, body, conn}
+
+          true ->
+            read_limited_body(conn, body)
+        end
+
+      {:error, _reason} ->
+        {:error, conn}
+    end
+  end
+
+  defp send_status(conn, status) do
+    conn
+    |> put_status(status)
+    |> json(%{error: "request rejected"})
+  end
+end
