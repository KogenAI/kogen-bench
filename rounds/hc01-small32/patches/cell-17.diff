@@ -96,6 +96,91 @@ defmodule Trackline.Support do
     ticket |> Ecto.Changeset.change(assignee_id: user_id) |> Repo.update()
   end
 
+  ## Inbound email
+
+  @doc """
+  Persist one inbound message and its organization-scoped delivery identity in a
+  single transaction. Returns `{:created, ticket_id}` or
+  `{:duplicate, ticket_id}`.
+  """
+  def process_inbound_email(%Organization{id: org_id}, attrs) when is_map(attrs) do
+    # SQLite's immediate transaction acquires the write reservation before the
+    # duplicate lookup; the unique index remains the final race-safe guard.
+    Repo.transaction(
+      fn ->
+        case Repo.get_by(Trackline.Support.InboundEmailDelivery,
+               organization_id: org_id,
+               message_id: attrs.message_id
+             ) do
+          %Trackline.Support.InboundEmailDelivery{ticket_id: ticket_id} ->
+            {:duplicate, ticket_id}
+
+          nil ->
+            persist_inbound_email(org_id, attrs)
+        end
+      end,
+      mode: :immediate
+    )
+    |> case do
+      {:ok, result} -> {:ok, result}
+      {:error, reason} -> {:error, reason}
+    end
+  end
+
+  defp persist_inbound_email(org_id, attrs) do
+    parent =
+      if is_binary(attrs.in_reply_to) and attrs.in_reply_to != "" do
+        Repo.get_by(Trackline.Support.InboundEmailDelivery,
+          organization_id: org_id,
+          message_id: attrs.in_reply_to
+        )
+      end
+
+    ticket_id =
+      if parent do
+        comment_text = String.slice(attrs.text, 0, 5_000)
+
+        comment = %Trackline.Support.Comment{ticket_id: parent.ticket_id, author_id: nil}
+
+        case comment
+             |> Trackline.Support.Comment.inbound_changeset(%{body: comment_text})
+             |> Repo.insert() do
+          {:ok, _comment} -> parent.ticket_id
+          {:error, reason} -> Repo.rollback(reason)
+        end
+      else
+        subject = attrs.subject || ""
+        title = if String.trim(subject) == "", do: "(no subject)", else: subject
+        title = String.slice(title, 0, 200)
+
+        ticket = %Ticket{organization_id: org_id, author_id: nil, assignee_id: nil}
+
+        case ticket
+             |> Ticket.inbound_changeset(%{
+               title: title,
+               body: attrs.text,
+               requester_email: attrs.from
+             })
+             |> Repo.insert() do
+          {:ok, saved_ticket} -> saved_ticket.id
+          {:error, reason} -> Repo.rollback(reason)
+        end
+      end
+
+    delivery = %Trackline.Support.InboundEmailDelivery{}
+
+    case delivery
+         |> Trackline.Support.InboundEmailDelivery.changeset(%{
+           organization_id: org_id,
+           message_id: attrs.message_id,
+           ticket_id: ticket_id
+         })
+         |> Repo.insert() do
+      {:ok, _delivery} -> {:created, ticket_id}
+      {:error, reason} -> Repo.rollback(reason)
+    end
+  end
+
   ## Comments
 
   def add_comment(%Ticket{id: ticket_id}, %User{id: author_id}, attrs) do
