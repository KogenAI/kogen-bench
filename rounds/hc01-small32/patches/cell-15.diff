diff --git a/lib/trackline/support.ex b/lib/trackline/support.ex
index 42b634f..5b0e9e3 100644
--- a/lib/trackline/support.ex
+++ b/lib/trackline/support.ex
@@ -77,9 +77,33 @@ defmodule Trackline.Support do
     do: Repo.get!(Ticket, id) |> Repo.preload([:organization, :author, :assignee])
 
   def create_ticket(%Organization{id: org_id}, %User{id: author_id}, attrs) do
-    %Ticket{organization_id: org_id, author_id: author_id}
-    |> Ticket.changeset(attrs)
-    |> Repo.insert()
+    changeset =
+      %Ticket{organization_id: org_id, author_id: author_id}
+      |> Ticket.changeset(attrs)
+
+    if changeset.valid? do
+      Repo.transact(fn ->
+        # Acquire SQLite's write reservation before reading the maximum so that
+        # concurrent creators serialize their allocation for this organization.
+        Ecto.Adapters.SQL.query!(Repo, "UPDATE organizations SET id = id WHERE id = ?", [org_id])
+
+        maximum_number =
+          Repo.one(
+            from(t in Ticket,
+              where: t.organization_id == ^org_id,
+              select: max(t.number)
+            )
+          )
+
+        next_number = (maximum_number || 0) + 1
+
+        changeset
+        |> Ecto.Changeset.put_change(:number, next_number)
+        |> Repo.insert()
+      end)
+    else
+      {:error, changeset}
+    end
   end
 
   def change_ticket(%Ticket{} = ticket, attrs \\ %{}), do: Ticket.changeset(ticket, attrs)
