+defmodule Trackline.Support.InboundEmailMessage do
+  use Ecto.Schema
+  import Ecto.Changeset
+
+  schema "inbound_email_messages" do
+    field :message_id, :string
+
+    belongs_to :organization, Trackline.Support.Organization
+    belongs_to :ticket, Trackline.Support.Ticket
+
+    timestamps(type: :utc_datetime)
+  end
+
+  def changeset(message, attrs) do
+    message
+    |> cast(attrs, [:organization_id, :ticket_id, :message_id])
+    |> validate_required([:organization_id, :ticket_id, :message_id])
+    |> unique_constraint([:organization_id, :message_id],
+      name: :inbound_email_messages_org_message_id_index
+    )
+  end
+end
