diff --git a/test/acceptance/syn-31-inbound-email-webhook_test.exs b/test/acceptance/syn-31-inbound-email-webhook_test.exs
new file mode 100644
index 0000000..c8872ad
--- /dev/null
+++ b/test/acceptance/syn-31-inbound-email-webhook_test.exs
@@ -0,0 +1,437 @@
+defmodule TracklineWeb.InboundEmailIntentAcceptanceTest do
+  use TracklineWeb.ConnCase, async: false
+
+  alias Trackline.Repo
+  alias Trackline.Support
+  alias Trackline.Support.{Comment, Ticket}
+
+  import Trackline.AccountsFixtures
+  import Trackline.SupportFixtures
+
+  @tag intent: "syn-31-inbound-email-webhook/A1"
+  test "signed new emails preserve fields, normalize titles, and ignore attachments" do
+    org = signed_org()
+
+    payload =
+      email("first", %{
+        "subject" => "Cannot log in",
+        "text" => "Please help.\nAccount: 42\n",
+        "attachments" => [%{"filename" => "error.txt", "content" => "ignored"}]
+      })
+
+    id = created_id(deliver(org, payload))
+    ticket = Repo.get!(Ticket, id)
+    assert ticket.organization_id == org.id
+    assert ticket.title == payload["subject"]
+    assert ticket.body == payload["text"]
+    assert Map.get(ticket, :requester_email) == payload["from"]
+    assert ticket.status == "open"
+    assert ticket.author_id == nil
+    assert ticket.assignee_id == nil
+    assert Support.list_comments(ticket) == []
+
+    empty_id = created_id(deliver(org, email("empty-subject", %{"subject" => ""})))
+    assert Repo.get!(Ticket, empty_id).title == "(no subject)"
+
+    subject = String.duplicate("é", 225)
+    long_id = created_id(deliver(org, email("long-subject", %{"subject" => subject})))
+    assert_prefix(Repo.get!(Ticket, long_id).title, subject, 200)
+
+    text = String.duplicate("x", 50_000)
+    large = email("large-description", %{"text" => text})
+    assert byte_size(Jason.encode!(large)) < 65_536
+    large_id = created_id(deliver(org, large))
+    assert Repo.get!(Ticket, large_id).body == text
+    assert Repo.aggregate(Ticket, :count, :id) == 4
+    assert Repo.aggregate(Comment, :count, :id) == 0
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A2"
+  test "reply chains thread locally in arrival order and unknown or foreign parents start tickets" do
+    org = signed_org()
+    other = signed_org()
+    id = created_id(deliver(org, email("root")))
+    ticket = Repo.get!(Ticket, id)
+
+    first = email("reply-1", %{"in_reply_to" => "root", "text" => "First reply"})
+    assert created_id(deliver(org, first)) == id
+    long_text = String.duplicate("é", 5_100)
+    second = email("reply-2", %{"in_reply_to" => "reply-1", "text" => long_text})
+    assert created_id(deliver(org, second)) == id
+    third = email("reply-3", %{"in_reply_to" => "reply-2", "text" => "Third reply"})
+    assert created_id(deliver(org, third)) == id
+
+    assert [c1, c2, c3] = Support.list_comments(ticket)
+    assert c1.body == "First reply"
+    assert_prefix(c2.body, long_text, 5_000)
+    assert c3.body == "Third reply"
+    assert Enum.all?([c1, c2, c3], &(&1.author_id == nil and &1.ticket_id == id))
+    assert length(Support.list_tickets(org)) == 1
+
+    unknown = email("unknown-parent", %{"in_reply_to" => "never-seen", "text" => "New problem"})
+    unknown_id = created_id(deliver(org, unknown))
+    assert unknown_id != id
+    assert Repo.get!(Ticket, unknown_id).body == "New problem"
+
+    foreign =
+      email("foreign-parent", %{"in_reply_to" => "reply-2", "text" => "Other organization"})
+
+    foreign_id = created_id(deliver(other, foreign))
+    assert foreign_id not in [id, unknown_id]
+    foreign_ticket = Repo.get!(Ticket, foreign_id)
+    assert foreign_ticket.organization_id == other.id
+    assert foreign_ticket.body == "Other organization"
+    assert foreign_ticket.author_id == nil
+    assert foreign_ticket.assignee_id == nil
+    assert Support.list_comments(foreign_ticket) == []
+    assert length(Support.list_comments(ticket)) == 3
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A3"
+  test "ticket and reply replays create nothing and deduplication is organization scoped" do
+    org = signed_org()
+    other = signed_org()
+    root = email("shared-message")
+    id = created_id(deliver(org, root))
+    before_replay = counts()
+    assert json_response(deliver(org, root), 200) == %{"ticket_id" => id, "duplicate" => true}
+    assert counts() == before_replay
+
+    altered = Map.merge(root, %{"subject" => "Changed", "text" => "Changed"})
+    assert json_response(deliver(org, altered), 200) == %{"ticket_id" => id, "duplicate" => true}
+    assert counts() == before_replay
+    assert Repo.get!(Ticket, id).title == root["subject"]
+    assert Repo.get!(Ticket, id).body == root["text"]
+
+    other_id = created_id(deliver(other, root))
+    assert other_id != id
+    assert Repo.get!(Ticket, other_id).organization_id == other.id
+
+    assert json_response(deliver(other, root), 200) == %{
+             "ticket_id" => other_id,
+             "duplicate" => true
+           }
+
+    reply = email("shared-reply", %{"in_reply_to" => "shared-message", "text" => "Reply"})
+    assert created_id(deliver(org, reply)) == id
+    before_reply_replay = counts()
+    assert json_response(deliver(org, reply), 200) == %{"ticket_id" => id, "duplicate" => true}
+    assert counts() == before_reply_replay
+    assert created_id(deliver(other, reply)) == other_id
+
+    assert json_response(deliver(other, reply), 200) == %{
+             "ticket_id" => other_id,
+             "duplicate" => true
+           }
+
+    assert counts() == {2, 2}
+    assert [%{body: "Reply"}] = Support.list_comments(Repo.get!(Ticket, id))
+    assert [%{body: "Reply"}] = Support.list_comments(Repo.get!(Ticket, other_id))
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A4"
+  test "authentication rejects bad signatures timestamps and secrets before decoding" do
+    org = signed_org()
+    body = Jason.encode!(email("auth"))
+    now = Integer.to_string(System.system_time(:second))
+    valid = signature(org.webhook_secret, now, body)
+
+    for headers <- [
+          [],
+          [{"x-webhook-timestamp", now}],
+          [{"x-webhook-signature", valid}],
+          [{"x-webhook-timestamp", now}, {"x-webhook-signature", String.duplicate("0", 64)}],
+          [{"x-webhook-timestamp", now}, {"x-webhook-signature", "bad"}],
+          [{"x-webhook-timestamp", now}, {"x-webhook-signature", String.upcase(valid)}]
+        ] do
+      assert raw_request(org.slug, body, headers).status == 401
+    end
+
+    for timestamp <- [
+          "not-a-number",
+          "123oops",
+          "1.5",
+          "",
+          Integer.to_string(System.system_time(:second) - 360),
+          Integer.to_string(System.system_time(:second) + 360)
+        ] do
+      assert signed_request(org, body, timestamp).status == 401
+      assert signed_request(org, "not JSON", timestamp).status == 401
+    end
+
+    invalid_json = "{broken"
+
+    assert raw_request(org.slug, invalid_json, [
+             {"x-webhook-timestamp", now},
+             {"x-webhook-signature", signature("wrong-secret", now, invalid_json)}
+           ]).status == 401
+
+    spaced_body = " " <> body
+
+    assert raw_request(org.slug, spaced_body, [
+             {"x-webhook-timestamp", now},
+             {"x-webhook-signature", valid}
+           ]).status == 401
+
+    no_secret = organization_fixture()
+    empty_secret = organization_fixture()
+    empty_secret = empty_secret |> Ecto.Changeset.change(webhook_secret: "") |> Repo.update!()
+
+    for secretless <- [no_secret, empty_secret] do
+      for rejected_body <- [body, "not JSON"] do
+        assert raw_request(secretless.slug, rejected_body, [
+                 {"x-webhook-timestamp", now},
+                 {"x-webhook-signature", signature("", now, rejected_body)}
+               ]).status == 401
+      end
+    end
+
+    assert counts() == {0, 0}
+
+    for offset <- [-290, 290] do
+      timestamp = Integer.to_string(System.system_time(:second) + offset)
+      accepted_body = Jason.encode!(email("within-window-#{offset}"))
+      assert created_id(signed_request(org, accepted_body, timestamp))
+    end
+
+    # Verify exact raw whitespace is part of the signed message, not re-encoded JSON.
+    assert created_id(signed_request(org, " \n" <> Jason.encode!(email("raw-bytes")) <> "\n"))
+    assert counts() == {3, 0}
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A5"
+  test "HTTP error statuses enforce body size and validation without consuming messages" do
+    org = signed_org()
+    body = Jason.encode!(email("unknown"))
+    timestamp = Integer.to_string(System.system_time(:second))
+
+    assert raw_request("missing-#{System.unique_integer([:positive])}", body, [
+             {"x-webhook-timestamp", timestamp},
+             {"x-webhook-signature", signature(org.webhook_secret, timestamp, body)}
+           ]).status == 404
+
+    assert signed_request(org, "not JSON").status == 400
+    assert signed_request(org, "{\"message_id\":").status == 400
+
+    for field <- ["message_id", "from"] do
+      invalid = email("retry-after-validation") |> Map.delete(field)
+      assert deliver(org, invalid).status == 422
+    end
+
+    # This valid JSON is over the byte limit while remaining below it in characters.
+    oversized =
+      Jason.encode!(email("retry-after-size", %{"text" => String.duplicate("é", 33_000)}))
+
+    assert byte_size(oversized) > 65_536
+    assert String.length(oversized) < 65_536
+    assert signed_request(org, oversized).status == 413
+    assert counts() == {0, 0}
+
+    exact_json = Jason.encode!(email("boundary"))
+    exact_body = exact_json <> String.duplicate(" ", 65_536 - byte_size(exact_json))
+    assert byte_size(exact_body) == 65_536
+    assert signed_request(org, exact_body <> " ").status == 413
+    assert counts() == {0, 0}
+    assert created_id(signed_request(org, exact_body))
+    assert created_id(deliver(org, email("retry-after-validation")))
+    assert created_id(deliver(org, email("retry-after-size")))
+    assert counts() == {3, 0}
+  end
