+  @tag intent: "syn-31-inbound-email-webhook/A9"
+  test "exact raw bytes authenticate with the organization key inside either side of the five minute window" do
+    org = signed_org()
+    other = signed_org()
+
+    for offset <- [-290, 0, 290] do
+      timestamp = Integer.to_string(System.system_time(:second) + offset)
+      json = Jason.encode!(email("hmac-window-#{offset}"))
+      body = " \n" <> json <> "\n "
+      correct = signature(org.webhook_secret, timestamp, body)
+
+      assert raw_request(org.slug, body, [
+               {"x-webhook-timestamp", timestamp},
+               {"x-webhook-signature", signature(other.webhook_secret, timestamp, body)}
+             ]).status == 401
+
+      assert raw_request(org.slug, body, [
+               {"x-webhook-timestamp", timestamp},
+               {"x-webhook-signature", signature(org.webhook_secret, timestamp, json)}
+             ]).status == 401
+
+      id =
+        created_id(
+          raw_request(org.slug, body, [
+            {"x-webhook-timestamp", timestamp},
+            {"x-webhook-signature", correct}
+          ])
+        )
+
+      assert Repo.get!(Ticket, id).organization_id == org.id
+    end
+
+    assert counts() == {3, 0}
+  end
