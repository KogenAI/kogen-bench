+defmodule TracklineWeb.ConditionalParsers do
+  @moduledoc false
+  @behaviour Plug
+
+  @inbound_email_path ~r/\A\/api\/orgs\/[^\/]+\/inbound-email\z/
+
+  @impl Plug
+  def init(opts), do: Plug.Parsers.init(opts)
+
+  @impl Plug
+  def call(%Plug.Conn{method: "POST", request_path: path} = conn, opts) do
+    if Regex.match?(@inbound_email_path, path) do
+      conn
+    else
+      Plug.Parsers.call(conn, opts)
+    end
+  end
+
+  def call(conn, opts), do: Plug.Parsers.call(conn, opts)
+end
diff --git a/lib/trackline_web/controllers/inbound_email_controller.ex b/lib/trackline_web/controllers/inbound_email_controller.ex
new file mode 100644
index 0000000..dc7bf3d
--- /dev/null
+++ b/lib/trackline_web/controllers/inbound_email_controller.ex
@@ -0,0 +1,161 @@
+defmodule TracklineWeb.InboundEmailController do
+  use TracklineWeb, :controller
+
+  alias Trackline.Support
+
+  @max_body_bytes 65_536
+  @timestamp_window_seconds 300
+
+  def create(conn, %{"slug" => slug}) do
+    case Support.get_organization_by_slug(slug) do
+      nil ->
+        respond(conn, 404, %{})
+
+      organization ->
+        case read_raw_body(conn) do
+          {:too_large, conn} ->
+            respond(conn, 413, %{})
+
+          {:error, conn} ->
+            respond(conn, 400, %{})
+
+          {:ok, body, conn} ->
+            process_authenticated_body(conn, organization, body)
+        end
+    end
+  end
+
+  defp process_authenticated_body(conn, organization, body) do
+    if authenticated?(conn, organization.webhook_secret, body) do
+      case Jason.decode(body) do
+        {:ok, payload} ->
+          case normalize_payload(payload) do
+            {:ok, attrs} ->
+              case Support.ingest_inbound_email(organization, attrs) do
+                {:ok, %{ticket_id: ticket_id, duplicate: true}} ->
+                  respond(conn, 200, %{ticket_id: ticket_id, duplicate: true})
+
+                {:ok, %{ticket_id: ticket_id, duplicate: false}} ->
+                  respond(conn, 201, %{ticket_id: ticket_id})
+
+                {:error, _reason} ->
+                  respond(conn, 422, %{})
+              end
+
+            :error ->
+              respond(conn, 422, %{})
+          end
+
+        {:error, _reason} ->
+          respond(conn, 400, %{})
+      end
+    else
+      respond(conn, 401, %{})
+    end
+  end
+
+  defp authenticated?(conn, secret, body) when is_binary(secret) and byte_size(secret) > 0 do
+    with [timestamp] <- Plug.Conn.get_req_header(conn, "x-webhook-timestamp"),
+         [provided] <- Plug.Conn.get_req_header(conn, "x-webhook-signature"),
+         {:ok, timestamp_seconds} <- parse_timestamp(timestamp),
+         true <- abs(System.system_time(:second) - timestamp_seconds) <= @timestamp_window_seconds,
+         true <- valid_signature?(secret, timestamp, body, provided) do
+      true
+    else
+      _ -> false
+    end
+  end
+
+  defp authenticated?(_conn, _secret, _body), do: false
+
+  defp parse_timestamp(timestamp) when is_binary(timestamp) do
+    if byte_size(timestamp) <= 20 and Regex.match?(~r/\A[0-9]+\z/, timestamp) do
+      case Integer.parse(timestamp) do
+        {seconds, ""} -> {:ok, seconds}
+        _ -> :error
+      end
+    else
+      :error
+    end
+  end
+
+  defp valid_signature?(secret, timestamp, body, provided)
+       when is_binary(provided) and byte_size(provided) == 64 do
+    if Regex.match?(~r/\A[0-9a-f]{64}\z/, provided) do
+      expected =
+        :crypto.mac(:hmac, :sha256, secret, timestamp <> "." <> body)
+        |> Base.encode16(case: :lower)
+
+      :crypto.hash_equals(expected, provided)
+    else
+      false
+    end
+  end
+
+  defp valid_signature?(_secret, _timestamp, _body, _provided), do: false
+
+  defp normalize_payload(payload) when is_map(payload) do
+    message_id = Map.get(payload, "message_id")
+    from = Map.get(payload, "from")
+    subject = Map.get(payload, "subject", "")
+    text = Map.get(payload, "text", "")
+    in_reply_to = Map.get(payload, "in_reply_to")
+
+    if nonempty_string?(message_id) and nonempty_string?(from) and
+         optional_string?(subject) and optional_string?(text) and
+         (is_nil(in_reply_to) or is_binary(in_reply_to)) do
+      {:ok,
+       %{
+         message_id: message_id,
+         from: from,
+         subject: subject || "",
+         text: text || "",
+         in_reply_to: in_reply_to
+       }}
+    else
+      :error
+    end
+  end
+
+  defp normalize_payload(_), do: :error
+
+  defp nonempty_string?(value), do: is_binary(value) and String.trim(value) != ""
+  defp optional_string?(nil), do: true
+  defp optional_string?(value), do: is_binary(value)
+
+  defp read_raw_body(conn), do: read_raw_body(conn, <<>>)
+
+  defp read_raw_body(conn, accumulated) do
+    remaining = @max_body_bytes + 1 - byte_size(accumulated)
+
+    case Plug.Conn.read_body(conn,
+           length: remaining,
+           read_length: min(16_384, remaining)
+         ) do
+      {:ok, chunk, conn} ->
+        body = accumulated <> chunk
+        if byte_size(body) > @max_body_bytes, do: {:too_large, conn}, else: {:ok, body, conn}
+
+      {:more, chunk, conn} ->
+        body = accumulated <> chunk
+
+        if byte_size(body) > @max_body_bytes do
+          {:too_large, conn}
+        else
+          read_raw_body(conn, body)
+        end
+
+      {:error, :too_large} ->
+        {:too_large, conn}
+
+      {:error, _reason} ->
+        {:error, conn}
+    end
+  end
+
+  defp respond(conn, status, body) do
+    conn
+    |> put_status(status)
+    |> json(body)
+  end
+end
