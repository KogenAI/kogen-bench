+  @tag intent: "syn-31-inbound-email-webhook/A10"
+  test "signed malformed JSON is decoded only after valid timestamp and nonempty secret checks" do
+    org = signed_org()
+    malformed = "{\"message_id\":"
+    assert signed_request(org, malformed).status == 400
+
+    for timestamp <- ["not-unix-seconds", "123abc", "1.5"] do
+      assert signed_request(org, malformed, timestamp).status == 401
+      assert signed_request(org, Jason.encode!(email("bad-timestamp")), timestamp).status == 401
+    end
+
+    no_secret = organization_fixture()
+    empty_secret = organization_fixture()
+    empty_secret = empty_secret |> Ecto.Changeset.change(webhook_secret: "") |> Repo.update!()
+    assert no_secret.webhook_secret == nil
+    assert empty_secret.webhook_secret == ""
+
+    for secretless <- [no_secret, empty_secret] do
+      for body <- [malformed, Jason.encode!(email("empty-key"))] do
+        timestamp = Integer.to_string(System.system_time(:second))
+
+        assert raw_request(secretless.slug, body, [
+                 {"x-webhook-timestamp", timestamp},
+                 {"x-webhook-signature", signature("", timestamp, body)}
+               ]).status == 401
+      end
+    end
+
+    assert counts() == {0, 0}
+  end
+
+  defp signed_org do
+    organization_fixture(nil, %{webhook_secret: "secret-#{System.unique_integer([:positive])}"})
+  end
+
+  defp email(message_id, overrides \\ %{}) do
+    Map.merge(
+      %{
+        "message_id" => message_id,
+        "from" => "${OWNER_EMAIL}",
+        "subject" => "Support request",
+        "text" => "Please help"
+      },
+      overrides
+    )
+  end
+
+  defp deliver(org, payload), do: signed_request(org, Jason.encode!(payload))
+
+  defp signed_request(org, body, timestamp \\ nil) do
+    timestamp = timestamp || Integer.to_string(System.system_time(:second))
+
+    raw_request(org.slug, body, [
+      {"x-webhook-timestamp", timestamp},
+      {"x-webhook-signature", signature(org.webhook_secret, timestamp, body)}
+    ])
+  end
+
+  defp raw_request(slug, body, headers) do
+    conn = build_conn() |> put_req_header("content-type", "application/json")
+
+    conn =
+      Enum.reduce(headers, conn, fn {name, value}, acc -> put_req_header(acc, name, value) end)
+
+    post(conn, "/api/orgs/#{slug}/inbound-email", body)
+  end
+
+  defp signature(secret, timestamp, body) do
+    :crypto.mac(:hmac, :sha256, secret, timestamp <> "." <> body)
+    |> Base.encode16(case: :lower)
+  end
+
+  defp created_id(conn) do
+    response = json_response(conn, 201)
+    assert Map.keys(response) == ["ticket_id"]
+    id = response["ticket_id"]
+    assert is_integer(id) and id > 0
+    id
+  end
+
+  defp counts do
+    {Repo.aggregate(Ticket, :count, :id), Repo.aggregate(Comment, :count, :id)}
+  end
+
+  defp assert_prefix(kept, original, limit) do
+    assert is_binary(kept)
+    assert String.length(kept) > 0
+    assert String.length(kept) <= limit
+    assert String.starts_with?(original, kept)
+  end
+end
