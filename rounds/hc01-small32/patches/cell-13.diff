+  @doc "Processes a validated inbound email atomically and deduplicates by organization and message ID."
+  def process_inbound_email(%Organization{id: org_id}, attrs) when is_map(attrs) do
+    result =
+      Repo.transaction(fn ->
+        # SQLite has no SELECT ... FOR UPDATE. A no-op update takes its write
+        # lock before the lookup, serializing concurrent webhook deliveries.
+        Repo.query!("UPDATE organizations SET id = id WHERE id = ?", [org_id])
+
+        case Repo.get_by(InboundEmailMessage,
+               organization_id: org_id,
+               message_id: attrs.message_id
+             ) do
+          %InboundEmailMessage{ticket_id: ticket_id} ->
+            {:duplicate, ticket_id}
+
+          nil ->
+            create_inbound_email(org_id, attrs)
+        end
+      end)
+
+    case result do
+      {:ok, {:created, ticket_id}} -> {:ok, ticket_id, :created}
+      {:ok, {:duplicate, ticket_id}} -> {:ok, ticket_id, :duplicate}
+      {:error, reason} -> {:error, reason}
+    end
+  end
+
+  defp create_inbound_email(org_id, attrs) do
+    parent =
+      case attrs[:in_reply_to] do
+        parent_id when is_binary(parent_id) and parent_id != "" ->
+          Repo.get_by(InboundEmailMessage,
+            organization_id: org_id,
+            message_id: parent_id
+          )
+
+        _ ->
+          nil
+      end
+
+    ticket_id =
+      case parent do
+        %InboundEmailMessage{ticket_id: ticket_id} ->
+          create_inbound_comment!(ticket_id, attrs.text)
+          ticket_id
+
+        nil ->
+          create_inbound_ticket!(org_id, attrs)
+      end
+
+    %InboundEmailMessage{}
+    |> InboundEmailMessage.changeset(%{
+      organization_id: org_id,
+      message_id: attrs.message_id,
+      ticket_id: ticket_id
+    })
+    |> Repo.insert()
+    |> case do
+      {:ok, _mapping} -> {:created, ticket_id}
+      {:error, changeset} -> Repo.rollback(changeset)
+    end
+  end
+
+  defp create_inbound_ticket!(org_id, attrs) do
+    subject = String.trim(attrs.subject)
+    title = if subject == "", do: "(no subject)", else: String.slice(subject, 0, 200)
+
+    ticket = %Ticket{
+      organization_id: org_id,
+      author_id: nil,
+      assignee_id: nil
+    }
+
+    ticket
+    |> Ecto.Changeset.change(%{
+      title: title,
+      body: attrs.text,
+      requester_email: attrs.from,
+      status: "open",
+      priority: "normal"
+    })
+    |> Repo.insert()
+    |> case do
+      {:ok, ticket} -> ticket.id
+      {:error, changeset} -> Repo.rollback(changeset)
+    end
+  end
+
+  defp create_inbound_comment!(ticket_id, body) do
+    comment = %Comment{ticket_id: ticket_id, author_id: nil}
+    body = String.slice(body, 0, 5_000)
+
+    comment
+    |> Ecto.Changeset.change(body: body)
+    |> Repo.insert()
+    |> case do
+      {:ok, comment} -> comment.id
+      {:error, changeset} -> Repo.rollback(changeset)
+    end
+  end
+
