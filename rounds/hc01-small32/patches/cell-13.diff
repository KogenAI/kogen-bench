@@ -0,0 +1,58 @@
+defmodule TracklineWeb.InboundEmailController do
+  use TracklineWeb, :controller
+
+  alias Trackline.Support
+
+  def create(conn, _params) do
+    payload = conn.assigns.inbound_email_payload
+
+    with {:ok, attrs} <- validated_attrs(payload),
+         {:ok, ticket_id, result} <-
+           Support.process_inbound_email(conn.assigns.inbound_email_organization, attrs) do
+      case result do
+        :created ->
+          conn |> put_status(:created) |> json(%{ticket_id: ticket_id})
+
+        :duplicate ->
+          json(conn, %{ticket_id: ticket_id, duplicate: true})
+      end
+    else
+      :error ->
+        conn |> put_status(:unprocessable_entity) |> json(%{error: "missing_required_fields"})
+
+      {:error, _reason} ->
+        conn |> put_status(:unprocessable_entity) |> json(%{error: "invalid_email"})
+    end
+  end
+
+  defp validated_attrs(payload) do
+    message_id = payload["message_id"]
+    sender = payload["from"]
+    subject = Map.get(payload, "subject", "")
+    text = Map.get(payload, "text", "")
+    in_reply_to = Map.get(payload, "in_reply_to")
+
+    cond do
+      not non_empty_binary?(message_id) or not non_empty_binary?(sender) ->
+        :error
+
+      not is_binary(subject) or not is_binary(text) ->
+        {:error, :invalid_text_fields}
+
+      not (is_nil(in_reply_to) or is_binary(in_reply_to)) ->
+        {:error, :invalid_reply_reference}
+
+      true ->
+        {:ok,
+         %{
+           message_id: message_id,
+           from: sender,
+           subject: subject,
+           text: text,
+           in_reply_to: in_reply_to
+         }}
+    end
+  end
+
+  defp non_empty_binary?(value), do: is_binary(value) and value != ""
+end
