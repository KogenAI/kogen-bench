diff --git a/test/acceptance/syn-31-inbound-email-webhook_test.exs b/test/acceptance/syn-31-inbound-email-webhook_test.exs
new file mode 100644
index 0000000..8e80fc6
--- /dev/null
+++ b/test/acceptance/syn-31-inbound-email-webhook_test.exs
@@ -0,0 +1,392 @@
+defmodule TracklineWeb.InboundEmailIntentAcceptanceTest do
+  use TracklineWeb.ConnCase, async: false
+
+  alias Trackline.Repo
+  alias Trackline.Support
+  alias Trackline.Support.{Comment, Ticket}
+
+  import Trackline.AccountsFixtures
+  import Trackline.SupportFixtures
+
+  defp signed_org(secret \\ "inbound-test-secret") do
+    organization_fixture(nil, %{webhook_secret: secret})
+  end
+
+  defp email(id, fields \\ %{}) do
+    Map.merge(
+      %{
+        "message_id" => id,
+        "from" => "${OWNER_EMAIL}",
+        "subject" => "Help",
+        "text" => "Email body"
+      },
+      fields
+    )
+  end
+
+  defp sign(secret, timestamp, body) do
+    # Provider signature: lowercase hex HMAC-SHA256 of "<timestamp>.<request body>".
+    :crypto.mac(:hmac, :sha256, secret, timestamp <> "." <> body)
+    |> Base.encode16(case: :lower)
+  end
+
+  defp deliver(org, payload, opts \\ []) do
+    body = if is_binary(payload), do: payload, else: Jason.encode!(payload)
+    timestamp = Keyword.get(opts, :timestamp, Integer.to_string(System.system_time(:second)))
+    secret = Keyword.get(opts, :secret, org.webhook_secret || "")
+
+    signature =
+      case Keyword.fetch(opts, :signature) do
+        {:ok, value} -> value
+        :error -> sign(secret, timestamp, body)
+      end
+
+    slug = Keyword.get(opts, :slug, org.slug)
+
+    conn =
+      build_conn()
+      |> put_req_header("content-type", "application/json")
+      |> put_req_header("accept", "application/json")
+
+    conn =
+      if timestamp == :missing,
+        do: conn,
+        else: put_req_header(conn, "x-webhook-timestamp", timestamp)
+
+    conn =
+      if signature == :missing,
+        do: conn,
+        else: put_req_header(conn, "x-webhook-signature", signature)
+
+    post(conn, "/api/orgs/#{slug}/inbound-email", body)
+  end
+
+  defp created(org, payload) do
+    response = org |> deliver(payload) |> json_response(201)
+    assert Map.has_key?(response, "ticket_id")
+    refute response["duplicate"]
+    ticket = Support.get_ticket!(response["ticket_id"])
+    assert ticket.author_id == nil
+    assert ticket.assignee_id == nil
+    ticket
+  end
+
+  defp counts do
+    {Repo.aggregate(Ticket, :count, :id), Repo.aggregate(Comment, :count, :id)}
+  end
+
+  defp records do
+    {Repo.all(Ticket) |> Enum.sort_by(& &1.id), Repo.all(Comment) |> Enum.sort_by(& &1.id)}
+  end
+
+  defp assert_prefix(actual, original, limit) do
+    assert is_binary(actual)
+    assert String.length(actual) > 0
+    assert String.length(actual) <= limit
+    assert String.starts_with?(original, actual)
+    assert actual != original
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A1"
+  test "new email tickets preserve sender and large bodies while normalizing titles and ignoring attachments" do
+    org = signed_org()
+    body = " \n" <> String.duplicate("x", 49_996) <> "\n "
+    assert String.length(body) == 50_000
+
+    payload =
+      email("large", %{
+        "subject" => "Need help",
+        "text" => body,
+        "attachments" => [%{"filename" => "ignored.txt", "content" => "ignore me"}]
+      })
+
+    assert byte_size(Jason.encode!(payload)) < 65_536
+    ticket = created(org, payload)
+    assert ticket.organization_id == org.id
+    assert ticket.title == "Need help"
+    assert ticket.body == body
+    assert Map.get(ticket, :requester_email) == "${OWNER_EMAIL}"
+    assert ticket.status == "open"
+    assert ticket.author_id == nil
+    assert ticket.assignee_id == nil
+    assert Support.list_comments(ticket) == []
+
+    blank = created(org, email("blank", %{"subject" => "", "from" => "${OWNER_EMAIL}"}))
+    assert blank.title == "(no subject)"
+    assert Map.get(blank, :requester_email) == "${OWNER_EMAIL}"
+    long_subject = String.duplicate("é", 230)
+    shortened = created(org, email("long-title", %{"subject" => long_subject}))
+    assert_prefix(shortened.title, long_subject, 200)
+    assert counts() == {3, 0}
+
+    exact_title = String.duplicate("é", 200)
+    at_limit = created(org, email("title-limit", %{"subject" => exact_title}))
+    assert at_limit.title == exact_title
+    assert counts() == {4, 0}
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A2"
+  test "replies thread through replies in arrival order and unknown or foreign references create tickets" do
+    org = signed_org()
+    other = signed_org("other-secret")
+    root = created(org, email("thread-root"))
+
+    first =
+      created(
+        org,
+        email("reply-one", %{
+          "in_reply_to" => "thread-root",
+          "text" => "First reply",
+          "from" => "${OWNER_EMAIL}"
+        })
+      )
+
+    assert first.id == root.id
+    assert Map.get(Support.get_ticket!(root.id), :requester_email) == "${OWNER_EMAIL}"
+    long_reply = String.duplicate("é", 5_400)
+
+    second =
+      created(
+        org,
+        email("reply-two", %{
+          "in_reply_to" => "reply-one",
+          "text" => long_reply,
+          "attachments" => [%{"filename" => "ignored.pdf"}]
+        })
+      )
+
+    assert second.id == root.id
+
+    third =
+      created(org, email("reply-three", %{"in_reply_to" => "reply-two", "text" => "Third reply"}))
+
+    assert third.id == root.id
+    comments = Support.list_comments(root)
+    assert [first_comment, second_comment, third_comment] = comments
+    assert first_comment.body == "First reply"
+    assert_prefix(second_comment.body, long_reply, 5_000)
+    assert third_comment.body == "Third reply"
+    assert Enum.all?(comments, &is_nil(&1.author_id))
+    assert Support.get_ticket!(root.id).assignee_id == nil
+
+    unknown =
+      created(
+        org,
+        email("unknown-parent", %{"in_reply_to" => "never-seen", "text" => "New issue"})
+      )
+
+    assert unknown.id != root.id
+    assert unknown.body == "New issue"
+    foreign = created(other, email("foreign-parent", %{"in_reply_to" => "reply-two"}))
+    assert foreign.organization_id == other.id
+    assert foreign.id != root.id
+    assert foreign.status == "open"
+    assert Support.list_comments(foreign) == []
+    assert length(Support.list_comments(root)) == 3
+    assert counts() == {3, 3}
+
+    exact_reply = String.duplicate("é", 5_000)
+
+    assert created(
+             org,
+             email("reply-limit", %{"in_reply_to" => "reply-three", "text" => exact_reply})
+           ).id == root.id
+
+    assert [a, b, c, last] = Support.list_comments(root)
+    assert [a.id, b.id, c.id] == Enum.map(comments, & &1.id)
+    assert last.body == exact_reply
+    assert last.author_id == nil
+    assert counts() == {3, 4}
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A3"
+  test "ticket and reply duplicates are mutation-free and IDs are independent between organizations" do
+    org = signed_org()
+    other = signed_org("separate-key")
+    root_payload = email("shared-root")
+    root = created(org, root_payload)
+    before = counts()
+    before_records = records()
+
+    assert json_response(deliver(org, root_payload), 200) == %{
+             "ticket_id" => root.id,
+             "duplicate" => true
+           }
+
+    assert counts() == before
+    assert records() == before_records
+    assert Support.get_ticket!(root.id).body == root.body
+
+    reply_payload = email("shared-reply", %{"in_reply_to" => "shared-root", "text" => "A reply"})
+    assert created(org, reply_payload).id == root.id
+    before = counts()
+    before_records = records()
+
+    assert json_response(deliver(org, reply_payload), 200) == %{
+             "ticket_id" => root.id,
+             "duplicate" => true
+           }
+
+    assert counts() == before
+    assert records() == before_records
+    assert [%{body: "A reply"}] = Support.list_comments(root)
+
+    other_root = created(other, root_payload)
+    assert other_root.id != root.id
+    assert other_root.organization_id == other.id
+    assert created(other, reply_payload).id == other_root.id
+    before_records = records()
+
+    assert json_response(deliver(other, root_payload), 200) == %{
+             "ticket_id" => other_root.id,
+             "duplicate" => true
+           }
+
+    assert json_response(deliver(other, reply_payload), 200) == %{
+             "ticket_id" => other_root.id,
+             "duplicate" => true
+           }
+
+    assert [%{body: "A reply"}] = Support.list_comments(other_root)
+    assert counts() == {2, 2}
+    assert records() == before_records
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A4"
+  test "exact raw bytes and timestamp are authenticated before parsing and secrets are mandatory" do
+    org = signed_org()
+    now = System.system_time(:second)
+    before = counts()
+
+    invalid_requests = [
+      {email("wrong-key"), [secret: "wrong-secret"]},
+      {email("bad-signature"), [signature: "not-a-signature"]},
+      {email("missing-signature"), [signature: :missing]},
+      {email("missing-time"), [timestamp: :missing, signature: "00"]},
+      {"not JSON", [timestamp: "not-a-number"]},
+      {"not JSON", [timestamp: "#{now}.5"]},
+      {"not JSON", [timestamp: "#{now}junk"]},
+      {"not JSON", [timestamp: Integer.to_string(now - 601)]},
+      {"not JSON", [timestamp: Integer.to_string(now + 601)]},
+      {"not JSON", [signature: "00"]}
+    ]
+
+    for {payload, opts} <- invalid_requests do
+      assert response(deliver(org, payload, opts), 401)
+      assert counts() == before
+    end
+
+    for offset <- [-305, 305] do
+      timestamp = Integer.to_string(System.system_time(:second) + offset)
+      assert response(deliver(org, "not JSON", timestamp: timestamp), 401)
+      assert counts() == before
+    end
+
+    for secret <- [nil, ""] do
+      unconfigured = signed_org(secret)
+      assert response(deliver(unconfigured, "not JSON", secret: ""), 401)
+      assert response(deliver(unconfigured, email("no-secret"), secret: ""), 401)
+      assert counts() == before
+    end
+
+    # Signatures must cover timestamp, dot, and raw body, not just the body.
+    body = Jason.encode!(email("signature-format"))
+    timestamp = Integer.to_string(System.system_time(:second))
+
+    for signed_bytes <- [body, timestamp <> body, timestamp <> ":" <> body] do
+      incorrect =
+        :crypto.mac(:hmac, :sha256, org.webhook_secret, signed_bytes)
+        |> Base.encode16(case: :lower)
+
+      assert response(deliver(org, body, timestamp: timestamp, signature: incorrect), 401)
+      assert counts() == before
+    end
+
+    # With valid authentication, malformed JSON is 400 instead of 401.
+    assert response(deliver(org, "not JSON"), 400)
+    assert counts() == before
+
+    # A valid signature on different bytes cannot authorize this body.
+    raw =
+      " {\"message_id\":\"raw\", \"from\":\"${OWNER_EMAIL}\", \"subject\":\"Raw\", \"text\":\"Exact bytes\"} \n"
+
+    timestamp = Integer.to_string(System.system_time(:second))
+    normalized = raw |> Jason.decode!() |> Jason.encode!()
+
+    assert response(
+             deliver(org, raw,
+               timestamp: timestamp,
+               signature: sign(org.webhook_secret, timestamp, normalized)
+             ),
+             401
+           )
+
+    assert counts() == before
+    raw_ticket = created(org, raw)
+    assert raw_ticket.body == "Exact bytes"
+
+    # Exercise valid timestamps on both sides, including the future 300-second boundary.
+    for offset <- [-240, 240, -295, 300] do
+      payload = email("window-#{offset}")
+
+      conn =
+        deliver(org, payload, timestamp: Integer.to_string(System.system_time(:second) + offset))
+
+      assert %{"ticket_id" => _} = json_response(conn, 201)
+    end
+
+    assert counts() == {5, 0}
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A5"
+  test "unknown organizations, byte limits, JSON errors and missing required fields return prescribed statuses" do
+    org = signed_org()
+    before = counts()
+    assert response(deliver(org, email("unknown-org"), slug: "not-a-real-organization"), 404)
+    assert response(deliver(org, "{invalid JSON"), 400)
+
+    for field <- ["message_id", "from"] do
+      assert response(deliver(org, Map.delete(email("missing-#{field}"), field)), 422)
+    end
+
+    assert counts() == before
+
+    large = Jason.encode!(email("oversize", %{"text" => String.duplicate("x", 65_536)}))
+    assert byte_size(large) > 65_536
+    assert response(deliver(org, large), 413)
+    assert counts() == before
+
+    # JSON trailing whitespace makes exact byte-boundary probes without changing fields.
+    encoded = Jason.encode!(email("boundary", %{"text" => "At the byte limit"}))
+    boundary = encoded <> String.duplicate(" ", 65_536 - byte_size(encoded))
+    assert byte_size(boundary) == 65_536
+    assert response(deliver(org, boundary <> " "), 413)
+    assert counts() == before
+    ticket = created(org, boundary)
+    assert ticket.body == "At the byte limit"
+    assert counts() == {1, 0}
+  end
+
