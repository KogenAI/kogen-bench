diff --git a/lib/trackline_web/plugs/inbound_email_auth.ex b/lib/trackline_web/plugs/inbound_email_auth.ex
new file mode 100644
index 0000000..788971e
--- /dev/null
+++ b/lib/trackline_web/plugs/inbound_email_auth.ex
@@ -0,0 +1,134 @@
+defmodule TracklineWeb.Plugs.InboundEmailAuth do
+  @moduledoc false
+  @behaviour Plug
+
+  import Plug.Conn
+
+  alias Trackline.Support
+
+  @max_body_bytes 65_536
+  @timestamp_window_seconds 300
+  @signature_pattern ~r/\A[0-9a-f]{64}\z/
+  @timestamp_pattern ~r/\A-?[0-9]+\z/
+
+  @impl Plug
+  def init(opts), do: opts
+
+  @impl Plug
+  def call(
+        %Plug.Conn{method: "POST", path_info: ["api", "orgs", slug, "inbound-email"]} = conn,
+        _opts
+      ) do
+    case Support.get_organization_by_slug(slug) do
+      nil ->
+        reject(conn, 404, "organization_not_found")
+
+      organization ->
+        authenticate_and_parse(conn, organization)
+    end
+  end
+
+  def call(conn, _opts), do: conn
+
+  defp authenticate_and_parse(conn, organization) do
+    timestamp_headers = get_req_header(conn, "x-webhook-timestamp")
+    signature_headers = get_req_header(conn, "x-webhook-signature")
+
+    authenticated =
+      with secret when is_binary(secret) and secret != "" <- organization.webhook_secret,
+           [timestamp] <- timestamp_headers,
+           {:ok, timestamp_seconds} <- parse_timestamp(timestamp),
+           true <- within_window?(timestamp_seconds),
+           [signature] <- signature_headers,
+           {:ok, body, conn} <- read_body_limited(conn) do
+        if valid_signature?(secret, timestamp, body, signature) do
+          {:ok, body, conn}
+        else
+          :unauthorized
+        end
+      else
+        :too_large -> :too_large
+        {:error, :read_body} -> :read_error
+        _ -> :unauthorized
+      end
+
+    case authenticated do
+      {:ok, body, conn} ->
+        case Jason.decode(body) do
+          {:ok, payload} when is_map(payload) ->
+            conn
+            |> assign(:inbound_email_organization, organization)
+            |> assign(:inbound_email_payload, payload)
+            |> Map.put(:body_params, payload)
+
+          _ ->
+            reject(conn, 400, "invalid_json")
+        end
+
+      :too_large ->
+        reject(conn, 413, "request_too_large")
+
+      :read_error ->
+        reject(conn, 400, "invalid_request_body")
+
+      :unauthorized ->
+        reject(conn, 401, "unauthorized")
+    end
+  end
+
+  defp parse_timestamp(timestamp) do
+    if is_binary(timestamp) and Regex.match?(@timestamp_pattern, timestamp) do
+      case Integer.parse(timestamp) do
+        {seconds, ""} -> {:ok, seconds}
+        _ -> :error
+      end
+    else
+      :error
+    end
+  end
+
+  defp within_window?(timestamp_seconds) do
+    abs(System.system_time(:second) - timestamp_seconds) <= @timestamp_window_seconds
+  end
+
+  defp valid_signature?(secret, timestamp, body, signature) do
+    if Regex.match?(@signature_pattern, signature) do
+      expected =
+        :crypto.mac(:hmac, :sha256, secret, timestamp <> "." <> body)
+        |> Base.encode16(case: :lower)
+
+      Plug.Crypto.secure_compare(expected, signature)
+    else
+      false
+    end
+  end
+
+  defp read_body_limited(conn), do: read_body_limited(conn, "")
+
+  defp read_body_limited(conn, accumulated) do
+    case read_body(conn, length: @max_body_bytes + 1, read_length: @max_body_bytes + 1) do
+      {:ok, chunk, conn} ->
+        body = accumulated <> chunk
+        if byte_size(body) <= @max_body_bytes, do: {:ok, body, conn}, else: :too_large
+
+      {:more, chunk, conn} ->
+        body = accumulated <> chunk
+
+        if byte_size(body) > @max_body_bytes do
+          :too_large
+        else
+          read_body_limited(conn, body)
+        end
+
+      {:error, _reason} ->
+        {:error, :read_body}
+    end
+  end
+
+  defp reject(conn, status, error) do
+    conn
+    |> put_resp_content_type("application/json")
+    |> send_resp(status, Jason.encode!(%{error: error}))
+    |> halt()
+  end
+end
