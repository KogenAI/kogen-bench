+  @tag intent: "syn-31-inbound-email-webhook/A6"
+  test "existing authored ticket and comment workflows remain intact" do
+    owner = user_fixture()
+    org = organization_fixture(owner)
+    other = organization_fixture()
+    {:ok, ticket} = Support.create_ticket(org, owner, %{title: "App ticket", body: "App body"})
+    assert ticket.author_id == owner.id
+    assert ticket.status == "open"
+    assert ticket.assignee_id == nil
+    {:ok, assigned} = Support.assign_ticket(ticket, owner)
+    assert assigned.assignee_id == owner.id
+    {:ok, pending} = Support.set_status(assigned, "pending")
+    assert pending.status == "pending"
+    {:ok, first} = Support.add_comment(pending, owner, %{body: "  First app comment  "})
+    {:ok, second} = Support.add_comment(pending, owner, %{body: "Second app comment"})
+    comments = Support.list_comments(pending)
+    assert Enum.map(comments, & &1.id) == [first.id, second.id]
+    assert Enum.map(comments, & &1.body) == ["First app comment", "Second app comment"]
+    assert Enum.all?(comments, &(&1.author_id == owner.id))
+    assert Enum.map(Support.list_tickets(org), & &1.id) == [ticket.id]
+    assert Support.list_tickets(other) == []
+    assert Support.comment_count(pending) == 2
+    {:ok, unassigned} = Support.assign_ticket(pending, nil)
+    assert unassigned.assignee_id == nil
+    {:error, changeset} = Support.create_ticket(org, owner, %{title: String.duplicate("x", 201)})
+    refute changeset.valid?
+
+    {:error, changeset} =
+      Support.add_comment(pending, owner, %{body: String.duplicate("x", 5_001)})
+
+    refute changeset.valid?
+  end
