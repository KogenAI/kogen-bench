+  end
+end
diff --git a/test/acceptance/syn-31-inbound-email-webhook_test.exs b/test/acceptance/syn-31-inbound-email-webhook_test.exs
new file mode 100644
index 0000000..308628a
--- /dev/null
+++ b/test/acceptance/syn-31-inbound-email-webhook_test.exs
@@ -0,0 +1,305 @@
+defmodule TracklineWeb.InboundEmailIntentTest do
+  use TracklineWeb.ConnCase, async: false
+
+  import Trackline.SupportFixtures
+  import Trackline.AccountsFixtures
+  alias Trackline.{Repo, Support}
+
+  defp organization(secret \\ "inbound-test-secret") do
+    organization_fixture(nil, %{webhook_secret: secret})
+  end
+
+  defp email(overrides \\ %{}) do
+    Map.merge(
+      %{
+        "message_id" => "message-#{System.unique_integer([:positive])}",
+        "from" => "${OWNER_EMAIL}",
+        "subject" => "Help with billing",
+        "text" => "Please investigate this charge."
+      },
+      overrides
+    )
+  end
+
+  defp signature(secret, timestamp, body) do
+    :crypto.mac(:hmac, :sha256, secret, timestamp <> "." <> body)
+    |> Base.encode16(case: :lower)
+  end
+
+  defp deliver_raw(org, body, opts \\ []) do
+    timestamp = Keyword.get(opts, :timestamp, Integer.to_string(System.system_time(:second)))
+    secret = Keyword.get(opts, :secret, org.webhook_secret || "")
+    sig = Keyword.get(opts, :signature, signature(secret, timestamp, body))
+
+    conn = build_conn() |> put_req_header("content-type", "application/json")
+
+    conn =
+      if Keyword.get(opts, :omit_timestamp, false),
+        do: conn,
+        else: put_req_header(conn, "x-webhook-timestamp", timestamp)
+
+    conn =
+      if Keyword.get(opts, :omit_signature, false),
+        do: conn,
+        else: put_req_header(conn, "x-webhook-signature", sig)
+
+    post(conn, "/api/orgs/#{org.slug}/inbound-email", body)
+  end
+
+  defp deliver(org, payload, opts \\ []) do
+    deliver_raw(org, Jason.encode!(payload), opts)
+  end
+
+  defp created(conn) do
+    result = json_response(conn, 201)
+    assert Map.keys(result) == ["ticket_id"]
+    assert is_integer(result["ticket_id"])
+    result["ticket_id"]
+  end
+
+  defp counts do
+    {Repo.aggregate("tickets", :count, :id), Repo.aggregate("comments", :count, :id)}
+  end
+
+  defp assert_prefix(actual, original, limit) do
+    assert is_binary(actual)
+    assert String.length(actual) in 1..limit
+    assert String.starts_with?(original, actual)
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A1"
+  test "new emails preserve bodies and sender while normalizing titles and ignoring attachments" do
+    org = organization()
+    long_body = String.duplicate("x", 50_000)
+
+    payload =
+      email(%{
+        "text" => long_body,
+        "attachments" => [%{"filename" => "invoice.pdf", "content" => "ignored"}]
+      })
+
+    id = created(deliver(org, payload))
+    ticket = Support.get_ticket!(id)
+    assert ticket.organization_id == org.id
+    assert ticket.title == payload["subject"]
+    assert ticket.body == long_body
+    assert Map.fetch!(ticket, :requester_email) == payload["from"]
+    assert ticket.status == "open"
+    assert ticket.author_id == nil
+    assert ticket.assignee_id == nil
+    assert Support.list_comments(ticket) == []
+
+    blank_id = created(deliver(org, email(%{"subject" => ""})))
+    assert Support.get_ticket!(blank_id).title == "(no subject)"
+
+    subject = String.duplicate("é", 250)
+    long_id = created(deliver(org, email(%{"subject" => subject})))
+    assert_prefix(Support.get_ticket!(long_id).title, subject, 200)
+    assert length(Support.list_tickets(org)) == 3
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A2"
+  test "reply chains append ordered anonymous comments and never cross organization boundaries" do
+    org = organization()
+    other = organization("other-secret")
+    root = email()
+    id = created(deliver(org, root))
+    first = email(%{"in_reply_to" => root["message_id"], "text" => "First reply"})
+    assert created(deliver(org, first)) == id
+    long_text = String.duplicate("é", 6_000)
+
+    second =
+      email(%{
+        "in_reply_to" => first["message_id"],
+        "text" => long_text,
+        "attachments" => [%{"filename" => "ignored.txt"}]
+      })
+
+    assert created(deliver(org, second)) == id
+    third = email(%{"in_reply_to" => second["message_id"], "text" => "Third reply"})
+    assert created(deliver(org, third)) == id
+
+    ticket = Support.get_ticket!(id)
+    [c1, c2, c3] = Support.list_comments(ticket)
+    assert c1.body == "First reply"
+    assert_prefix(c2.body, long_text, 5_000)
+    assert c3.body == "Third reply"
+    assert Enum.all?([c1, c2, c3], &is_nil(&1.author_id))
+    assert Enum.all?([c1, c2, c3], &is_nil(Map.get(&1, :assignee_id)))
+    assert Enum.all?([c1, c2, c3], &(&1.ticket_id == id))
+    assert ticket.body == root["text"]
+    assert ticket.author_id == nil
+    assert ticket.assignee_id == nil
+    assert length(Support.list_tickets(org)) == 1
+
+    unknown = email(%{"in_reply_to" => "unknown-message"})
+    unknown_id = created(deliver(org, unknown))
+    unknown_ticket = Support.get_ticket!(unknown_id)
+    assert unknown_id != id
+    assert unknown_ticket.organization_id == org.id
+    assert unknown_ticket.title == unknown["subject"]
+    assert unknown_ticket.body == unknown["text"]
+    assert Map.fetch!(unknown_ticket, :requester_email) == unknown["from"]
+    assert unknown_ticket.status == "open"
+    assert unknown_ticket.author_id == nil
+    assert unknown_ticket.assignee_id == nil
+    assert Support.list_comments(unknown_ticket) == []
+
+    foreign = email(%{"in_reply_to" => second["message_id"]})
+    foreign_id = created(deliver(other, foreign))
+    foreign_ticket = Support.get_ticket!(foreign_id)
+    assert foreign_id != id
+    assert foreign_ticket.organization_id == other.id
+    assert foreign_ticket.title == foreign["subject"]
+    assert foreign_ticket.body == foreign["text"]
+    assert Map.fetch!(foreign_ticket, :requester_email) == foreign["from"]
+    assert foreign_ticket.status == "open"
+    assert foreign_ticket.author_id == nil
+    assert foreign_ticket.assignee_id == nil
+    assert length(Support.list_comments(ticket)) == 3
+    assert Support.list_comments(foreign_ticket) == []
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A3"
+  test "ticket and comment redeliveries are idempotent with organization scoped message IDs" do
+    org = organization()
+    other = organization("other-secret")
+    root = email()
+    id = created(deliver(org, root))
+    original_ticket = Support.get_ticket!(id)
+    before_duplicate = counts()
+    assert json_response(deliver(org, root), 200) == %{"ticket_id" => id, "duplicate" => true}
+    assert counts() == before_duplicate
+    assert Support.get_ticket!(id) == original_ticket
+
+    reply = email(%{"in_reply_to" => root["message_id"], "text" => "Reply once"})
+    assert created(deliver(org, reply)) == id
+    ticket_before_duplicate = Support.get_ticket!(id)
+    comments = Support.list_comments(ticket_before_duplicate)
+    before_duplicate = counts()
+    assert json_response(deliver(org, reply), 200) == %{"ticket_id" => id, "duplicate" => true}
+    assert counts() == before_duplicate
+    assert Support.list_comments(Support.get_ticket!(id)) == comments
+    assert Support.get_ticket!(id) == ticket_before_duplicate
+
+    other_id = created(deliver(other, root))
+    assert other_id != id
+    assert Support.get_ticket!(other_id).organization_id == other.id
+    assert created(deliver(other, reply)) == other_id
+
+    assert json_response(deliver(other, reply), 200) == %{
+             "ticket_id" => other_id,
+             "duplicate" => true
+           }
+
+    assert length(Support.list_tickets(org)) == 1
+    assert length(Support.list_tickets(other)) == 1
+    assert Support.comment_count(Support.get_ticket!(id)) == 1
+    assert Support.comment_count(Support.get_ticket!(other_id)) == 1
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A4"
+  test "authentication uses exact raw bytes and rejects invalid credentials before decoding" do
+    org = organization()
+    payload = email()
+    raw = Jason.encode!(payload, pretty: true) <> "\n"
+    assert created(deliver_raw(org, raw)) > 0
+
+    for offset <- [-299, 299] do
+      timestamp = Integer.to_string(System.system_time(:second) + offset)
+      assert created(deliver(org, email(), timestamp: timestamp)) > 0
+    end
+
+    before_rejections = counts()
+    bad_json = "not JSON"
+    now = System.system_time(:second)
+
+    for opts <- [
+          [signature: String.duplicate("0", 64)],
+          [secret: "wrong-secret"],
+          [omit_signature: true],
+          [omit_timestamp: true],
+          [timestamp: "not-a-number"],
+          [timestamp: Integer.to_string(now) <> "invalid"],
+          [timestamp: Integer.to_string(now) <> ".5"],
+          [timestamp: Integer.to_string(now - 301)],
+          [timestamp: Integer.to_string(now + 302)]
+        ] do
+      assert deliver(org, email(), opts).status == 401
+      assert deliver_raw(org, bad_json, opts).status == 401
+    end
+
+    # A signature for canonical JSON must not authenticate different raw bytes.
+    changed = email()
+    canonical = Jason.encode!(changed)
+    timestamp = Integer.to_string(System.system_time(:second))
+    sig = signature(org.webhook_secret, timestamp, canonical)
+    assert deliver_raw(org, canonical <> " ", timestamp: timestamp, signature: sig).status == 401
+
+    no_secret = organization(nil)
+    empty_secret = organization() |> Ecto.Changeset.change(webhook_secret: "") |> Repo.update!()
+
+    for unconfigured <- [no_secret, empty_secret] do
+      assert deliver(unconfigured, email(), secret: "").status == 401
+      assert deliver_raw(unconfigured, bad_json, secret: "").status == 401
+    end
+
+    assert counts() == before_rejections
+  end
+
+  @tag intent: "syn-31-inbound-email-webhook/A5"
+  test "HTTP errors and the exact request size boundary follow the provider contract" do
+    org = organization()
+    before_rejections = counts()
+    unknown = %{org | slug: "missing-#{System.unique_integer([:positive])}"}
+    assert deliver(unknown, email()).status == 404
+    assert deliver_raw(org, "{broken JSON").status == 400
+
+    for field <- ["message_id", "from"] do
+      assert deliver(org, Map.delete(email(), field)).status == 422
+    end
+
+    payload = email()
+    json = Jason.encode!(payload)
+    boundary_body = json <> String.duplicate(" ", 65_536 - byte_size(json))
+    assert byte_size(boundary_body) == 65_536
+    assert deliver_raw(org, boundary_body <> " ").status == 413
+    assert counts() == before_rejections
+    id = created(deliver_raw(org, boundary_body))
+    assert Support.get_ticket!(id).body == payload["text"]
+    assert length(Support.list_tickets(org)) == 1
+  end
