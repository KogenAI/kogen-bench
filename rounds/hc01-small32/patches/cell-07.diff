@@ -0,0 +1,21 @@
+defmodule TracklineWeb.InboundEmailParser do
+  @moduledoc false
+
+  @behaviour Plug.Parsers
+
+  @impl true
+  def init(opts), do: opts
+
+  @impl true
+  def parse(%{method: "POST", request_path: path} = conn, _type, _subtype, _headers, _opts) do
+    if Regex.match?(~r{\A/api/orgs/[^/]+/inbound-email\z}, path) do
+      # Leave the body untouched for the webhook controller. It must first
+      # authenticate the exact bytes sent by the provider.
+      {:ok, %{}, conn}
+    else
+      {:next, conn}
+    end
+  end
+
+  def parse(conn, _type, _subtype, _headers, _opts), do: {:next, conn}
+end
