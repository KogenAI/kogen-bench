diff --git a/lib/trackline_web/controllers/inbound_email_controller.ex b/lib/trackline_web/controllers/inbound_email_controller.ex
new file mode 100644
index 0000000..284615f
--- /dev/null
+++ b/lib/trackline_web/controllers/inbound_email_controller.ex
@@ -0,0 +1,126 @@
+defmodule TracklineWeb.InboundEmailController do
+  use TracklineWeb, :controller
+
+  alias Trackline.Support
+
+  @max_body_bytes 65_536
+  @timestamp_window_seconds 300
+
+  def create(conn, %{"slug" => slug}) do
+    case Support.get_organization_by_slug(slug) do
+      nil -> respond_error(conn, 404, "not_found")
+      organization -> receive_email(conn, organization)
+    end
+  end
+
+  defp receive_email(conn, organization) do
+    case read_bounded_body(conn) do
+      {:too_large, conn} ->
+        respond_error(conn, 413, "payload_too_large")
+
+      {:error, conn} ->
+        respond_error(conn, 400, "invalid_body")
+
+      {:ok, body, conn} ->
+        if authenticated?(conn, organization.webhook_secret, body) do
+          decode_and_ingest(conn, organization, body)
+        else
+          respond_error(conn, 401, "unauthorized")
+        end
+    end
+  end
+
+  defp decode_and_ingest(conn, organization, body) do
+    case Jason.decode(body) do
+      {:ok, payload} when is_map(payload) ->
+        if required_fields?(payload) do
+          case Support.ingest_inbound_email(organization, payload) do
+            {:ok, ticket_id} ->
+              json(conn |> put_status(:created), %{ticket_id: ticket_id})
+
+            {:ok, ticket_id, :duplicate} ->
+              json(conn, %{ticket_id: ticket_id, duplicate: true})
+
+            {:error, :invalid_message} ->
+              respond_error(conn, 422, "missing_required_fields")
+
+            {:error, _reason} ->
+              respond_error(conn, 500, "ingestion_failed")
+          end
+        else
+          respond_error(conn, 422, "missing_required_fields")
+        end
+
+      {:ok, _non_object} ->
+        respond_error(conn, 422, "missing_required_fields")
+
+      {:error, _decode_error} ->
+        respond_error(conn, 400, "invalid_json")
+    end
+  end
+
+  defp required_fields?(payload) do
+    non_empty_string?(Map.get(payload, "message_id")) and
+      non_empty_string?(Map.get(payload, "from"))
+  end
+
+  defp non_empty_string?(value), do: is_binary(value) and byte_size(value) > 0
+
+  defp authenticated?(conn, secret, body) when is_binary(secret) and byte_size(secret) > 0 do
+    case {get_req_header(conn, "x-webhook-timestamp"),
+          get_req_header(conn, "x-webhook-signature")} do
+      {[timestamp], [signature]} ->
+        with true <- Regex.match?(~r/\A-?[0-9]+\z/, timestamp),
+             {timestamp_seconds, ""} <- Integer.parse(timestamp),
+             true <-
+               abs(System.system_time(:second) - timestamp_seconds) <= @timestamp_window_seconds,
+             true <- Regex.match?(~r/\A[0-9a-f]{64}\z/, signature) do
+          expected =
+            :crypto.mac(:hmac, :sha256, secret, timestamp <> "." <> body)
+            |> Base.encode16(case: :lower)
+
+          Plug.Crypto.secure_compare(expected, signature)
+        else
+          _ -> false
+        end
+
+      _ ->
+        false
+    end
+  end
+
+  defp authenticated?(_conn, _secret, _body), do: false
+
+  defp read_bounded_body(conn), do: read_bounded_body(conn, "")
+
+  defp read_bounded_body(conn, accumulated) do
+    remaining = @max_body_bytes + 1 - byte_size(accumulated)
+
+    case Plug.Conn.read_body(conn, length: remaining, read_length: remaining) do
+      {:ok, chunk, conn} ->
+        body = accumulated <> chunk
+
+        if byte_size(body) > @max_body_bytes do
+          {:too_large, conn}
+        else
+          {:ok, body, conn}
+        end
+
+      {:more, chunk, conn} ->
+        body = accumulated <> chunk
+
+        if byte_size(body) > @max_body_bytes do
+          {:too_large, conn}
+        else
+          read_bounded_body(conn, body)
+        end
+
+      {:error, _reason} ->
+        {:error, conn}
+    end
+  end
+
+  defp respond_error(conn, status, error) do
+    conn |> put_status(status) |> json(%{error: error})
+  end
+end
