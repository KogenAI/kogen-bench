+  @doc """
+  Atomically ingest an authenticated provider message. Every accepted message is
+  tracked within its organization so duplicate deliveries and reply chains are
+  resolved durably.
+  """
+  def ingest_inbound_email(%Organization{id: org_id}, attrs) when is_map(attrs) do
+    message_id = Map.get(attrs, "message_id")
+    sender = Map.get(attrs, "from")
+
+    if valid_non_empty_string?(message_id) and valid_non_empty_string?(sender) do
+      subject = attrs |> Map.get("subject") |> normalize_subject()
+      body = attrs |> Map.get("text") |> normalize_text()
+      in_reply_to = Map.get(attrs, "in_reply_to")
+
+      result =
+        Repo.transaction(fn ->
+          case Repo.get_by(InboundMessage, organization_id: org_id, message_id: message_id) do
+            %InboundMessage{ticket_id: ticket_id} ->
+              {:duplicate, ticket_id}
+
+            nil ->
+              ticket_id =
+                case resolve_inbound_reply(org_id, in_reply_to) do
+                  nil -> create_inbound_ticket!(org_id, sender, subject, body)
+                  ticket_id -> create_inbound_comment!(ticket_id, body)
+                end
+
+              insert_inbound_message!(org_id, ticket_id, message_id)
+              {:created, ticket_id}
+          end
+        end)
+
+      case result do
+        {:ok, {:created, ticket_id}} ->
+          {:ok, ticket_id}
+
+        {:ok, {:duplicate, ticket_id}} ->
+          {:ok, ticket_id, :duplicate}
+
+        {:error, :duplicate_conflict} ->
+          case Repo.get_by(InboundMessage, organization_id: org_id, message_id: message_id) do
+            %InboundMessage{ticket_id: ticket_id} -> {:ok, ticket_id, :duplicate}
+            nil -> {:error, :duplicate_conflict}
+          end
+
+        {:error, reason} ->
+          {:error, reason}
+      end
+    else
+      {:error, :invalid_message}
+    end
+  end
+
+  def ingest_inbound_email(_organization, _attrs), do: {:error, :invalid_message}
+
+  defp create_inbound_ticket!(org_id, sender, subject, body) do
+    title =
+      case subject do
+        "" -> "(no subject)"
+        value -> String.slice(value, 0, 200)
+      end
+
+    ticket = %Ticket{
+      organization_id: org_id,
+      author_id: nil,
+      assignee_id: nil,
+      requester_email: sender,
+      status: "open"
+    }
+
+    case ticket |> Ticket.changeset(%{title: title, body: body}) |> Repo.insert() do
+      {:ok, ticket} -> ticket.id
+      {:error, changeset} -> Repo.rollback({:insert_error, changeset})
+    end
+  end
+
+  defp create_inbound_comment!(ticket_id, body) do
+    comment = %Comment{ticket_id: ticket_id, author_id: nil, body: String.slice(body, 0, 5_000)}
+
+    case Repo.insert(comment) do
+      {:ok, _comment} -> ticket_id
+      {:error, changeset} -> Repo.rollback({:insert_error, changeset})
+    end
+  end
+
+  defp insert_inbound_message!(org_id, ticket_id, message_id) do
+    changeset =
+      %InboundMessage{}
+      |> InboundMessage.changeset(%{
+        organization_id: org_id,
+        ticket_id: ticket_id,
+        message_id: message_id
+      })
+
+    case Repo.insert(changeset) do
+      {:ok, _message} ->
+        :ok
+
+      {:error, changeset} ->
+        if unique_message_conflict?(changeset) do
+          Repo.rollback(:duplicate_conflict)
+        else
+          Repo.rollback({:insert_error, changeset})
+        end
+    end
+  end
+
+  defp unique_message_conflict?(changeset) do
+    Enum.any?(changeset.errors, fn {_field, {_message, options}} ->
+      Keyword.get(options, :constraint) == :unique
+    end)
+  end
+
+  defp resolve_inbound_reply(org_id, message_id)
+       when is_binary(message_id) and message_id != "" do
+    case Repo.get_by(InboundMessage, organization_id: org_id, message_id: message_id) do
+      %InboundMessage{ticket_id: ticket_id} -> ticket_id
+      nil -> nil
+    end
+  end
+
+  defp resolve_inbound_reply(_org_id, _message_id), do: nil
+
+  defp valid_non_empty_string?(value), do: is_binary(value) and byte_size(value) > 0
+
+  defp normalize_subject(value) when is_binary(value), do: value
+  defp normalize_subject(_value), do: ""
+
+  defp normalize_text(value) when is_binary(value), do: value
+  defp normalize_text(_value), do: ""
+
   def change_ticket(%Ticket{} = ticket, attrs \\ %{}), do: Ticket.changeset(ticket, attrs)
 
   def set_status(%Ticket{} = ticket, status) do
