  pure val fixture220: Fixture = { id: "valid_flow", doc: { bytes: Octets([123, 110, 97, 109, 101, 58, 32, 112, 114, 111, 106, 101, 99, 116, 44, 32, 99, 104, 101, 99, 107, 115, 58, 32, 91, 123, 110, 97, 109, 101, 58, 32, 108, 105, 110, 116, 44, 32, 97, 114, 103, 118, 58, 32, 91, 34, 116, 114, 117, 101, 34, 93, 44, 32, 116, 105, 109, 101, 111, 117, 116, 95, 109, 115, 58, 32, 49, 125, 93, 125, 10]), nodes: Map(0 -> { path: "project", value: Mapping([{ key: "name", debug: "name", kind: "string", id: 1, line: 1, lineText: "1" }, { key: "checks", debug: "checks", kind: "string", id: 2, line: 2, lineText: "2" }]) }, 1 -> { path: "name", value: Text("project") }, 2 -> { path: "checks", value: Sequence([3]) }, 3 -> { path: "checks[1]", value: Mapping([{ key: "name", debug: "name", kind: "string", id: 4, line: 2, lineText: "2" }, { key: "argv", debug: "argv", kind: "string", id: 5, line: 2, lineText: "2" }, { key: "timeout_ms", debug: "timeout_ms", kind: "string", id: 7, line: 2, lineText: "2" }]) }, 4 -> { path: "checks[1].name", value: Text("lint") }, 5 -> { path: "checks[1].argv", value: Sequence([6]) }, 6 -> { path: "checks[1].argv[1]", value: Text("true") }, 7 -> { path: "checks[1].timeout_ms", value: Integer(1) }), syntax: [] }, accepted: true }
  pure val fixture221: Fixture = { id: "valid_comments", doc: { bytes: Octets([110, 97, 109, 101, 58, 32, 112, 114, 111, 106, 101, 99, 116, 32, 35, 32, 99, 111, 109, 109, 101, 110, 116, 10, 99, 104, 101, 99, 107, 115, 58, 32, 91, 93, 10]), nodes: Map(0 -> { path: "project", value: Mapping([{ key: "name", debug: "name", kind: "string", id: 1, line: 1, lineText: "1" }, { key: "checks", debug: "checks", kind: "string", id: 2, line: 2, lineText: "2" }]) }, 1 -> { path: "name", value: Text("project") }, 2 -> { path: "checks", value: Sequence([]) }), syntax: [] }, accepted: true }
  pure val fixture222: Fixture = { id: "valid_crlf", doc: { bytes: Octets([110, 97, 109, 101, 58, 32, 112, 114, 111, 106, 101, 99, 116, 13, 10, 99, 104, 101, 99, 107, 115, 58, 32, 91, 93, 13, 10]), nodes: Map(0 -> { path: "project", value: Mapping([{ key: "name", debug: "name", kind: "string", id: 1, line: 1, lineText: "1" }, { key: "checks", debug: "checks", kind: "string", id: 2, line: 2, lineText: "2" }]) }, 1 -> { path: "name", value: Text("project") }, 2 -> { path: "checks", value: Sequence([]) }), syntax: [] }, accepted: true }
  pure val fixture223: Fixture = { id: "same_line_duplicate_scopes", accepted: false, doc: {
    bytes: Octets([123, 120, 58, 32, 123, 121, 58, 32, 97, 44, 32, 121, 58, 32, 98, 125, 44, 32, 120, 58, 32, 99, 125, 10]), syntax: [], nodes: Map(
      0 -> { path: "project", value: Mapping([
        { key: "x", debug: "x", kind: "string", id: 1, line: 1, lineText: "1" },
        { key: "x", debug: "x", kind: "string", id: 4, line: 1, lineText: "1" }]) },
      1 -> { path: "x", value: Mapping([
        { key: "y", debug: "y", kind: "string", id: 2, line: 1, lineText: "1" },
        { key: "y", debug: "y", kind: "string", id: 3, line: 1, lineText: "1" }]) },
      2 -> { path: "x.y", value: Text("a") },
      3 -> { path: "x.y", value: Text("b") },
      4 -> { path: "x", value: Text("c") }) } }
  // Otherwise-valid ASCII YAML padded with a comment to the byte boundary.
  // Doubling keeps the source compact; WriteFile still emits every concrete byte.
  pure val boundaryPadding: List[int] = 0.to(19).fold([32], (bs, _) => bs.concat(bs))
  pure def boundaryDocument(byteCount: int): Document = {
    val prefix = match bareBytes { Octets(bs) => bs.append(35) | _ => [] }
    { ...fixture0.doc,
      bytes: Octets(prefix.concat(boundaryPadding.slice(0, byteCount - prefix.length()))) }
  }
  pure val sizeAtLimit: Fixture = {
    id: "size_at_limit", doc: boundaryDocument(1048576), accepted: true }
  pure val sizeOverLimit: Fixture = {
    id: "size_over_limit", doc: boundaryDocument(1048577), accepted: false }
  pure val fixtures: List[Fixture] = [fixture0, fixture1, fixture2, fixture3, fixture4, fixture5, fixture6, fixture7, fixture8, fixture9, fixture10, fixture11, fixture12, fixture13, fixture14, fixture15, fixture16, fixture17, fixture18, fixture19, fixture20, fixture21, fixture22, fixture23, fixture24, fixture25, fixture26, fixture27, fixture28, fixture29, fixture30, fixture31, fixture32, fixture33, fixture34, fixture35, fixture36, fixture37, fixture38, fixture39, fixture40, fixture41, fixture42, fixture43, fixture44, fixture45, fixture46, fixture47, fixture48, fixture49, fixture50, fixture51, fixture52, fixture53, fixture54, fixture55, fixture56, fixture57, fixture58, fixture59, fixture60, fixture61, fixture62, fixture63, fixture64, fixture65, fixture66, fixture67, fixture68, fixture69, fixture70, fixture71, fixture72, fixture73, fixture74, fixture75, fixture76, fixture77, fixture78, fixture79, fixture80, fixture81, fixture82, fixture83, fixture84, fixture85, fixture86, fixture87, fixture88, fixture89, fixture90, fixture91, fixture92, fixture93, fixture94, fixture95, fixture96, fixture97, fixture98, fixture99, fixture100, fixture101, fixture102, fixture103, fixture104, fixture105, fixture106, fixture107, fixture108, fixture109, fixture110, fixture111, fixture112, fixture113, fixture114, fixture115, fixture116, fixture117, fixture118, fixture119, fixture120, fixture121, fixture122, fixture123, fixture124, fixture125, fixture126, fixture127, fixture128, fixture129, fixture130, fixture131, fixture132, fixture133, fixture134, fixture135, fixture136, fixture137, fixture138, fixture139, fixture140, fixture141, fixture142, fixture143, fixture144, fixture145, fixture146, fixture147, fixture148, fixture149, fixture150, fixture151, fixture152, fixture153, fixture154, fixture155, fixture156, fixture157, fixture158, fixture159, fixture160, fixture161, fixture162, fixture163, fixture164, fixture165, fixture166, fixture167, fixture168, fixture169, fixture170, fixture171, fixture172, fixture173, fixture174, fixture175, fixture176, fixture177, fixture178, fixture179, fixture180, fixture181, fixture182, fixture183, fixture184, fixture185, fixture186, fixture187, fixture188, fixture189, fixture190, fixture191, fixture192, fixture193, fixture194, fixture195, fixture196, fixture197, fixture198, fixture199, fixture200, fixture201, fixture202, fixture203, fixture204, fixture205, fixture206, fixture207, fixture208, fixture209, fixture210, fixture211, fixture212, fixture213, fixture214, fixture215, fixture216, fixture217, fixture218, fixture219, fixture220, fixture221, fixture222, fixture223, sizeAtLimit, sizeOverLimit]
  pure def named(id: str): Fixture = fixtures.foldl(fixture0, (found, f) => if (f.id == id) f else found)


  // Exact stdout oracle, including quote bytes that kogen_io.Line cannot encode.
  // Internal marker \x22 is translated here, never given to the replay runner.
  pure val quotedFragments: str -> List[Bytes] = Map(" has unknown key \x22" -> [Utf8(" has unknown key "), Octets([34])], " has unknown role \x22" -> [Utf8(" has unknown role "), Octets([34])], ".name duplicates check name \x22" -> [Utf8(".name duplicates check name "), Octets([34])], "\x22" -> [Octets([34])], "\x22 at " -> [Octets([34]), Utf8(" at ")], "\x22 is reserved" -> [Octets([34]), Utf8(" is reserved")], "duplicate key \x22" -> [Utf8("duplicate key "), Octets([34])], "env key \x22" -> [Utf8("env key "), Octets([34])], "quote \x22a[1]\x22: brackets inside a flow collection" -> [Utf8("quote "), Octets([34]), Utf8("a[1]"), Octets([34]), Utf8(": brackets inside a flow collection")], "unquoted `: ` inside a value: \x22a: b\x22" -> [Utf8("unquoted `: ` inside a value: "), Octets([34]), Utf8("a: b"), Octets([34])])
  pure def diagnosticBytes(parts: Line): List[Bytes] = parts.foldl([], (bs, part) =>
    bs.concat(if (quotedFragments.keys().contains(part)) quotedFragments.get(part) else [Utf8(part)]))
  pure def preciseConfigError(d: Document): { exitCode: int, stdout: List[List[Bytes]], stderr: Bytes } = {
    exitCode: 3,
    stdout: [[Utf8("environment/project_config_invalid: ${repo}/.kogen/project.yaml")]]
      .concat(validation(d).foldl([], (lines, parts) => lines.append([Utf8("  ")].concat(diagnosticBytes(parts))))),
    stderr: Utf8("")
  }
  pure def replayableDiagnostics(d: Document): bool = validation(d).indices().forall(i =>
    validation(d).nth(i).indices().forall(j => not(quotedFragments.keys().contains(validation(d).nth(i).nth(j)))))

  pure def sizePreflight(byteCount: int): List[Issue] =
    if (byteCount > 1048576) [{ line: 0, lineText: "0", rank: 0, order: 0,
      detail: ["document exceeds the maximum size of 1048576 bytes"] }] else []
  pure def fixtureIndex(id: str): int = fixtures.indices().fold(-1, (found, i) =>
    if (fixtures.nth(i).id == id) i else found)
  pure def initMessage(existing: bool): List[Line] =
    if (existing) [["Kogen is already initialized."]] else [["Initialized Kogen project."]]

  // Consume the lifecycle owner's semantic warning. The CLI owner selects
  // stderr with the shared warning prefix; exact wording is not fixed by CORE.
  pure def successfulInitExpect(existing: bool): Expect = {
    ...exited(0, initMessage(existing)),
    stderr: { class: Observe("warning"),
      text: ExactLines([["kogen: warning: ", agentWarning]]) }
  }
  // Explicit current-Rust divergence, never used as a conforming lastStep.
  pure def missingInitWarningDivergence(existing: bool): Expect = exited(0, initMessage(existing))

  type State = { current: Optional[int], history: str, ignorePresent: bool,
    cargoRoot: bool, mixRoot: bool, lastResult: int, cliWrites: int }
  var st: State
  var ioSeam: Seam
  var lastStep: List[Step]
  pure def currentDocument(s: State): Document =
    match s.current { Present(i) => fixtures.nth(i).doc | Missing => fixture0.doc }
  pure def stableGit(s: State): Git = {
    ...noGitExpectation,
    head: Observe(if (s.history == "unborn") Missing else
      Present(if (s.history == "history") "${historyHead}" else "${initializedHead}")),
    symbolicHead: Observe(Present("refs/heads/main")),
    indexTree: Observe(if (s.history == "unborn") "${emptyIndex}" else
      if (s.history == "history") "${emptyIndex}" else "${initializedIndex}"), kogenRefs: { complete: true, entries: Map() }
  }
  pure val ignoreBytes = Octets([46, 107, 111, 103, 101, 110, 47, 108, 111, 99, 97, 108, 47, 10])
  pure def stableFiles(s: State): str -> File = Map(
    "${repo}/.kogen/project.yaml" -> (match s.current {
      Missing => AbsentFile | Present(i) => FileBytes(fixtures.nth(i).doc.bytes) }),
    "${repo}/.gitignore" -> (if (s.ignorePresent) FileBytes(ignoreBytes) else AbsentFile),
    "${home}/.kogen/accounts.yaml" -> AbsentFile)
  pure def configValidationExpect(s: State): Expect = {
    val expected = if (valid(currentDocument(s))) successfulInitExpect(true)
      else { ...noExpectation, exitCode: Observe(3),
        stdoutLines: if (replayableDiagnostics(currentDocument(s)))
          Observe([["environment/project_config_invalid: ${repo}/.kogen/project.yaml"]]
            .concat(validation(currentDocument(s)).foldl([], (lines, parts) => lines.append(["  "].concat(parts))))) else Unobserved,
        stderr: { class: Observe("empty"), text: ExactLines([]) } }
    { ...expected, git: Observe(stableGit(s)), files: stableFiles(s) }
  }
  // Success/no-op and required warning are observed on both successful routes.
  pure def freshConfigExpect(s: State): Expect = {
    ...successfulInitExpect(false),
    git: Observe({ ...noGitExpectation,
      head: Observe(Present("${capture:initializedHead:oid}")),
      indexTree: Observe("${capture:initializedIndex:oid}"),
      symbolicHead: Observe(Present("refs/heads/main")), subject: Observe(initSubject(s.history != "unborn")),
      changedPaths: Observe(Set(".kogen/project.yaml", ".gitignore")),
      parents: Observe(if (s.history == "unborn") [] else ["${historyHead}"]),
      author: Observe({ name: "Kogen Suite", email: "kogen-suite@example.invalid" }),
      committer: Observe({ name: "Kogen Suite", email: "kogen-suite@example.invalid" }),
      kogenRefs: { complete: true, entries: Map() } }),
    files: Map("${repo}/.kogen/project.yaml" -> FileBytes(bareBytes),
      "${repo}/.gitignore" -> FileBytes(ignoreBytes), "${home}/.kogen/accounts.yaml" -> AbsentFile),
    relations: [Different({ left: "${initializedIndex}", right: "${emptyIndex}" })]
      .concat(if (s.history == "history") [Different({ left: "${initializedHead}", right: "${historyHead}" })] else [])
  }
  action init = all {
    st' = { current: Missing, history: "unborn", ignorePresent: false,
      cargoRoot: false, mixRoot: false, lastResult: -1, cliWrites: 0 },
    ioSeam' = defaultSeam,
    lastStep' = [Setup({ op: Inspect, expect: { ...noExpectation,
      git: Observe({ ...noGitExpectation, head: Observe(Missing),
        symbolicHead: Observe(Present("refs/heads/main")),
        indexTree: Observe("${capture:emptyIndex:oid}") }) } })]
  }
  action install(index: int): bool = all {
    index >= 0 and index < fixtures.length(),
    st' = { ...st, current: Present(index), lastResult: -1 }, ioSeam' = ioSeam,
    lastStep' = [Setup({ op: WriteFile({ path: "${repo}/.kogen/project.yaml",
      bytes: fixtures.nth(index).doc.bytes, mode: 420 }), expect: {
        ...noExpectation, git: Observe(stableGit(st)),
        files: Map("${repo}/.kogen/project.yaml" -> FileBytes(fixtures.nth(index).doc.bytes)) } })]
  }
  action removeConfig = all {
    st.history != "initialized", st' = { ...st, current: Missing, lastResult: -1 }, ioSeam' = ioSeam,
    lastStep' = [setupStep(DeletePath("${repo}/.kogen/project.yaml"))]
  }
  action existingConfigInit = all {
    st.current != Missing, st' = { ...st, lastResult: if (valid(currentDocument(st))) 0 else 3 },
    ioSeam' = ioSeam, lastStep' = [cliStep(command(["init"]), configValidationExpect(st))]
  }
  action writeDefaults = all {
    st.current == Missing, st.history != "initialized",
    st' = { ...st, current: Present(0), history: "initialized", ignorePresent: true,
      lastResult: 0, cliWrites: 1 }, ioSeam' = ioSeam,
    lastStep' = [cliStep(command(["init"]), freshConfigExpect(st))]
  }
  action seedHistory = all {
    st.history == "unborn", st' = { ...st, history: "history", lastResult: -1 }, ioSeam' = ioSeam,
    lastStep' = [Setup({ op: GitCommand({ executable: "git",
      argv: ["commit", "--allow-empty", "-m", "Baseline"], stdin: Utf8(""), env: Map(),
      cwd: "${repo}", timeoutMs: 30000 }), expect: {
        ...noExpectation, exitCode: Observe(0), git: Observe({ ...noGitExpectation,
          head: Observe(Present("${capture:historyHead:oid}")), subject: Observe("Baseline"),
          changedPaths: Observe(Set()), parents: Observe([]) }) } })]
  }
  action setMarkers(cargo: bool, mix: bool): bool = all {
    st' = { ...st, cargoRoot: cargo, mixRoot: mix, lastResult: -1 }, ioSeam' = ioSeam,
    lastStep' = [setupStep(if (cargo) WriteFile({ path: "${repo}/Cargo.toml",
      bytes: Utf8("[package]
name = 'suite'
version = '0.1.0'
"), mode: 420 }) else DeletePath("${repo}/Cargo.toml")),
      setupStep(if (mix) WriteFile({ path: "${repo}/mix.exs",
        bytes: Utf8("defmodule Suite.MixProject do
end
"), mode: 420 }) else DeletePath("${repo}/mix.exs"))]
  }
  action step = any {
    nondet index = 0.to(fixtures.length() - 1).oneOf()
    install(index),
    existingConfigInit, writeDefaults, removeConfig, seedHistory,
    nondet cargo = Set(false, true).oneOf()
    nondet mix = Set(false, true).oneOf()
    setMarkers(cargo, mix)
  }
  val schemaInvariant = match st.current {
    Missing => true | Present(i) => i >= 0 and i < fixtures.length() and
      valid(fixtures.nth(i).doc) == fixtures.nth(i).accepted }
  val defaultsInvariant = and {
    st.cliWrites >= 0 and st.cliWrites <= 1,
    (st.history == "initialized") == (st.cliWrites == 1), st.cliWrites == 1 implies st.ignorePresent,
    st.lastResult == 0 implies st.current != Missing and valid(currentDocument(st)),
    st.lastResult == 3 implies st.current != Missing and not(valid(currentDocument(st))) }
  val adapterInvariant = (selectedAdapter(currentDocument(st), st.cargoRoot, st.mixRoot) == ExUnit) implies st.mixRoot
  val replayInvariant = ioSeam == defaultSeam and lastStep.indices().forall(i => match lastStep.nth(i) {
    Cli(c) => and {
      validCmd(c.cmd), c.cmd.argv == ["init"], c.expect.exitCode == Observe(st.lastResult),
      st.lastResult == 0 implies and {
        c.expect.stdoutLines == Observe(initMessage(true)) or
          c.expect.stdoutLines == Observe(initMessage(false)),
        c.expect.stderr == successfulInitExpect(true).stderr,
        c.expect.stderr != missingInitWarningDivergence(true).stderr
      },
      st.lastResult == 3 implies c.expect.stderr.text == ExactLines([])
    }
    | Setup(_) => st.lastResult == -1 })
  val invariant = schemaInvariant and defaultsInvariant and adapterInvariant and replayInvariant

  run fixtureCorpusTest = init.expect(fixtures.indices().forall(i => valid(fixtures.nth(i).doc) == fixtures.nth(i).accepted))
  run requiredFieldsTest = init.expect(validation(named("missing_both").doc) ==
    [["missing required key `", "name", "`"], ["missing required key `", "checks", "`"]] and
    valid(named("empty_name").doc) and valid(named("bare").doc))
  run exactCheckDiagnosticsTest = init.expect(and {
    validation(named("argv_shell").doc) == [["checks[1]", ".argv must be a list"]],
    validation(named("argv_empty").doc) == [["checks[1]", ".argv must be a non-empty list of strings"]],
    validation(named("timeout_zero").doc) == [["checks[1]", ".", "timeout_ms", " must be a positive integer"]],
    validation(named("duplicate_check_names").doc) == [["checks[2]", ".name duplicates check name \x22", "lint", "\x22"]],
    valid(named("same_name_across_lists").doc) })
  run strictSubsetFirstErrorTest = init.expect(and {
    validation(named("duplicate_root").doc) == [["line ", "3", ": ", "duplicate key \x22", "name", "\x22 at ", "project", ".", "name"]],
    validation(named("yaml_tab").doc) == [["line ", "3", ": ", "tab character: indent with spaces"]],
    validation(named("yaml_empty").doc) == [["empty document"]],
    validation(named("duplicate_unknown_subtree").doc).length() == 1 })
  run optionalRegistryTest = init.expect(projectKeys.size() == 16 and acceptanceKeys.size() == 5 and buildKeys.size() == 7 and
    not(projectKeys.contains("credentials")) and not(projectKeys.contains("accounts")))
  run defaultsAndPrecedenceTest = init.expect(and {
    named("bare").doc.bytes == bareBytes, not(webSearch(named("bare").doc)),
    not(webSearch(named("shaping_false").doc)), webSearch(named("shaping_true").doc),
    retentionDays(named("bare").doc) == 14, retentionDays(named("retention_one").doc) == 1,
    budgetMs(named("bare").doc) == 3600000, budgetMs(named("build_budget_precedence").doc) == 99,
    budgetMs(named("build_minutes").doc) == 120000 })
  run adapterDetectionTest = init.expect(and {
    detectAdapter(Missing, false, false) == CriteriaOnly, detectAdapter(Missing, true, false) == Cargo,
    detectAdapter(Missing, false, true) == ExUnit, detectAdapter(Missing, true, true) == Cargo,
    detectAdapter(Present("exunit"), true, false) == CriteriaOnly, detectAdapter(Present("exunit"), true, true) == ExUnit,
    detectAdapter(Present("command"), true, true) == CommandAdapter,
    detectAdapter(Present("cargo"), false, true) == Cargo, detectAdapter(Present("rails"), false, false) == Rails,
    detectAdapter(Present("criteria"), true, true) == CriteriaOnly,
    detectAdapter(Present("criteria-only"), true, true) == CriteriaOnly,
    detectAdapter(Present("unknown"), true, true) == CriteriaOnly })
  run freshInitThenNoopTest = init.then(writeDefaults).then(existingConfigInit).expect(st.cliWrites == 1 and st.lastResult == 0 and invariant)
  run freshInitOutputTest = init.then(writeDefaults).expect(match lastStep.nth(0) {
    Cli(c) => c.expect.stdoutLines == Observe(initMessage(false)) and
      c.expect.stderr == successfulInitExpect(false).stderr and
      c.expect.stderr != missingInitWarningDivergence(false).stderr
    | _ => false
  })
  run existingInitWarningTest = init.then(install(fixtureIndex("bare")))
    .then(existingConfigInit).expect(match lastStep.nth(0) {
      Cli(c) => c.expect.stdoutLines == Observe(initMessage(true)) and
        c.expect.stderr == successfulInitExpect(true).stderr and
        c.expect.stderr != missingInitWarningDivergence(true).stderr
      | _ => false
    })
  run invalidInitNoWritesTest = init.then(install(fixtureIndex("root_list"))).then(existingConfigInit).expect(st.cliWrites == 0 and st.lastResult == 3 and st.history == "unborn" and invariant)
  run existingValidInitNoWritesTest = init.then(install(fixtureIndex("valid_checks"))).then(existingConfigInit).expect(st.cliWrites == 0 and st.lastResult == 0 and st.history == "unborn" and invariant)
  run historyInitSubjectTest = init.then(seedHistory).then(writeDefaults).expect(st.history == "initialized" and st.cliWrites == 1 and invariant)
  run cargoMarkerNeverDiscoversChecksTest = init.then(setMarkers(true, true)).then(writeDefaults).expect(
    rows(currentDocument(st), lookup(currentDocument(st), 0, "checks")).length() == 0 and selectedAdapter(currentDocument(st), true, true) == Cargo and invariant)

  run sizeLimitTest = init.expect(and {
    sizePreflight(1048576) == [],
    sizePreflight(1048577) == [{ line: 0, lineText: "0", rank: 0, order: 0,
      detail: ["document exceeds the maximum size of 1048576 bytes"] }]
  })
  run exactLimitCliTest = init.then(install(fixtureIndex("size_at_limit")))
    .then(existingConfigInit).expect(and {
      st.lastResult == 0, st.cliWrites == 0, st.history == "unborn", invariant,
      match lastStep.nth(0) {
        Cli(c) => c.expect.exitCode == Observe(0) and
          c.expect.git == Observe(stableGit(st)) and c.expect.files == stableFiles(st)
        | _ => false
      }
    })
  run overLimitCliTest = init.then(install(fixtureIndex("size_over_limit")))
    .then(existingConfigInit).expect(and {
      st.lastResult == 3, st.cliWrites == 0, st.history == "unborn", invariant,
      match lastStep.nth(0) {
        Cli(c) => c.expect.exitCode == Observe(3) and c.expect.stdoutLines == Observe([
          ["environment/project_config_invalid: ${repo}/.kogen/project.yaml"],
          ["  ", "document exceeds the maximum size of 1048576 bytes"]]) and
          c.expect.stderr.text == ExactLines([]) and
          c.expect.git == Observe(stableGit(st)) and c.expect.files == stableFiles(st)
        | _ => false
      }
    })
  run sizeBoundaryBytesTest = init.expect(and {
    match sizeAtLimit.doc.bytes { Octets(bs) => bs.length() == 1048576 | _ => false },
    match sizeOverLimit.doc.bytes { Octets(bs) => bs.length() == 1048577 | _ => false },
    sizeAtLimit.doc.nodes == fixture0.doc.nodes,
    sizeOverLimit.doc.nodes == fixture0.doc.nodes,
    sizeAtLimit.doc.syntax == [], sizeOverLimit.doc.syntax == []
  })
  val exactLimitCliWitness = st.current == Present(fixtureIndex("size_at_limit")) and st.lastResult == 0
  val overLimitCliWitness = st.current == Present(fixtureIndex("size_over_limit")) and st.lastResult == 3

  run exactQuoteBytesTest = init.expect(and {
    diagnosticBytes(["duplicate key \x22", "name", "\x22 at ", "project", ".", "name"]) ==
      [Utf8("duplicate key "), Octets([34]), Utf8("name"), Octets([34]), Utf8(" at "),
        Utf8("project"), Utf8("."), Utf8("name")],
    preciseConfigError(named("duplicate_root").doc).exitCode == 3,
    preciseConfigError(named("duplicate_root").doc).stderr == Utf8(""),
    not(replayableDiagnostics(named("duplicate_root").doc)),
    replayableDiagnostics(named("argv_shell").doc)
  })
  run exactUnquotedCliErrorTest = init.then(install(fixtureIndex("argv_shell")))
    .then(existingConfigInit).expect(match lastStep.nth(0) {
      Cli(c) => c.expect.stdoutLines == Observe([
        ["environment/project_config_invalid: ${repo}/.kogen/project.yaml"],
        ["  ", "checks[1]", ".argv must be a list"]]) and c.expect.exitCode == Observe(3) and
        c.expect.stderr.text == ExactLines([])
      | _ => false
    })
  run correctedConfigTest = init.then(install(fixtureIndex("shaping_string"))).then(existingConfigInit)
    .then(install(fixtureIndex("shaping_true"))).then(existingConfigInit)
    .expect(st.lastResult == 0 and st.cliWrites == 0 and webSearch(currentDocument(st)) and invariant)
  run repeatedInvalidConfigTest = init.then(install(fixtureIndex("timeout_zero"))).then(existingConfigInit)
    .then(existingConfigInit).expect(st.lastResult == 3 and st.cliWrites == 0 and invariant)
  run sameLineDuplicateOrderTest = init.expect(validation(fixture223.doc) ==
    [["line ", "1", ": ", "duplicate key \x22", "y", "\x22 at ", "project.", "x", ".", "y"]])
  pure def shapingRepairLimit(d: Document): int = match value(d, lookup(d, lookup(d, 0, "shaping"), "repair_limit")) { Integer(n) => n | _ => 2 }
  run defaultShapingRepairLimitTest = init.expect(shapingRepairLimit(fixture0.doc) == 2)
}
