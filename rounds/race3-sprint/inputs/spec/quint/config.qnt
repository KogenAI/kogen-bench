// CORE 4.1.schema/required/check-schema/optional and 5.init-files.
// Finite lossless YAML syntax witnesses; schema validation is independent of Rust.
module config {
  import kogen_io.* from "./kogen_io"
  import init.agentWarning from "./init"

  type Entry = { key: str, debug: str, kind: str, id: int, line: int, lineText: str }
  type Value = Text(str) | Integer(int) | U64Maximum | U64Overflow | Boolean(bool) | OtherScalar
    | Sequence(List[int]) | Mapping(List[Entry]) | NoValue
  type Node = { path: str, value: Value }
  type Issue = { line: int, lineText: str, rank: int, order: int, detail: Line }
  type Document = { bytes: Bytes, nodes: int -> Node, syntax: List[Issue] }
  type Fixture = { id: str, doc: Document, accepted: bool }
  type Adapter = Cargo | ExUnit | Rails | CommandAdapter | CriteriaOnly

  pure val projectKeys = Set("name", "checks", "acceptance_checks", "setup", "fix", "format",
    "protected_paths", "gate_paths", "domains", "env", "sandbox", "base", "acceptance",
    "shaping", "build", "recovery_retention_days")
  pure val checkKeys = Set("name", "argv", "timeout_ms")
  pure val acceptanceKeys = Set("adapter", "ext", "candidate_dir", "run", "timeout_ms")
  pure val buildKeys = Set("roles", "wall_minutes", "tool_result_tokens", "model_generation_tokens",
    "budget_ms", "log_limit_bytes", "memory_limit_bytes")
  pure val positiveBuildKeys = ["wall_minutes", "budget_ms", "tool_result_tokens",
    "model_generation_tokens", "log_limit_bytes", "memory_limit_bytes"]
  pure val roleKeys = Set("builder", "shaper", "auditor")
  pure val bareBytes = Octets([110, 97, 109, 101, 58, 32, 112, 114, 111, 106, 101, 99, 116, 10, 99, 104, 101, 99, 107, 115, 58, 32, 91, 93, 10])

  pure def node(d: Document, id: int): Node =
    if (d.nodes.keys().contains(id)) d.nodes.get(id) else { path: "", value: NoValue }
  pure def value(d: Document, id: int): Value = node(d, id).value
  pure def entries(d: Document, id: int): List[Entry] =
    match value(d, id) { Mapping(es) => es | _ => [] }
  pure def rows(d: Document, id: int): List[int] =
    match value(d, id) { Sequence(rs) => rs | _ => [] }
  pure def lookup(d: Document, id: int, key: str): int =
    entries(d, id).foldl(-1, (found, e) => if (e.kind != "nonstring" and e.key == key) e.id else found)
  pure def has(d: Document, id: int, key: str): bool = lookup(d, id, key) != -1
  pure def isMap(v: Value): bool = match v { Mapping(_) => true | _ => false }
  pure def isList(v: Value): bool = match v { Sequence(_) => true | _ => false }
  pure def isText(v: Value): bool = match v { Text(_) => true | _ => false }
  pure def text(v: Value): str = match v { Text(s) => s | _ => "" }
  pure def isBool(v: Value): bool = match v { Boolean(_) => true | _ => false }
  pure def positive(v: Value): bool = match v { Integer(n) => n > 0 | U64Maximum => true | _ => false }
  pure def issueWhen(b: bool, parts: Line): List[Line] = if (b) [parts] else []
  pure def path(d: Document, id: int): Line = [node(d, id).path]
  pure def unknown(d: Document, id: int, allowed: Set[str]): List[Line] =
    entries(d, id).foldl([], (issues, e) => issues.concat(
      if (e.kind == "nonstring") [path(d, id).concat([" has non-string key ", e.debug])]
      else issueWhen(not(allowed.contains(e.key)), path(d, id).concat([" has unknown key \x22", e.key, "\x22"]))))
  pure def required(d: Document, id: int, requiredKeys: List[str], root: bool): List[Line] =
    requiredKeys.foldl([], (issues, k) => issues.concat(issueWhen(not(has(d, id, k)),
      (if (root) [] else path(d, id).concat([" is "])).concat(["missing required key `", k, "`"]))))
  pure def stringField(d: Document, id: int, key: str): List[Line] =
    issueWhen(has(d, id, key) and not(isText(value(d, lookup(d, id, key)))),
      (if (id == 0) [] else path(d, id).concat(["."])).concat([key, " must be a string"]))
  pure def positiveField(d: Document, id: int, key: str): List[Line] =
    issueWhen(has(d, id, key) and not(positive(value(d, lookup(d, id, key)))),
      (if (id == 0) [] else path(d, id).concat(["."])).concat([key, " must be a positive integer"]))
  pure def booleanField(d: Document, id: int, key: str): List[Line] =
    issueWhen(has(d, id, key) and not(isBool(value(d, lookup(d, id, key)))),
      (if (id == 0) [] else path(d, id).concat(["."])).concat([key, " must be true or false"]))
  // `nonempty` here forbids empty elements, not an empty vector (Rust behavior).
  pure def strings(d: Document, id: int, nonempty: bool): List[Line] =
    if (not(isList(value(d, id)))) [path(d, id).concat([" must be a list"])]
    else issueWhen(rows(d, id).indices().exists(i =>
      not(isText(value(d, rows(d, id).nth(i)))) or
      (nonempty and text(value(d, rows(d, id).nth(i))) == "")),
      path(d, id).concat([" must contain only strings"]))
  pure def checkRow(d: Document, id: int, earlier: Set[str]): List[Line] =
    if (not(isMap(value(d, id)))) [path(d, id).concat([" must be a map"])] else {
      val nameId = lookup(d, id, "name")
      val argvId = lookup(d, id, "argv")
      unknown(d, id, checkKeys)
        .concat(required(d, id, ["name"], false)).concat(stringField(d, id, "name"))
        .concat(issueWhen(isText(value(d, nameId)) and earlier.contains(text(value(d, nameId))),
          path(d, id).concat([".name duplicates check name \x22", text(value(d, nameId)), "\x22"])))
        .concat(if (argvId == -1) required(d, id, ["argv"], false)
          else if (not(isList(value(d, argvId)))) [path(d, id).concat([".argv must be a list"])]
          else issueWhen(rows(d, argvId).length() == 0 or
            rows(d, argvId).indices().exists(i => not(isText(value(d, rows(d, argvId).nth(i))))),
            path(d, id).concat([".argv must be a non-empty list of strings"])))
        .concat(required(d, id, ["timeout_ms"], false)).concat(positiveField(d, id, "timeout_ms"))
    }
  pure def checks(d: Document, id: int): List[Line] =
    if (not(isList(value(d, id)))) [path(d, id).concat([" must be a list"])] else {
      val result = rows(d, id).foldl({ names: Set(), issues: [] }, (acc, row) => {
        names: if (isText(value(d, lookup(d, row, "name"))))
          acc.names.union(Set(text(value(d, lookup(d, row, "name"))))) else acc.names,
        issues: acc.issues.concat(checkRow(d, row, acc.names))
      })
      result.issues
    }
  pure def domains(d: Document, id: int): List[Line] =
    if (not(isMap(value(d, id)))) [path(d, id).concat([" must be a map"])]
    else entries(d, id).foldl([], (issues, e) => issues.concat(
      if (e.kind == "nonstring") [path(d, id).concat([" has non-string key ", e.debug])]
      else strings(d, e.id, false)))
  pure def environment(d: Document, id: int): List[Line] =
    if (not(isMap(value(d, id)))) [path(d, id).concat([" must be a map"])]
    else entries(d, id).foldl([], (issues, e) => issues.concat(
      if (e.kind == "nonstring") [path(d, id).concat([" has non-string key ", e.debug])]
      else issueWhen(e.kind == "reserved", ["env key \x22", e.key, "\x22 is reserved"])
        .concat(issueWhen(not(isText(value(d, e.id))), path(d, e.id).concat([" must be a string"])))))
  pure def acceptanceIssues(d: Document, id: int): List[Line] =
    if (not(isMap(value(d, id)))) [path(d, id).concat([" must be a map"])]
    else unknown(d, id, acceptanceKeys)
      .concat(["adapter", "ext", "candidate_dir"].foldl([], (is, k) => is.concat(stringField(d, id, k))))
      .concat(if (has(d, id, "run")) strings(d, lookup(d, id, "run"), true) else [])
      .concat(positiveField(d, id, "timeout_ms"))
  pure def shapingIssues(d: Document, id: int): List[Line] =
    if (not(isMap(value(d, id)))) [path(d, id).concat([" must be a map"])]
    else unknown(d, id, Set("web_search", "repair_limit")).concat(booleanField(d, id, "web_search"))
      .concat(if (has(d, id, "repair_limit")) issueWhen(not(match value(d, lookup(d, id, "repair_limit")) { Integer(n) => n >= 0 and n <= 5 | _ => false }), ["shaping.repair_limit must be an integer from 0 through 5"]) else [])
  pure def roles(d: Document, id: int): List[Line] =
    if (not(isMap(value(d, id)))) [path(d, id).concat([" must be a map"])]
    else entries(d, id).foldl([], (issues, e) => issues.concat(
      if (e.kind == "nonstring") [path(d, id).concat([" has non-string key ", e.debug])]
      else if (not(roleKeys.contains(e.key))) [path(d, id).concat([" has unknown role \x22", e.key, "\x22"])]
      else if (not(isMap(value(d, e.id)))) [path(d, e.id).concat([" must be a map"])]
      else unknown(d, e.id, Set("model", "effort"))
        .concat(["model", "effort"].foldl([], (is, k) => is
          .concat(required(d, e.id, [k], false)).concat(stringField(d, e.id, k))))))
  pure def buildIssues(d: Document, id: int): List[Line] =
    if (not(isMap(value(d, id)))) [path(d, id).concat([" must be a map"])] else {
      val limit = value(d, lookup(d, id, "log_limit_bytes"))
      unknown(d, id, buildKeys)
        .concat(if (has(d, id, "roles")) roles(d, lookup(d, id, "roles")) else [])
        .concat(positiveBuildKeys.foldl([], (is, k) => is.concat(positiveField(d, id, k))))
        .concat(issueWhen(match limit { Integer(n) => n >= 0 and n < 12 | _ => false },
          ["build.log_limit_bytes must be at least 12"]))
    }
  pure def schemaIssues(d: Document): List[Line] =
    if (not(isMap(value(d, 0)))) [["project config must be a YAML map"]] else
      unknown(d, 0, projectKeys).concat(required(d, 0, ["name", "checks"], true))
        .concat(stringField(d, 0, "name")).concat(stringField(d, 0, "base"))
        .concat(["checks", "acceptance_checks", "setup", "fix"].foldl([], (is, k) => is
          .concat(if (has(d, 0, k)) checks(d, lookup(d, 0, k)) else [])))
        .concat(["protected_paths", "gate_paths", "format"].foldl([], (is, k) => is
          .concat(if (has(d, 0, k)) strings(d, lookup(d, 0, k), k == "format") else [])))
        .concat(if (has(d, 0, "domains")) domains(d, lookup(d, 0, "domains")) else [])
        .concat(if (has(d, 0, "env")) environment(d, lookup(d, 0, "env")) else [])
        .concat(booleanField(d, 0, "sandbox")).concat(positiveField(d, 0, "recovery_retention_days"))
        .concat(if (has(d, 0, "acceptance")) acceptanceIssues(d, lookup(d, 0, "acceptance")) else [])
        .concat(if (has(d, 0, "shaping")) shapingIssues(d, lookup(d, 0, "shaping")) else [])
        .concat(if (has(d, 0, "build")) buildIssues(d, lookup(d, 0, "build")) else [])

  // All mapping scopes, including open env/domain names and unknown subtrees.
  // Duplicate detection precedes schema validation; quoted keys are decoded.
  pure def duplicates(d: Document): List[Issue] = d.nodes.keys().fold([], (issues, id) => {
    val es = entries(d, id)
    issues.concat(es.indices().fold([], (is, i) => is.concat(
      if (es.indices().exists(j => j < i and es.nth(j).key == es.nth(i).key)) [{
        line: es.nth(i).line, lineText: es.nth(i).lineText, rank: 20, order: es.nth(i).id,
        detail: ["duplicate key \x22", es.nth(i).key, "\x22 at "]
          .concat(if (id == 0) ["project"] else ["project.", node(d, id).path])
          .concat([".", es.nth(i).key])
      }] else [])))
  })
  pure def validation(d: Document): List[Line] = {
    val sizeErrors = match d.bytes { Octets(bs) => sizePreflight(bs.length()) | Utf8(_) => [] }
    val candidates = sizeErrors.concat(d.syntax).concat(duplicates(d))
    if (candidates.length() == 0) schemaIssues(d) else {
      val first = candidates.foldl(candidates.nth(0), (a, b) =>
        if (b.line < a.line or (b.line == a.line and b.rank < a.rank) or
          (b.line == a.line and b.rank == a.rank and b.order < a.order)) b else a)
      [(if (first.line == 0) [] else ["line ", first.lineText, ": "]).concat(first.detail)]
    }
  }
  pure def valid(d: Document): bool = validation(d).length() == 0
  pure def webSearch(d: Document): bool =
    value(d, lookup(d, lookup(d, 0, "shaping"), "web_search")) == Boolean(true)
  pure def retentionDays(d: Document): int =
    match value(d, lookup(d, 0, "recovery_retention_days")) { Integer(n) => n | _ => 14 }
  pure def budgetMs(d: Document): int =
    match value(d, lookup(d, lookup(d, 0, "build"), "budget_ms")) {
      Integer(n) => n | _ => match value(d, lookup(d, lookup(d, 0, "build"), "wall_minutes")) {
        Integer(n) => n * 60000 | _ => 3600000
      }
    }
  // Detection is a shared helper consumed by the shape owner, not an init discovery action.
  pure def detectAdapter(configured: Optional[str], cargoMarker: bool, mixMarker: bool): Adapter =
    match configured {
      Present(s) => if (s == "cargo") Cargo else if (s == "exunit")
        (if (mixMarker) ExUnit else CriteriaOnly)
        else if (s == "rails") Rails else if (s == "command") CommandAdapter else CriteriaOnly
      | Missing => if (cargoMarker) Cargo else if (mixMarker) ExUnit else CriteriaOnly
    }
  pure def selectedAdapter(d: Document, cargoMarker: bool, mixMarker: bool): Adapter = {
    val v = value(d, lookup(d, lookup(d, 0, "acceptance"), "adapter"))
    detectAdapter(if (isText(v)) Present(text(v)) else Missing, cargoMarker, mixMarker)
  }

  // Concrete byte witnesses and their lossless finite syntax trees.
  pure val fixture0: Fixture = { id: "bare", doc: { bytes: bareBytes, nodes: Map(0 -> { path: "project", value: Mapping([{ key: "name", debug: "name", kind: "string", id: 1, line: 1, lineText: "1" }, { key: "checks", debug: "checks", kind: "string", id: 2, line: 2, lineText: "2" }]) }, 1 -> { path: "name", value: Text("project") }, 2 -> { path: "checks", value: Sequence([]) }), syntax: [] }, accepted: true }
  pure val fixture1: Fixture = { id: "empty_name", doc: { bytes: Octets([110, 97, 109, 101, 58, 32, 34, 34, 10, 99, 104, 101, 99, 107, 115, 58, 32, 91, 93, 10]), nodes: Map(0 -> { path: "project", value: Mapping([{ key: "name", debug: "name", kind: "string", id: 1, line: 1, lineText: "1" }, { key: "checks", debug: "checks", kind: "string", id: 2, line: 2, lineText: "2" }]) }, 1 -> { path: "name", value: Text("") }, 2 -> { path: "checks", value: Sequence([]) }), syntax: [] }, accepted: true }
  pure val fixture2: Fixture = { id: "quoted_numeric_name", doc: { bytes: Octets([110, 97, 109, 101, 58, 32, 34, 49, 50, 51, 34, 10, 99, 104, 101, 99, 107, 115, 58, 32, 91, 93, 10]), nodes: Map(0 -> { path: "project", value: Mapping([{ key: "name", debug: "name", kind: "string", id: 1, line: 1, lineText: "1" }, { key: "checks", debug: "checks", kind: "string", id: 2, line: 2, lineText: "2" }]) }, 1 -> { path: "name", value: Text("123") }, 2 -> { path: "checks", value: Sequence([]) }), syntax: [] }, accepted: true }
  pure val fixture3: Fixture = { id: "valid_checks", doc: { bytes: Octets([110, 97, 109, 101, 58, 32, 34, 112, 114, 111, 106, 101, 99, 116, 34, 10, 99, 104, 101, 99, 107, 115, 58, 32, 91, 123, 34, 110, 97, 109, 101, 34, 58, 32, 34, 108, 105, 110, 116, 34, 44, 32, 34, 97, 114, 103, 118, 34, 58, 32, 91, 34, 116, 114, 117, 101, 34, 93, 44, 32, 34, 116, 105, 109, 101, 111, 117, 116, 95, 109, 115, 34, 58, 32, 49, 125, 44, 32, 123, 34, 110, 97, 109, 101, 34, 58, 32, 34, 116, 101, 115, 116, 34, 44, 32, 34, 97, 114, 103, 118, 34, 58, 32, 91, 34, 112, 114, 105, 110, 116, 102, 34, 44, 32, 34, 97, 32, 98, 34, 44, 32, 34, 59, 34, 93, 44, 32, 34, 116, 105, 109, 101, 111, 117, 116, 95, 109, 115, 34, 58, 32, 49, 48, 48, 48, 125, 93, 10]), nodes: Map(0 -> { path: "project", value: Mapping([{ key: "name", debug: "name", kind: "string", id: 1, line: 1, lineText: "1" }, { key: "checks", debug: "checks", kind: "string", id: 2, line: 2, lineText: "2" }]) }, 1 -> { path: "name", value: Text("project") }, 2 -> { path: "checks", value: Sequence([3, 8]) }, 3 -> { path: "checks[1]", value: Mapping([{ key: "name", debug: "name", kind: "string", id: 4, line: 2, lineText: "2" }, { key: "argv", debug: "argv", kind: "string", id: 5, line: 2, lineText: "2" }, { key: "timeout_ms", debug: "timeout_ms", kind: "string", id: 7, line: 2, lineText: "2" }]) }, 4 -> { path: "checks[1].name", value: Text("lint") }, 5 -> { path: "checks[1].argv", value: Sequence([6]) }, 6 -> { path: "checks[1].argv[1]", value: Text("true") }, 7 -> { path: "checks[1].timeout_ms", value: Integer(1) }, 8 -> { path: "checks[2]", value: Mapping([{ key: "name", debug: "name", kind: "string", id: 9, line: 2, lineText: "2" }, { key: "argv", debug: "argv", kind: "string", id: 10, line: 2, lineText: "2" }, { key: "timeout_ms", debug: "timeout_ms", kind: "string", id: 14, line: 2, lineText: "2" }]) }, 9 -> { path: "checks[2].name", value: Text("test") }, 10 -> { path: "checks[2].argv", value: Sequence([11, 12, 13]) }, 11 -> { path: "checks[2].argv[1]", value: Text("printf") }, 12 -> { path: "checks[2].argv[2]", value: Text("a b") }, 13 -> { path: "checks[2].argv[3]", value: Text(";") }, 14 -> { path: "checks[2].timeout_ms", value: Integer(1000) }), syntax: [] }, accepted: true }
  pure val fixture4: Fixture = { id: "empty_argv_element", doc: { bytes: Octets([110, 97, 109, 101, 58, 32, 34, 112, 114, 111, 106, 101, 99, 116, 34, 10, 99, 104, 101, 99, 107, 115, 58, 32, 91, 123, 34, 110, 97, 109, 101, 34, 58, 32, 34, 34, 44, 32, 34, 97, 114, 103, 118, 34, 58, 32, 91, 34, 34, 93, 44, 32, 34, 116, 105, 109, 101, 111, 117, 116, 95, 109, 115, 34, 58, 32, 49, 125, 93, 10]), nodes: Map(0 -> { path: "project", value: Mapping([{ key: "name", debug: "name", kind: "string", id: 1, line: 1, lineText: "1" }, { key: "checks", debug: "checks", kind: "string", id: 2, line: 2, lineText: "2" }]) }, 1 -> { path: "name", value: Text("project") }, 2 -> { path: "checks", value: Sequence([3]) }, 3 -> { path: "checks[1]", value: Mapping([{ key: "name", debug: "name", kind: "string", id: 4, line: 2, lineText: "2" }, { key: "argv", debug: "argv", kind: "string", id: 5, line: 2, lineText: "2" }, { key: "timeout_ms", debug: "timeout_ms", kind: "string", id: 7, line: 2, lineText: "2" }]) }, 4 -> { path: "checks[1].name", value: Text("") }, 5 -> { path: "checks[1].argv", value: Sequence([6]) }, 6 -> { path: "checks[1].argv[1]", value: Text("") }, 7 -> { path: "checks[1].timeout_ms", value: Integer(1) }), syntax: [] }, accepted: true }
  pure val fixture5: Fixture = { id: "root_list", doc: { bytes: Octets([91, 93, 10]), nodes: Map(0 -> { path: "project", value: Sequence([]) }), syntax: [] }, accepted: false }
  pure val fixture6: Fixture = { id: "root_string", doc: { bytes: Octets([34, 112, 114, 111, 106, 101, 99, 116, 34, 10]), nodes: Map(0 -> { path: "project", value: Text("project") }), syntax: [] }, accepted: false }
  pure val fixture7: Fixture = { id: "root_null", doc: { bytes: Octets([110, 117, 108, 108, 10]), nodes: Map(0 -> { path: "project", value: OtherScalar }), syntax: [] }, accepted: false }
  pure val fixture8: Fixture = { id: "missing_both", doc: { bytes: Octets([123, 125, 10]), nodes: Map(0 -> { path: "project", value: Mapping([]) }), syntax: [] }, accepted: false }
  pure val fixture9: Fixture = { id: "missing_name", doc: { bytes: Octets([99, 104, 101, 99, 107, 115, 58, 32, 91, 93, 10]), nodes: Map(0 -> { path: "project", value: Mapping([{ key: "checks", debug: "checks", kind: "string", id: 1, line: 1, lineText: "1" }]) }, 1 -> { path: "checks", value: Sequence([]) }), syntax: [] }, accepted: false }
  pure val fixture10: Fixture = { id: "missing_checks", doc: { bytes: Octets([110, 97, 109, 101, 58, 32, 34, 112, 114, 111, 106, 101, 99, 116, 34, 10]), nodes: Map(0 -> { path: "project", value: Mapping([{ key: "name", debug: "name", kind: "string", id: 1, line: 1, lineText: "1" }]) }, 1 -> { path: "name", value: Text("project") }), syntax: [] }, accepted: false }
  pure val fixture11: Fixture = { id: "name_number", doc: { bytes: Octets([110, 97, 109, 101, 58, 32, 49, 10, 99, 104, 101, 99, 107, 115, 58, 32, 91, 93, 10]), nodes: Map(0 -> { path: "project", value: Mapping([{ key: "name", debug: "name", kind: "string", id: 1, line: 1, lineText: "1" }, { key: "checks", debug: "checks", kind: "string", id: 2, line: 2, lineText: "2" }]) }, 1 -> { path: "name", value: Integer(1) }, 2 -> { path: "checks", value: Sequence([]) }), syntax: [] }, accepted: false }
  pure val fixture12: Fixture = { id: "name_bool", doc: { bytes: Octets([110, 97, 109, 101, 58, 32, 116, 114, 117, 101, 10, 99, 104, 101, 99, 107, 115, 58, 32, 91, 93, 10]), nodes: Map(0 -> { path: "project", value: Mapping([{ key: "name", debug: "name", kind: "string", id: 1, line: 1, lineText: "1" }, { key: "checks", debug: "checks", kind: "string", id: 2, line: 2, lineText: "2" }]) }, 1 -> { path: "name", value: Boolean(true) }, 2 -> { path: "checks", value: Sequence([]) }), syntax: [] }, accepted: false }
  pure val fixture13: Fixture = { id: "name_null", doc: { bytes: Octets([110, 97, 109, 101, 58, 32, 110, 117, 108, 108, 10, 99, 104, 101, 99, 107, 115, 58, 32, 91, 93, 10]), nodes: Map(0 -> { path: "project", value: Mapping([{ key: "name", debug: "name", kind: "string", id: 1, line: 1, lineText: "1" }, { key: "checks", debug: "checks", kind: "string", id: 2, line: 2, lineText: "2" }]) }, 1 -> { path: "name", value: OtherScalar }, 2 -> { path: "checks", value: Sequence([]) }), syntax: [] }, accepted: false }
