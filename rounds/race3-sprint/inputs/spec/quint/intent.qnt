  pure val fixtureScripts: str -> FixtureScript = Map(
    "life" -> fixtureScript([]),
    "life.shape.criteria" -> fixtureScript([shaperFixture(shapeCriteria), shaperFixture(shapeDone)]),
    "life.shape.second" -> fixtureScript([shaperFixture(shapeSecond), shaperFixture(shapeDone)]),
    "life.shape.cargo" -> fixtureScript([shaperFixture(shapeCargo), shaperFixture(shapeDone)]),
    "life.shape.exunit" -> fixtureScript([shaperFixture(shapeExunit), shaperFixture(shapeDone)]),
    "life.shape.format-missing" -> fixtureScript([shaperFixture(shapeCriteria), shaperFixture(shapeDone)]),
    "life.shape.environment" -> fixtureScript([shaperFixture(shapeCargo), shaperFixture(shapeDone)]),
    "life.shape.questions" -> fixtureScript([shaperFixture(shapeQuestions)]),
    "life.shape.repair-cap" -> fixtureScript((0.to(5)).fold([], (xs, _) => xs.concat([shaperFixture(shapeBad), shaperFixture(shapeDone)]))),
    "life.build.cargo" -> { ...fixtureScript([builderFixture(builderCargoWrite), builderFixture(builderFinish), builderFixture(builderFinish)]), min_requests: 2 },
    "life.build.cargo-gated" -> fixtureScript([fixtureTurn("gpt-6-luna", "max", builderCargoWrite, 200, Present("private-build"), 0), builderFixture(builderFinish)]),
    "life.build.self-fix-gated" -> fixtureScript([fixtureTurn("gpt-6-luna", "max", builderBad, 200, Present("private-build"), 0), builderFixture(builderWrite), builderFixture(builderFinish)]),
    "life.build.gated" -> fixtureScript([fixtureTurn("gpt-6-luna", "max", builderWrite, 200, Present("private-build"), 0), builderFixture(builderFinish)]),
    "life.build.green" -> fixtureScript([builderFixture(builderWrite), builderFixture(builderFinish)]),
    "life.build.self-fix" -> fixtureScript([builderFixture(builderBad), builderFixture(builderWrite), builderFixture(builderFinish)]),
    "life.build.protected" -> fixtureScript([builderFixture(builderProtected), builderFixture(builderFinish)]),
    "life.build.expiry" -> { ...fixtureScript([fixtureTurn("gpt-6-luna", "max", builderWrite, 200, Missing, 5000)]), min_requests: 1 },
    "life.build.custody" -> fixtureScript([builderFixture(builderCustody), builderFixture(builderFinish)]),
    "life.build.overload" -> { ...fixtureScript((0.to(59)).fold([], (xs, _) => xs.append(fixtureTurn("gpt-6-luna", "max", overload, 503, Missing, 0)))), min_requests: 1 },
    "life.queue.serial" -> fixtureScript([builderFixture(builderWrite), builderFixture(builderFinish), builderFixture(builderWrite), builderFixture(builderFinish)]),
    "life.queue.gated" -> { ...fixtureScript([fixtureTurn("gpt-6-luna", "max", builderWrite, 200, Present("first-build"), 0), builderFixture(builderFinish)]), min_requests: 2 },
    "life.landing.red-turns" -> fixtureScript([builderFixture(builderWrite), builderFixture(builderFinish)].concat(
      ["red1", "red2", "red3", "red4"].foldl([], (xs, gate) => xs.concat([fixtureTurn("gpt-6-luna", "max", builderWrite, 200, Present(gate), 0), builderFixture(builderFinish)])))),
    "life.landing.turn-cap" -> { ...fixtureScript((0.to(4)).fold([], (xs, _) => xs.concat([builderFixture(builderWrite), builderFixture(builderFinish)]))), min_requests: 2 },
    "life.landing.hook" -> { ...fixtureScript((0.to(4)).fold([], (xs, _) => xs.concat([builderFixture(builderWrite), builderFixture(builderFinish)]))), min_requests: 2 },
    "life.landing.green" -> { ...fixtureScript([builderFixture(builderWrite), builderFixture(builderFinish), builderFixture(builderWrite), builderFixture(builderFinish)]), min_requests: 2 },
    "life.check.green" -> fixtureScript([builderFixture(builderWrite), builderFixture(builderFinish)]),
    "life.check.exit101" -> { ...fixtureScript([builderFixture(builderWrite), builderFixture(builderFinish), builderFixture(builderFinish)]), min_requests: 2 },
    "life.check.zero" -> { ...fixtureScript([builderFixture(builderWrite), builderFixture(builderFinish), builderFixture(builderFinish)]), min_requests: 2 },
    "life.check.malformed" -> { ...fixtureScript([builderFixture(builderWrite), builderFixture(builderFinish), builderFixture(builderFinish)]), min_requests: 2 },
    "life.check.red" -> { ...fixtureScript([builderFixture(builderWrite), builderFixture(builderFinish), builderFixture(builderFinish)]), min_requests: 2 },
    "life.check.matrix" -> { ...fixtureScript([builderFixture(builderWrite), builderFixture(builderFinish), builderFixture(builderFinish)]), min_requests: 2 },
    "life.check.mixed" -> { ...fixtureScript([builderFixture(builderWrite), builderFixture(builderFinish), builderFixture(builderFinish)]), min_requests: 2 },
    "life.check.missing-target" -> { ...fixtureScript([builderFixture(builderWrite), builderFixture(builderFinish), builderFixture(builderFinish)]), min_requests: 2 },
    "life.check.timeout" -> { ...fixtureScript([builderFixture(builderWrite), builderFixture(builderFinish), builderFixture(builderFinish)]), min_requests: 2 }
  )
  pure def observedGit(g: Git): bool = g.branches.complete or g.branches.entries.keys() != Set()
    or g.kogenRefs.complete or g.kogenRefs.entries.keys() != Set()
    or g.head != Unobserved or g.symbolicHead != Unobserved or g.headTree != Unobserved
    or g.indexTree != Unobserved or g.subject != Unobserved or g.trailers != Unobserved
    or g.changedPaths != Unobserved or g.parents != Unobserved or g.author != Unobserved or g.committer != Unobserved
  pure def observedFilesOrGit(e: Expect): bool = e.files.keys() != Set() or e.jsonFiles.keys() != Set()
    or (match e.git { Unobserved => false | Observe(g) => observedGit(g) })
  pure def observedEffect(e: Expect): bool = e.stdoutLines != Unobserved or e.stderr.text != IgnoreText
    or observedFilesOrGit(e) or e.jsonRows != Unobserved or e.statusRows != Unobserved
  pure def validSetup(op: SetupOp, e: Expect): bool = match op {
    WriteFile(f) => f.path != "" and validBytes(f.bytes) and f.mode >= 0 and f.mode <= 511
    | DeletePath(p) => p != ""
    | GitCommand(g) => g.executable == "git" and g.argv.length() > 0 and validBytes(g.stdin) and g.cwd != "" and g.timeoutMs > 0
    | AwaitExit(a) => a.handle != "" and a.timeoutMs > 0 and e.exitCode != Unobserved
      and (observedEffect(e) or e.stderr.class != Unobserved)
    | AwaitOutput(a) => a.handle != "" and a.pattern != "" and a.timeoutMs > 0
    | ProviderGate(g) => fixtureScripts.keys().contains(g.script) and Set("await", "release").contains(g.operation)
      and fixtureScripts.get(g.script).turns.indices().exists(i => fixtureScripts.get(g.script).turns.nth(i).response.chunks.indices().exists(j =>
        fixtureScripts.get(g.script).turns.nth(i).response.chunks.nth(j).gate == Present(g.gate))) and g.timeoutMs > 0
    | AwaitBarrier(b) => Set("before-candidate-recheck", "before-publication", "after-cas-loss").contains(b.point) and b.ticket != "" and b.timeoutMs > 0
    | ReleaseBarrier(ticket) => ticket != ""
    | Inspect => observedFilesOrGit(e)
    | AdvanceClock(ms) => ms >= 0
    | WaitRealMs(ms) => ms >= 0
    | SendSignal(s) => s.target != "" and Set("TERM", "KILL", "INT").contains(s.signal)
  }
  pure def validReplaySteps(steps: List[Step]): bool = steps.indices().forall(i => match steps.nth(i) {
    Cli(c) => validCmd(c.cmd) and (match c.cmd.providerScript { Missing => true | Present(id) => fixtureScripts.keys().contains(id) })
      and (match c.cmd.launch {
      Foreground => c.expect.exitCode != Unobserved and (observedEffect(c.expect) or c.expect.stderr.class != Unobserved)
      | Background(_) => c.expect.exitCode == Unobserved and c.expect.stdoutLines == Unobserved and c.expect.jsonRows == Unobserved
        and c.expect.statusRows == Unobserved and c.expect.stderr.class == Unobserved and c.expect.stderr.text == IgnoreText
    })
    | Setup(s) => validSetup(s.op, s.expect)
  })
  var record: IntentRecord
  var replayPhase: int
  action retainRequest = all {
    replayPhase == 0, st' = shape(st, "Add a greeting.\r\nKeep the exact request bytes.\n", "greeting", "A1", "gpt-6.1-sol"),
    record' = criteriaRecord, replayPhase' = 1, ioSeam' = ioSeam,
    lastStep' = bootstrap.concat(shapeInvocation("stdin", "life.shape.criteria"))
  }
  action associateBuild = all {
    replayPhase == 1, st' = st, record' = linkBuild(record, "build-1"),
    replayPhase' = 2, ioSeam' = ioSeam,
    lastStep' = [reviewStep, approvalStep,
      cliStep(scriptedCommand(["queue", "start"], "life.build.green"), landingExpectation(true))]
  }
  action retainStutter = all {
    replayPhase == 2, st' = st, record' = record, replayPhase' = replayPhase,
    ioSeam' = ioSeam, lastStep' = []
  }
  run recordBytesAndSingleBuildTest = {
    val r = linkBuild(criteriaRecord, "one")
    init.expect(and { r.request == requestFixture, linkBuild(r, "two") == r, recordSound(r) })
  }

  var st: State
  var lastStep: List[Step]
  var ioSeam: Seam
  action init = all { st' = initial, record' = criteriaRecord, replayPhase' = 0,
    ioSeam' = fixtureSeam, lastStep' = [] }
  action step = any { retainRequest, associateBuild, retainStutter }
  val invariant = sound(st) and recordSound(record) and validSeam(ioSeam) and validReplaySteps(lastStep)
}

// Export only authored fixture inputs. This module never drives the public executable.
module lifeArtifacts {
  import kogen_io.* from "./kogen_io"
  import intent
  var scripts: str -> intent::FixtureScript
  var children: str -> Bytes
  var lastStep: List[Step]
  var ioSeam: Seam
  action init = all { scripts' = intent::fixtureScripts, children' = intent::cargoChildren.put("named-green", intent::acceptanceChildren.get("named-green")).put("missing-case", intent::acceptanceChildren.get("missing-case")).put("duplicate-case", intent::acceptanceChildren.get("duplicate-case")), lastStep' = [], ioSeam' = defaultSeam }
  action step = all { scripts' = scripts, children' = children, lastStep' = [], ioSeam' = ioSeam }
  val invariant = scripts.keys() == intent::fixtureScripts.keys()
}
