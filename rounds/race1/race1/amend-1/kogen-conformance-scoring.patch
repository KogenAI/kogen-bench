+def _sweep_case(workdir):
+    """Kill every process whose cwd is under this case's workdir (escaped sessions/groups). Harness-side only."""
+    try:
+        out = subprocess.run(["lsof", "-t", "-a", "-d", "cwd", "+D", workdir], capture_output=True, text=True, timeout=30).stdout
+        me = os.getpid()
+        for pid in set(out.split()):
+            if pid.isdigit() and int(pid) != me:
+                try:
+                    os.kill(int(pid), 9)
+                except Exception:
+                    pass
+    except Exception:
+        pass
