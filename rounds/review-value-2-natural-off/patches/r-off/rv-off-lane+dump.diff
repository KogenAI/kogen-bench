diff --git a/cli/build/rvoff.go b/cli/build/rvoff.go
new file mode 100644
index 0000000..64cdf51
--- /dev/null
+++ b/cli/build/rvoff.go
@@ -0,0 +1,44 @@
+package build
+
+import (
+	"context"
+
+	"kogen/verify"
+)
+
+// Research lane rv-off (REVIEW-VALUE-2): KOGEN_REVIEW_OFF=1 approves every green pass with the
+// existing approveWithoutReview stub, so no reviewer request is made. "0", "" or no value
+// leave the independent review as it is (any other value means the same as no value). A
+// Deps.Reviewer set by the caller (tests) wins.
+//
+// reviewOffDefault is what "no value" means. It is false here. The "-lane" variants of the
+// patch set it to true, so that a lane whose binary is the review-off arm needs no environment
+// variable (the lanes harness cannot set one per lane); KOGEN_REVIEW_OFF=0 then turns review on.
+const reviewOffEnv = "KOGEN_REVIEW_OFF"
+
+var reviewOffDefault = true
+
+func reviewOff(value string) bool {
+	switch value {
+	case "1":
+		return true
+	case "0":
+		return false
+	}
+	return reviewOffDefault
+}
+
+type skippedReview struct{ approveWithoutReview }
+
+func (r skippedReview) Review(ctx context.Context, b *Attempt, pass verify.Pass) (Approved, error) {
+	b.Run.Event(map[string]any{"event": "review_skipped"})
+	return r.approveWithoutReview.Review(ctx, b, pass)
+}
+
+// reviewer is the Build's reviewer: the stub when review is switched off, else the Deps one.
+func (b *Attempt) reviewer() Reviewer {
+	if b.deps.Reviewer == nil && reviewOff(b.s.Getenv(reviewOffEnv)) {
+		return skippedReview{}
+	}
+	return b.deps.reviewer()
+}
diff --git a/cli/build/rvoff_test.go b/cli/build/rvoff_test.go
new file mode 100644
index 0000000..6a56e48
--- /dev/null
+++ b/cli/build/rvoff_test.go
@@ -0,0 +1,71 @@
+package build
+
+import "testing"
+
+// The suite runs with the base meaning of "no value" whichever default a patch variant carries.
+func init() { reviewOffDefault = false }
+
+func TestRVOffApprovesAGreenPassWithoutAReviewerRequest(t *testing.T) {
+	e := newEnv(t)
+	f := e.prov
+	f.then(landScript(f)...)
+	t.Setenv("KOGEN_REVIEW_OFF", "1")
+	a := e.reviewed()
+	if a.exit != 0 || a.err != nil {
+		t.Fatalf("exit %d err %v\n%s", a.exit, a.err, a.shown())
+	}
+	id := e.onlyRun()
+	eq(t, "review requests", len(f.reviewRequests()), 0)
+	eq(t, "requests", f.count(), 1)
+	events := e.events(id)
+	eq(t, "review_skipped", len(eventsNamed(events, "review_skipped")), 1)
+	reviews := eventsNamed(events, "review")
+	if len(reviews) != 1 || reviews[0]["stub"] != "no independent review ran" || reviews[0]["verdict"] != "approve" {
+		t.Fatalf("review events %v", reviews)
+	}
+	eq(t, "committed app", e.gitOut("show", "HEAD:app.txt"), "candidate")
+}
+
+func TestRVOffIsOffUnlessExactlyOne(t *testing.T) {
+	for _, v := range []string{"", "0", "off", "true"} {
+		t.Run("value "+v, func(t *testing.T) {
+			e := newEnv(t)
+			f := e.prov
+			f.then(landScript(f)...)
+			f.then(submit(f, "approve"))
+			t.Setenv("KOGEN_REVIEW_OFF", v)
+			a := e.reviewed()
+			if a.exit != 0 || a.err != nil {
+				t.Fatalf("exit %d err %v\n%s", a.exit, a.err, a.shown())
+			}
+			eq(t, "review requests", len(f.reviewRequests()), 1)
+			eq(t, "review_skipped", len(eventsNamed(e.events(e.onlyRun()), "review_skipped")), 0)
+		})
+	}
+}
+
+func TestRVOffLaneDefaultSwitchesReviewOffUnlessZero(t *testing.T) {
+	reviewOffDefault = true
+	t.Cleanup(func() { reviewOffDefault = false })
+	for value, wantOff := range map[string]bool{"": true, "1": true, "other": true, "0": false} {
+		t.Run("value "+value, func(t *testing.T) {
+			e := newEnv(t)
+			f := e.prov
+			f.then(landScript(f)...)
+			if !wantOff {
+				f.then(submit(f, "approve"))
+			}
+			t.Setenv("KOGEN_REVIEW_OFF", value)
+			a := e.reviewed()
+			if a.exit != 0 || a.err != nil {
+				t.Fatalf("exit %d err %v\n%s", a.exit, a.err, a.shown())
+			}
+			wantReviews, wantSkips := 1, 0
+			if wantOff {
+				wantReviews, wantSkips = 0, 1
+			}
+			eq(t, "review requests", len(f.reviewRequests()), wantReviews)
+			eq(t, "review_skipped", len(eventsNamed(e.events(e.onlyRun()), "review_skipped")), wantSkips)
+		})
+	}
+}
