diff --git a/cli/provider/wire_sid_test.go b/cli/provider/wire_sid_test.go
new file mode 100644
index 0000000..5f47457
--- /dev/null
+++ b/cli/provider/wire_sid_test.go
@@ -0,0 +1,23 @@
+package provider
+
+import "testing"
+
+func TestChatGPTSessionHeadersLaneCSID(t *testing.T) {
+	info := Info{Name: "chatgpt"}
+	if !info.chatgpt() {
+		t.Skip("chatgpt Info helper differs; covered by the render test below")
+	}
+	req := Request{Role: Role{Model: "gpt-6.1-sol", Effort: "medium"}, Instructions: "i", Input: []any{}}
+	r, err := render(info, req, "cache-abc", false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r.headers["session_id"] != "cache-abc" || r.headers["conversation_id"] != "cache-abc" || r.body["prompt_cache_key"] != "cache-abc" {
+		t.Fatalf("headers %v body key %v", r.headers, r.body["prompt_cache_key"])
+	}
+	t.Setenv("KOGEN_CHATGPT_SESSION_HEADERS", "off")
+	r, _ = render(info, req, "cache-abc", false)
+	if len(r.headers) != 0 {
+		t.Fatalf("kill switch left headers %v", r.headers)
+	}
+}
