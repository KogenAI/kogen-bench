#!/usr/bin/env python3
"""Agent-visible fv client. Authoritative execution and log belong to the root broker."""
import json, os, pathlib, secrets, sys, time
if sys.argv[1:] != ['check']:
    raise SystemExit('usage: ./fv check')
control=pathlib.Path(__file__).resolve().parent / '.fv-control'
ident=secrets.token_hex(16)
with (control/'requests.fifo').open('wb',buffering=0) as request:
    request.write((json.dumps({'action':'check','id':ident})+'\n').encode())
reply=control/'replies'/(ident+'.jsonl')
while not reply.exists(): time.sleep(.02)
f=reply.open('rb')
status=1
while True:
    position=f.tell(); line=f.readline()
    if not line.endswith(b'\n'): f.seek(position); time.sleep(.02); continue
    x=json.loads(line)
    if 'output' in x: print(x['output'],end='',flush=True)
    if 'summary' in x:
        print('FV_SUMMARY '+json.dumps(x['summary'],sort_keys=True),flush=True); status=x['summary']['exit_code']; break
raise SystemExit(status)
