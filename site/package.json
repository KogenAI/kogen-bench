{
  "name": "kogen-bench-site",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "prepare:data": "python3 scripts/prepare.py",
    "build": "npm run prepare:data && astro build && python3 scripts/finalize.py && python3 scripts/check.py",
    "release": "python3 ../reproduce/validate_release.py && npm run build",
    "dev": "npm run prepare:data && astro dev",
    "preview": "astro preview"
  },
  "dependencies": {
    "astro": "7.3.1",
    "marked": "15.0.12"
  }
}
