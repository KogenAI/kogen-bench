---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import StatusPill from '../../components/StatusPill.astro';
import { pageByRoute, siteData } from '../../lib/data.js';
const page = pageByRoute.get('/rounds/');
const statuses = [...new Set(siteData.rounds.map((round) => round.status))].sort();
const families = siteData.families;
---
<SiteLayout page={page}>
  <PageHeading page={page} kicker="Experiment register" lead="The round list comes from rounds/index.json. Status comes from the reviewed rounds/STATUS.md inventory; each source page retains its badge, reasons and limits." />
  <p class="no-script-note">The complete register is below without JavaScript. Search and filters are optional enhancements; they never remove records from the document source.</p>
  <form class="filter-bar" data-round-filters role="search">
    <label>Search rounds<input type="search" name="q" placeholder="ID, hypothesis, title" autocomplete="off" data-round-query /></label>
    <label>Status<select name="status" data-round-status><option value="">All statuses</option>{statuses.map((status) => <option value={status}>{status}</option>)}</select></label>
    <label>Family<select name="family" data-round-family><option value="">All families</option>{families.map((family) => <option value={family.id}>{family.id} · {family.title}</option>)}</select></label>
    <span class="filter-count" data-round-count aria-live="polite">Registered entries</span>
  </form>
  <div class="record-table-wrap" role="region" aria-label="Data table" tabindex="0">
    <table class="record-table" data-round-table data-origin="round-crosswalk">
      <thead><tr><th scope="col">Round</th><th scope="col">Status</th><th scope="col">Family</th><th scope="col">Related hypotheses</th><th scope="col">Claim records</th></tr></thead>
      <tbody>
        {siteData.rounds.map((round) => <tr data-round-row data-status={round.status} data-families={round.family_ids.join(' ')} data-search={`${round.id} ${round.title} ${round.status} ${round.hypothesis_ids.join(' ')} ${round.family_ids.join(' ')}`}>
          <td><a href={`/rounds/${round.slug}/`}>{round.id}</a></td>
          <td><StatusPill status={round.status} /></td>
          <td>{round.family_ids.length ? round.family_ids.map((id) => <a href={`/families/${id.toLowerCase()}/`}>{id} </a>) : 'Not linked'}</td>
          <td>{round.hypothesis_ids.length ? round.hypothesis_ids.map((id) => <a href={`/hypotheses/${id.toLowerCase()}/`}>{id} </a>) : 'Not linked'}</td>
          <td>{round.claim_ids.length ? round.claim_ids.map((id) => <a href={`/claims/${id.toLowerCase()}/`} title={id}>Claim</a>) : 'None linked'}</td>
        </tr>)}
      </tbody>
    </table>
  </div>
  <script is:inline src="/js/round-filter.js"></script>
</SiteLayout>
