---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import StatusPill from '../../components/StatusPill.astro';
import { pageByRoute, siteData } from '../../lib/data.js';
const page = pageByRoute.get('/comparisons/');
const comparisons = siteData.claims.filter((claim) => claim.comparison !== null && claim.comparison !== undefined && claim.comparison !== '' && !(Array.isArray(claim.comparison) && claim.comparison.length === 0));
---
<SiteLayout page={page}>
  <PageHeading page={page} kicker="Claim-ledger comparisons" lead="This page surfaces only claims with an explicit comparison field. It does not pool cohorts, rank configurations, or synthesize a winner." />
  <div class="status-callout"><strong>No automatic pooling</strong>Round, task, venue, model, effort, and analysis differences remain attached to each claim. Follow every included and excluded record before drawing a comparison.</div>
  {comparisons.length ? <div class="record-table-wrap" role="region" aria-label="Data table" tabindex="0"><table class="record-table" data-origin="claim-ledger">
    <thead><tr><th scope="col">Claim</th><th scope="col">Status</th><th scope="col">Comparison field</th><th scope="col">Round</th><th scope="col">Evidence</th></tr></thead>
    <tbody>{comparisons.map((claim) => <tr>
      <td><a href={`/claims/${claim.claim_id.toLowerCase()}/`}>{claim.claim_id}</a></td>
      <td><StatusPill status={claim.claim_status || 'Not recorded'} /></td>
      <td>{typeof claim.comparison === 'object' ? JSON.stringify(claim.comparison) : claim.comparison}</td>
      <td>{claim.round_id && siteData.rounds.some((round) => round.id === claim.round_id) ? <a href={`/rounds/${String(claim.round_id).toLowerCase()}/`}>{claim.round_id}</a> : 'Not linked'}</td>
      <td>{claim.evidence_status || 'Not recorded'}</td>
    </tr>)}</tbody>
  </table></div> : <p class="empty-state">No claim-ledger row has a structured comparison field. Comparison pages remain status-only until such records are published.</p>}
</SiteLayout>
