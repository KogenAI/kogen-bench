---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import SourceDocument from '../../components/SourceDocument.astro';
import { pageByRoute, siteData } from '../../lib/data.js';
export function getStaticPaths() {
  return siteData.result_comparisons.map((comp) => ({ params: { slug: comp.id }, props: { comp } }));
}
const { comp } = Astro.props;
const page = pageByRoute.get(comp.url);
---
<SiteLayout page={page}>
  <PageHeading page={page} kicker="Comparison" lead={comp.blurb} />
  <SourceDocument markdown={page.markdown.replace(/^# .*\n+/, '')} sourcePath={page.source_path} revision={siteData.meta.revision} label="Comparison" />
</SiteLayout>
