---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import SourceDocument from '../../components/SourceDocument.astro';
import RelatedRecords from '../../components/RelatedRecords.astro';
import { pageByRoute, siteData } from '../../lib/data.js';
export function getStaticPaths() {
  return siteData.families.map((family) => ({ params: { id: family.slug }, props: { family } }));
}
const { family } = Astro.props;
const page = pageByRoute.get(`/families/${family.slug}/`);
---
<SiteLayout page={page}>
  <PageHeading page={page} kicker={family.id} lead="The authored family record is reproduced below. Structured links connect its hypotheses, rounds, and claim-ledger rows." />
  <div class="source-callout"><strong>Source-reported narrative</strong>Numeric statements in this family document remain source-reported unless an exact claim-ledger row is linked and its status allows that interpretation.</div>
  <SourceDocument markdown={family.markdown} sourcePath={family.source_path} revision={siteData.meta.revision} label="Family source document" />
  <RelatedRecords hypothesisIds={family.hypothesis_ids} roundIds={family.round_ids} claimIds={family.claim_ids} />
</SiteLayout>
