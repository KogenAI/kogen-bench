---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import SourceDocument from '../../components/SourceDocument.astro';
import { pageByRoute, siteData } from '../../lib/data.js';
const page = pageByRoute.get('/languages/');
const body = page.markdown.replace(/^#\s+[^\n]+\n+/, '');
---
<SiteLayout page={page}>
  <PageHeading page={page} kicker="Language comparison" />
  <SourceDocument markdown={body} sourcePath="research/LANGUAGES.md" revision={siteData.meta.revision} label="Language round summary" />
</SiteLayout>
