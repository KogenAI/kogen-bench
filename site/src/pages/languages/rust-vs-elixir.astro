---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeading from '../../components/PageHeading.astro';
import SourceDocument from '../../components/SourceDocument.astro';
import { pageByRoute, siteData } from '../../lib/data.js';
const page = pageByRoute.get('/languages/rust-vs-elixir/');
const body = page.markdown.replace(/^#\s+[^\n]+\n+/, '');
---
<SiteLayout page={page}>
  <PageHeading page={page} kicker="Cross-round evidence" />
  <SourceDocument markdown={body} sourcePath="research/RUST-VS-ELIXIR-EVIDENCE.md" revision={siteData.meta.revision} label="Rust and Elixir evidence" />
</SiteLayout>
